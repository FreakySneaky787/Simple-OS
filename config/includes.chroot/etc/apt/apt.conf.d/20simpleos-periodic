// Simple OS – Paketlisten täglich im Hintergrund laden (apt-daily.timer), damit simpleos-update --check
// ohne Passwort sieht, ob es Updates gibt. Installiert wird nichts automatisch.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::Unattended-Upgrade "0";
