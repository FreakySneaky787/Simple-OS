# Simple OS: never route local addresses through a proxy (system proxy, VPN proxy) – local helper services
# and system apps stay reachable even when a proxy is set. Existing exceptions are kept.
NO_PROXY="localhost,127.0.0.1,::1${NO_PROXY:+,$NO_PROXY}"
no_proxy="localhost,127.0.0.1,::1${no_proxy:+,$no_proxy}"
export NO_PROXY no_proxy
