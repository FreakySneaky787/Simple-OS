// Simple OS – fastfetch (Catppuccin Mocha)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/simpleos/fastfetch-logo.txt",
    "color": { "1": "38;2;137;180;250", "2": "38;2;203;166;247" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 10 },
    "color": { "keys": "38;2;137;180;250", "title": "38;2;203;166;247", "output": "38;2;205;214;244" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─", "outputColor": "38;2;69;71;90" },
    { "type": "os",       "key": "OS",       "keyColor": "38;2;137;180;250" },
    { "type": "kernel",   "key": "Kernel",   "keyColor": "38;2;180;190;254" },
    { "type": "uptime",   "key": "Uptime",   "keyColor": "38;2;203;166;247" },
    { "type": "packages", "key": "Packages", "keyColor": "38;2;245;194;231" },
    { "type": "shell",    "key": "Shell",    "keyColor": "38;2;243;139;168" },
    { "type": "wm",       "key": "WM",       "keyColor": "38;2;250;179;135" },
    { "type": "localip",  "key": "LAN IP",   "keyColor": "38;2;116;199;236", "format": "{ipv4} ({ifname})",
      "showIpv4": true, "showIpv6": false, "showPrefixLen": false, "defaultRouteOnly": true },
    { "type": "terminal", "key": "Terminal", "keyColor": "38;2;249;226;175" },
    { "type": "cpu",      "key": "CPU",      "keyColor": "38;2;166;227;161" },
    { "type": "memory",   "key": "Memory",   "keyColor": "38;2;148;226;213" },
    { "type": "disk",     "key": "Disk",     "keyColor": "38;2;137;220;235", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
