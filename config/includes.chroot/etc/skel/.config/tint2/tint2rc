#---- Panel
panel_items = PTEESCP
panel_size = 100% 40
# Distance from the screen edge (left/right, bottom) -> the bar floats
panel_margin = 12 10
panel_padding = 10 5 6
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 0
mouse_effects = 1
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0

#---- Taskbar
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 0 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_distribute_size = 0
taskbar_sort_order = none

#---- Tasks
task_text = 1
task_icon = 1
task_centered = 0
urgent_nb_of_blink = 100000
task_maximum_size = 200 30
task_padding = 10 4 8
task_tooltip = 1
task_thumbnail = 0
task_font = Inter Medium 10
task_font_color = #cdd6f4 100
task_active_font_color = #cdd6f4 100
task_iconified_font_color = #6c7086 100
task_urgent_font_color = #cdd6f4 100
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 2
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

#---- System tray
systray_padding = 6 0 8
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18
systray_icon_asb = 100 0 0
systray_monitor = 1

#---- Do Not Disturb (icon only while DND is on; a click toggles it; simpleos-taskbar-select --apply sets the block)
execp = new
execp_command = /usr/local/bin/simpleos-dnd --panel
execp_interval = 0
execp_continuous = 1
execp_has_icon = 0
execp_markup = 1
execp_font_color = #cdd6f4 100
execp_padding = 6 4
execp_background_id = 6
execp_centered = 1
execp_tooltip = Do Not Disturb is on – click to turn it off
execp_lclick_command = /usr/local/bin/simpleos-dnd --toggle
execp_rclick_command = /usr/local/bin/simpleos-control-center system
#---- Do Not Disturb End

#---- Network (LAN IP visible directly, details in the tooltip = stderr; click = Wi-Fi menu, right-click = Super+N)
execp = new
execp_command = simpleos-netinfo --panel
execp_interval = 5
execp_has_icon = 0
execp_continuous = 0
execp_markup = 1
execp_font = Inter Medium 10
execp_font_color = #cdd6f4 100
execp_padding = 8 4
execp_background_id = 6
execp_centered = 1
execp_lclick_command = /usr/local/bin/simpleos-wifi
execp_rclick_command = simpleos-netinfo

#---- Battery: simpleos-taskbar-select --apply puts "B" into panel_items at login only if there is a battery;
# simpleos-battery checks again for the notification (real battery, discharging) – never in VMs
battery_tooltip = 1
battery_low_status = 10
battery_low_cmd = /usr/local/bin/simpleos-battery --low-alert
battery_full_cmd =
bat1_font = Inter Medium 10
bat2_font = Inter 8
battery_font_color = #cdd6f4 100
bat1_format = %p
bat2_format =
battery_padding = 8 0
battery_background_id = 0
battery_hide = 101
ac_connected_cmd =
ac_disconnected_cmd =

#---- Clock (two lines like Windows 11: time above date)
time1_format = %H:%M
time1_font = Inter Semibold 10
time2_format = %a, %b %-d
time2_font = Inter 8
clock_font_color = #cdd6f4 100
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A, %B %-d, %Y
clock_lclick_command =
clock_rclick_command =

#---- App button (opens rofi)
button = new
button_text = 
button_font = FontAwesome 13
button_font_color = #89b4fa 100
button_padding = 10 4
button_background_id = 6
button_centered = 1
button_max_icon_size = 0
button_tooltip = Apps (Super)
button_lclick_command = rofi -show drun

#---- Power button on the far right (opens the power menu, like Super+X)
button = new
