# Simple OS – Benachrichtigungen (dunst 1.9), Catppuccin Mocha
# Unten rechts über der schwebenden Taskleiste, weiche Ecken, Inter, Papirus-Icons.
# Linksklick löst die Aktion einer Meldung aus ("Open" beim USB-Stick, "Install" bei Updates),
# Rechtsklick schließt alle. Nicht gesetzte Werte nehmen dunsts eingebaute Vorgaben.

[global]
    monitor = 0
    follow = mouse
    origin = bottom-right
    offset = 16x64
    width = (280, 380)
    height = 160
    notification_limit = 4
    indicate_hidden = yes
    separator_height = 0
    gap_size = 8
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#313244"
    corner_radius = 12
    sort = yes

    # Fortschrittsbalken (Lautstärke/Helligkeit, Ladefenster ohne Anzeige): schlank, Catppuccin Mocha
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 340
    highlight = "#89b4fa"

    font = Inter 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    ignore_newline = no
    show_indicators = no
    word_wrap = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

    dmenu = /usr/bin/rofi -dmenu -p Action
    browser = /usr/bin/xdg-open
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

    sticky_history = yes
    history_length = 20

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0

# OSD für Fn-Tasten (simpleos-osd): ersetzt sich selbst (Stack-Tag), kurz sichtbar, nicht im Verlauf,
# Balken in Catppuccin-Blau auf Surface0
[simpleos-osd]
    category = x-simpleos-osd
    timeout = 1.5
    history_ignore = yes
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    highlight = "#89b4fa"
    format = "<b>%s</b>  %b"
