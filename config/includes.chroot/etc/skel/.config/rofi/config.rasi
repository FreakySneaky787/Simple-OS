configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "Inter 11";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    /* Start menu like Windows: ONE click opens/accepts the entry (Rofi's default would be a double click).
       Applies to all Rofi windows (menu, search, flyouts); desktop icons (pcmanfm) stay with a double click.
       "!" = accept on RELEASE: on press the app (Wi-Fi, Sound, Appearance …) already opened its own
       Rofi window while the button was still down – releasing it outside closed it again right away. */
    me-select-entry: "";
    me-accept-entry: "!MousePrimary";
    /* Tapping Super again closes the menu (xcape sends XF86Search on a tap, see the Openbox autostart) */
    kb-cancel: "Escape,Control+g,Control+bracketleft,XF86Search";
}

* {
    bg:        #1e1e2e;
    bg-alt:    #313244;
    bg-sel:    #45475a;
    fg:        #cdd6f4;
    fg-sub:    #a6adc8;
    fg-dim:    #6c7086;
    line:      #313244;
    accent:    #89b4fa;

    background-color: transparent;
    text-color:       @fg;
}

/* Window: soft corners, a fine border instead of a heavy frame; picom draws the shadow */
window {
    location:         center;
    anchor:           center;
    width:            600px;
    border:           1px;
    border-color:     @line;
    border-radius:    16px;
    background-color: @bg;
    transparency:     "real";
}

mainbox {
    /* message: hint line from "rofi -mesg" (network, power, updates …); without -mesg Rofi hides it */
    children: [ inputbar, message, listview ];
    spacing:  10px;
    padding:  14px;
}

/* Search field: a calm area without a border, the prompt word only as a quiet label */
inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          10px;
}

prompt {
    text-color: @fg-sub;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    cursor:            text;
}

/* Hint line as a heading, not as a box */
message {
    padding: 2px 6px 0px 6px;
    /* without its own setting Rofi draws its built-in dashed border (visible in light mode) */
    border:  0px;
}

textbox {
    text-color: @fg-sub;
}

listview {
    border:       0px;
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element {
    padding:       9px 12px;
    border-radius: 10px;
    spacing:       12px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

/* Selection: a subtle area, a narrow accent marker on the left (color via simpleos-theme) */
element selected.normal {
    background-color: @bg-alt;
    text-color:       @fg;
    border:           0px 0px 0px 3px;
    border-color:     @accent;
}

element-icon {
    size:           24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
