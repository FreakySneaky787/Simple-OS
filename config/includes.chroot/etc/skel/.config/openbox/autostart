# Simple OS – Openbox Autostart
# Resolution: in VMs first 1920x1080 as a base (real monitors keep their native resolution).
# If the virtual graphics does not offer that mode, take the preferred mode instead of staying at 1024x768.
# Afterwards spice-vdagent adjusts size + clipboard, if the VM has a SPICE channel
# (the spice-vdagentd daemon starts via udev). The size follows the window only with a SPICE client (virt-manager,
# remote-viewer); QEMU's built-in qemu-vdagent (test_vm.sh) only provides the clipboard.
if systemd-detect-virt -q --vm; then
    xrandr -s 1920x1080 2>/dev/null || xrandr --auto 2>/dev/null || true
fi
# Standard folders (Documents, Downloads, Pictures … come with ~/.config/user-dirs.dirs from /etc/skel): fill the
# sidebar of Thunar and file dialogs with them once at first login – needs the real home path, so not already
# in /etc/skel. No xdg-user-dirs-update: it does not recreate deleted folders but points them to ~ instead
mkdir -p ~/.config/gtk-3.0
[ -e ~/.config/gtk-3.0/bookmarks ] || for d in Documents Downloads Pictures Music Videos; do
    echo "file://$HOME/$d $d"
done > ~/.config/gtk-3.0/bookmarks
# Your own display setting (Settings → Display, confirmed with "Keep changes") takes precedence
simpleos-display --restore
# A monitor/projector/TV plugged in later is switched on and extends the desktop (Xorg only reports it)
simpleos-display --watch &
# Saved touchpad/mouse settings (Control Center → Mouse & Touchpad), again for devices connected later
simpleos-input --watch &
# Keyboard layout of the account (simpleos-keyboard-setup; system-wide it is in /etc/default/keyboard)
simpleos-keyboard-setup --apply
# Live session (USB stick/ISO): desktop icon "Install Simple OS" + Welcome with the install banner;
# installed system: remove installer leftovers from the desktop and menu. Taskbar badge: --apply below
simpleos-live --setup
if [ -e /dev/virtio-ports/com.redhat.spice.0 ]; then
    spice-vdagent &
fi
# Compositor (shadows, rounded corners; GLX + VSync; software OpenGL/llvmpipe only -> xrender without effects, fallbacks
# without VSync/GLX): simpleos-picom – Do Not Disturb (simpleos-dnd) uses the same logic when switching back on
simpleos-picom --start
# XSETTINGS (xsettingsd): GTK theme/icons/font for all GTK3 programs; simpleos-theme switches light/dark
# through it live (SIGHUP) – without a settings service, running windows would only see the change after a restart
simpleos-theme --xsettings
# Background: fallback color, then the wallpaper via feh (synchronous, visible immediately),
# then pcmanfm for desktop icons (draws the same wallpaper)
xsetroot -solid "#1e1e2e"
feh --no-fehbg --bg-fill /usr/share/backgrounds/simpleos/wallpaper.png
pcmanfm --desktop &
# Set the default mouse cursor (otherwise invisible over the root window)
xsetroot -cursor_name left_ptr &
# Notifications first: applets and scripts sometimes report right at startup (e.g. nm-applet
# "Connection established"); otherwise D-Bus would start dunst on the side and this call would go nowhere.
# simpleos-dunst appends the battery filter in VMs/without a real battery (no false "Battery low" alarms)
simpleos-dunst &
# System applets for the taskbar
lxpolkit &
# NetworkManager applet: a left click on the tray icon lists the Wi-Fi networks (click, enter the password)
nm-applet &
# Bluetooth applet (pairing agent for keyboards/phones, tray icon) only with Bluetooth hardware: a Python process of
# ~40 MB that would sit idle on desktops and in VMs without it. A USB dongle plugged in later: next sign-in
[ -n "$(ls /sys/class/bluetooth 2>/dev/null)" ] && blueman-applet &
# Power manager only with a real battery (not in VMs, not on desktop PCs): otherwise it reported phantom
# devices with 0 % as "low power" via UPower. Notifications/tray icon are off anyway
# (/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-power-manager.xml), battery display: tint2 + simpleos-battery
simpleos-battery --present && xfce4-power-manager &
volumeicon &
# Taskbar: apply the settings (e.g. battery display only on devices with a battery), then start it.
# Without DISPLAY, otherwise --apply starts a tint2 itself and there would be two bars.
env -u DISPLAY simpleos-taskbar-select --apply 2>/dev/null
tint2 &
# Mount USB sticks/drives automatically; notification with "Open" via simpleos-usb-notify (instead of the
# technical udiskie notifications), tray icon for safe removal only while a drive is plugged in
udiskie --automount --no-notify --smart-tray --file-manager thunar \
    --notify-command "/usr/local/bin/simpleos-usb-notify {event} {mount_path} {id_label} {drive_label}" &
# Updates: check 2 minutes after login, then every 12 hours (also after waking up from sleep) – a notification only
# if there are any (not in the live session)
/usr/local/bin/simpleos-update --watch &
# Clipboard history (Super+V) remembers copied texts
simpleos-clipboard --daemon &
# Night light (on/off/automatic 20–7 o'clock, Settings → Night Light) and screen blanking (Control Center → Power)
simpleos-nightlight --daemon &
# Dynamic wallpaper (Control Center → Appearance): light during the day, dark in the evening/night light – silent unless switched on
simpleos-wallpaper-schedule --daemon &
simpleos-power --apply
# Tapping the Super key alone -> XF86Search (Openbox: search/menu). Deliberately its own key instead of a
# synthetic Super+Space: that mixed with real Super+Space (the menu opened and closed again right away
# or not at all) and with Super shortcuts. Super+Space stays its own Openbox key; tapping again
# closes the menu (Rofi: kb-cancel XF86Search). If you hold Super longer than 500 ms, nothing happens.
pkill -x xcape 2>/dev/null
xcape -e 'Super_L=XF86Search;Super_R=XF86Search' &
# Setup Wizard at first login (not in the live session). With SPICE wait briefly until
# spice-vdagent has set the resolution – otherwise the wizard is centered on the old screen size.
[ -e /dev/virtio-ports/com.redhat.spice.0 ] && sleep 2
simpleos-welcome-wizard --first-run &
