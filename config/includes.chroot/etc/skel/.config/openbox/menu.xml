<?xml version="1.0" encoding="UTF-8"?>
<!-- Simple OS – right-click menu: deliberately slim. The launcher (Super) finds all apps;
     all settings are bundled under "Settings". Papirus icons on every entry: Openbox 3.6
     has no padding for menu entries, the icon column moves the text away from the edge. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Simple OS">
    <!-- simpleos-installer-begin: only in the live session. simpleos-post-install (Calamares) and
         simpleos-live at login without a live medium delete everything up to the end marker. -->
    <item label="Install Simple OS" icon="/usr/share/simpleos/menu-icons/install.svg">
      <action name="Execute"><command>/usr/local/bin/simpleos-install</command></action>
    </item>
    <separator />
    <!-- simpleos-installer-end -->
    <item label="Search (Super+Space)" icon="/usr/share/simpleos/menu-icons/search.svg">
      <action name="Execute"><command>/usr/local/bin/simpleos-search</command></action>
    </item>
    <item label="Files" icon="/usr/share/simpleos/menu-icons/files.svg">
      <action name="Execute"><command>thunar</command></action>
    </item>
    <item label="Web Browser (Super+B)" icon="/usr/share/simpleos/menu-icons/browser.svg">
      <action name="Execute"><command>simpleos-browser</command></action>
    </item>
    <item label="Software Center" icon="/usr/share/simpleos/menu-icons/store.svg">
      <action name="Execute"><command>/usr/local/bin/simpleos-software-center</command></action>
    </item>
    <item label="Terminal" icon="/usr/share/simpleos/menu-icons/terminal.svg">
      <action name="Execute"><command>kitty</command></action>
    </item>
    <menu id="apps" label="Apps" icon="/usr/share/simpleos/menu-icons/apps.svg">
      <item label="PDF Viewer" icon="/usr/share/simpleos/menu-icons/pdf.svg">
        <action name="Execute"><command>atril</command></action>
      </item>
      <!-- simpleos-office: simpleos-system-setup adds LibreOffice/ONLYOFFICE here after the installation -->
      <item label="Text Editor" icon="/usr/share/simpleos/menu-icons/editor.svg">
        <action name="Execute"><command>mousepad</command></action>
      </item>
      <item label="Calculator" icon="/usr/share/simpleos/menu-icons/calculator.svg">
        <action name="Execute"><command>galculator</command></action>
      </item>
      <item label="Media Player" icon="/usr/share/simpleos/menu-icons/media.svg">
        <action name="Execute"><command>mpv --player-operation-mode=pseudo-gui</command></action>
      </item>
      <item label="Image Viewer" icon="/usr/share/simpleos/menu-icons/image.svg">
        <action name="Execute"><command>viewnior</command></action>
      </item>
      <item label="Camera" icon="/usr/share/simpleos/menu-icons/camera.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-camera</command></action>
      </item>
    </menu>
    <separator />
    <!-- Order: everyday apps – Settings (each entry opens its Control Center page) – Tools – Help – Power; keyboard
         shortcuts in brackets so you learn them. Never change the lines next to the installer markers (the
         installation removes that block) or the office marker: updates merge this file into every account's copy,
         and a change next to theirs makes the merge give up and keep the old menu. -->
    <menu id="simpleos-settings" label="Settings" icon="/usr/share/simpleos/menu-icons/settings.svg">
      <item label="All Settings (Super+I)" icon="/usr/share/simpleos/menu-icons/settings.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center</command></action>
      </item>
      <separator />
      <item label="Wi-Fi &amp; Network" icon="/usr/share/simpleos/menu-icons/wifi.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center wifi</command></action>
      </item>
      <item label="Bluetooth" icon="/usr/share/simpleos/menu-icons/bluetooth.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center bluetooth</command></action>
      </item>
      <item label="Sound" icon="/usr/share/simpleos/menu-icons/sound.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center sound</command></action>
      </item>
      <item label="Display" icon="/usr/share/simpleos/menu-icons/display.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center display</command></action>
      </item>
      <item label="Appearance &amp; Wallpaper" icon="/usr/share/simpleos/menu-icons/appearance.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center appearance</command></action>
      </item>
      <item label="Keyboard" icon="/usr/share/simpleos/menu-icons/keys.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center keyboard</command></action>
      </item>
      <item label="Printers &amp; Scanners" icon="/usr/share/simpleos/menu-icons/printer.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center printers</command></action>
      </item>
      <item label="Default &amp; Startup Apps" icon="/usr/share/simpleos/menu-icons/apps.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-control-center apps</command></action>
      </item>
      <separator />
      <item label="Night Light" icon="/usr/share/simpleos/menu-icons/night.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-nightlight</command></action>
      </item>
      <item label="Do Not Disturb (on/off)" icon="/usr/share/simpleos/menu-icons/dnd.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-dnd --toggle</command></action>
      </item>
    </menu>
    <menu id="simpleos-tools" label="Tools" icon="/usr/share/simpleos/menu-icons/system.svg">
      <item label="Software Updates" icon="/usr/share/simpleos/menu-icons/updates.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-update</command></action>
      </item>
      <item label="Task Manager (Ctrl+Shift+Esc)" icon="/usr/share/simpleos/menu-icons/taskmanager.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-taskmanager</command></action>
      </item>
      <item label="Backups" icon="/usr/share/simpleos/menu-icons/backup.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-backup</command></action>
      </item>
      <item label="Storage Cleaner" icon="/usr/share/simpleos/menu-icons/cleaner.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-cleaner</command></action>
      </item>
      <item label="Disks &amp; USB Sticks" icon="/usr/share/simpleos/menu-icons/disks.svg">
        <action name="Execute"><command>gnome-disks</command></action>
      </item>
      <item label="Network Info (Super+N)" icon="/usr/share/simpleos/menu-icons/netinfo.svg">
        <action name="Execute"><command>simpleos-netinfo</command></action>
      </item>
    </menu>
    <menu id="simpleos-help" label="Help" icon="/usr/share/simpleos/menu-icons/help.svg">
      <item label="Welcome to Simple OS" icon="/usr/share/simpleos/menu-icons/welcome.svg">
        <action name="Execute"><command>simpleos-welcome</command></action>
      </item>
      <item label="What&apos;s New" icon="/usr/share/simpleos/menu-icons/whatsnew.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-whats-new</command></action>
      </item>
      <item label="Keyboard Shortcuts (Super+H)" icon="/usr/share/simpleos/menu-icons/keys.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-help</command></action>
      </item>
      <item label="Setup Wizard" icon="/usr/share/simpleos/menu-icons/wizard.svg">
        <action name="Execute"><command>simpleos-welcome-wizard</command></action>
      </item>
      <item label="Report a Problem" icon="/usr/share/simpleos/menu-icons/report.svg">
        <action name="Execute"><command>/usr/local/bin/simpleos-report</command></action>
      </item>
    </menu>
    <separator />
    <item label="Power (Super+X)" icon="/usr/share/simpleos/menu-icons/power.svg">
      <action name="Execute"><command>/usr/local/bin/simpleos-powermenu</command></action>
    </item>
  </menu>
</openbox_menu>
