#!/bin/sh
# Simple OS – lock the screen BEFORE the computer sleeps (systemd sleep hook, runs as root).
# systemd calls all programs in /usr/lib/systemd/system-sleep/ with "pre|post" and "suspend|hibernate|
# hybrid-sleep|suspend-then-hibernate" – so on every sleep: closing the laptop lid (logind,
# /etc/systemd/logind.conf.d/10-simpleos-lid.conf), power menu "Sleep", systemctl suspend, empty battery.
# Steps on "pre":
#   1. lock every LightDM user session: D-Bus org.freedesktop.DisplayManager.Session.Lock (the same as
#      "dm-tool lock" – LightDM switches to the login screen, password needed)
#   2. wait until the lock screen is really visible: the active VT (/sys/class/tty/tty0/active) is no longer
#      the VT of a locked session (loginctl VTNr) – at most 3 s. Otherwise the computer would sleep before
#      LightDM has switched, and when opening the lid the desktop would be visible briefly. If it is already
#      locked (the power menu "Sleep" locks itself first), it continues without waiting.
# Not in the live session (the live user has no known password). Never an error exit: sleeping
# must not fail because of locking. Messages go to the journal (journalctl -u systemd-suspend).
# Tests: SIMPLEOS_BUSCTL / SIMPLEOS_LOGINCTL replace busctl/loginctl, SIMPLEOS_TTY_ACTIVE the file of the active
# VT, SIMPLEOS_LOCK_WAIT the waiting time in tenths of a second (systemd calls the hook with an empty environment).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ "${1:-}" = pre ] || exit 0

if [ -x /usr/local/bin/simpleos-live ] && /usr/local/bin/simpleos-live --check; then
    echo "simpleos-lock: live session – not locked"
    exit 0
fi
BUSCTL=${SIMPLEOS_BUSCTL:-busctl}
LOGINCTL=${SIMPLEOS_LOGINCTL:-loginctl}
ACTIVE=${SIMPLEOS_TTY_ACTIVE:-/sys/class/tty/tty0/active}
WAIT=${SIMPLEOS_LOCK_WAIT:-30}
DM=org.freedesktop.DisplayManager

# LightDM user sessions: 'ao 1 "/org/freedesktop/DisplayManager/Session0"'
sessions=$($BUSCTL --system get-property $DM /org/freedesktop/DisplayManager $DM Sessions 2>/dev/null |
    grep -o '"/org/freedesktop/DisplayManager/Session[0-9]*"' | tr -d '"')
if [ -z "$sessions" ]; then
    echo "simpleos-lock: no LightDM session – loginctl lock-sessions"
    $LOGINCTL lock-sessions 2>/dev/null
    exit 0
fi

vts=
for s in $sessions; do
    user=$($BUSCTL --system get-property $DM "$s" $DM.Session UserName 2>/dev/null | sed -n 's/^s "\(.*\)"$/\1/p')
    if $BUSCTL --system call $DM "$s" $DM.Session Lock >/dev/null 2>&1; then
        echo "simpleos-lock: $s (${user:-?}) locked"
    else
        echo "simpleos-lock: $s could not be locked"
    fi
    [ -n "$user" ] || continue
    # VTs of this user's graphical sessions
    for id in $($LOGINCTL list-sessions --no-legend 2>/dev/null | awk -v u="$user" '$3 == u { print $1 }'); do
        vt=$($LOGINCTL show-session "$id" -p VTNr --value 2>/dev/null)
        case "$vt" in ''|0|*[!0-9]*) ;; *) vts="$vts tty$vt" ;; esac
    done
done

# Wait until the lock screen is in front
i=0
while [ "$i" -lt "$WAIT" ]; do
    now=$(cat "$ACTIVE" 2>/dev/null)
    case " $vts " in
        *" $now "*) ;;                       # the user session is still visible
        *) echo "simpleos-lock: lock screen active (${now:-?})"; exit 0 ;;
    esac
    sleep 0.1
    i=$((i + 1))
done
echo "simpleos-lock: lock screen still not visible after $((WAIT / 10)) s – sleeping anyway"
exit 0
