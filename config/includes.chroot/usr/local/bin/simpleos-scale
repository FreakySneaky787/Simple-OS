#!/bin/sh
# Simple OS – display scaling for screens with many pixels (HiDPI, #41): text, taskbar, menus, notifications and the
# mouse pointer bigger, like "Scale" on Windows (Control Center → Display → Scale). Before, nothing scaled: on a
# 2.8K/4K laptop everything was tiny.
#   simpleos-scale --status       setting=auto|100|125|150|200, scale=<percent in use>, recommended=<percent>
#   simpleos-scale --set auto|100|125|150|200   save it and apply it in the running session
#   simpleos-scale --recommended  the automatic percent for this screen (also greeter-screen for the login screen)
#   simpleos-scale --percent      the percent of this session
#   simpleos-scale --session      Xsession (82simpleos-scale), before Openbox: Xft.dpi + cursor size for every program
#   simpleos-scale --xsettings    lines for xsettingsd (simpleos-theme writes them into its file)
#   simpleos-scale --tint2-ref    scale_relative_to_dpi for the taskbar (simpleos-taskbar-select); 0 = off (100 %)
#   simpleos-scale --refresh      the resolution changed (simpleos-display, Control Center): taskbar at the same scale
# Setting ~/.config/simpleos/scale (scale=…, default auto). Automatic = from the real size of the main screen (xrandr:
# pixels and the millimetres of its EDID): from 216 dpi 200 % (14" 2.8K, 13" 2560x1600, 15.6" 4K), from 180 dpi
# 150 % (16" 2560x1600, 24" 4K), below that 100 % – a 15.6"/16" Full HD laptop (~141 dpi) looks the same as before the
# update; 125 % is a choice. No size, a TV that only reports its aspect ratio (160x90 mm …) or nonsense: 100 %.
# X11 has one scale for all screens: the main screen decides (primary output, otherwise the first one that is on).
# What a percent p changes:
#   X resources (xrdb): Xft.dpi = 96·p, Xcursor.size = 24·p – kitty, dunst (its scale 0 = from Xft.dpi), Openbox title
#     bars and menus, Qt, Firefox/Chromium; programs read them when they start
#   XSETTINGS (xsettingsd, simpleos-theme): Xft/DPI, Gtk/CursorThemeSize and from 200 % Gdk/WindowScalingFactor 2 (GTK
#     draws everything twice as big; Gdk/UnscaledDPI keeps the text from growing twice) – running GTK3 windows at once
#   taskbar: tint2 scales everything (sizes, fonts) by monitor dpi / scale_relative_to_dpi, so that value is the
#     monitor's dpi as tint2 computes it divided by p (a resolution change needs --refresh)
#   Rofi: /usr/local/bin/rofi (font dpi and px values), reads the percent from the cache file
#   Openbox theme: borders and paddings (simpleos-theme --openbox-theme writes its copy in ~/.themes)
#   login/lock screen: greeter-screen (the automatic value – nobody is signed in there)
# Cache for the session ~/.cache/simpleos/scale: percent=…, tint2_ref=… (--session, --set, --refresh).
# Tests: SIMPLEOS_XRANDR (instead of xrandr), SIMPLEOS_XRDB, SIMPLEOS_SCALE_CACHE.
STATE=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/simpleos/scale
CACHE=${SIMPLEOS_SCALE_CACHE:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/simpleos/scale}
XRANDR=${SIMPLEOS_XRANDR:-xrandr}
XRDB=${SIMPLEOS_XRDB:-xrdb}

valid() { case "$1" in 100|125|150|200) return 0 ;; esac; return 1; }
setting() {
    _s=$(sed -n 's/^scale=//p' "$STATE" 2>/dev/null | head -n 1)
    if valid "$_s"; then echo "$_s"; else echo auto; fi
}

# The main screen: "<width> <height> <mm width> <mm height>" of the primary output, otherwise of the first output that
# is switched on; nothing without a screen. --current: no probing of the outputs (that can take a second)
main_screen() {
    LC_ALL=C $XRANDR --current 2>/dev/null | LC_ALL=C awk '
        $2 == "connected" {
            geo = ""; mw = 0; mh = 0
            for (i = 3; i <= NF; i++) {
                if (geo == "" && $i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) geo = $i
                if ($i ~ /^[0-9]+mm$/ && $(i + 1) == "x" && $(i + 2) ~ /^[0-9]+mm$/) { mw = $i + 0; mh = $(i + 2) + 0 }
            }
            if (geo == "") next
            split(geo, g, /[x+]/)
            line = g[1] " " g[2] " " mw " " mh
            if ($3 == "primary") { print line; found = 1; exit }
            if (first == "") first = line
        }
        END { if (!found && first != "") print first }'
}

recommended() {
    _p=$(main_screen | LC_ALL=C awk '
        NF == 4 {
            w = $1; h = $2; mw = $3; mh = $4
            p = 100
            # a TV/projector that only reports its aspect ratio as the size (like GNOME: 16x9, 160x90, 1600x1000 …)
            aspect = (mw == 16 || mw == 160 || mw == 1600) && (mh == 9 || mh == 10 || mh == 90 || mh == 100 || mh == 900 || mh == 1000)
            if (mw > 0 && mh > 0 && !aspect) {
                if ((w < h) != (mw < mh)) { t = mw; mw = mh; mh = t }   # turned screen: pixels turned, millimetres not
                dx = w / mw * 25.4; dy = h / mh * 25.4; dpi = dx > dy ? dx : dy
                if (dpi >= 216 && dpi <= 600) p = 200
                else if (dpi >= 180 && dpi < 216) p = 150
            }
            print p; exit
        }')
    echo "${_p:-100}"
}

effective() {  # the percent the setting means on this screen
    _s=$(setting)
    if [ "$_s" = auto ]; then recommended; else echo "$_s"; fi
}

cached() { sed -n "s/^$1=//p" "$CACHE" 2>/dev/null | head -n 1; }
in_use() {  # the percent of this session (cache), otherwise what the setting means now
    _c=$(cached percent)
    if valid "$_c"; then echo "$_c"; else effective; fi
}

# tint2's dpi of the main screen (util/server.c compute_dpi: per axis int(pixels / mm * 25.4), the larger one; no size:
# 96) divided by the scale -> tint2 ends up at exactly p/100. 0 at 100 %: the option stays off
tint2_ref() {  # $1 percent
    [ "$1" = 100 ] && { echo 0; return 0; }
    main_screen | LC_ALL=C awk -v p="$1" '
        NF == 4 {
            dpi = 96
            if ($3 > 0 && $4 > 0) { dx = int($1 / $3 * 25.4); dy = int($2 / $4 * 25.4); d = dx > dy ? dx : dy; if (d) dpi = d }
            printf "%.2f\n", dpi * 100 / p; f = 1; exit
        }
        END { if (!f) printf "%.2f\n", 96 * 100 / p }'
}

write_cache() {  # $1 percent
    mkdir -p "${CACHE%/*}" 2>/dev/null
    printf 'percent=%s\ntint2_ref=%s\n' "$1" "$(tint2_ref "$1")" > "$CACHE.$$" && mv -f "$CACHE.$$" "$CACHE"
}

resources() {  # $1 percent -> X resources for every program started from now on
    printf 'Xft.dpi: %s\nXcursor.size: %s\n' $((96 * $1 / 100)) $((24 * $1 / 100)) | $XRDB -merge -nocpp 2>/dev/null
}

case "${1:-}" in
    --status)
        printf 'setting=%s\nscale=%s\nrecommended=%s\n' "$(setting)" "$(in_use)" "$(recommended)" ;;
    --recommended)
        recommended ;;
    --percent)
        in_use ;;
    --session)
        p=$(effective)
        write_cache "$p"
        resources "$p"
        simpleos-theme --openbox-theme >/dev/null 2>&1 || true ;;
    --xsettings)
        p=$(in_use)
        dpi=$((96 * p / 100)) wsf=1
        [ "$p" -ge 200 ] && wsf=2
        printf 'Xft/DPI %s\nGdk/WindowScalingFactor %s\nGdk/UnscaledDPI %s\nGtk/CursorThemeSize %s\n' \
            $((dpi * 1024)) "$wsf" $((dpi * 1024 / wsf)) $((24 * p / 100)) ;;
    --tint2-ref)
        r=$(cached tint2_ref)
        case "$r" in ""|*[!0-9.]*) r=$(tint2_ref "$(in_use)") ;; esac
        echo "${r:-0}" ;;
    --refresh)
        p=$(in_use)
        [ "$p" = 100 ] && exit 0
        write_cache "$p"
        # a running taskbar takes the new value (at sign-in the Openbox autostart starts it afterwards)
        if pgrep -u "$(id -u)" -x tint2 >/dev/null 2>&1; then
            simpleos-taskbar-select --apply >/dev/null 2>&1 || true
        fi ;;
    --set)
        v=${2:-}
        { valid "$v" || [ "$v" = auto ]; } || { echo "Usage: simpleos-scale --set auto|100|125|150|200" >&2; exit 2; }
        mkdir -p "${STATE%/*}" && printf 'scale=%s\n' "$v" > "$STATE" || exit 1
        p=$(effective)
        write_cache "$p"
        resources "$p"
        if [ -n "${DISPLAY:-}" ]; then
            # GTK3 windows at once (xsettingsd), the taskbar (tint2 reloads), Openbox title bars and menus (a restart keeps
            # every window and reads Xft.dpi and the theme copy again), notifications and the pointer
            simpleos-theme --xsettings >/dev/null 2>&1 || true
            simpleos-taskbar-select --apply >/dev/null 2>&1 || true
            simpleos-theme --openbox-theme >/dev/null 2>&1 || true
            openbox --restart >/dev/null 2>&1 || true
            if pkill -u "$(id -u)" -x dunst 2>/dev/null; then
                (setsid simpleos-dunst >/dev/null 2>&1 &)
            fi
            xsetroot -cursor_name left_ptr >/dev/null 2>&1 || true
        fi
        echo "scale=$p" ;;
    *)
        echo "Usage: simpleos-scale --status | --set auto|100|125|150|200 | --recommended | --percent | --session | --xsettings | --tint2-ref | --refresh" >&2
        exit 2 ;;
esac
exit 0
