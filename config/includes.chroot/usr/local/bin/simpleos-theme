#!/bin/sh
# Simple OS – apply the design (used by the Setup Wizard, but also works directly):
#   simpleos-theme [--mode dark|light] [--accent blue|mauve|pink|green|peach|teal] [--show]
#   simpleos-theme --pick    selection via Rofi (Menu → Settings → Appearance)
#   simpleos-theme --xsettings   Openbox autostart: start the XSETTINGS service (xsettingsd) with the current design
#   simpleos-theme … --no-wallpaper   do not touch the wallpaper (simpleos-wallpaper-schedule sets it itself)
# --mode   light (Catppuccin Latte) / dark (Mocha) – immediately in the running session:
#            a) GTK: settings.ini (gtk-theme-name, gtk-application-prefer-dark-theme), GTK2, gsettings
#               (libadwaita/Flatpaks via the portal) and XSETTINGS (xsettingsd, SIGHUP -> running GTK3 windows
#               switch without a restart; without a settings service they read the theme only at startup)
#            b) Openbox: openbox --reconfigure
#            c) wallpaper: light/dark Simple OS wallpaper via pcmanfm --set-wallpaper (simpleos-wallpaper) –
#               only if a Simple OS wallpaper is still set (own pictures stay) and dynamic wallpaper is off
#            d) Rofi: Latte/Mocha colors in config.rasi (applies from the next opening); taskbar with "Match theme"
#               (simpleos-taskbar-select) light/dark, tint2 reloads via SIGUSR1
#          Window borders and the right-click menu stay Mocha (Openbox theme SimpleOS).
# --accent colors Rofi, the taskbar (tint2) and window borders/menus (Openbox theme).
set -e

STATE="$HOME/.config/simpleos/theme"
BASE_ACCENT="#89b4fa"   # accent in the shipped files (skel, /usr/share/themes/SimpleOS)

mode=dark
accent=blue
[ -r "$STATE" ] && . "$STATE"
old_accent=$accent
set_wallpaper=1
DAY_WP=/usr/share/backgrounds/simpleos/wallpaper-day.png
NIGHT_WP=/usr/share/backgrounds/simpleos/wallpaper.png
XSD_CONF="$HOME/.config/xsettingsd/xsettingsd.conf"

# XSETTINGS file for xsettingsd: theme, icons, font (from gtk-3.0/settings.ini)
write_xsettings() {  # $1 GTK theme, $2 icons
    font=$(sed -n 's/^gtk-font-name=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null | head -n 1)
    mkdir -p "$(dirname "$XSD_CONF")"
    printf 'Net/ThemeName "%s"\nNet/IconThemeName "%s"\nGtk/FontName "%s"\n' "$1" "$2" "${font:-Inter 10}" > "$XSD_CONF"
}
# Reload a running xsettingsd (SIGHUP) or start it
reload_xsettings() {
    command -v xsettingsd >/dev/null || return 0
    [ -n "${DISPLAY:-}" ] || return 0
    if pkill -HUP -x xsettingsd 2>/dev/null; then return 0; fi
    setsid xsettingsd -c "$XSD_CONF" >/dev/null 2>&1 &
}

while [ $# -gt 0 ]; do
    case "$1" in
        --mode)   mode=$2; shift 2 ;;
        --accent) accent=$2; shift 2 ;;
        --show)   echo "mode=$mode"; echo "accent=$accent"; exit 0 ;;
        --no-wallpaper) set_wallpaper=0; shift ;;
        --xsettings)
            case "$mode" in light) write_xsettings Arc Papirus-Light ;; *) write_xsettings Arc-Dark Papirus-Dark ;; esac
            reload_xsettings
            exit 0 ;;
        --pick)
            # rofi-retry: grab error -> new attempt, rofi missing/does not start -> notification instead of a silent end
            rofi=/usr/local/lib/simpleos/rofi-retry
            [ -x "$rofi" ] || rofi=rofi
            choice=$(printf '%s\n' "Dark mode" "Light mode" "Accent: blue" "Accent: mauve" "Accent: pink" \
                         "Accent: green" "Accent: peach" "Accent: teal" |
                SOS_NAME=simpleos-theme SOS_TITLE=Appearance "$rofi" -dmenu -i -no-custom -p "Appearance" -mesg "Current: $mode mode, $accent accent" \
                    -theme-str 'window { width: 360px; } listview { lines: 8; } element-icon { enabled: false; }' || true)
            case "$choice" in
                "Dark mode")  mode=dark ;;
                "Light mode") mode=light ;;
                "Accent: "*)  accent=${choice#Accent: } ;;
                *) exit 0 ;;
            esac
            shift ;;
        *) echo "Usage: simpleos-theme [--mode dark|light] [--accent blue|mauve|pink|green|peach|teal] [--no-wallpaper] [--show|--pick|--xsettings]" >&2; exit 2 ;;
    esac
done

hex_of() {
    case "$1" in
        blue)  echo "#89b4fa" ;;
        mauve) echo "#cba6f7" ;;
        pink)  echo "#f5c2e7" ;;
        green) echo "#a6e3a1" ;;
        peach) echo "#fab387" ;;
        teal)  echo "#94e2d5" ;;
        *) return 1 ;;
    esac
}
# Latte accents (darker, readable on a light background) for Rofi in light mode
latte_of() {
    case "$1" in
        blue) echo "#1e66f5" ;; mauve) echo "#8839ef" ;; pink) echo "#ea76cb" ;;
        green) echo "#40a02b" ;; peach) echo "#fe640b" ;; teal) echo "#179299" ;;
        *) return 1 ;;
    esac
}
hex=$(hex_of "$accent") || { echo "Unknown accent: $accent" >&2; exit 2; }
old_hex=$(hex_of "$old_accent" 2>/dev/null || echo "$BASE_ACCENT")

# gtk-application-prefer-dark-theme stays 0 in BOTH modes: GTK reads it only at program start (there is no
# XSETTING for it), and all Arc variants have a dark variant (gtk-dark.css) – a window started with 1
# would stay dark after switching to light. Dark comes only from the theme name Arc-Dark (live via
# XSETTINGS); libadwaita/Flatpaks follow color-scheme (gsettings, live via the portal).
case "$mode" in
    dark)  gtk_theme=Arc-Dark; icons=Papirus-Dark; prefer=0; scheme=prefer-dark ;;
    light) gtk_theme=Arc;      icons=Papirus-Light; prefer=0; scheme=prefer-light ;;
    *) echo "Unknown mode: $mode" >&2; exit 2 ;;
esac

# ---- Apps: GTK 3/4, GTK 2, gsettings (libadwaita/Flatpaks via the GTK portal) ----
for ini in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
    [ -f "$ini" ] || continue
    sed -i -e "s/^gtk-theme-name=.*/gtk-theme-name=$gtk_theme/" \
           -e "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$icons/" \
           -e "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$prefer/" "$ini"
done
if [ -f "$HOME/.gtkrc-2.0" ]; then
    sed -i -e "s/^gtk-theme-name=.*/gtk-theme-name=\"$gtk_theme\"/" \
           -e "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=\"$icons\"/" "$HOME/.gtkrc-2.0"
fi
if command -v gsettings >/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null || true
fi

# XSETTINGS: running GTK3 programs switch immediately (xsettingsd rereads the file on SIGHUP)
write_xsettings "$gtk_theme" "$icons"

# ---- Rofi: colors Mocha (dark) / Latte (light) + accent ----
rasi="$HOME/.config/rofi/config.rasi"
if [ -f "$rasi" ]; then
    if [ "$mode" = light ]; then
        rofi_hex=$(latte_of "$accent")
        set -- "#eff1f5" "#e6e9ef" "#ccd0da" "#4c4f69" "#6c6f85" "#9ca0b0" "#ccd0da"
    else
        rofi_hex=$hex
        set -- "#1e1e2e" "#313244" "#45475a" "#cdd6f4" "#a6adc8" "#6c7086" "#313244"
    fi
    sed -i -e "s/^\(\s*bg:\s*\)#[0-9a-fA-F]\{6\};/\1$1;/" -e "s/^\(\s*bg-alt:\s*\)#[0-9a-fA-F]\{6\};/\1$2;/" \
           -e "s/^\(\s*bg-sel:\s*\)#[0-9a-fA-F]\{6\};/\1$3;/" -e "s/^\(\s*fg:\s*\)#[0-9a-fA-F]\{6\};/\1$4;/" \
           -e "s/^\(\s*fg-sub:\s*\)#[0-9a-fA-F]\{6\};/\1$5;/" -e "s/^\(\s*fg-dim:\s*\)#[0-9a-fA-F]\{6\};/\1$6;/" \
           -e "s/^\(\s*line:\s*\)#[0-9a-fA-F]\{6\};/\1$7;/" \
           -e "s/^\(\s*accent:\s*\)#[0-9a-fA-F]\{6\};/\1$rofi_hex;/" "$rasi"
fi

# ---- Accent color: tint2, Openbox ----

tint2rc="$HOME/.config/tint2/tint2rc"
# Only the accent lines: background 3 ("Task (active)" = the 3rd "rounded =" block) and the app button's font color.
# The whole file would also recolor the "Install Simple OS" badge (background 8: mauve/pink are accent values too).
if [ -f "$tint2rc" ] && [ "$old_hex" != "$hex" ]; then
    tmp=$(mktemp "$tint2rc.XXXXXX") && awk -v old="$old_hex" -v new="$hex" '
        /^rounded[ \t]*=/ { b++ }
        {
            line = $0
            if (b == 3 || line ~ /^button_font_color[ \t]*=/) {
                while ((i = index(tolower(line), old)) > 0) line = substr(line, 1, i - 1) new substr(line, i + length(old))
            }
            print line
        }' "$tint2rc" > "$tmp" && cat "$tmp" > "$tint2rc"
    rm -f "$tmp"
fi

# Openbox: own copy of the SimpleOS theme (~/.themes takes precedence over /usr/share/themes)
ob_dir="$HOME/.themes/SimpleOS/openbox-3"
if [ "$hex" = "$BASE_ACCENT" ]; then
    rm -rf "$HOME/.themes/SimpleOS"
else
    mkdir -p "$ob_dir"
    sed "s/$BASE_ACCENT/$hex/gI" /usr/share/themes/SimpleOS/openbox-3/themerc > "$ob_dir/themerc"
fi

mkdir -p "$(dirname "$STATE")"
printf 'mode=%s\naccent=%s\n' "$mode" "$accent" > "$STATE"

# Taskbar "Match theme" (simpleos-taskbar-select): follow light/dark
if grep -qx 'style=theme' "$HOME/.config/simpleos/taskbar" 2>/dev/null; then
    DISPLAY= simpleos-taskbar-select --apply || true
fi

# ---- Wallpaper: light/dark Simple OS wallpaper (own pictures and dynamic wallpaper stay untouched)
if [ "$set_wallpaper" = 1 ] && [ "$(simpleos-wallpaper-schedule --status 2>/dev/null | head -n 1)" != on ]; then
    current=$(sed -n 's/^wallpaper=//p' "$HOME/.config/pcmanfm/default/desktop-items-0.conf" 2>/dev/null | head -n 1)
    case "$current" in
        ""|"$DAY_WP"|"$NIGHT_WP")
            if [ "$mode" = light ] && [ -r "$DAY_WP" ]; then target=$DAY_WP; else target=$NIGHT_WP; fi
            [ "$current" = "$target" ] || simpleos-wallpaper "$target" >/dev/null 2>&1 || true ;;
    esac
fi

# ---- Reload the running session ----
if [ -n "${DISPLAY:-}" ]; then
    reload_xsettings || true
    openbox --reconfigure 2>/dev/null || true
    pkill -USR1 -x tint2 2>/dev/null || true
fi
