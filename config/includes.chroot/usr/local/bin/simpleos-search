#!/usr/bin/env python3
"""Simple OS – Spotlight-Suche (Super+Space, Super antippen, Alt+F2).

Ein Rofi-Fenster (Catppuccin Mocha) für alles:
  Apps und Einstellungen   tippen filtert, Enter startet (auch über Stichwörter: "wifi" findet Network)
  Systembefehle            Lock, Sleep, Restart, Shut down, Sign out (Neustart/Aus/Abmelden mit Rückfrage)
  Rechnen                  "42 * 12" + Enter -> "42 * 12 = 504", Enter kopiert das Ergebnis; auch 2^10, 3,5*2,
                           sqrt(2), (1+2)/3, pi – eigener Rechner über den Syntaxbaum, kein eval
  Dateien und Ordner       Name + Enter durchsucht das Home-Verzeichnis (ohne versteckte Ordner), Enter öffnet
Passt nichts aus der Liste, nimmt Enter den getippten Text; passt etwas, erzwingt Strg+Enter die Suche.

Technik: Rofi-Script-Modus (rofi -show search -modi search:simpleos-search). Rofi ruft dieses Programm bei
jeder Auswahl auf (ROFI_RETV 0 = Start, 1 = Zeile gewählt, 2 = eigener Text), die Antwort sind neue Zeilen –
das Fenster bleibt offen, bis etwas gestartet wird.
  simpleos-search             Fenster öffnen (Rofi fehlt -> Meldung, Grab-Fehler -> neuer Versuch)
  simpleos-search --calc AUSDRUCK   nur rechnen (Tests), Exit 1 = kein Rechenausdruck
Tests: SIMPLEOS_SEARCH_ROOT ersetzt das durchsuchte Verzeichnis ($HOME).
"""
import ast
import math
import operator
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

SEP = "\x1f"
HOME = Path(os.environ.get("SIMPLEOS_SEARCH_ROOT") or Path.home())
MAX_FILES = 60
FILE_TIMEOUT = 3.0   # Sekunden für die Dateisuche
LIVE = "/usr/local/bin/simpleos-live"
SYSTEM = [  # (Schlüssel, Name, Symbol, Stichwörter, Rückfrage)
    ("lock", "Lock", "system-lock-screen", "lock screen sperren", None),
    ("sleep", "Sleep", "system-suspend", "sleep suspend standby ruhezustand", None),
    ("restart", "Restart", "system-reboot", "restart reboot neustart", "Restart now"),
    ("shutdown", "Shut down", "system-shutdown", "shut down shutdown power off poweroff herunterfahren", "Shut down now"),
    ("logout", "Sign out", "system-log-out", "sign out log out logout abmelden", "Sign out now"),
]


# ------------------------------------------------------------------ Rechnen (sicher, ohne eval)
_BIN = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
        ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow}
_UNARY = {ast.UAdd: operator.pos, ast.USub: operator.neg}
_FUNCS = {"sqrt": math.sqrt, "sin": math.sin, "cos": math.cos, "tan": math.tan, "log": math.log10,
          "ln": math.log, "abs": abs, "round": round, "floor": math.floor, "ceil": math.ceil}
_CONST = {"pi": math.pi, "e": math.e}
# Größte Ganzzahl (Bits, ~1200 Stellen): größere Ergebnisse brachten Python an die Grenze der Zahl-zu-Text-Umwandlung
# (4300 Stellen, Absturz der Suche) bzw. ließen den Rechner minutenlang rechnen ("((9^999)^999)^999")
_MAX_BITS = 4000


class TooLarge(ValueError):
    pass


def _check(value):
    if isinstance(value, int) and value.bit_length() > _MAX_BITS:
        raise TooLarge("number too large")
    return value


def _eval(node):
    if isinstance(node, ast.Expression):
        return _eval(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)) and not isinstance(node.value, bool):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _BIN:
        left, right = _eval(node.left), _eval(node.right)
        if isinstance(node.op, ast.Pow):
            if abs(right) > 1000:
                raise ValueError("exponent too large")
            # Größe vorher abschätzen: Bits des Ergebnisses ≈ Exponent · log2(Basis)
            if abs(left) > 1 and right > 0 and right * math.log2(abs(left)) > _MAX_BITS:
                raise TooLarge("number too large")
        return _check(_BIN[type(node.op)](left, right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in _UNARY:
        return _check(_UNARY[type(node.op)](_eval(node.operand)))
    if isinstance(node, ast.Name) and node.id in _CONST:
        return _CONST[node.id]
    if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in _FUNCS
            and not node.keywords and 1 <= len(node.args) <= 2):
        return _check(_FUNCS[node.func.id](*[_eval(a) for a in node.args]))
    raise ValueError("not a calculation")


def calculate(text):
    """(Anzeige, Ergebnis) oder None, wenn der Text keine Rechnung ist. Fehler -> (Meldung, None)."""
    expr = text.strip().rstrip("=").strip()
    # Nur Ziffern, Operatoren, Klammern, bekannte Funktionen/Konstanten; mindestens eine Zahl und ein Operator
    words = set(re.findall(r"[A-Za-z_]+", expr))
    if not expr or not re.search(r"\d", expr) or words - set(_FUNCS) - set(_CONST):
        return None
    if not re.fullmatch(r"[\d\s.,+\-*/%^()×÷A-Za-z_]+", expr) or not re.search(r"[+\-*/%^(×÷]", expr):
        return None
    py = re.sub(r"(\d),(\d)", r"\1.\2", expr).replace("^", "**").replace("×", "*").replace("÷", "/")
    try:
        value = _eval(ast.parse(py, mode="eval"))
    except ZeroDivisionError:
        return f"{expr} – can't divide by zero", None
    except TooLarge:
        return f"{expr} – the number is too large", None
    except (ValueError, TypeError, SyntaxError, OverflowError, RecursionError):
        return None
    # negative Basis mit gebrochenem Exponenten ((-8)^(1/3)) ergibt in Python eine komplexe Zahl
    if isinstance(value, complex):
        return f"{expr} – no result", None
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return f"{expr} – no result", None
        value = int(value) if value.is_integer() and abs(value) < 1e15 else float(f"{value:.12g}")
    pretty = re.sub(r"\s*([+\-*/%^×÷])\s*", r" \1 ", expr).strip()
    pretty = re.sub(r"\s+", " ", pretty).replace("( ", "(").replace(" )", ")")
    # Vorzeichen (am Anfang, nach "(" oder nach einem Operator) ohne Leerzeichen: "(-8)" statt "(- 8)"
    pretty = re.sub(r"(^|[(+\-*/%^×÷] ?)([+-]) (?=[\d(.a-z])", r"\1\2", pretty)
    return f"{pretty} = {value}", str(value)


# ------------------------------------------------------------------ Apps (.desktop-Dateien)
def data_dirs():
    home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [home] + [d for d in dirs.split(":") if d]


def read_desktop(path):
    """Schlüssel des Abschnitts [Desktop Entry]; Name/GenericName/Keywords in der Sprache von $LANG."""
    entry, section = {}, None
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        line = line.strip()
        if line.startswith("["):
            section = line
        elif section == "[Desktop Entry]" and "=" in line and not line.startswith("#"):
            key, value = (x.strip() for x in line.split("=", 1))
            entry.setdefault(key, value)
    lang = (os.environ.get("LANG") or "").split(".")[0].split("@")[0]
    for key in ("Name", "GenericName", "Keywords"):
        for variant in (f"{key}[{lang}]", f"{key}[{lang.split('_')[0]}]"):
            if lang and variant in entry:
                entry[key] = entry[variant]
                break
    return entry


def apps():
    """[(desktop_id, Pfad, Eintrag)] – sichtbare Programme, nach Namen sortiert; erste Fundstelle gewinnt."""
    found = {}
    desktop = (os.environ.get("XDG_CURRENT_DESKTOP") or "openbox").lower().split(":")
    for d in data_dirs():
        base = Path(d) / "applications"
        if not base.is_dir():
            continue
        for path in sorted(base.rglob("*.desktop")):
            did = str(path.relative_to(base)).replace("/", "-")
            if did in found:
                continue
            e = read_desktop(path)
            found[did] = (path, e)
    result = []
    for did, (path, e) in found.items():
        if not e or e.get("Type", "Application") != "Application" or "Name" not in e:
            continue
        if e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
            continue
        only = [x.lower() for x in e.get("OnlyShowIn", "").split(";") if x]
        if only and not set(only) & set(desktop):
            continue
        tryexec = e.get("TryExec")
        if tryexec and not shutil.which(tryexec):
            continue
        result.append((did, path, e))
    return sorted(result, key=lambda a: a[2]["Name"].lower())


def launch_app(path):
    did = path.name
    if shutil.which("gtk-launch"):
        base = next((Path(d) / "applications" for d in data_dirs()
                     if str(path).startswith(str(Path(d) / "applications") + "/")), None)
        if base:
            did = str(path.relative_to(base)).replace("/", "-")
        if spawn(["gtk-launch", did]):
            return True
    e = read_desktop(path) or {}
    try:
        argv = [a for a in shlex.split(e.get("Exec", "")) if not re.fullmatch(r"%[fFuUdDnNickvm]", a)]
    except ValueError:
        argv = []
    if not argv:
        return False
    if e.get("Terminal") == "true":
        argv = ["kitty", "-e"] + argv
    return spawn(argv)


# ------------------------------------------------------------------ Dateien
def find_files(query):
    """Dateien/Ordner im Home, deren Name den Text enthält (ohne versteckte Ordner), beste zuerst."""
    q = query.lower()
    hits, start = [], time.monotonic()
    for root, dirs, files in os.walk(HOME):
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for name in dirs + sorted(files):
            if name.startswith(".") or q not in name.lower():
                continue
            p = Path(root) / name
            hits.append(p)
        if len(hits) >= MAX_FILES * 3 or time.monotonic() - start > FILE_TIMEOUT:
            break

    def rank(p):
        name = p.name.lower()
        return (name != q, not name.startswith(q), not p.is_dir(), len(p.parts), name)
    return sorted(hits, key=rank)[:MAX_FILES]


def file_icon(p):
    if p.is_dir():
        return "folder"
    ext = p.suffix.lower()
    for exts, icon in ((".png .jpg .jpeg .gif .webp .svg .bmp", "image-x-generic"),
                       (".pdf", "application-pdf"), (".mp4 .mkv .webm .avi .mov", "video-x-generic"),
                       (".mp3 .flac .ogg .wav .m4a", "audio-x-generic"),
                       (".zip .tar .gz .xz .7z .rar .bz2 .zst", "package-x-generic"),
                       (".odt .doc .docx .rtf", "x-office-document"), (".ods .xls .xlsx .csv", "x-office-spreadsheet"),
                       (".txt .md .log .conf .ini .json .xml .sh .py", "text-x-generic")):
        if ext and ext in exts.split():
            return icon
    return "text-x-generic"


def open_path(path):
    p = Path(path)
    if p.is_dir() and shutil.which("thunar"):
        return spawn(["thunar", str(p)])
    return spawn(["xdg-open", str(p)])


# ------------------------------------------------------------------ Ausgabe für Rofi
def spawn(argv):
    try:
        subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def notify(text, urgency="normal"):
    if shutil.which("notify-send"):
        spawn(["notify-send", "-u", urgency, "-c", "x-simpleos", "-a", "Search", "-i", "system-search", "Search", text])


def clean(text):
    return text.replace("\n", " ").replace("\0", "").replace(SEP, " ")


def row(text, info, icon=None, meta=None):
    opts = [f"info{SEP}{clean(info)}"]
    if icon:
        opts.append(f"icon{SEP}{icon}")
    if meta:
        opts.append(f"meta{SEP}{clean(meta)}")
    print(clean(text) + "\0" + SEP.join(opts))


def header(message):
    print(f"\0prompt{SEP}Search")
    print(f"\0message{SEP}{clean(message)}")
    print(f"\0markup-rows{SEP}false")
    print(f"\0no-custom{SEP}false")


HINT = "Apps, settings and power options · type a calculation or a file name and press Enter"


def start_page():
    header(HINT)
    for did, path, e in apps():
        meta = " ".join(x for x in (e.get("GenericName", ""), e.get("Keywords", "").replace(";", " "),
                                    e.get("Comment", ""), did) if x)
        row(e["Name"], f"app:{path}", e.get("Icon") or "application-x-executable", meta)
    for key, name, icon, words, _confirm in SYSTEM:
        row(name, f"sys:{key}", icon, words + " system power")


def search_page(text):
    calc = calculate(text)
    if calc:
        shown, value = calc
        header("Enter copies the result" if value is not None else "That calculation has no result")
        row(shown, f"calc:{value}" if value is not None else "back:", "accessories-calculator")
        row("Back", "back:", "go-previous")
        return
    hits = find_files(text)
    if not hits:
        header(f"Nothing found for “{text}” in your files")
        row("Back", "back:", "go-previous")
        return
    header(f"{len(hits)} file{'s' if len(hits) != 1 else ''} and folder{'s' if len(hits) != 1 else ''} "
           f"matching “{text}” · Enter opens")
    for p in hits:
        try:
            where = str(p.parent.relative_to(HOME))
        except ValueError:
            where = str(p.parent)
        where = "Home" if where == "." else f"~/{where}"
        row(f"{p.name}   —   {where}", f"file:{p}", file_icon(p))
    row("Back", "back:", "go-previous")


def run_system(key):
    def first(*cmds):
        for c in cmds:
            if shutil.which(c[0]) and subprocess.run(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                return True
        return False
    lock = (["dm-tool", "lock"], ["loginctl", "lock-session"])
    # vor dem Schlafen sperren – nicht in der Live-Session (Passwort unbekannt, wie system-sleep/simpleos-lock)
    live = os.access(LIVE, os.X_OK) and subprocess.run([LIVE, "--check"], stdout=subprocess.DEVNULL,
                                                        stderr=subprocess.DEVNULL).returncode == 0
    ok = {"lock": lambda: first(*lock),
          "sleep": lambda: ((live or first(*lock)), first(["systemctl", "suspend"], ["loginctl", "suspend"]))[1],
          "restart": lambda: first(["systemctl", "reboot"], ["loginctl", "reboot"]),
          "shutdown": lambda: first(["systemctl", "poweroff"], ["loginctl", "poweroff"]),
          "logout": lambda: first(["openbox", "--exit"])}[key]()
    if not ok:
        notify("That did not work. Please try again.", "critical")


def selected(info, text):
    kind, _, value = info.partition(":")
    if kind == "app":
        if not launch_app(Path(value)):
            notify(f"{text} could not be started.", "critical")
    elif kind == "file":
        if not open_path(value):
            notify("The file could not be opened.", "critical")
    elif kind == "calc":
        if shutil.which("xclip"):
            try:
                subprocess.run(["xclip", "-selection", "clipboard"], input=value.encode(), timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                pass
        notify(f"{value} copied to the clipboard.", "low")
    elif kind == "sys":
        confirm = next((c for k, _n, _i, _w, c in SYSTEM if k == value), None)
        if confirm:   # Neustart/Aus/Abmelden: erst nachfragen (Suche nach "sh…" soll nie ausschalten)
            header("Save your work first.")
            row(confirm, f"do:{value}", next(i for k, _n, i, _w, _c in SYSTEM if k == value))
            row("Cancel", "back:", "go-previous")
            return
        run_system(value)
    elif kind == "do":
        run_system(value)
    elif kind == "back":
        start_page()


def open_window():
    if not shutil.which("rofi"):
        notify("Search is not available (rofi missing). Press Super+Space again later.", "critical")
        return 0
    theme = ("window { width: 680px; location: center; anchor: center; } listview { lines: 9; } "
             "element-icon { size: 24px; } entry { placeholder: \"Search apps, files, or calculate\"; }")
    cmd = ["rofi", "-show", "search", "-modi", f"search:{os.path.abspath(sys.argv[0])}", "-show-icons",
           "-i", "-matching", "normal", "-sort", "-sorting-method", "fzf", "-theme-str", theme]
    for _ in range(6):
        proc = subprocess.run(cmd, stderr=subprocess.PIPE, text=True)
        err = proc.stderr.lower()
        if proc.returncode == 0 or not ("grab" in err or "already running" in err or "pidfile" in err):
            break
        # direkt nach einem Tastendruck/Klick hält X Tastatur/Maus noch fest, oder ein anderes Rofi beendet sich gerade
        time.sleep(0.3)
    else:
        notify("Search could not open. Please try again.", "critical")
    return 0


def main(argv):
    if len(argv) > 2 and argv[1] == "--calc":
        res = calculate(" ".join(argv[2:]))
        if not res:
            return 1
        print(res[0])
        return 0
    retv = os.environ.get("ROFI_RETV")
    if retv is None:
        return open_window()
    text = argv[1] if len(argv) > 1 else ""
    info = os.environ.get("ROFI_INFO", "")
    if retv == "0":
        start_page()
    elif retv == "1" and info:
        selected(info, text)
    elif retv in ("1", "2") and text.strip():
        search_page(text.strip())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        sys.exit(0)
