# ------------------------------------------------------------------ Calculations (safe, without eval)
_BIN = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
        ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow}
_UNARY = {ast.UAdd: operator.pos, ast.USub: operator.neg}
def _round(x, digits=0):
    """Rounds half up like a pocket calculator (Python's round() gives round(2.5) = 2)."""
    digits = int(digits)
    r = Decimal(repr(x)).quantize(Decimal(1).scaleb(-digits), rounding=ROUND_HALF_UP)
    return int(r) if digits <= 0 else float(r)


_FUNCS = {"sqrt": math.sqrt, "sin": math.sin, "cos": math.cos, "tan": math.tan, "log": math.log10,
          "ln": math.log, "abs": abs, "round": _round, "floor": math.floor, "ceil": math.ceil,
          "min": min, "max": max}
_CONST = {"pi": math.pi, "e": math.e}
_MULTI_ARG = {"min", "max", "round"}     # functions that take two (or more) numbers
# Largest integer (bits, ~1200 digits): larger results brought Python to the limit of number-to-text conversion
# (4300 digits, search crashed) or kept the calculator busy for minutes ("((9^999)^999)^999")
_MAX_BITS = 4000


class TooLarge(ValueError):
    pass


class NoResult(ValueError):
    """A function outside its domain: sqrt(-1), ln(0) … (a calculation, but without a result)"""


def _check(value):
    if isinstance(value, int) and value.bit_length() > _MAX_BITS:
        raise TooLarge("number too large")
    return value


def _eval(node):
    if isinstance(node, ast.Expression):
        return _eval(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)) and not isinstance(node.value, bool):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _BIN:
        left, right = _eval(node.left), _eval(node.right)
        if isinstance(node.op, ast.Pow):
            if abs(right) > 1000:
                raise ValueError("exponent too large")
            # Estimate the size beforehand: bits of the result ≈ exponent · log2(base)
            if abs(left) > 1 and right > 0 and right * math.log2(abs(left)) > _MAX_BITS:
                raise TooLarge("number too large")
        return _check(_BIN[type(node.op)](left, right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in _UNARY:
        return _check(_UNARY[type(node.op)](_eval(node.operand)))
    if isinstance(node, ast.Name) and node.id in _CONST:
        return _CONST[node.id]
    if (isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in _FUNCS
            and not node.keywords and 1 <= len(node.args) <= 2):
        try:
            return _check(_FUNCS[node.func.id](*[_eval(a) for a in node.args]))
        except (ValueError, ArithmeticError) as err:
            if isinstance(err, (TooLarge, NoResult)) or type(err) is ValueError and "not a calculation" in str(err):
                raise
            raise NoResult(str(err)) from err
    raise ValueError("not a calculation")


# Languages that write the decimal comma ("3,5"); elsewhere "1,000" is one thousand
_COMMA_DECIMAL = {"de", "fr", "es", "it", "pt", "nl", "pl", "cs", "sk", "ru", "uk", "tr", "sv", "da", "nb", "nn", "no",
                  "fi", "hu", "ro", "bg", "hr", "sl", "el"}


def _comma_language():
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_NUMERIC") or os.environ.get("LANG") or "")[:2].lower()
    return lang in _COMMA_DECIMAL


def _enclosing_call(expr, pos):
    """Name of the function whose brackets are around position pos ("" for none or a plain bracket)"""
    calls = []
    for i, ch in enumerate(expr[:pos]):
        if ch == "(":
            calls.append(re.search(r"([A-Za-z_]*)\s*$", expr[:i]).group(1))
        elif ch == ")" and calls:
            calls.pop()
    return calls[-1] if calls else ""


def _decimal_commas(expr):
    """Commas, dots and semicolons the way people write numbers (#147).

    - A comma between digits is a decimal comma ("3,5" = 3.5) – except inside a function call outside
      decimal-comma languages, where it separates the arguments ("round(3.14159,2)", "max(1,2)").
    - Outside decimal-comma languages, groups of exactly three digits ("1,000", "12,345,678") are thousands.
    - In decimal-comma languages a dot followed by groups of exactly three digits is a thousands separator
      ("1.000" = 1000, "1.234,5" = 1234.5); a comma followed by a space or a semicolon separates the arguments
      ("round(3,14159; 2)"), and so does a comma after a number written with a decimal dot ("round(3.14159,2)")
      and every comma in min/max ("max(1,2)")."""
    comma_decimal = _comma_language()
    if comma_decimal:
        expr = re.sub(r"(?<![\d.,])[1-9]\d{0,2}(?:\.\d{3})+(?:,\d+)?(?![\d.]|,\d)",
                      lambda m: m.group(0).replace(".", ""), expr)
    else:
        # not inside min/max/round: there every comma separates the arguments ("max(1,234)" = 234, not 1234);
        # "sqrt(1,000,000)" stays one million
        expr = re.sub(r"(?<![\d,.])\d{1,3}(?:,\d{3})+(?![\d,])(?!\.)",
                      lambda m: m.group(0) if _enclosing_call(expr, m.start()) in _MULTI_ARG
                      else m.group(0).replace(",", ""), expr)
    out, calls = [], []      # calls: one entry per open bracket – the function's name, "" for a plain bracket
    for i, ch in enumerate(expr):
        if ch == "(":
            name = re.search(r"([A-Za-z_]*)\s*$", expr[:i]).group(1)
            calls.append(name)
        elif ch == ")":
            if calls:
                calls.pop()
        elif ch in ",;":
            func = calls[-1] if calls else ""
            between_digits = expr[i - 1:i].isdigit() and expr[i + 1:i + 2].isdigit()
            if ch == ";":
                ch = "," if func else ch
            elif between_digits:
                number_before = re.search(r"[\d.]*$", expr[:i]).group(0)
                separator = func and (not comma_decimal or func in ("min", "max") or "." in number_before)
                if not separator:
                    ch = "."
        out.append(ch)
    return "".join(out)


def calculate(text):
    """(display, result) or None if the text is not a calculation. Error -> (message, None)."""
    expr = text.strip().rstrip("=").strip().replace("**", "^")   # 2**3 = 2^3
    # Only digits, operators, brackets, known functions/constants; at least one number and one operator
    words = set(re.findall(r"[A-Za-z_]+", expr))
    if not expr or not re.search(r"\d", expr) or words - set(_FUNCS) - set(_CONST):
        return None
    if not re.fullmatch(r"[\d\s.,;+\-*/%^()×÷A-Za-z_]+", expr) or not re.search(r"[+\-*/%^(×÷]", expr):
        return None
    # Dates and phone numbers are names to look for, not subtractions (#82): "2026-10-20" (screenshots are called
    # Screenshot_2026-10-20_14-03-11.png), "2026-10", "079-123-45-67" = digits joined by "-" without spaces, more than
    # one "-", or a year-month. "10-2" and "10 - 2 - 3" stay calculations.
    if re.fullmatch(r"\d+(?:-\d+){2,}|(?:19|20)\d\d-(?:0[1-9]|1[0-2])", expr):
        return None
    py = _decimal_commas(expr).replace("^", "**").replace("×", "*").replace("÷", "/")
    try:
        value = _eval(ast.parse(py, mode="eval"))
    except ZeroDivisionError:
        return _("{expr} – can't divide by zero").format(expr=expr), None
    except TooLarge:
        return _('{expr} – the number is too large').format(expr=expr), None
    except NoResult:
        return _('{expr} – no result').format(expr=expr), None
    except (ValueError, TypeError, SyntaxError, OverflowError, RecursionError, ArithmeticError):
        return None
    # a negative base with a fractional exponent ((-8)^(1/3)) gives a complex number in Python
    if isinstance(value, complex):
        return _('{expr} – no result').format(expr=expr), None
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return _('{expr} – no result').format(expr=expr), None
        value = int(value) if value.is_integer() and abs(value) < 1e15 else float(f"{value:.12g}")
    pretty = re.sub(r"\s*(//|[+\-*/%^×÷])\s*", r" \1 ", expr).strip()
    pretty = re.sub(r"\s+", " ", pretty).replace("( ", "(").replace(" )", ")")
    # Sign (at the start, after "(" or after an operator) without a space: "(-8)" instead of "(- 8)"
    pretty = re.sub(r"(^|[(,+\-*/%^×÷] ?)([+-]) (?=[\d(.a-z])", r"\1\2", pretty)
    # In decimal-comma languages the result is written (and copied) with a decimal comma too: 1235,5
    shown = str(value).replace(".", ",") if _comma_language() and isinstance(value, float) else str(value)
    return f"{pretty} = {shown}", shown


# ------------------------------------------------------------------ Apps (.desktop files)
def data_dirs():
    home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [home] + [d for d in dirs.split(":") if d]


def read_desktop(path):
    """Keys of the [Desktop Entry] section; Name/GenericName/Keywords in the language of $LANG."""
    entry, section = {}, None
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        line = line.strip()
        if line.startswith("["):
            section = line
        elif section == "[Desktop Entry]" and "=" in line and not line.startswith("#"):
            key, value = (x.strip() for x in line.split("=", 1))
            entry.setdefault(key, value)
    lang = (os.environ.get("LANG") or "").split(".")[0].split("@")[0]
    for key in ("Name", "GenericName", "Keywords"):
        for variant in (f"{key}[{lang}]", f"{key}[{lang.split('_')[0]}]"):
            if lang and variant in entry:
                entry[key] = entry[variant]
                break
    return entry


def apps():
    """[(desktop_id, path, entry)] – visible programs sorted by name; the first location wins."""
    found = {}
    desktop = (os.environ.get("XDG_CURRENT_DESKTOP") or "openbox").lower().split(":")
    for d in data_dirs():
        base = Path(d) / "applications"
        if not base.is_dir():
            continue
        for path in sorted(base.rglob("*.desktop")):
            did = str(path.relative_to(base)).replace("/", "-")
            if did in found:
                continue
            e = read_desktop(path)
            found[did] = (path, e)
    result = []
    for did, (path, e) in found.items():
        if not e or e.get("Type", "Application") != "Application" or "Name" not in e:
            continue
        if e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
            continue
        only = [x.lower() for x in e.get("OnlyShowIn", "").split(";") if x]
        if only and not set(only) & set(desktop):
            continue
        tryexec = e.get("TryExec")
        if tryexec and not shutil.which(tryexec):
            continue
        result.append((did, path, e))
    return sorted(result, key=lambda a: a[2]["Name"].lower())


def launch_app(path):
    did = path.name
    if shutil.which("gtk-launch"):
        base = next((Path(d) / "applications" for d in data_dirs()
                     if str(path).startswith(str(Path(d) / "applications") + "/")), None)
        if base:
            did = str(path.relative_to(base)).replace("/", "-")
        if spawn(["gtk-launch", did]):
            return True
    e = read_desktop(path) or {}
    try:
        argv = [a for a in shlex.split(e.get("Exec", "")) if not re.fullmatch(r"%[fFuUdDnNickvm]", a)]
    except ValueError:
        argv = []
    if not argv:
        return False
    if e.get("Terminal") == "true":
        argv = ["kitty", "-e"] + argv
    return spawn(argv)


# ------------------------------------------------------------------ Files
def find_files(query):
    """Files/folders in the home folder whose name contains the text (without hidden folders), best first."""
    q = query.lower()
    hits, start = [], time.monotonic()
    for root, dirs, files in os.walk(HOME):
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for name in dirs + sorted(files):
            if name.startswith(".") or q not in name.lower():
                continue
            p = Path(root) / name
            hits.append(p)
        if len(hits) >= MAX_FILES * 3 or time.monotonic() - start > FILE_TIMEOUT:
            break

    def rank(p):
        name = p.name.lower()
        return (name != q, not name.startswith(q), not p.is_dir(), len(p.parts), name)
    return sorted(hits, key=rank)[:MAX_FILES]


def file_icon(p):
    if p.is_dir():
        return "folder"
    ext = p.suffix.lower()
    for exts, icon in ((".png .jpg .jpeg .gif .webp .svg .bmp", "image-x-generic"),
                       (".pdf", "application-pdf"), (".mp4 .mkv .webm .avi .mov", "video-x-generic"),
                       (".mp3 .flac .ogg .wav .m4a", "audio-x-generic"),
                       (".zip .tar .gz .xz .7z .rar .bz2 .zst", "package-x-generic"),
                       (".odt .doc .docx .rtf", "x-office-document"), (".ods .xls .xlsx .csv", "x-office-spreadsheet"),
                       (".txt .md .log .conf .ini .json .xml .sh .py", "text-x-generic")):
        if ext and ext in exts.split():
            return icon
    return "text-x-generic"


def open_path(path):
    p = Path(path)
    if p.is_dir() and shutil.which("thunar"):
        return spawn(["thunar", str(p)])
    return spawn(["xdg-open", str(p)])


# ------------------------------------------------------------------ Output for Rofi
def spawn(argv):
    try:
        subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def notify(text, urgency="normal"):
    if shutil.which("notify-send"):
        spawn(["notify-send", "-u", urgency, "-c", "x-simpleos", "-a", _("Search"), "-i", "system-search", _("Search"),
               text])


def clean(text):
    return text.replace("\n", " ").replace("\0", "").replace(SEP, " ")


def row(text, info, icon=None, meta=None):
    opts = [f"info{SEP}{clean(info)}"]
    if icon:
        opts.append(f"icon{SEP}{icon}")
    if meta:
        opts.append(f"meta{SEP}{clean(meta)}")
    print(clean(text) + "\0" + SEP.join(opts))


def header(message):
    print(f"\0prompt{SEP}" + _("Search"))
    print(f"\0message{SEP}{clean(message)}")
    print(f"\0markup-rows{SEP}false")
    print(f"\0no-custom{SEP}false")


HINT = _("Apps, settings and power options · type a calculation or a file name and press Enter")


def start_page():
    header(HINT)
    for did, path, e in apps():
        meta = " ".join(x for x in (e.get("GenericName", ""), e.get("Keywords", "").replace(";", " "),
                                    e.get("Comment", ""), did) if x)
        row(e["Name"], f"app:{path}", e.get("Icon") or "application-x-executable", meta)
    for key, name, icon, words in SETTINGS:
        row(name, f"cc:{key}", icon, words + " settings preferences control center einstellungen")
    for key, name, icon, words, _confirm in SYSTEM:
        row(name, f"sys:{key}", icon, words + " system power")


def search_page(text):
    calc = calculate(text)
    if calc:
        shown, value = calc
        header(_("Enter copies the result") if value is not None else _("That calculation has no result"))
        row(shown, f"calc:{value}" if value is not None else "back:", "accessories-calculator")
        row(_("Back"), "back:", "go-previous")
        return
    hits = find_files(text)
    if not hits:
        header(_('Nothing found for “{text}” in your files').format(text=text))
        row(_("Back"), "back:", "go-previous")
        return
    header((_("1 file or folder matching “{text}” · Enter opens") if len(hits) == 1 else
            _("{count} files and folders matching “{text}” · Enter opens")).format(count=len(hits), text=text))
    for p in hits:
        try:
            where = str(p.parent.relative_to(HOME))
        except ValueError:
            where = str(p.parent)
        where = _("Home") if where == "." else f"~/{where}"
        row(f"{p.name}   —   {where}", f"file:{p}", file_icon(p))
    row(_("Back"), "back:", "go-previous")


def run_system(key):
    def first(*cmds):
        for c in cmds:
            if shutil.which(c[0]) and subprocess.run(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                return True
        return False
    # simpleos-power --lock-now = dm-tool lock, noted so that the sleep hook does not lock a second time (#96)
    lock = (["/usr/local/bin/simpleos-power", "--lock-now"], ["loginctl", "lock-session"])
    # lock before sleeping – not in the live session (password unknown, like system-sleep/simpleos-lock)
    live = os.access(LIVE, os.X_OK) and subprocess.run([LIVE, "--check"], stdout=subprocess.DEVNULL,
                                                        stderr=subprocess.DEVNULL).returncode == 0
    if key == "switch":
        if live:
            notify(_("Switching users is not available in Live Mode."))
            return
        os.environ.setdefault("XDG_SEAT_PATH", "/org/freedesktop/DisplayManager/Seat0")   # dm-tool finds LightDM by it
    ok = {"lock": lambda: first(*lock),
          "sleep": lambda: ((live or first(*lock)), first(["systemctl", "suspend"], ["loginctl", "suspend"]))[1],
          "restart": lambda: first(["systemctl", "reboot"], ["loginctl", "reboot"]),
          "shutdown": lambda: first(["systemctl", "poweroff"], ["loginctl", "poweroff"]),
          "logout": lambda: first(["openbox", "--exit"]),
          # the login screen next to this session (#68); not in the live session: nobody else can sign in there
          "switch": lambda: first(["dm-tool", "switch-to-greeter"])}[key]()
    if not ok:
        notify(_("That did not work. Please try again."), "critical")


def selected(info, text):
    kind, _sep, value = info.partition(":")
    if kind == "app":
        if not launch_app(Path(value)):
            notify(_('{text} could not be started.').format(text=text), "critical")
    elif kind == "file":
        if not open_path(value):
            notify(_("The file could not be opened."), "critical")
    elif kind == "cc":
        if not spawn(["simpleos-control-center", value]):
            notify(_("The Control Center could not be opened."), "critical")
    elif kind == "calc":
        if shutil.which("xclip"):
            try:
                subprocess.run(["xclip", "-selection", "clipboard"], input=value.encode(), timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                pass
        notify(_('{value} copied to the clipboard.').format(value=value), "low")
    elif kind == "sys":
        confirm = next((c for k, _n, _i, _w, c in SYSTEM if k == value), None)
        if confirm:   # restart/off/sign out: ask first (a search for "sh…" should never switch off)
            header(_("Save your work first."))
            row(confirm, f"do:{value}", next(i for k, _n, i, _w, _c in SYSTEM if k == value))
            row(_("Cancel"), "back:", "go-previous")
            return
        run_system(value)
    elif kind == "do":
        run_system(value)
    elif kind == "back":
        start_page()


def open_window():
    if not shutil.which("rofi"):
        notify(_("Search is not available (rofi missing). Press Super+Space again later."), "critical")
        return 0
    theme = ("window { width: 680px; location: center; anchor: center; } listview { lines: 9; } "
             "element-icon { size: 24px; } entry { placeholder: \"" +
             _("Search apps, files, or calculate").replace('"', "'") + "\"; }")
    cmd = ["rofi", "-show", "search", "-modi", f"search:{os.path.abspath(sys.argv[0])}", "-show-icons",
           "-i", "-matching", "normal", "-sort", "-sorting-method", "fzf", "-theme-str", theme]
    for _attempt in range(40):
        proc = subprocess.run(cmd, stderr=subprocess.PIPE, text=True)
        err = proc.stderr.lower()
        if proc.returncode == 0 or not ("grab" in err or "already running" in err or "pidfile" in err):
            break
        # right after a key press/click X still holds keyboard/mouse, or another Rofi is just closing: look again soon
        # (every 0.05 s, at most about 2 s; a fixed 0.3 s before 1.1.2)
        time.sleep(0.05)
    else:
        notify(_("Search could not open. Please try again."), "critical")
    return 0


def main(argv):
    if len(argv) > 2 and argv[1] == "--calc":
        res = calculate(" ".join(argv[2:]))
        if not res:
            return 1
        print(res[0])
        return 0
    retv = os.environ.get("ROFI_RETV")
    if retv is None:
        return open_window()
    text = argv[1] if len(argv) > 1 else ""
    info = os.environ.get("ROFI_INFO", "")
    if retv == "0":
        start_page()
    elif retv == "1" and info:
        selected(info, text)
    elif retv in ("1", "2") and text.strip():
        search_page(text.strip())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        sys.exit(0)
