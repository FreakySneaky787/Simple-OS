#!/usr/bin/env python3
"""Simple OS – Spotlight search (Super+Space, tap Super, Alt+F2).

One Rofi window (Catppuccin Mocha) for everything:
  apps and settings        typing filters, Enter starts (also via keywords: "wifi" finds Network); every Control
                           Center page as "… settings" ("display settings" opens Control Center → Display)
  system commands          Lock, Sleep, Restart, Shut down, Sign out (restart/off/sign out with confirmation)
  calculations             "42 * 12" + Enter -> "42 * 12 = 504", Enter copies the result; also 2^10, 3,5*2,
                           sqrt(2), (1+2)/3, pi – own calculator via the syntax tree, no eval
  files and folders        name + Enter searches the home folder (without hidden folders), Enter opens
If nothing in the list matches, Enter takes the typed text; if something matches, Ctrl+Enter forces the search.

Technique: Rofi script mode (rofi -show search -modi search:simpleos-search). Rofi calls this program on
every selection (ROFI_RETV 0 = start, 1 = row selected, 2 = own text), the answer are new rows –
the window stays open until something is started.
  simpleos-search             open the window (Rofi missing -> notification, grab error -> new attempt)
  simpleos-search --calc EXPRESSION   only calculate (tests), exit 1 = not a calculation
Tests: SIMPLEOS_SEARCH_ROOT replaces the searched folder ($HOME).
"""
import ast
import math
import operator
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from decimal import ROUND_HALF_UP, Decimal
from pathlib import Path
import gettext

# Translations (#43): the system language from /usr/share/locale/<lang>/LC_MESSAGES/simpleos.mo, else English
_ = gettext.translation("simpleos", fallback=True).gettext

SEP = "\x1f"
HOME = Path(os.environ.get("SIMPLEOS_SEARCH_ROOT") or Path.home())
MAX_FILES = 60
FILE_TIMEOUT = 3.0   # seconds for the file search
LIVE = "/usr/local/bin/simpleos-live"
SYSTEM = [  # (key, name, icon, keywords incl. German synonyms for German speakers, confirmation)
    ("lock", _("Lock"), "system-lock-screen", "lock screen sperren", None),
    ("sleep", _("Sleep"), "system-suspend", "sleep suspend standby ruhezustand", None),
    ("restart", _("Restart"), "system-reboot", "restart reboot neustart", _("Restart now")),
    ("shutdown", _("Shut down"), "system-shutdown", "shut down shutdown power off poweroff herunterfahren", _("Shut down now")),
    ("switch", _("Switch user"), "system-switch-user", "switch user change user other account benutzer wechseln", None),
    ("logout", _("Sign out"), "system-log-out", "sign out log out logout abmelden", _("Sign out now")),
]
# Pages of the Control Center (1.1.2): "display settings" opens Control Center → Display, like Windows' search does.
# (page key of simpleos-control-center, name, icon as in its sidebar, keywords incl. German synonyms)
SETTINGS = [
    ("wifi", _("Wi-Fi settings"), "network-wireless", "wifi wlan wireless network internet netzwerk"),
    ("bluetooth", _("Bluetooth settings"), "bluetooth", "bluetooth pair pairing headphones kopfhörer"),
