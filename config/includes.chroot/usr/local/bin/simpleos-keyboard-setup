#!/bin/sh
# Simple OS – Tastaturlayout (Control Center → System → Keyboard layout, Menü → Settings → Keyboard Layout)
#   simpleos-keyboard-setup                 Rofi-Auswahl der gängigen Layouts (aktuelles markiert)
#   simpleos-keyboard-setup --set L[:V]     z.B. "ch", "ch:fr", "de:nodeadkeys", "us:intl"
#   simpleos-keyboard-setup --apply         gespeichertes Layout anwenden (Openbox-Autostart), still
#   simpleos-keyboard-setup --status        "Layout<TAB>Variante" (aktuell gespeichert/aktiv)
#   simpleos-keyboard-setup --list          "Layout:Variante<TAB>Name" je Zeile (Control Center)
# --set wirkt sofort (setxkbmap), wird fürs Konto gespeichert (~/.config/simpleos/keyboard, beim Login per
# --apply) und systemweit über localectl (systemd-localed schreibt unter Debian /etc/default/keyboard – gilt für
# Anmeldebildschirm, Konsole und neue Konten; Polkit fragt dafür nach dem Passwort). Abgebrochen: nur fürs Konto.
# Nur Layouts/Varianten, die XKB kennt (/usr/share/X11/xkb/rules/base.lst). Kein set -e, Exit 0 (außer Aufruf).
# Tests: SIMPLEOS_XKB_LST ersetzt base.lst.

SOS_NAME=simpleos-keyboard-setup SOS_TITLE="Keyboard layout" SOS_ICON=input-keyboard SOS_PROMPT=Keyboard
TAB=$(printf '\t')
LIB=/usr/local/lib/simpleos/common.sh
[ -r "$LIB" ] || { notify-send "Keyboard layout" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"
CONF=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/simpleos/keyboard
LST=${SIMPLEOS_XKB_LST:-/usr/share/X11/xkb/rules/base.lst}

# Gängige Layouts: "Layout:Variante<TAB>Name"
LAYOUTS="us:	English (US)
us:intl	English (US, international – accents with dead keys)
gb:	English (UK)
de:	German
de:nodeadkeys	German (no dead keys)
ch:	Swiss German
ch:fr	Swiss French
at:	German (Austria)
fr:	French
be:	Belgian
es:	Spanish
it:	Italian
pt:	Portuguese
br:	Portuguese (Brazil)
nl:	Dutch
pl:	Polish
cz:	Czech
se:	Swedish
no:	Norwegian
dk:	Danish
fi:	Finnish
tr:	Turkish
ru:	Russian
ua:	Ukrainian"

# Layout/Variante bei XKB bekannt? (base.lst: "! layout" / "! variant"-Abschnitte; Variante: "  fr  ch: French")
known() {  # $1 Layout, $2 Variante (leer = Standard)
    [ -r "$LST" ] || return 0      # ohne Liste nicht prüfbar -> setxkbmap entscheidet
    awk -v l="$1" -v v="$2" '
        /^! / { sec = $2; next }
        sec == "layout" && $1 == l { okl = 1 }
        sec == "variant" && v != "" && $1 == v && $2 == l ":" { okv = 1 }
        END { exit !(okl && (v == "" || okv)) }' "$LST"
}
name_of() { printf '%s\n' "$LAYOUTS" | awk -F'\t' -v k="$1" '$1 == k { print $2; exit }'; }
current() {  # gespeichert, sonst aktiv (setxkbmap -query)
    l= v=
    if [ -r "$CONF" ]; then
        l=$(sed -n 's/^layout=//p' "$CONF" | head -n 1) v=$(sed -n 's/^variant=//p' "$CONF" | head -n 1)
    fi
    if [ -z "$l" ] && command -v setxkbmap >/dev/null; then
        q=$(setxkbmap -query 2>/dev/null)
        l=$(printf '%s\n' "$q" | awk '$1 == "layout:" { print $2 }' | cut -d, -f1)
        v=$(printf '%s\n' "$q" | awk '$1 == "variant:" { print $2 }' | cut -d, -f1)
    fi
    printf '%s\t%s\n' "${l:-us}" "$v"
}
apply_x() {  # $1 Layout, $2 Variante
    command -v setxkbmap >/dev/null || { sos_log "setxkbmap fehlt"; return 1; }
    [ -n "${DISPLAY:-}" ] || return 0
    setxkbmap -layout "$1" -variant "$2" >&2 2>&1
}

set_layout() {  # $1 "Layout[:Variante]"
    l=${1%%:*} v=
    case "$1" in *:*) v=${1#*:} ;; esac
    case "$l$v" in *[!a-z0-9_]*|'') echo "Ungültig: $1" >&2; exit 2 ;; esac
    known "$l" "$v" || { sos_notify "This keyboard layout is not available: $1" critical; return 0; }
    if ! apply_x "$l" "$v"; then
        sos_notify "The keyboard layout could not be changed." critical
        return 0
    fi
    mkdir -p "${CONF%/*}" && printf 'layout=%s\nvariant=%s\n' "$l" "$v" > "$CONF"
    name=$(name_of "$l:$v"); name=${name:-$l${v:+ ($v)}}
    # systemweit (Anmeldebildschirm, Konsole): localectl -> /etc/default/keyboard; Passwort über Polkit
    if command -v localectl >/dev/null && localectl set-x11-keymap "$l" pc105 "$v" >&2 2>&1; then
        sos_notify "Keyboard layout: $name" low
    else
        sos_notify "Keyboard layout: $name – for your account (the login screen keeps its layout)." low
    fi
}

case "${1:-}" in
    --set)    [ -n "${2:-}" ] || { echo "Aufruf: simpleos-keyboard-setup --set LAYOUT[:VARIANTE]" >&2; exit 2; }
              set_layout "$2"; exit 0 ;;
    --apply)  [ -r "$CONF" ] || exit 0
              cur=$(current); apply_x "${cur%%"$TAB"*}" "${cur#*"$TAB"}" || sos_log "apply fehlgeschlagen"; exit 0 ;;
    --status) current; exit 0 ;;
    --list)   printf '%s\n' "$LAYOUTS"; exit 0 ;;
    "") ;;
    *) echo "Aufruf: simpleos-keyboard-setup [--set L[:V]|--apply|--status|--list]" >&2; exit 2 ;;
esac

# ---- Rofi-Auswahl
cur=$(current); curkey="${cur%%"$TAB"*}:${cur#*"$TAB"}"
I_KEY='\357\204\234' I_CHECK='\357\200\214'   # FontAwesome 4: keyboard U+F11C, check U+F00C
while IFS="$TAB" read -r key label; do
    [ -n "$key" ] || continue
    if [ "$key" = "$curkey" ]; then
        sos_add "$(sos_fa "$I_CHECK")  $(sos_esc "$label")  $(sos_dim "Current")" "noop"
    else
        sos_add "$(sos_fa "$I_KEY")  $(sos_esc "$label")" "set$TAB$key"
    fi
done <<EOF
$LAYOUTS
EOF
sos_pick "<b>Keyboard layout</b>   $(sos_dim "applies right away")" 520
[ "$action" = set ] && set_layout "$arg1"
exit 0
