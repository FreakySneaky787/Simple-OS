#!/usr/bin/env python3
"""Simple OS – "What's new" window: the highlights of the installed Simple OS version, in plain words.

  simpleos-whats-new            the window (Menu → Help → What's New, Control Center → System & Updates)
  simpleos-whats-new --login    Openbox autostart: the window once after an update to a new version
  simpleos-whats-new --print    the notes as text (tests, terminal)

Shown at sign-in only once per new version, and never on a fresh install or a new account (the Setup Wizard
greets those). "Show this after updates" off = only from the menu. Remembered per account in
~/.config/simpleos/whats-new (seen=VERSION, show=yes|no).
Notes: /usr/share/simpleos/whats-new – first line "# Simple OS X.Y.Z" (must be the installed version, otherwise
--login shows nothing), then "- " bullets with **bold** starts, "## Heading" lines, plain paragraphs.
Tests: SIMPLEOS_WHATS_NEW (notes file), SIMPLEOS_OS_RELEASE, SIMPLEOS_WHATS_NEW_DRY=1 (--login prints
"show"/"skip" instead of opening the window).
"""
import html
import os
import re
import subprocess
import sys
from pathlib import Path

NOTES = Path(os.environ.get("SIMPLEOS_WHATS_NEW", "/usr/share/simpleos/whats-new"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "simpleos"
STATE = CONFIG / "whats-new"
WIZARD_DONE = CONFIG / "wizard-done"
RELEASES = "https://github.com/FreakySneaky787/Simple-OS/releases/tag/v"


def os_version():
    for f in (os.environ.get("SIMPLEOS_OS_RELEASE", "/etc/os-release"), "/usr/lib/os-release"):
        try:
            m = re.search(r'^VERSION_ID="?([^"\n]*)"?$', Path(f).read_text(), re.M)
            if m:
                return m.group(1)
        except OSError:
            continue
    return ""


def read_notes():
    """(version, [(kind, text)]) – kind: h (heading), li (bullet), p (paragraph); ("", []) without notes"""
    try:
        lines = NOTES.read_text().splitlines()
    except OSError:
        return "", []
    version, blocks = "", []
    for line in lines:
        s = line.strip()
        if not s:
            continue
        if s.startswith("# ") and not version:
            m = re.search(r"(\d+(?:\.\d+)+)", s)
            version = m.group(1) if m else ""
        elif s.startswith("## "):
            blocks.append(("h", s[3:]))
        elif s.startswith("- "):
            blocks.append(("li", s[2:]))
        elif blocks and blocks[-1][0] in ("li", "p") and line.startswith("  "):
            blocks[-1] = (blocks[-1][0], blocks[-1][1] + " " + s)   # continuation line
        else:
            blocks.append(("p", s))
    return version, blocks


def markup(text):
    """**bold** -> Pango markup, everything else escaped"""
    return re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", html.escape(text, quote=False))


def read_state():
    try:
        return dict(l.split("=", 1) for l in STATE.read_text().splitlines() if "=" in l)
    except OSError:
        return {}


def write_state(**kw):
    st = read_state()
    st.update({k: v for k, v in kw.items() if v is not None})
    try:
        CONFIG.mkdir(parents=True, exist_ok=True)
        STATE.write_text("".join(f"{k}={v}\n" for k, v in st.items()))
    except OSError:
        pass


def live_session():
    try:
        return subprocess.run(["/usr/local/bin/simpleos-live", "--check"], capture_output=True,
                              timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def due_at_login():
    """True if the window belongs to this sign-in (and remember that it was shown)"""
    version = os_version()
    notes_version, blocks = read_notes()
    if not version or notes_version != version or not blocks or live_session():
        return False
    st = read_state()
    if not st:
        # first time this tool runs for the account: an account that went through the Setup Wizard before is an
        # update (show it); a new account or a fresh install gets the wizard and starts at this version
        if not WIZARD_DONE.exists():
            write_state(seen=version, show="yes")
            return False
    if st.get("seen") == version:
        return False
    write_state(seen=version)
    return st.get("show", "yes") != "no"


def window():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gtk

    version, blocks = read_notes()
    version = version or os_version()
    win = Gtk.Window(title="What's new in Simple OS")
    win.set_default_size(560, 520)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_icon_name("help-about")
    win.connect("destroy", Gtk.main_quit)
    win.connect("key-press-event", lambda w, e: e.keyval == Gdk.KEY_Escape and w.destroy())
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    win.add(outer)
    head = Gtk.Box(spacing=14, margin=20)
    head.pack_start(Gtk.Image.new_from_icon_name("starred", Gtk.IconSize.DIALOG), False, False, 0)
    title = Gtk.Label(xalign=0)
    title.set_markup(f"<span size='x-large' weight='bold'>What's new in Simple OS {html.escape(version)}</span>\n"
                     "<span alpha='70%'>Your computer was updated. Here is what changed for you.</span>")
    head.pack_start(title, True, True, 0)
    outer.pack_start(head, False, False, 0)
    scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_start=24, margin_end=24, margin_bottom=12)
    scroll.add(body)
    outer.pack_start(scroll, True, True, 0)
    if not blocks:
        blocks = [("p", "No notes for this version. The release notes on the project page list every change.")]
    for kind, text in blocks:
        lab = Gtk.Label(xalign=0)
        lab.set_line_wrap(True)
        lab.set_max_width_chars(60)
        if kind == "h":
            lab.set_markup(f"<b>{html.escape(text)}</b>")
            lab.set_margin_top(6)
            body.pack_start(lab, False, False, 0)
        elif kind == "li":
            lab.set_markup(markup(text))
            row = Gtk.Box(spacing=10)
            dot = Gtk.Label(label="•", yalign=0)
            row.pack_start(dot, False, False, 0)
            row.pack_start(lab, True, True, 0)
            body.pack_start(row, False, False, 0)
        else:
            lab.set_markup(markup(text))
            body.pack_start(lab, False, False, 0)
    foot = Gtk.Box(spacing=8, margin=14)
    show = Gtk.CheckButton(label="Show this after updates")
    show.set_active(read_state().get("show", "yes") != "no")
    show.connect("toggled", lambda b: write_state(show="yes" if b.get_active() else "no"))
    foot.pack_start(show, False, False, 0)
    close = Gtk.Button(label="Close")
    close.get_style_context().add_class("suggested-action")
    close.connect("clicked", lambda _b: win.destroy())
    foot.pack_end(close, False, False, 0)
    full = Gtk.Button(label="All changes")
    full.set_tooltip_text("The full release notes on the project page")
    full.connect("clicked", lambda _b: subprocess.Popen(["xdg-open", RELEASES + version], start_new_session=True,
                                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    foot.pack_end(full, False, False, 0)
    outer.pack_start(Gtk.Separator(), False, False, 0)
    outer.pack_start(foot, False, False, 0)
    win.show_all()
    close.grab_focus()
    if os.environ.get("SIMPLEOS_WHATS_NEW_SELFTEST") == "1":
        from gi.repository import GLib
        GLib.timeout_add(800, win.destroy)
    Gtk.main()
    return 0


def main(argv):
    arg = argv[1] if len(argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(__doc__)
        return 0
    if arg == "--print":
        version, blocks = read_notes()
        print(f"Simple OS {version}")
        for kind, text in blocks:
            print(("- " if kind == "li" else "") + re.sub(r"\*\*", "", text))
        return 0
    if arg == "--login":
        due = due_at_login()
        if os.environ.get("SIMPLEOS_WHATS_NEW_DRY") == "1":
            print("show" if due else "skip")
            return 0
        if not due:
            return 0
    elif arg:
        print(f"simpleos-whats-new: unknown option {arg}", file=sys.stderr)
        return 2
    if not os.environ.get("DISPLAY"):
        print("simpleos-whats-new: no display", file=sys.stderr)
        return 1
    return window()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
