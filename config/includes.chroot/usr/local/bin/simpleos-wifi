#!/bin/sh
# Simple OS – network flyout (click on the network display in the taskbar, Settings → Network & Wi-Fi)
# Built like on Windows, a Rofi menu in plain language, without interface names (wlan0, eth0, …):
#   heading       "Select network"
#   first row     active network ("Connected: Home" / "Connected: Ethernet" / "Not connected")
#                 click -> "Disconnect", "Network Details", "Back"
#   below         available Wi-Fi networks, sorted by signal strength; a click connects (password via Rofi,
#                 saved networks without asking); without a Wi-Fi device "Wi-Fi Hardware: Not found / Disabled"
#   at the bottom actions: "Turn off Wi-Fi" / "Turn on Wi-Fi", "Network Details"
# No terminals, no TUI forms.
#
# Robustness: no set -e/-u; every path ends with exit 0 and – if something goes wrong – with a
# clear notify-send notification. Technical details go to ~/.cache/simpleos-wifi.log.
# Right after a taskbar click Rofi often cannot grab keyboard/mouse -> wait briefly, try again.
# If Rofi does not start at all: nm-connection-editor (GTK), otherwise a notification with the network data.

NETINFO=/usr/local/bin/simpleos-netinfo
TAB=$(printf '\t')

SOS_NAME=simpleos-wifi SOS_TITLE=Network SOS_ICON=network-wireless SOS_PROMPT=Network SOS_CORNER=1
LIB=/usr/local/lib/simpleos/common.sh
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || { notify-send "Network" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init

I_CHECK='\357\200\214' I_OFF='\357\204\247' I_WIFI='\357\207\253' I_LOCK='\357\200\243'
I_POWER='\357\200\221' I_INFO='\357\201\232' I_BACK='\357\201\240' I_UNLINK='\357\200\215' I_SEARCH='\357\200\202'
signal_word() {
    if [ "${1:-0}" -ge 70 ]; then echo "Strong"; elif [ "${1:-0}" -ge 40 ]; then echo "Good"; else echo "Weak"; fi
}
details() {
    if [ -x "$NETINFO" ]; then exec "$NETINFO"; fi
    sos_notify "Network details are not available on this system."
    exit 0
}
# Rofi does not work: graphical editor, otherwise a notification with the most important network data
sos_rofi_failed() {
    if command -v nm-connection-editor >/dev/null; then
        sos_notify "The network menu could not open. Opening the network settings window instead."
        exec nm-connection-editor
    fi
    summary=
    [ -x "$NETINFO" ] && summary=$(timeout 5 "$NETINFO" --text 2>/dev/null | head -n 1)
    sos_notify "The network menu could not open.${summary:+
$summary}" critical
    exit 0
}

command -v nmcli >/dev/null || { sos_notify "Network management is not installed (NetworkManager missing)." critical; exit 0; }
command -v rofi >/dev/null || { sos_log "rofi missing"; sos_rofi_failed; }

while :; do
    # ---- State: Wi-Fi device, active connection (Wi-Fi before cable), cable device to connect
    devs=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>/dev/null)
    wifi=$(printf '%s\n' "$devs" | awk -F: '$2 == "wifi" { print $1; exit }')
    wifi_up=$(printf '%s\n' "$devs" | awk -F: '$2 == "wifi" && $3 ~ /^connected/ { print $1; exit }')
    eth_up=$(printf '%s\n' "$devs" | awk -F: '$2 == "ethernet" && $3 ~ /^connected/ { print $1; exit }')
    eth=$(printf '%s\n' "$devs" | awk -F: '$2 == "ethernet" && $3 != "unmanaged" { print $1; exit }')
    # A cable that NetworkManager does not manage (some VMs): the default route counts as "Connected: Ethernet"
    route_dev=
    [ -n "$wifi_up$eth_up" ] || route_dev=$(ip -4 route show default 2>/dev/null | awk '{
        d = ""; m = 0
        for (i = 1; i < NF; i++) { if ($i == "dev") d = $(i + 1); if ($i == "metric") m = $(i + 1) + 0 }
        if (d != "" && (best == "" || m < best)) { best = m; dev = d }
    } END { if (dev != "") print dev }')
    radio=on
    [ -n "$wifi" ] && [ "$(nmcli radio wifi 2>/dev/null)" != enabled ] && radio=off

    # ---- Wi-Fi networks: SSID<TAB>signal<TAB>security<TAB>connected, one line per network, strongest first.
    # With nmcli -t the SSID comes last, because ':' in it arrives as '\:'; hidden networks are missing.
    nets=
    if [ -n "$wifi" ] && [ "$radio" = on ]; then
        nets=$(nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID device wifi list ifname "$wifi" --rescan auto 2>/dev/null | awk '
        {
            line = $0; gsub(/\\\\/, "\001", line); gsub(/\\:/, "\002", line)
            n = split(line, f, ":"); ssid = f[4]; for (i = 5; i <= n; i++) ssid = ssid ":" f[i]
            gsub("\002", ":", ssid); gsub("\001", "\\", ssid)
            if (ssid == "") next
            if (f[1] == "*") use[ssid] = 1
            if (!(ssid in sig) || f[2] + 0 > sig[ssid]) { sig[ssid] = f[2] + 0; sec[ssid] = f[3] }
        }
        END { for (s in sig) printf "%s\t%d\t%s\t%d\n", s, sig[s], (sec[s] == "" || sec[s] == "--" ? "open" : sec[s]), use[s] + 0 }' |
            sort -t "$TAB" -k2,2nr)
    fi
    current=
    [ -n "$wifi_up" ] && current=$(printf '%s\n' "$nets" | awk -F '\t' '$4 == 1 { print $1; exit }')
    [ -n "$wifi_up" ] && [ -z "$current" ] &&
        current=$(printf '%s\n' "$devs" | awk -F: -v d="$wifi_up" '$1 == d { print $4; exit }')

    # ---- First row: active network
    if [ -n "$wifi_up" ]; then
        sos_add "$(sos_fa "$I_CHECK")  Connected: $(sos_esc "$current")" "active${TAB}wifi${TAB}$current"
    elif [ -n "$eth_up$route_dev" ]; then
        sos_add "$(sos_fa "$I_CHECK")  Connected: Ethernet" "active${TAB}ethernet${TAB}Ethernet"
    elif [ -n "$wifi" ] && [ "$radio" = on ]; then
        sos_add "$(sos_fa "$I_OFF")  Not connected" "rescan"
    elif [ -n "$eth" ]; then
        sos_add "$(sos_fa "$I_OFF")  Ethernet  $(sos_dim "Cable unplugged")" "eth-connect"
    else
        sos_add "$(sos_fa "$I_OFF")  No network adapter" "none"
    fi

    # ---- Below: available Wi-Fi networks (without the active one), strongest first; without a Wi-Fi device (no module/
    # driver, VM, switched off) only a hint – a click on it opens the menu again
    others=0
    [ -n "$wifi" ] || sos_add "$(sos_fa "$I_WIFI")  Wi-Fi Hardware: $(sos_dim "Not found / Disabled")" "info"
    if [ -n "$wifi" ] && [ "$radio" = on ]; then
        rows_nets=$(printf '%s\n' "$nets" | while IFS="$TAB" read -r ssid signal security used; do
            [ -n "$ssid" ] && [ "$used" != 1 ] || continue
            lock=; [ "$security" != open ] && lock=$(sos_fa "$I_LOCK")
            printf '%s\t%s\n' "$(sos_fa "$I_WIFI")  $(sos_esc "$ssid")  $(sos_dim "$(signal_word "$signal")")  $lock" \
                "connect${TAB}$ssid${TAB}$security"
        done)
        while IFS="$TAB" read -r shown act ssid security; do
            [ -n "$shown" ] || continue
            sos_add "$shown" "$act${TAB}$ssid${TAB}$security"
            others=$((others + 1))
        done <<EOF
$rows_nets
EOF
        [ "$others" -gt 0 ] || sos_add "$(sos_fa "$I_SEARCH")  Search again" "rescan"
    fi

    # ---- At the bottom: actions
    if [ -n "$wifi" ]; then
        if [ "$radio" = on ]; then sos_add "$(sos_fa "$I_POWER")  Turn off Wi-Fi" "wifi-off"
        else                       sos_add "$(sos_fa "$I_POWER")  Turn on Wi-Fi" "wifi-on"; fi
    fi
    sos_add "$(sos_fa "$I_INFO")  Network Details" "details"

    mesg="<b>Select network</b>"
    [ -n "$wifi" ] && [ "$radio" = off ] && mesg="$mesg  $(sos_dim "Wi-Fi is off")"
    sos_pick "$mesg"

    case "$action" in
        active)
            sos_add "$(sos_fa "$I_UNLINK")  Disconnect" "disconnect"
            sos_add "$(sos_fa "$I_INFO")  Network Details" "details"
            sos_add "$(sos_fa "$I_BACK")  Back" "back"
            kind=$arg1 name=$arg2
            sos_pick "<b>$(sos_esc "$name")</b>  Connected"
            case "$action" in
                disconnect)
                    dev=$wifi_up; [ "$kind" = ethernet ] && dev=${eth_up:-$route_dev}
                    if nmcli device disconnect "$dev" >&2 2>&1; then sos_notify "Disconnected from $name."
                    else sos_notify "Could not disconnect from $name. Please try again." critical; fi
                    exit 0 ;;
                details) details ;;
                back) continue ;;
            esac
            exit 0 ;;
        connect) ssid=$arg1 security=$arg2; break ;;
        info) continue ;;
        rescan) nmcli device wifi rescan >&2 2>&1; sleep 2; continue ;;
        wifi-off) nmcli radio wifi off >&2 2>&1; sos_notify "Wi-Fi is off."; exit 0 ;;
        wifi-on) nmcli radio wifi on >&2 2>&1; sos_notify "Wi-Fi is on. Looking for networks …"; sleep 3; continue ;;
        eth-connect)
            sos_notify "Connecting …"
            if nmcli --wait 20 device connect "$eth" >&2 2>&1; then sos_notify "You're online (Ethernet)."
            else sos_notify "Could not connect. Check that the network cable is plugged in at both ends." critical; fi
            exit 0 ;;
        details) details ;;
        *) exit 0 ;;
    esac
done
[ -n "$ssid" ] || exit 0

# ---- Connect: saved profile without a password, otherwise the password via Rofi
if nmcli -t -f NAME connection show 2>/dev/null | grep -qxF "$ssid" &&
   nmcli --wait 20 connection up id "$ssid" >&2 2>&1; then
    sos_notify "Connected to $ssid."; exit 0
fi
had_profile=$(nmcli -t -f NAME connection show 2>/dev/null | grep -cxF "$ssid" || true)

set -- device wifi connect "$ssid" ifname "$wifi"
ask=
if [ "$security" != open ]; then
    pw=$(sos_rofi -dmenu -password -p "Password" -mesg "<b>$(sos_esc "$ssid")</b>  Enter the password" -markup \
        -theme-str 'window { width: 480px; } listview { lines: 0; }' </dev/null)
    [ -n "$pw" ] || exit 0
    ask=--ask    # nmcli asks for the password and reads it from stdin – never on the command line (visible in ps)
fi

sos_notify "Connecting to $ssid …"
# Saved profile (the password just did not work): delete it, the connection below creates a new one with the new
# password – "device wifi connect" would otherwise create a second profile next to it or keep trying the old password
if [ "${had_profile:-0}" != 0 ] && [ -n "${pw:-}" ]; then
    nmcli connection delete id "$ssid" >&2 2>&1
    had_profile=0
fi
if err=$(printf '%s\n' "${pw:-}" | nmcli $ask --wait 30 "$@" 2>&1 >/dev/null); then
    sos_notify "Connected to $ssid."
    exit 0
fi
sos_log "connect failed: $err"
# Failed (usually a wrong password): delete the newly created profile again
[ "${had_profile:-0}" = 0 ] && nmcli connection delete id "$ssid" >&2 2>&1
if [ "$security" != open ]; then
    sos_notify "Could not connect to $ssid. The password may be wrong – click the network display and try again." critical
else
    sos_notify "Could not connect to $ssid. Move closer to the router and try again." critical
fi
exit 0
