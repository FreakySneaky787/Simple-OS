#!/bin/sh
# Simple OS – Dynamic Wallpaper (Control Center → Appearance "Dynamic wallpaper (day/night)")
# Tagsüber das helle Wallpaper (Catppuccin Latte), abends und sobald der Nachtmodus aktiv ist das dunkle
# (Catppuccin Mocha) – gekoppelt an simpleos-nightlight:
#   dunkel, wenn  simpleos-nightlight --status "on" meldet (Nachtmodus gerade aktiv, auch tagsüber von Hand)
#            oder es 20:00–07:00 ist (gleicher Abend wie der automatische Nachtmodus, ohne Standortdienst)
#   simpleos-wallpaper-schedule --on        einschalten (merkt sich das bisherige Hintergrundbild)
#   simpleos-wallpaper-schedule --off       ausschalten (bisheriges Bild zurück)
#   simpleos-wallpaper-schedule --theme on|off   Hell/Dunkel-Modus mitschalten (simpleos-theme --mode light|dark:
#                                           GTK live per XSETTINGS, Openbox, Rofi, Taskleiste) – Vorgabe aus
#   simpleos-wallpaper-schedule --status    "on"/"off", Zeile 2: "day"/"night" (was gerade gelten soll),
#                                           Zeile 3: "theme=on"/"theme=off"
#   simpleos-wallpaper-schedule --apply     jetzt prüfen und wechseln (simpleos-nightlight ruft das bei jeder
#                                           Änderung auf -> Wechsel sofort beim Ein-/Ausschalten des Nachtmodus)
#   simpleos-wallpaper-schedule --daemon    Openbox-Autostart: alle 5 Minuten prüfen (läuft nur einmal)
# Gesetzt wird über simpleos-wallpaper (pcmanfm-Desktop, bleibt nach dem Neustart). Kein set -e, Exit 0.
# Tests: SIMPLEOS_HOUR ersetzt die Stunde, SIMPLEOS_NIGHTLIGHT das Nachtmodus-Programm,
#        SIMPLEOS_WALLPAPER das Programm zum Setzen, SIMPLEOS_THEME das Design-Programm.
DAY=/usr/share/backgrounds/simpleos/wallpaper-day.png
NIGHT=/usr/share/backgrounds/simpleos/wallpaper.png
CONF=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/simpleos/wallpaper-schedule
RUN=${XDG_RUNTIME_DIR:-${HOME:-/tmp}/.cache}
NIGHTLIGHT=${SIMPLEOS_NIGHTLIGHT:-simpleos-nightlight}
SETWP=${SIMPLEOS_WALLPAPER:-simpleos-wallpaper}
THEME=${SIMPLEOS_THEME:-simpleos-theme}
PCMANFM_CONF=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/pcmanfm/default/desktop-items-0.conf

mode=off previous= theme=off
[ -r "$CONF" ] && . "$CONF" 2>/dev/null
case "$mode" in on|off) ;; *) mode=off ;; esac
case "$theme" in on|off) ;; *) theme=off ;; esac

save() {
    mkdir -p "${CONF%/*}" 2>/dev/null
    printf 'mode=%s\nprevious="%s"\ntheme=%s\n' "$mode" "$(printf '%s' "$previous" | tr -d '"$`\\')" "$theme" > "$CONF" 2>/dev/null
}
# Design passend zur Tageszeit (nur wenn eingeschaltet und abweichend); Hintergrund setzt dieses Skript selbst
switch_theme() {  # $1 day|night
    [ "$theme" = on ] || return 0
    if [ "$1" = night ]; then want_mode=dark; else want_mode=light; fi
    [ "$("$THEME" --show 2>/dev/null | sed -n 's/^mode=//p')" = "$want_mode" ] && return 0
    "$THEME" --mode "$want_mode" --no-wallpaper >/dev/null 2>&1
}
night() {
    [ "$("$NIGHTLIGHT" --status 2>/dev/null | head -n 1)" = on ] && return 0
    h=${SIMPLEOS_HOUR:-$(date +%H)}; h=${h#0}; h=${h:-0}
    [ "$h" -ge 20 ] || [ "$h" -lt 7 ]
}
wanted() { if night; then echo night; else echo day; fi; }
apply() {
    [ "$mode" = on ] || return 0
    want=$(wanted)
    [ "${1:-}" != force ] && [ "$(cat "$RUN/simpleos-wallpaper-schedule.state" 2>/dev/null)" = "$want" ] && return 0
    if [ "$want" = night ]; then file=$NIGHT; else file=$DAY; fi
    [ -r "$file" ] || file=$NIGHT
    "$SETWP" "$file" >/dev/null 2>&1
    switch_theme "$want"
    echo "$want" > "$RUN/simpleos-wallpaper-schedule.state" 2>/dev/null
}
current_wallpaper() { sed -n 's/^wallpaper=//p' "$PCMANFM_CONF" 2>/dev/null | head -n 1; }

case "${1:-}" in
    --on)
        if [ "$mode" != on ]; then
            cur=$(current_wallpaper)
            case "$cur" in "$DAY"|"$NIGHT"|"") ;; *) previous=$cur ;; esac
        fi
        mode=on; save; apply force ;;
    --off)
        [ "$mode" = on ] || exit 0
        mode=off; save
        rm -f "$RUN/simpleos-wallpaper-schedule.state"
        if [ -n "$previous" ] && [ -r "$previous" ]; then "$SETWP" "$previous" >/dev/null 2>&1
        else "$SETWP" "$NIGHT" >/dev/null 2>&1; fi ;;
    --status) echo "$mode"; wanted; echo "theme=$theme" ;;
    --theme)
        case "${2:-}" in on|off) theme=$2 ;; *) echo "Aufruf: --theme on|off" >&2; exit 2 ;; esac
        save
        [ "$theme" = on ] && [ "$mode" = on ] && switch_theme "$(wanted)" ;;
    --apply)  apply ;;
    --daemon)
        pidf=$RUN/simpleos-wallpaper-schedule.pid
        if [ -r "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then exit 0; fi
        echo $$ > "$pidf" 2>/dev/null
        rm -f "$RUN/simpleos-wallpaper-schedule.state"
        while :; do
            mode=off previous= theme=off
            [ -r "$CONF" ] && . "$CONF" 2>/dev/null
            apply
            sleep 300
        done ;;
    *) echo "Aufruf: simpleos-wallpaper-schedule --on|--off|--status|--apply|--daemon" >&2; exit 2 ;;
esac
exit 0
