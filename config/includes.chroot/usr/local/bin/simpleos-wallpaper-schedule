#!/bin/sh
# Simple OS – dynamic wallpaper (Control Center → Appearance "Dynamic wallpaper (day/night)")
# During the day the light wallpaper (Catppuccin Latte), in the evening and as soon as night light is active the dark
# one (Catppuccin Mocha) – coupled to simpleos-nightlight:
#   dark if  simpleos-nightlight --status reports "on" (night light active right now, also by hand during the day)
#            or it is 20:00–07:00 (the same evening as the automatic night light, without a location service)
#   simpleos-wallpaper-schedule --on        switch on (remembers the previous wallpaper)
#   simpleos-wallpaper-schedule --off       switch off (previous picture back)
#   simpleos-wallpaper-schedule --theme on|off   switch light/dark mode along (simpleos-theme --mode light|dark:
#                                           GTK live via XSETTINGS, Openbox, Rofi, taskbar) – default off
#   simpleos-wallpaper-schedule --status    "on"/"off", line 2: "day"/"night" (what should apply right now),
#                                           line 3: "theme=on"/"theme=off"
#   simpleos-wallpaper-schedule --apply     check and switch now (simpleos-nightlight calls this on every
#                                           change -> switches immediately when night light is turned on/off)
#   simpleos-wallpaper-schedule --daemon    Openbox autostart: check every 5 minutes (runs only once)
# Set via simpleos-wallpaper (pcmanfm desktop, stays after a restart). No set -e, exit 0.
# Tests: SIMPLEOS_HOUR replaces the hour, SIMPLEOS_NIGHTLIGHT the night light program,
#        SIMPLEOS_WALLPAPER the program that sets it, SIMPLEOS_THEME the theme program.
DAY=/usr/share/backgrounds/simpleos/wallpaper-day.png
NIGHT=/usr/share/backgrounds/simpleos/wallpaper.png
CONF=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/simpleos/wallpaper-schedule
RUN=${XDG_RUNTIME_DIR:-${HOME:-/tmp}/.cache}
NIGHTLIGHT=${SIMPLEOS_NIGHTLIGHT:-simpleos-nightlight}
SETWP=${SIMPLEOS_WALLPAPER:-simpleos-wallpaper}
THEME=${SIMPLEOS_THEME:-simpleos-theme}
PCMANFM_CONF=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/pcmanfm/default/desktop-items-0.conf

mode=off previous= theme=off
[ -r "$CONF" ] && . "$CONF" 2>/dev/null
case "$mode" in on|off) ;; *) mode=off ;; esac
case "$theme" in on|off) ;; *) theme=off ;; esac

save() {
    mkdir -p "${CONF%/*}" 2>/dev/null
    printf 'mode=%s\nprevious="%s"\ntheme=%s\n' "$mode" "$(printf '%s' "$previous" | tr -d '"$`\\')" "$theme" > "$CONF" 2>/dev/null
}
# Theme matching the time of day (only if switched on and different); this script sets the wallpaper itself
switch_theme() {  # $1 day|night
    [ "$theme" = on ] || return 0
    if [ "$1" = night ]; then want_mode=dark; else want_mode=light; fi
    [ "$("$THEME" --show 2>/dev/null | sed -n 's/^mode=//p')" = "$want_mode" ] && return 0
    "$THEME" --mode "$want_mode" --no-wallpaper >/dev/null 2>&1
}
night() {
    [ "$("$NIGHTLIGHT" --status 2>/dev/null | head -n 1)" = on ] && return 0
    h=${SIMPLEOS_HOUR:-$(date +%H)}; h=${h#0}; h=${h:-0}
    [ "$h" -ge 20 ] || [ "$h" -lt 7 ]
}
wanted() { if night; then echo night; else echo day; fi; }
apply() {
    [ "$mode" = on ] || return 0
    want=$(wanted)
    [ "${1:-}" != force ] && [ "$(cat "$RUN/simpleos-wallpaper-schedule.state" 2>/dev/null)" = "$want" ] && return 0
    if [ "$want" = night ]; then file=$NIGHT; else file=$DAY; fi
    [ -r "$file" ] || file=$NIGHT
    "$SETWP" "$file" >/dev/null 2>&1
    switch_theme "$want"
    echo "$want" > "$RUN/simpleos-wallpaper-schedule.state" 2>/dev/null
}
current_wallpaper() { sed -n 's/^wallpaper=//p' "$PCMANFM_CONF" 2>/dev/null | head -n 1; }

case "${1:-}" in
    --on)
        if [ "$mode" != on ]; then
            cur=$(current_wallpaper)
            case "$cur" in "$DAY"|"$NIGHT"|"") ;; *) previous=$cur ;; esac
        fi
        mode=on; save; apply force ;;
    --off)
        [ "$mode" = on ] || exit 0
        mode=off; save
        rm -f "$RUN/simpleos-wallpaper-schedule.state"
        if [ -n "$previous" ] && [ -r "$previous" ]; then "$SETWP" "$previous" >/dev/null 2>&1
        else "$SETWP" "$NIGHT" >/dev/null 2>&1; fi ;;
    --status) echo "$mode"; wanted; echo "theme=$theme" ;;
    --theme)
        case "${2:-}" in on|off) theme=$2 ;; *) echo "Usage: --theme on|off" >&2; exit 2 ;; esac
        save
        [ "$theme" = on ] && [ "$mode" = on ] && switch_theme "$(wanted)" ;;
    --apply)  apply ;;
    --daemon)
        pidf=$RUN/simpleos-wallpaper-schedule.pid
        if [ -r "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then exit 0; fi
        echo $$ > "$pidf" 2>/dev/null
        rm -f "$RUN/simpleos-wallpaper-schedule.state"
        while :; do
            mode=off previous= theme=off
            [ -r "$CONF" ] && . "$CONF" 2>/dev/null
            apply
            sleep 300
        done ;;
    *) echo "Usage: simpleos-wallpaper-schedule --on|--off|--status|--apply|--daemon" >&2; exit 2 ;;
esac
exit 0
