#!/bin/sh
# Simple OS – report a problem (Menu → Help → Report a Problem, Control Center → System)
# Rofi window with three ways:
#   "Create report"                   system info + logs including the system log (pkexec helper, password)
#   "Create report without system logs"  the same without a password (only what the user may read)
#   "Open the issue page only"        only the page for bug reports
# The report is saved as a text file on the desktop (simpleos-report-YYYYMMDD-HHMM.txt); then the page for
# a new bug report opens with a template – you drag the file into it.
# Privacy: before saving, user name, real name, computer name, Wi-Fi/connection names,
# IP and MAC addresses, serial numbers and email addresses are replaced (redact()). The computer's serial numbers
# (/sys/class/dmi/id/*_serial) are not even read.
# The address comes from BUG_REPORT_URL in /etc/os-release – the only place where it is set. Without an address
# the report is only saved. GitHub addresses (…/issues) get /new with a title and template.
#   simpleos-report                    window
#   simpleos-report --collect [--system]   report (cleaned) on stdout, without a window
#   simpleos-report --url              address for a new bug report (exit 1 if none is set)
#   simpleos-report --redact           stdin cleaned on stdout (test of the cleaning, 99_verify)
# Robust like the other Rofi tools: no set -e, exit 0 (except on wrong usage),
# details in ~/.cache/simpleos-report.log.
# Tests: SIMPLEOS_REPORT_OSRELEASE replaces /etc/os-release, SIMPLEOS_REPORT_DIR the desktop folder,
# SIMPLEOS_REPORT_SYS the root for /sys and /var/log paths.

SOS_NAME=simpleos-report SOS_TITLE="Report a Problem" SOS_ICON=dialog-warning SOS_PROMPT=Report
TAB=$(printf '\t')
HELPER=/usr/local/sbin/simpleos-report-helper
OS_RELEASE=${SIMPLEOS_REPORT_OSRELEASE:-/etc/os-release}
SYS=${SIMPLEOS_REPORT_SYS:-}
LIB=/usr/local/lib/simpleos/common.sh
[ -r "$LIB" ] || { notify-send "Report a Problem" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"
export LC_ALL=C
# iw, rfkill, swapon … live in /usr/sbin, which a normal user's PATH on Debian does not contain: without this the report
# said "(iw not installed)" and had no Wi-Fi data at all
PATH=$PATH:${SIMPLEOS_SBIN:-/usr/sbin:/sbin}

osr() { sed -n "s/^$1=//p" "$OS_RELEASE" 2>/dev/null | head -n 1 | sed 's/^"//; s/"$//'; }
# Command with a time limit; if it is missing, the report says so instead of an empty spot
run() {
    command -v "$1" >/dev/null || { echo "($1 not installed)"; return 0; }
    timeout 15 "$@" 2>&1 || true
}
section() { printf '\n==== %s ====\n' "$1"; }
dmi() { cat "$SYS/sys/class/dmi/id/$1" 2>/dev/null || echo "?"; }

# Address for a new bug report. GitHub: …/issues -> …/issues/new?title=…&body=… (template)
issue_url() {
    base=$(osr BUG_REPORT_URL)
    case "$base" in http://*|https://*) ;; *) return 1 ;; esac
    case "$base" in
        https://github.com/*/issues|https://github.com/*/issues/)
            model="$(dmi sys_vendor) $(dmi product_name)"
            [ "$model" = "? ?" ] && model="unknown computer"
            BASE=${base%/} VERSION="$(osr PRETTY_NAME)" MODEL=$model python3 - <<'PY' 2>/dev/null || echo "${base%/}/new"
import os
from urllib.parse import quote
body = """**What happened?**


**What did you expect to happen?**


**Steps to reproduce**
1.
2.

**Report file**
Drag the file `simpleos-report-….txt` from your Desktop into this box.
(Menu → Help → Report a Problem creates it.)

---
%s · %s""" % (os.environ["VERSION"], os.environ["MODEL"])
print("%s/new?body=%s" % (os.environ["BASE"], quote(body)))
PY
            ;;
        *) echo "$base" ;;
    esac
}

# ---- Report
collect() {
    section "Simple OS"
    echo "Version:      $(osr PRETTY_NAME)"
    echo "Created:      $(date '+%F %H:%M %Z')"
    if [ -d "$SYS/sys/firmware/efi" ]; then boot=UEFI; else boot="BIOS (legacy)"; fi
    sb=$(run mokutil --sb-state | head -n 1)
    echo "Boot mode:    $boot${sb:+ – $sb}"
    if command -v simpleos-live >/dev/null && simpleos-live --check >/dev/null 2>&1; then
        echo "Session:      live USB"
    else
        echo "Session:      installed"
    fi
    echo "Kernel:       $(uname -r) ($(uname -m))"
    echo "Uptime:       $(run uptime -p)"
    echo "Desktop:      ${XDG_SESSION_TYPE:-x11}, ${DESKTOP_SESSION:-openbox}"

    section "Computer"
    echo "Model:        $(dmi sys_vendor) $(dmi product_name) ($(dmi product_version))"
    echo "Board:        $(dmi board_vendor) $(dmi board_name)"
    echo "BIOS:         $(dmi bios_vendor) $(dmi bios_version) ($(dmi bios_date))"
    run lscpu | grep -E '^(Model name|CPU\(s\):|Thread|Virtualization|Hypervisor vendor)'
    echo "Virtual:      $(run systemd-detect-virt)"
    run free -h
    run swapon --show

    section "Graphics"
    run lspci -nnk | grep -A3 -E 'VGA|3D controller|Display controller'
    run glxinfo -B | grep -E 'OpenGL (vendor|renderer|core profile version)|direct rendering|Accelerated'
    run xrandr --query | grep -E ' connected|\*'

    section "Network & Bluetooth"
    run lspci -nnk | grep -A3 -E 'Network controller|Ethernet controller'
    run nmcli -f DEVICE,TYPE,STATE device
    # Wi-Fi: link rate/signal, power saving mode and driver options (drops to a few kB/s)
    for w in "$SYS"/sys/class/net/*/wireless; do
        [ -d "$w" ] || continue
        i=${w%/wireless}; i=${i##*/}
        echo "--- Wi-Fi $i: driver $(basename "$(readlink -f "$SYS/sys/class/net/$i/device/driver" 2>/dev/null)" 2>/dev/null)"
        run iw dev "$i" link | grep -E 'signal|bitrate|freq'
        run iw dev "$i" get power_save
        # Transmission quality: many retries/failures or a low bitrate with good signal = interference (Bluetooth on 2.4 GHz,
        # a crowded channel), beacon loss = the chip loses the router now and then
        run iw dev "$i" station dump | grep -E 'signal:|signal avg|tx bitrate|rx bitrate|tx retries|tx failed|beacon loss|expected throughput|connected time'
    done
    run iw reg get | grep -E 'country|phy#'
    # Bluetooth shares the antenna/2.4 GHz band with Wi-Fi on most laptop chips: searching for devices or streaming to
    # headphones can pull the Wi-Fi speed down to a few kB/s
    echo "Bluetooth:    $(run bluetoothctl show | grep -E 'Powered|Discovering' | tr -d '\t' | tr '\n' ' ') connected devices: $(run bluetoothctl devices Connected | grep -c Device)"
    for p in "$SYS"/sys/module/rtw89_core/parameters/disable_ps_mode "$SYS"/sys/module/rtw89_pci/parameters/disable_aspm_l1 \
             "$SYS"/sys/module/rtw88_pci/parameters/disable_aspm "$SYS"/sys/module/mt7921e/parameters/disable_aspm; do
        [ -r "$p" ] && echo "${p#"$SYS"/sys/module/} = $(cat "$p")"
    done
    run rfkill list
    run lsusb

    section "Sound"
    run pactl info | grep -E '^(Server Name|Default Sink|Default Source)'
    run pactl list short sinks
    run lspci -nnk | grep -A3 -E 'Audio device|Multimedia audio'

    section "Storage"
    run lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
    run df -h -x tmpfs -x devtmpfs -x squashfs -x overlay

    section "Battery & power"
    for b in "$SYS"/sys/class/power_supply/BAT*; do
        [ -d "$b" ] || continue
        echo "${b##*/}: $(cat "$b/status" 2>/dev/null), $(cat "$b/capacity" 2>/dev/null) %," \
             "limit $(cat "$b/charge_control_end_threshold" 2>/dev/null || echo none)"
    done
    echo "Power mode:   $(run powerprofilesctl get)"

    section "Services that failed"
    run systemctl --failed --no-legend --plain
    run systemctl --user --failed --no-legend --plain

    section "Software"
    echo "Broken packages (dpkg --audit):"
    run dpkg --audit
    echo "Held packages: $(run apt-mark showhold | tr '\n' ' ')"
    echo "Flatpak apps:"
    run flatpak list --app --columns=application,version

    section "Simple OS logs (last lines)"
    for f in "${XDG_CACHE_HOME:-$HOME/.cache}"/simpleos*.log; do
        [ -f "$f" ] || continue
        [ "${f##*/}" = simpleos-report.log ] && continue
        printf -- '--- %s\n' "${f##*/}"
        tail -n 60 "$f" 2>/dev/null
    done

    section "Desktop session errors"
    tail -n 80 "$HOME/.xsession-errors" 2>/dev/null || echo "(none)"
    echo "--- Xorg (EE) lines:"
    grep -h '(EE)' "$SYS/var/log/Xorg.0.log" "$HOME/.local/share/xorg/Xorg.0.log" 2>/dev/null | tail -n 40

    section "User session log (warnings and errors, this boot)"
    run journalctl --user -b -p warning -n 150 --no-pager -o short-monotonic
}

# Replace personal data. Words: user name, real name, computer name, saved connections (Wi-Fi names)
redact() {
    real=$(getent passwd "$(id -un 2>/dev/null)" 2>/dev/null | cut -d: -f5 | cut -d, -f1)
    conns=$(timeout 10 nmcli -t -f NAME connection show 2>/dev/null)
    R_USER=$(id -un 2>/dev/null) R_REAL=$real R_HOST=$(hostname 2>/dev/null) R_HOME=$HOME R_CONNS=$conns python3 -c '
import ipaddress, os, re, sys

text = sys.stdin.read()
# Email first – otherwise a rest of "name.x@example.org" would remain after replacing the name
text = re.sub(r"[\w.+-]+@[\w-]+\.[\w.-]+", "<email>", text)
# Words that also appear elsewhere in the report: never replace them ("simple" is the live user)
keep = {"", "simple", "simple-os", "root", "user", "live", "debian", "localhost", "lo"}
words = [(os.environ.get("R_HOME", ""), "/home/<user>")]
words += [(os.environ.get(k, ""), r) for k, r in (("R_REAL", "<name>"), ("R_USER", "<user>"), ("R_HOST", "<hostname>"))]
words += [(c, "<network>") for c in os.environ.get("R_CONNS", "").splitlines() if not c.startswith("Wired connection")]
for w, r in sorted(words, key=lambda x: -len(x[0])):
    w = w.strip()
    if len(w) < 3 or w.lower() in keep or w in ("/home", "/root"):
        continue
    # Whole words; paths (/home/name) also in the middle of a line
    pat = re.escape(w) if w.startswith("/") else r"(?<![\w-])" + re.escape(w) + r"(?![\w-])"
    text = re.sub(pat, r, text)

text = re.sub(r"\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\b", "XX:XX:XX:XX:XX:XX", text)
text = re.sub(r"(?i)(serial(?:\s*number)?\s*[:=]\s*)\S+", r"\1<removed>", text)

def v4(m):
    s = m.group(0)
    try:
        a = ipaddress.IPv4Address(s)
    except ValueError:
        return s
    return s if a.is_loopback or a.is_unspecified or s.startswith("255.") else "<ip>"
# no version numbers (1.2.5.1-2, v1.2.3.4, 1.2.3.4.5): neither a letter nor a hyphen nor another number with a
# dot before/after it; a full stop at the end ("from 192.168.1.1.") does not count
text = re.sub(r"(?<![\w-])(?<!\d\.)\d{1,3}(?:\.\d{1,3}){3}(?![\w-])(?!\.\d)", v4, text)

def v6(m):
    s = m.group(0)
    core = s.split("/")[0].split("%")[0]
    try:
        a = ipaddress.IPv6Address(core)
    except ValueError:
        return s
    return s if a.is_loopback or a.is_unspecified else "<ip6>"
text = re.sub(r"(?<![\w:.])[0-9A-Fa-f]{0,4}(?::[0-9A-Fa-f]{0,4}){2,7}(?:/\d+|%\w+)?(?![\w:])", v6, text)
sys.stdout.write(text)
'
}

# $1 = 1: with the system log (pkexec). Output cleaned on stdout.
report() {
    tmp=$(mktemp) || return 1
    collect > "$tmp" 2>&1
    if [ "$1" = 1 ]; then
        section "System log (needs password)" >> "$tmp"
        if ! command -v pkexec >/dev/null; then
            echo "(pkexec missing)" >> "$tmp"
        else
            pkexec "$HELPER" >> "$tmp" 2>&1; rc=$?
            case "$rc" in
                0) ;;
                126|127) echo "(not included – no password entered)" >> "$tmp"; SOS_NOPW=1 ;;
                *) echo "(system log could not be read, exit $rc)" >> "$tmp" ;;
            esac
        fi
    fi
    if command -v python3 >/dev/null; then
        redact < "$tmp"
    else
        # Without python3 better save nothing than something uncleaned
        sos_log "python3 missing – report not created"
        rm -f "$tmp"; return 1
    fi
    rm -f "$tmp"
}

desktop_dir() {
    [ -n "${SIMPLEOS_REPORT_DIR:-}" ] && { echo "$SIMPLEOS_REPORT_DIR"; return; }
    d=$(xdg-user-dir DESKTOP 2>/dev/null)
    [ -n "$d" ] && [ "$d" != "$HOME" ] && [ -d "$d" ] && { echo "$d"; return; }
    [ -d "$HOME/Desktop" ] && { echo "$HOME/Desktop"; return; }
    echo "$HOME"
}

open_url() { command -v simpleos-browser >/dev/null && setsid simpleos-browser "$1" >/dev/null 2>&1 & }

case "${1:-}" in
    --collect)
        sys=0
        case "${2:-}" in --system) sys=1 ;; "") ;; *) echo "Usage: simpleos-report --collect [--system]" >&2; exit 2 ;; esac
        report "$sys"; exit 0 ;;
    --url) issue_url || exit 1; exit 0 ;;
    --redact) redact; exit 0 ;;
    "") ;;
    *) echo "Usage: simpleos-report [--collect [--system] | --url | --redact]" >&2; exit 2 ;;
esac

command -v rofi >/dev/null || { sos_log "rofi missing"; sos_rofi_failed; }
# FontAwesome 4: file-text U+F15C, lock U+F023, globe U+F0AC, arrow-left U+F060
I_FILE='\357\205\234' I_LOCK='\357\200\243' I_GLOBE='\357\202\254' I_BACK='\357\201\240'
url=$(issue_url)
sos_add "$(sos_fa "$I_LOCK")  Create report  $(sos_dim "includes system logs – asks for your password")" "report${TAB}1"
sos_add "$(sos_fa "$I_FILE")  Create report without system logs" "report${TAB}0"
[ -n "$url" ] && sos_add "$(sos_fa "$I_GLOBE")  Open the issue page only" "web"
sos_add "$(sos_fa "$I_BACK")  Cancel" "cancel"
sos_pick "<b>Report a problem</b>
$(sos_dim "Saves details about this computer to a text file you can attach.")
$(sos_dim "Your name, user name, network names and addresses are removed.")" 560

case "$action" in
    web) open_url "$url"; exit 0 ;;
    report) ;;
    *) exit 0 ;;
esac

dir=$(desktop_dir)
file="$dir/simpleos-report-$(date +%Y%m%d-%H%M).txt"
sos_notify "Collecting details… this takes a few seconds." low
SOS_NOPW=0
if ! report "$arg1" > "$file" || [ ! -s "$file" ]; then
    rm -f "$file"
    sos_notify "The report could not be created. Details: ~/.cache/simpleos-report.log" critical
    exit 0
fi
sos_log "saved $file"
name=${file##*/}
where="Desktop"
[ "$dir" = "$HOME" ] && where="Home folder"
[ "$SOS_NOPW" = 1 ] && name="$name (without system logs – no password entered)"
if [ -n "$url" ]; then
    open_url "$url"
    sos_notify "Saved to your $where: $name
Drag this file into the issue page that just opened."
else
    command -v thunar >/dev/null && { setsid thunar "$dir" >/dev/null 2>&1 & }
    sos_notify "Saved to your $where: $name"
fi
exit 0
