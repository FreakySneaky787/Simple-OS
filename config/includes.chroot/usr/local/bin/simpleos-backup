#!/bin/sh
# Simple OS – backups / restore points (Menu → System → Backups, Control Center → System)
# Rofi window:
#   "Create restore point now"                   asks for a name (optional), then the pkexec password
#   "Restore point before updates: On/Off"       a point before every system update (Settings → Software Updates)
#   below the existing points ("1 Oct 2026, 14:30 · Before system update"); click -> Restore…,
#   Check, Delete, Back. Restore asks twice and explains: the system is reset, personal files
#   in /home stay, the PC restarts afterwards.
# The root helper /usr/local/sbin/simpleos-backup-helper (timeshift) does the actual work.
# Live session: "Backups can only be created on an installed system." instead of the menu (simpleos-live --check).
# The first time it is opened the helper sets up timeshift itself (target device = partition of "/", RSYNC).
# Errors are told apart: live system, no target device, not enough space, other error (then without
# a guess about the space, details in the log). At most ONE result notification per action: not enough
# space -> only the space warning (checked before creating, "helper --space"), other error -> only the hint
# to the log; after that no further error notifications in this run.
# simpleos-progress shows long actions (create, restore, delete) as a plain progress window with a live bar
# (percent and time left from timeshift, section, duration), without showing a dunst bar.
# Robust like simpleos-wifi: no set -e, exit 0, errors as a notification, details in ~/.cache/simpleos-backup.log.
#   simpleos-backup              window
#   simpleos-backup --create     create a point right away (Control Center "Create now")

SOS_NAME=simpleos-backup SOS_TITLE=Backups SOS_ICON=document-save SOS_PROMPT=Backups
TAB=$(printf '\t')
HELPER=/usr/local/sbin/simpleos-backup-helper
LIB=/usr/local/lib/simpleos/common.sh
[ -r "$LIB" ] || { notify-send "Backups" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"

LIVE_MSG="Backups can only be created on an installed system."
if [ -x /usr/local/bin/simpleos-live ] && /usr/local/bin/simpleos-live --check; then
    sos_notify "$LIVE_MSG"
    exit 0
fi
command -v pkexec >/dev/null || { sos_notify "Backups are not available (pkexec missing)." critical; exit 0; }

# helper ARGS… -> output in $HOUT, exit code in $hrc (126 = password cancelled). Do not call it in $(…),
# otherwise both would be lost in the subshell.
helper() {
    HOUT=$(pkexec "$HELPER" "$@" 2>>"$SOS_LOG"); hrc=$?
}
# helper_live "title" "success title" "hint" ARGS… – like helper, but with a progress window
# (simpleos-progress reads the helper's live lines STEP/STAGE/PROGRESS from $pout; without a display as a
# dunst notification with a bar). The window shows no errors – the one result notification comes from explain.
# Returns 1 = ran without a progress display (the caller then reports "running…" itself).
PROGRESS=/usr/local/bin/simpleos-progress
helper_live() {
    ptitle=$1 pdone=$2 phint=$3; shift 3
    if [ ! -x "$PROGRESS" ] || ! pout=$(mktemp); then helper "$@"; return 1; fi
    "$PROGRESS" --follow "$pout" --title "$ptitle" --done "$pdone" --hint "$phint" --app "$SOS_TITLE" --icon-name "$SOS_ICON" \
        --pid $$ 2>>"$SOS_LOG" &
    ppid=$!
    pkexec "$HELPER" "$@" >"$pout" 2>>"$SOS_LOG"; hrc=$?
    HOUT=$(cat "$pout")
    echo "EXIT: $hrc" >> "$pout"
    wait "$ppid" 2>/dev/null   # success: let the full bar stand briefly, only then "Restore point created."
    rm -f "$pout"
    return 0
}
# Bytes -> "3.2 GB" (from 999.5 MB, one decimal place, rounded half up, ".0" dropped) or "480 MB"
# – never "0.0 GB"
size() {
    awk -v b="$1" 'BEGIN {
        if (b >= 999.5e6) { v = int(b / 1e8 + 0.5) / 10; s = sprintf("%.1f", v); sub(/\.0$/, "", s); printf "%s GB", s }
        else printf "%d MB", int(b / 1e6 + 0.5) }'
}
REPORTED=0   # an error notification was already shown -> no second one in this run
explain() {  # the helper's exit code -> exactly one notification ($1 = text for other errors, without guessing the cause)
    [ "$hrc" -eq 0 ] && return 0
    [ "$REPORTED" = 1 ] && { sos_log "further notification suppressed (exit $hrc): $1"; return 1; }
    REPORTED=1
    case "$hrc" in
        126|127) sos_notify "No password entered – nothing was changed." ;;
        3) sos_notify "Backups need the program Timeshift, which is missing." critical ;;
        4) sos_notify "$LIVE_MSG" ;;
        5) sos_notify "No backup location is set up: the system partition could not be found. Restore points need Simple OS installed on a disk." critical ;;
        6) free=$(printf '%s\n' "$HOUT" | sed -n 's/^FREE: *//p' | head -n 1)
           need=$(printf '%s\n' "$HOUT" | sed -n 's/^NEED: *//p' | head -n 1)
           if sos_is_num "$free" && sos_is_num "$need"; then
               sos_notify "Not enough free space for a restore point: $(size "$free") free, at least $(size "$need") needed. Free up space with the Storage Cleaner." critical
           elif sos_is_num "$free"; then
               sos_notify "Not enough free space for a restore point: $(size "$free") free, but Timeshift needs more for this one. Free up space with the Storage Cleaner." critical
           else
               sos_notify "Not enough free space for a restore point – Timeshift reports the backup disk is too full. Free up space with the Storage Cleaner." critical
           fi ;;
        *) sos_notify "$1 Details: ~/.cache/simpleos-backup.log" critical ;;
    esac
    return 1
}
# 2026-10-01_14-30-00 -> "1 Oct 2026, 14:30"
pretty() {
    d=${1%_*} hm=$(printf '%s' "${1#*_}" | cut -d- -f1,2 | tr - :)
    date -d "$d $hm" '+%-d %b %Y, %H:%M' 2>/dev/null || echo "$1"
}
create() {
    # Check space/device first (one password, pkexec remembers it), only then report "Creating…"
    helper --space
    explain "The restore point could not be created." || return 1
    helper_live "Creating a restore point" "Restore point created" \
        "The first one takes 10–20 minutes · you can keep working" --create "${1:-Restore point}" ||
        sos_notify "Creating a restore point. The first one copies the whole system and can take 10–20 minutes." low
    explain "The restore point could not be created." || return 1
    sos_notify "Restore point created."
}

if [ "${1:-}" = --create ]; then create "Restore point"; exit 0; fi
command -v rofi >/dev/null || { sos_log "rofi missing"; sos_rofi_failed; }

# FontAwesome 4: plus U+F067, history U+F1DA, clock U+F017, check U+F00C, trash U+F1F8, arrow-left U+F060,
# undo U+F0E2, shield U+F132
I_PLUS='\357\201\247' I_HIST='\357\207\232' I_CLOCK='\357\200\227' I_CHECK='\357\200\214' I_TRASH='\357\207\270'
I_BACK='\357\201\240' I_UNDO='\357\203\242' I_SHIELD='\357\204\262'

point_menu() {  # $1 name, $2 display text
    sos_add "$(sos_fa "$I_UNDO")  Restore this point…" "restore"
    sos_add "$(sos_fa "$I_CHECK")  Check" "check"
    sos_add "$(sos_fa "$I_TRASH")  Delete" "delete"
    sos_add "$(sos_fa "$I_BACK")  Back" "back"
    sos_pick "<b>$(sos_esc "$2")</b>" 420
    case "$action" in
        restore)
            sos_add "$(sos_fa "$I_UNDO")  Yes, restore and restart" "yes"
            sos_add "$(sos_fa "$I_BACK")  Cancel" "no"
            sos_pick "<b>Restore $(sos_esc "$2")?</b>   $(sos_dim "System files go back to that point · your personal files stay · the computer restarts")" 620
            [ "$action" = yes ] || return
            helper_live "Restoring $2" "Restored – restarting" \
                "Don't turn off the computer – it restarts by itself when done" --restore "$1" ||
                sos_notify "Restoring… Don't turn off the computer. It restarts by itself when done."
            explain "The restore point could not be restored. Nothing was changed." ;;
        check)
            helper --check "$1"
            explain "This restore point is damaged or incomplete. Create a new one." || return
            case "$HOUT" in
                ok)     sos_notify "This restore point is complete." low ;;
                listed) sos_notify "This restore point is listed by Timeshift (stored on another disk)." low ;;
            esac ;;
        delete)
            helper_live "Deleting $2" "Restore point deleted" "Only this restore point is removed" --delete "$1"
            explain "The restore point could not be deleted." && sos_notify "Restore point deleted." low ;;
    esac
}

while :; do
    helper --list
    # after an error notification (e.g. not enough space) end silently instead of a second notification
    explain "The restore points could not be read." || exit 0
    points=$HOUT
    helper --auto status
    auto=$HOUT
    sos_add "$(sos_fa "$I_PLUS")  Create restore point now" "create"
    if [ "$auto" = on ]; then
        sos_add "$(sos_fa "$I_SHIELD")  Restore point before updates  $(sos_dim "On")" "auto${TAB}off"
    else
        sos_add "$(sos_fa "$I_SHIELD")  Restore point before updates  $(sos_dim "Off")" "auto${TAB}on"
    fi
    n=0
    while IFS="$TAB" read -r name tags comment; do
        [ -n "$name" ] || continue
        n=$((n + 1))
        label=$(pretty "$name")
        sos_add "$(sos_fa "$I_HIST")  $(sos_esc "$label")  $(sos_dim "${comment:-Restore point}")" "point$TAB$name$TAB$label"
    done <<EOF
$points
EOF
    [ "$n" -gt 0 ] || sos_add "$(sos_fa "$I_CLOCK")  No restore points yet" "noop"
    sos_pick "<b>Backups</b>   $(sos_dim "$n restore point$( [ "$n" -eq 1 ] || echo s) · system files only, not your personal files")" 560
    case "$action" in
        create)
            name=$(printf '' | sos_rofi -dmenu -p "Name" -mesg "<b>Name for the restore point</b>   $(sos_dim "optional, e.g. Before installing drivers")" -markup \
                   -theme-str 'window { width: 520px; } listview { lines: 0; } mainbox { children: [ message, inputbar ]; }')
            # only allowed characters, at most 60
            name=$(printf '%s' "$name" | tr -cd '[:alnum:] .,:()_-' | cut -c1-60)
            create "${name:-Restore point}" ;;
        auto)  helper --auto "$arg1"; explain "The setting could not be changed." ;;
        point) point_menu "$arg1" "$arg2" ;;
        noop)  ;;
        *)     break ;;
    esac
done
exit 0
