#!/bin/sh
# Simple OS – taskbar designer (Control Center → Appearance → Taskbar)
#   simpleos-taskbar-select                  selection via Rofi (position, layout, look, network/clock)
#   simpleos-taskbar-select --set key=value  set directly, e.g. --set position=top --set clock=off
#   simpleos-taskbar-select --apply          apply the settings again (simpleos-theme after dark/light)
# Keys: position=bottom|top  size=full|compact|large  tasks=text|icons  style=dark|transparent|theme
#            network=on|off  clock=on|off
# Only the affected lines in ~/.config/tint2/tint2rc are changed (the accent color from simpleos-theme
# and everything else stays), then tint2 reloads the file via SIGUSR1 in the running process (no restart).
# Display scale (simpleos-scale, #41): scale_relative_to_dpi from simpleos-scale --tint2-ref – tint2 then scales sizes
# and fonts itself; the line is added to an older tint2rc that does not have it yet.
set -e

STATE="$HOME/.config/simpleos/taskbar"
TINT2RC="$HOME/.config/tint2/tint2rc"

position=bottom size=full tasks=text style=dark network=on clock=on
[ -r "$STATE" ] && . "$STATE"

# Real battery (BAT*, type Battery, present 1) – VMs/PCs without a battery: no; script missing: also no
has_battery() { simpleos-battery --present 2>/dev/null; }
# Live session (USB stick/ISO) -> badge "Install Simple OS"; script missing: no
is_live() { /usr/local/bin/simpleos-live --check 2>/dev/null; }

valid() {  # $1 = key, $2 = value
    case "$1=$2" in
        position=bottom|position=top|size=full|size=compact|size=large|tasks=text|tasks=icons) return 0 ;;
        style=dark|style=transparent|style=theme|network=on|network=off|clock=on|clock=off) return 0 ;;
    esac
    return 1
}
# Reset broken values in the state file to the default
valid position "$position" || position=bottom
valid size "$size"         || size=full
valid tasks "$tasks"       || tasks=text
valid style "$style"       || style=dark
valid network "$network"   || network=on
valid clock "$clock"       || clock=on

apply() {
    [ -f "$TINT2RC" ] || { echo "No tint2 configuration: $TINT2RC" >&2; exit 1; }
    mkdir -p "$(dirname "$STATE")"
    printf 'position=%s\nsize=%s\ntasks=%s\nstyle=%s\nnetwork=%s\nclock=%s\n' \
        "$position" "$size" "$tasks" "$style" "$network" "$clock" > "$STATE"

    # Colors: Dark / Dark transparent / like the app design (simpleos-theme --mode light -> light bar)
    mode=dark
    [ "$style" = theme ] && mode=$(simpleos-theme --show 2>/dev/null | sed -n 's/^mode=//p')
    panel_alpha=92
    [ "$style" = transparent ] && panel_alpha=60
    if [ "$mode" = light ]; then
        panel="#eff1f5 95" border="#ccd0da 100" fg="#4c4f69 100" dim="#9ca0b0 100"
        task="#ccd0da 60" task_hover="#bcc0cc 90" task_pressed="#acb0be 90"
        btn_hover="#ccd0da 90" btn_pressed="#bcc0cc 90"
    else
        panel="#1e1e2e $panel_alpha" border="#313244 100" fg="#cdd6f4 100" dim="#6c7086 100"
        task="#313244 50" task_hover="#45475a 80" task_pressed="#585b70 80"
        btn_hover="#313244 80" btn_pressed="#45475a 80"
    fi

    # Size and task display
    # Large (#41, asked for on Bluesky: the clock was too small for older eyes): a higher bar, bigger clock and texts –
    # on any screen, independent of the display scale (which scales everything, also this)
    font=10 small=8 icon=13
    case "$size" in
        compact) height=34 task_h=26 tray=16 ;;
        large)   height=48 task_h=38 tray=22 font=12 small=10 icon=16 ;;
        *)       height=40 task_h=30 tray=18 ;;
    esac
    if [ "$tasks" = icons ]; then
        task_text=0 task_centered=1 task_padding="8 4 0" task_w=$((task_h + 16))
    else
        task_text=1 task_centered=0 task_padding="10 4 8" task_w=200
        [ "$size" = compact ] && task_w=160
        [ "$size" = large ] && task_w=240
    fi

    # Bar: app button, tasks, Do Not Disturb icon, [network], [live badge], tray, [battery], [clock], power button
    # tint2 assigns the executor blocks to the "E"s in order: the DND block comes before the network block and
    # is always there (it only shows something while DND is on) -> first E = DND, second E = network
    # Battery only if there really is one: without a battery tint2 reports 0 % and triggers "Battery low",
    # VMs sometimes provide a dummy (present 0)
    # Live badge: tint2 assigns the buttons to the "P"s in order -> the badge block sits between the app and
    # power button and only exists in the live session (otherwise the power slot would get the badge)
    live=0
    is_live && live=1
    items=PTE
    [ "$network" = on ] && items=${items}E
    [ "$live" = 1 ] && items=${items}P
    items=${items}S
    has_battery && items=${items}B
    [ "$clock" = on ] && items=${items}C
    items=${items}P

    # Backgrounds (section "Backgrounds", numbered by "rounded ="): 1 bar, 2 tasks, 6 app button
    bg="1|background_color|$panel;1|background_color_hover|$panel;1|background_color_pressed|$panel"
    bg="$bg;1|border_color|$border;1|border_color_hover|$border;1|border_color_pressed|$border"
    bg="$bg;2|background_color|$task;2|background_color_hover|$task_hover;2|background_color_pressed|$task_pressed"
    bg="$bg;6|background_color_hover|$btn_hover;6|background_color_pressed|$btn_pressed"
    kv="panel_position|$position center horizontal;panel_size|100% $height;panel_items|$items"
    kv="$kv;task_text|$task_text;task_centered|$task_centered;task_padding|$task_padding"
    kv="$kv;task_maximum_size|$task_w $task_h;systray_icon_size|$tray"
    kv="$kv;task_font|Inter Medium $font;execp_font|Inter Medium $font;bat1_font|Inter Medium $font;bat2_font|Inter $small"
    kv="$kv;time1_font|Inter Semibold $font;time2_font|Inter $small;button_font|FontAwesome $icon"
    kv="$kv;task_font_color|$fg;task_active_font_color|$fg;task_urgent_font_color|$fg"
    kv="$kv;task_iconified_font_color|$dim;clock_font_color|$fg;execp_font_color|$fg;battery_font_color|$fg"
    # Date of the clock in the order of the language (#81): "Di, 20. Okt" instead of "Di, Okt 20"
    dates=$(/usr/local/lib/simpleos/date-formats 2>/dev/null) || true
    d_short=$(printf '%s\n' "$dates" | sed -n 's/^short=//p') d_full=$(printf '%s\n' "$dates" | sed -n 's/^full=//p')
    [ -n "$d_short" ] && kv="$kv;time2_format|$d_short"
    [ -n "$d_full" ] && kv="$kv;clock_tooltip|$d_full"
    # Display scale (#41): 0 = off (100 %)
    scale_ref=$(simpleos-scale --tint2-ref 2>/dev/null) || scale_ref=0
    case "$scale_ref" in ""|*[!0-9.]*) scale_ref=0 ;; esac
    kv="$kv;scale_relative_to_dpi|$scale_ref"

    tmp=$(mktemp "$TINT2RC.XXXXXX")
    awk -v bg="$bg" -v kv="$kv" -v live="$live" '
    BEGIN {
        n = split(bg, a, ";"); for (i = 1; i <= n; i++) { split(a[i], f, "|"); B[f[1] SUBSEP f[2]] = f[3] }
        n = split(kv, a, ";"); for (i = 1; i <= n; i++) { split(a[i], f, "|"); K[f[1]] = f[2] }
    }
    # Do Not Disturb: always remove the old block and insert it again before the network block (older tint2rc without
    # the block get it this way on the next --apply). Markers: "End" also matches the old "Ende", "Netzwerk" = old name
    /^#---- Do Not Disturb/ { dskip = 1 }
    dskip { if (/^#---- Do Not Disturb End/) { dskip = 0; eat = 1 } next }
    /^#---- (Netzwerk|Network)/ {
        print "#---- Do Not Disturb (icon only while DND is on; a click toggles it; simpleos-taskbar-select --apply sets the block)"
        print "execp = new"
        print "execp_command = /usr/local/bin/simpleos-dnd --panel"
        print "execp_interval = 0"
        print "execp_continuous = 1"
        print "execp_has_icon = 0"
        print "execp_markup = 1"
        print "execp_font_color = " (("execp_font_color" in K) ? K["execp_font_color"] : "#cdd6f4 100")
        print "execp_padding = 6 4"
        print "execp_background_id = 6"
        print "execp_centered = 1"
        print "execp_tooltip = Do Not Disturb is on – click to turn it off"
        print "execp_lclick_command = /usr/local/bin/simpleos-dnd --toggle"
        print "execp_rclick_command = /usr/local/bin/simpleos-control-center notifications"
        print "#---- Do Not Disturb End"
        print ""
    }
    # Live badge: always remove the old block, insert it again before the power button in the live session ("Power-Button" = old name)
    /^#---- Live-Badge/ { skip = 1 }
    skip { if (/^#---- Live-Badge End/) { skip = 0; eat = 1 } next }
    eat { eat = 0; if ($0 == "") next }      # the empty line after the block belongs to it
    /^#---- Power[- ][Bb]utton/ && live == 1 {
        # an empty line as between all sections; when removing, "eat" takes it along again
        print "#---- Live-Badge (live session only; simpleos-taskbar-select --apply sets/removes it)"
        print "button = new"
        print "button_text = Install Simple OS"
        print "button_font = Inter Bold 10"
        print "button_font_color = #1e1e2e 100"
        print "button_padding = 14 4"
        print "button_background_id = 8"
        print "button_centered = 1"
        print "button_max_icon_size = 0"
        print "button_tooltip = Install Simple OS on this computer"
        print "button_lclick_command = /usr/local/bin/simpleos-install"
        print "#---- Live-Badge End"
        print ""
    }
    # scale_relative_to_dpi missing (tint2rc from before 1.1): at the end of the Panel section
    /^#---- / && in_panel && !have_scale { print "scale_relative_to_dpi = " K["scale_relative_to_dpi"]; have_scale = 1 }
    /^#---- / { in_panel = 0 }
    /^#---- Panel/ { panel = 1; in_panel = 1 }
    /^scale_relative_to_dpi = / { have_scale = 1 }
    in_panel && /^$/ { blank++; next }
    blank { for (; blank > 0; blank--) print "" }
    !panel && /^rounded = / { block++ }
    match($0, /^[a-z0-9_]+ = /) {
        key = substr($0, 1, RLENGTH - 3)
        if (!panel && (block SUBSEP key) in B) { print key " = " B[block, key]; next }
        if (panel && key in K) { print key " = " K[key]; next }
    }
    { print }' "$TINT2RC" > "$tmp"
    cat "$tmp" > "$TINT2RC"   # replace the content, the file (permissions, owner) stays
    rm -f "$tmp"

    if [ -n "$DISPLAY" ]; then
        pkill -USR1 -x tint2 2>/dev/null || { setsid tint2 >/dev/null 2>&1 & }
    fi
}

# ------------------------------------------------------------------ Calls without Rofi
case "${1:-}" in
    --apply) apply; exit 0 ;;
    --set)
        while [ "${1:-}" = --set ] && [ -n "${2:-}" ]; do
            key=${2%%=*} value=${2#*=}
            valid "$key" "$value" || { echo "Invalid: $2" >&2; exit 2; }
            eval "$key=\$value"
            shift 2
        done
        [ $# -eq 0 ] || { echo "Usage: simpleos-taskbar-select [--apply | --set key=value ...]" >&2; exit 2; }
        apply; exit 0 ;;
    "") ;;
    *) echo "Usage: simpleos-taskbar-select [--apply | --set key=value ...]" >&2; exit 2 ;;
esac

# ------------------------------------------------------------------ Rofi
# rofi-retry: grab error -> new attempt, rofi missing/does not start -> notification instead of a silent end
rofi_cmd=/usr/local/lib/simpleos/rofi-retry
[ -x "$rofi_cmd" ] || rofi_cmd=rofi
export SOS_NAME=simpleos-taskbar-select SOS_TITLE=Taskbar
pick() {  # $1 = title, rest = entries; the current value is marked with ●
    title=$1; shift
    printf '%s\n' "$@" | "$rofi_cmd" -dmenu -i -no-custom -p "Taskbar" -mesg "<b>$title</b>" -markup \
        -theme-str 'window { width: 460px; } listview { lines: 7; } element-icon { enabled: false; }' || true
}
mark() { if [ "$1" = "$2" ]; then echo "●  $3"; else echo "○  $3"; fi; }
label() {
    case "$1" in
        bottom) echo Bottom ;; top) echo Top ;; full) echo Full ;; compact) echo Compact ;; large) echo Large ;;
        text) echo "icons + text" ;; icons) echo "icons only" ;;
        dark) echo Dark ;; transparent) echo "Dark transparent" ;; theme) echo "Match theme" ;;
        on) echo on ;; off) echo off ;;
    esac
}

while :; do
    choice=$(pick "Simple OS Taskbar Setup" \
        "Position:  $(label "$position")" \
        "Layout:  $(label "$size"), $(label "$tasks")" \
        "Look:  $(label "$style")" \
        "Network & clock:  network $network, clock $clock" \
        "Reset to defaults")
    case "$choice" in
        Position*)
            case "$(pick "Position" "$(mark "$position" bottom Bottom)" "$(mark "$position" top Top)")" in
                *Bottom) position=bottom ;; *Top) position=top ;; *) continue ;;
            esac ;;
        Layout*)
            case "$(pick "Layout" \
                "$(mark "$size" full "Full (40 px bar)")" "$(mark "$size" compact "Compact (34 px bar)")" \
                "$(mark "$size" large "Large (48 px bar, bigger clock and text)")" \
                "$(mark "$tasks" text "Icons + text")" "$(mark "$tasks" icons "Icons only")")" in
                *Full*) size=full ;; *Compact*) size=compact ;; *Large*) size=large ;;
                *"Icons + text") tasks=text ;; *"Icons only") tasks=icons ;; *) continue ;;
            esac ;;
        Look*)
            case "$(pick "Look" "$(mark "$style" dark "Dark")" "$(mark "$style" transparent "Dark transparent")" \
                "$(mark "$style" theme "Match theme (light or dark like your apps)")")" in
                *"Dark") style=dark ;; *"Dark transparent") style=transparent ;; *"Match theme"*) style=theme ;;
                *) continue ;;
            esac ;;
        Network*)
            case "$(pick "Network & clock (select to switch on/off)" \
                "$(mark "$network" on "Network display (LAN IP)")" "$(mark "$clock" on "Clock")")" in
                *Network*) if [ "$network" = on ]; then network=off; else network=on; fi ;;
                *Clock)    if [ "$clock" = on ]; then clock=off; else clock=on; fi ;;
                *) continue ;;
            esac ;;
        Reset*) position=bottom size=full tasks=text style=dark network=on clock=on ;;
        *) exit 0 ;;
    esac
    apply
done
