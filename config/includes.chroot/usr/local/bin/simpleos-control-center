#!/usr/bin/env python3
"""Simple OS – Control Center (Super+I, Menu → Settings → All Settings).

One window for all settings, the sections on the left, the page on the right:
  Sound        volume, mute, output (speakers/headphones/HDMI), microphone, -> pavucontrol
  Display      scale (simpleos-scale: Automatic/100/125/150/200 %, #41), resolution, refresh rate, several screens,
               night light (simpleos-nightlight)
  Wi-Fi        networks, connect with a password, disconnect, Wi-Fi on/off (functions of the Setup Wizard),
               band of the connected network (Automatic / 5 GHz / 2.4 GHz)
  Bluetooth    on/off, connect/disconnect/remove paired devices, search for and pair devices
  Appearance   light/dark, accent color (simpleos-theme), wallpaper (simpleos-wallpaper)
  Appearance   … + "Dynamic wallpaper (day/night)" (simpleos-wallpaper-schedule)
  Power        turn off the screen after … (simpleos-power), battery, power profile (power-profiles-daemon),
               battery protection (charge only up to 80 % if the laptop supports it), lock/sleep/restart/off
  Mouse & Touchpad  natural scrolling, tap to click, pointer speed (simpleos-input)
  Notifications  Do Not Disturb (simpleos-dnd: pause notifications, optionally without window effects)
  Keyboard     keyboard layout (simpleos-keyboard-setup), keyboard shortcuts (simpleos-help)
  Printers & Scanners  system-config-printer, simple-scan
  Apps         default apps (browser, email, PDF, pictures, music, videos, text, documents, spreadsheets,
               presentations: ~/.config/mimeapps.list and ~/.local/share/applications/defaults.list), startup apps
               (XDG autostart: switch on/off, add, remove)
  Date & Time  time zone, automatic time via timedatectl
  Language & Region  system language and formats (dates, numbers, currency): simpleos-system-setup --locale via pkexec
               (locale-gen, /etc/default/locale, language packs), applies after signing out (#42)
  Storage & Backups  free space, simpleos-cleaner, disks (gnome-disks), restore points (simpleos-backup)
  Password & Security  password, firewall (ufw via the root helper)
  System & Updates  Simple OS version, What's new (simpleos-whats-new), Software Updates, Hardware & Drivers
               (simpleos-drivers: graphics, Wi-Fi, CPU microcode; "Install Recommended Drivers"), Task Manager,
               Setup Wizard, report a problem (simpleos-report)
  Up to 1.0.4 one "System" page held most of the last eight; old page names still work (ALIASES).

  simpleos-control-center [PAGE]   window (on this page; PAGE = a key of PAGES or ALIASES, e.g. wifi, apps, system)
Runs only once (Gtk.Application); a second call brings the window to the front.
Changes go through the same tools as the Rofi flyouts – both always show the same state.
Display changes must be confirmed (15 s, otherwise reverted); saved like in simpleos-display.
Long calls (Wi-Fi search, Bluetooth, connecting) run in the background, the window stays usable.
Test: SIMPLEOS_CC_SELFTEST=1 opens every page once and ends with exit 1 if a Python exception
occurred (99_verify uses that with the GTK Broadway backend, without a screen).
"""
import importlib.machinery
import os
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path

