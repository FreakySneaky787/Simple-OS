PAGES = [("wifi", "Wi-Fi", "network-wireless"), ("bluetooth", "Bluetooth", "bluetooth"),
         ("sound", "Sound", "audio-volume-high"), ("display", "Display", "video-display"),
         ("appearance", "Appearance", "preferences-desktop-theme"),
         ("notifications", "Notifications", "preferences-system-notifications"),
         ("input", "Mouse & Touchpad", "input-mouse"), ("keyboard", "Keyboard", "input-keyboard"),
         ("printers", "Printers & Scanners", "printer"), ("power", "Power", "battery"),
         ("apps", "Apps", "preferences-desktop-default-applications"),
         ("datetime", "Date & Time", "preferences-system-time"),
         ("language", "Language & Region", "preferences-desktop-locale"),
         ("storage", "Storage & Backups", "drive-harddisk"), ("security", "Password & Security", "security-high"),
         ("system", "System & Updates", "computer")]
GROUP_STARTS = {"sound", "input", "apps"}
# Older names and what they open now (simpleos-control-center PAGE from scripts, taskbar clicks …)
ALIASES = {"dnd": "notifications", "time": "datetime", "date": "datetime", "printer": "printers", "backup": "storage",
           "backups": "storage", "firewall": "security", "password": "security", "default-apps": "apps",
           "startup": "apps", "network": "wifi", "about": "system", "updates": "system",
           "region": "language", "locale": "language", "formats": "language"}
WIZARD = "/usr/local/bin/simpleos-welcome-wizard"
HELPER = "/usr/local/sbin/simpleos-system-setup"
UFW_CONF = Path(os.environ.get("SIMPLEOS_UFW_CONF", "/etc/ufw/ufw.conf"))
PROFILES = [("power-saver", "Power saver", "Longer battery life, a bit slower"),
            ("balanced", "Balanced", "Recommended"),
            ("performance", "Performance", "Fastest – uses more power, fans get louder")]
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "simpleos"
ACCENTS = ["blue", "mauve", "pink", "green", "peach", "teal"]
SCREEN_OFF = [(0, "Never"), (5, "5 minutes"), (10, "10 minutes"), (15, "15 minutes"), (30, "30 minutes"),
              (60, "1 hour")]


def cmd(*args, timeout=15, env=None):
    """Run a command; never an exception (missing program, timeout -> code 127/124)."""
    try:
        return subprocess.run(list(args), capture_output=True, text=True, timeout=timeout, env=env)
    except FileNotFoundError:
        return subprocess.CompletedProcess(args, 127, "", f"{args[0]}: not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", f"{args[0]}: timeout")
    except OSError as err:
        return subprocess.CompletedProcess(args, 1, "", str(err))


def spawn(*args):
    try:
        subprocess.Popen(list(args), start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


# ------------------------------------------------------------------ Sound (pactl, like simpleos-volume)
def _c(*args):
    return cmd(*args, env=dict(os.environ, LC_ALL="C"))


def volume(kind="sink"):
    out = _c("pactl", f"get-{kind}-volume", f"@DEFAULT_{kind.upper()}@").stdout
    m = re.search(r"/\s*(\d+)%", out)
    return int(m.group(1)) if m else 0


def muted(kind="sink"):
    return "yes" in _c("pactl", f"get-{kind}-mute", f"@DEFAULT_{kind.upper()}@").stdout


def set_volume(percent, kind="sink"):
    # moving the output slider unmutes (you want to hear it); the microphone stays muted if you muted it
    if kind == "sink":
        _c("pactl", f"set-{kind}-mute", f"@DEFAULT_{kind.upper()}@", "0")
    return _c("pactl", f"set-{kind}-volume", f"@DEFAULT_{kind.upper()}@", f"{int(percent)}%").returncode == 0


def set_mute(on, kind="sink"):
    return _c("pactl", f"set-{kind}-mute", f"@DEFAULT_{kind.upper()}@", "1" if on else "0").returncode == 0


def outputs():
    """[(sink, port, label, active)] – one entry per available port (headphones only when plugged in)."""
    default = _c("pactl", "get-default-sink").stdout.strip()
    result, cur = [], None

    def flush():
        if not cur:
            return
        ports = cur["ports"]
        if not ports:
            result.append((cur["name"], "", cur["desc"], cur["name"] == default))
        for port, pdesc in ports:
            label = f"{cur['desc']} – {pdesc}" if len(ports) > 1 else cur["desc"]
            active = cur["name"] == default and (cur["active"] == port or len(ports) == 1)
            result.append((cur["name"], port, label, active))

    inports = False
    for line in _c("pactl", "list", "sinks").stdout.splitlines():
        if line.startswith("Sink #"):
            flush()
            cur, inports = {"name": "", "desc": "", "ports": [], "active": ""}, False
        elif cur is None:
            continue
        elif line.startswith("\tName: "):
            cur["name"] = line[7:]
        elif line.startswith("\tDescription: "):
            cur["desc"] = line[14:]
        elif line.startswith("\tPorts:"):
            inports = True
        elif line.startswith("\tActive Port: "):
            cur["active"], inports = line[14:], False
        elif line.startswith("\t") and not line.startswith("\t\t"):
            inports = False
        elif inports and line.startswith("\t\t") and not line.startswith("\t\t\t"):
            if "not available" in line:
                continue
            port, _, rest = line[2:].partition(": ")
            cur["ports"].append((port, re.sub(r" \((type|priority):.*$", "", rest)))
    flush()
    return result


def switch_output(sink, port):
    if _c("pactl", "set-default-sink", sink).returncode != 0:
        return False
    if port:
        _c("pactl", "set-sink-port", sink, port)
    for line in _c("pactl", "list", "short", "sink-inputs").stdout.splitlines():
        sid = line.split("\t", 1)[0]
        if sid.isdigit():
            _c("pactl", "move-sink-input", sid, sink)
    return True


# ------------------------------------------------------------------ Display (xrandr, like simpleos-display)
def screens(query=None):
    """[{name, on, primary, pos, modes: [(mode, [rates])], mode, rate}] – only connected outputs."""
    if query is None:
        query = _c("xrandr", "--query").stdout
    result, cur = [], None
    for line in query.splitlines():
        if line and not line[0].isspace():
            cur = None
            f = line.split()
            if len(f) >= 2 and f[1] == "connected":
                geo = next((x for x in f[2:] if re.match(r"^\d+x\d+\+\d+\+\d+$", x)), "")
                pos = "x".join(geo.split("+")[1:3]) if geo else ""
                cur = {"name": f[0], "on": bool(geo), "primary": len(f) > 2 and f[2] == "primary",
                       "pos": pos or "0x0", "modes": [], "mode": "", "rate": ""}
                result.append(cur)
        elif cur is not None and re.match(r"^\s+\d+x\d+", line):
            f = line.split()
            rates = []
            for tok in f[1:]:
                r = tok.replace("*", "").replace("+", "")
                if not r:
                    continue
                rates.append(r)
                if "*" in tok:
                    cur["mode"], cur["rate"] = f[0], r
            # some drivers list a resolution on several lines (e.g. 59.95 on one, 143.97 120.00 on another): merge
            known = next((r for m, r in cur["modes"] if m == f[0]), None)
            if known is None:
                cur["modes"].append((f[0], rates))
            else:
                known.extend(r for r in rates if r not in known)
    return result


def rate_labels(rates, cur=""):
    """[(rate, text)] for the rates of one resolution, one per whole Hz: panels offer 60.00 next to 59.95/59.97 – for
    the user the same "60 Hz" (#78, ThinkPad E16). The current rate stands for its group, otherwise the first one
    xrandr lists (the preferred one comes first). xrandr's own text, so it is exactly the rate that is set."""
    pick = {}
    for r in rates:
        w = int(float(r) + 0.5)   # half up like simpleos-display (round() would make 60.5 -> 60)
        if w not in pick or r == cur:
            pick[w] = r
    return [(r, f"{w} Hz") for w, r in pick.items()]


def pretty(name):
    num = name.rsplit("-", 1)[-1]
    num = f" {num}" if num.isdigit() else ""
    for prefixes, label in ((("eDP", "LVDS", "DSI"), "Built-in display"), (("HDMI",), "HDMI"),
                            (("DP", "DisplayPort"), "DisplayPort"), (("DVI",), "DVI"), (("VGA",), "VGA"),
                            (("Virtual", "qxl", "default", "XWAYLAND"), "Screen")):
        if name.startswith(prefixes):
            return label if label == "Built-in display" else label + num
    return name


def snapshot(scr):
    """xrandr arguments for the current state – the same format as simpleos-display."""
    args = []
    for s in scr:
        if s["on"]:
            args += ["--output", s["name"], "--mode", s["mode"], "--rate", s["rate"], "--pos", s["pos"]]
            if s["primary"]:
                args.append("--primary")
        else:
            args += ["--output", s["name"], "--off"]
    return args


def layout_args(scr, main, kind):
    """Several screens: dup | right | left | only (main only)."""
    by = {s["name"]: s for s in scr}
    args = ["--output", main, "--primary"] if by[main]["on"] else ["--output", main, "--auto", "--primary", "--pos", "0x0"]
    others = [s["name"] for s in scr if s["name"] != main]
    if kind == "dup":
        common = set(m for m, _ in by[main]["modes"])
        for o in others:
            common &= set(m for m, _ in by[o]["modes"])
        best = max(common, key=lambda m: int(m.split("x")[0]) * int(re.sub(r"\D.*", "", m.split("x")[1])),
                   default="")
        if best:
            args = ["--output", main, "--mode", best, "--primary", "--pos", "0x0"]
            for o in others:
                args += ["--output", o, "--mode", best, "--same-as", main]
        else:
            for o in others:
                args += ["--output", o, "--auto", "--same-as", main]
        return args
    prev = main
    for o in others:
        if kind == "only":
            args += ["--output", o, "--off"]
        else:
            args += ["--output", o, "--auto", "--right-of" if kind == "right" else "--left-of", prev]
            prev = o
    return args


def save_display(args):
    try:
        CONFIG.mkdir(parents=True, exist_ok=True)
        (CONFIG / "display").write_text(" ".join(args) + "\n")
        return True
    except OSError:
        return False


SCALES = [("100", "100 %"), ("125", "125 %"), ("150", "150 %"), ("200", "200 %")]


def scale_status():
    """{setting: auto|100|125|150|200, scale: percent in use, recommended: percent} from simpleos-scale --status;
    {} without the tool"""
    out = cmd("simpleos-scale", "--status").stdout
    return dict(l.split("=", 1) for l in out.splitlines() if "=" in l)


def nightlight_status():
    out = cmd("simpleos-nightlight", "--status").stdout.split()
    if len(out) >= 3:
        return out[1], int(out[2]) if out[2].isdigit() else 4000
    return "off", 4000


# ------------------------------------------------------------------ Wi-Fi (nmcli through the Setup Wizard's functions)
def wifi_view(state, nets):
    """What the Wi-Fi page shows. Its own view, not the Setup Wizard's network_view() (that one hides the list while
    online and never offers Disconnect – #76): the list of networks whenever there is Wi-Fi and it is on, online or
    not; the connected network offers Disconnect, every other one Connect (= switch networks). No interface names.
    state = network_state(), nets = wifi_networks() of the wizard.
    Returns: status, hint, rows [(ssid, info, secured, in_use, button text)]"""
    has_wifi, radio, kind = bool(state.get("wifi")), bool(state.get("radio", True)), state.get("kind")
    current = next((n[0] for n in nets if n[3]), "")
    if kind == "wifi":
        status = f"Connected to {current or state.get('name') or 'Wi-Fi'}"
    elif kind == "ethernet":
        status = "Connected with a network cable"
    else:
        status = "Not connected"
    rows = []
    if has_wifi and radio:
        for ssid, signal, secured, in_use in nets:
            word = "Strong signal" if signal >= 70 else "Good signal" if signal >= 40 else "Weak signal"
            rows.append((ssid, "Connected" if in_use else word + (" · needs password" if secured else " · open"),
                         secured, in_use, "Disconnect" if in_use else "Connect"))
    if not has_wifi:
        hint = ("This computer has no Wi-Fi." if kind else
                "This computer has no Wi-Fi. Plug in a network cable – it connects by itself.")
    elif not radio:
        hint = "Wi-Fi is turned off. Turn it on with the switch to see the networks around you."
    elif not rows:
        hint = "No Wi-Fi networks found nearby. Move closer to your router and click Refresh."
    elif any(r[3] for r in rows):
        hint = "To switch, click Connect next to another network."
    else:
        hint = ("Click Connect next to your network and type its password if it asks for one "
                "(often on a sticker on your router).")
    return {"status": status, "hint": hint, "rows": rows}


def disconnect_wifi(nmcli, dev):
    """(ok, message) – nmcli = the wizard's nmcli() (English messages, never raises)."""
    ok = nmcli("device", "disconnect", dev, timeout=30).returncode == 0
    return ok, "Disconnected." if ok else "Could not disconnect. Please try again."


# ------------------------------------------------------------------ Bluetooth (bluetoothctl)
def bt(*args, timeout=15):
    return cmd("bluetoothctl", *args, timeout=timeout)


def bt_state():
    """(adapter present, switched on)"""
    if not re.search(r"^Controller ", bt("list").stdout, re.M):
        return False, False
    return True, "Powered: yes" in bt("show").stdout


BT_KINDS = {"audio-headset": "Headphones", "audio-headphones": "Headphones", "audio-card": "Speaker",
            "audio-speakers": "Speaker", "input-mouse": "Mouse", "input-keyboard": "Keyboard",
            "input-gaming": "Gamepad", "input-tablet": "Tablet", "phone": "Phone", "computer": "Computer"}


def bt_devices(paired=True):
    """[(mac, name, connected, kind, paired, battery % or None)]"""
    out = bt("devices", "Paired").stdout if paired else bt("devices").stdout
    if paired and "Device " not in out:
        out = bt("paired-devices").stdout   # bluez < 5.65
    result = []
    for mac, name in re.findall(r"^Device ([0-9A-Fa-f:]{17}) (.*)$", out, re.M):
        info = bt("info", mac).stdout
        icon = (re.search(r"^\s*Icon: (\S+)", info, re.M) or [None, ""])[1]
        # headphones report it through PipeWire -> BlueZ's battery provider (bluetoothd --experimental, Simple OS 1.0.5)
        bat = re.search(r"^\s*Battery Percentage: 0x[0-9A-Fa-f]+ \((\d+)\)", info, re.M)
        result.append((mac, name, bool(re.search(r"^\s*Connected: yes", info, re.M)),
                       BT_KINDS.get(icon, "Device"), bool(re.search(r"^\s*Paired: yes", info, re.M)),
                       int(bat.group(1)) if bat else None))
    return result


def bt_scan(seconds=10):
    bt("--timeout", str(seconds), "scan", "on", timeout=seconds + 5)
    return [d for d in bt_devices(paired=False) if not d[4] and d[1] != d[0].replace(":", "-")]


def bt_subtitle(kind, connected, battery):
    return kind + (" · Connected" if connected else "") + (f" · Battery {battery} %" if connected and battery is not None else "")


def _agent_running():
    """blueman-applet is BlueZ's default agent: it shows the PIN / passkey / confirmation dialogs."""
    return cmd("pgrep", "-x", "blueman-applet").returncode == 0 and shutil.which("busctl") is not None


def bt_pair(mac):
    if _agent_running():
        # Device1.Pair via D-Bus: the agent answers keyboards (type a code) and phones (confirm a number); a one-shot
        # "bluetoothctl pair" has nobody to answer them
        hcis = sorted(p.name for p in Path("/sys/class/bluetooth").glob("hci[0-9]*"))
        obj = f"/org/bluez/{hcis[0] if hcis else 'hci0'}/dev_{mac.upper().replace(':', '_')}"
        out = cmd("busctl", "--system", "call", "org.bluez", obj, "org.bluez.Device1", "Pair", timeout=95)
        if out.returncode != 0 and "AlreadyExists" not in out.stderr:
            return False
    else:
        out = bt("pair", mac, timeout=40)
        if not re.search(r"successful|AlreadyExists", out.stdout + out.stderr):
            return False
    bt("trust", mac)
    return "successful" in bt("connect", mac, timeout=30).stdout


# ------------------------------------------------------------------ Appearance / Power
def theme_state():
    out = cmd("simpleos-theme", "--show").stdout
    mode = (re.search(r"^mode=(\w+)", out, re.M) or [None, "dark"])[1]
    accent = (re.search(r"^accent=(\w+)", out, re.M) or [None, "blue"])[1]
    return mode, accent


def current_wallpaper():
    conf = Path.home() / ".config/pcmanfm/default/desktop-items-0.conf"
    try:
        m = re.search(r"^wallpaper=(.+)$", conf.read_text(), re.M)
        return m.group(1) if m else ""
    except OSError:
        return ""


def screen_off():
    m = re.search(r"screen_off=(\d+)", cmd("simpleos-power", "--get").stdout)
    return int(m.group(1)) if m else 10


def charge_limit():
    """on | off | unsupported (battery protection via simpleos-power)"""
    m = re.search(r"charge_limit=(\w+)", cmd("simpleos-power", "--get").stdout)
    return m.group(1) if m else "unsupported"


def brightness_get():
    """Screen brightness in % (simpleos-osd), None without a backlight (desktop monitor, VM)"""
    out = cmd("simpleos-osd", "brightness", "get").stdout.strip()
    return int(out) if out.isdigit() else None


def lock_idle():
    """True if the screen locks when it turns off (simpleos-power --lock)"""
    return cmd("simpleos-power", "--lock", "status").stdout.strip() != "off"


def power_profile():
    """(current, [available]) via simpleos-power; ("unsupported", []) without power-profiles-daemon"""
    out = cmd("simpleos-power", "--profile").stdout
    cur = (re.search(r"^current=(\S+)", out, re.M) or [None, "unsupported"])[1]
    avail = (re.search(r"^available=(.*)$", out, re.M) or [None, ""])[1].split()
    return cur, avail


def firewall_on():
    """ufw loads its rules at boot only with ENABLED=yes (the file is readable by everyone, ufw status would need root)"""
    try:
        return re.search(r"^ENABLED=yes\s*$", UFW_CONF.read_text(), re.M) is not None
    except OSError:
        return False


def drivers_report():
    import json
    r = cmd("simpleos-drivers", "--json", timeout=30)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else RuntimeError("simpleos-drivers failed")


def keyboard_layouts():
    """[(layout:variant, name)] from simpleos-keyboard-setup --list"""
    out = cmd("simpleos-keyboard-setup", "--list").stdout
    return [tuple(l.split("\t", 1)) for l in out.splitlines() if "\t" in l]


def keyboard_current():
    l, _, v = cmd("simpleos-keyboard-setup", "--status").stdout.rstrip("\n").partition("\t")
    return f"{l or 'us'}:{v}"


def input_status():
    """{touchpad: yes|no, mouse: yes|no, natural, tap, tspeed, mnatural, mspeed} from simpleos-input --status"""
    out = cmd("simpleos-input", "--status").stdout
    return dict(l.split("=", 1) for l in out.splitlines() if "=" in l)


def clock_info():
    """(time zone, automatic time on, can use NTP, clock synchronized) via timedatectl"""
    out = _c("timedatectl", "show", "-p", "Timezone", "-p", "NTP", "-p", "CanNTP", "-p", "NTPSynchronized").stdout
    d = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    return d.get("Timezone", ""), d.get("NTP") == "yes", d.get("CanNTP", "yes") == "yes", d.get("NTPSynchronized") == "yes"


GRUB_CFG = os.environ.get("SIMPLEOS_GRUB_CFG", "/boot/grub/grub.cfg")
EFIVARS = os.environ.get("SIMPLEOS_EFIVARS", "/sys/firmware/efi/efivars")


def windows_present():
    """A dual-boot computer with Windows – found without root: GRUB's menu is often readable by root only (the
    installer writes it with mode 0600), so also the UEFI boot entries (efivars can be read by everyone) and, for
    BIOS computers, an NTFS partition on an internal disk (USB drives do not count)"""
    try:
        if "--class windows" in Path(GRUB_CFG).read_text(errors="replace"):
            return True
    except OSError:
        pass
    wbm = "Windows Boot Manager".encode("utf-16-le")
    for f in Path(EFIVARS).glob("Boot[0-9A-F][0-9A-F][0-9A-F][0-9A-F]-8be4df61-93ca-11d2-aa0d-00e098032b8c"):
        try:
            if wbm in f.read_bytes():
                return True
        except OSError:
            continue
    import json
    try:
        disks = json.loads(cmd("lsblk", "-J", "-o", "NAME,FSTYPE,RM,TRAN,TYPE").stdout or "{}").get("blockdevices", [])
    except ValueError:
        return False

    def internal(d):
        return d.get("type") == "disk" and str(d.get("rm")).lower() not in ("1", "true") and d.get("tran") != "usb"
    return any(c.get("fstype") == "ntfs" for d in disks if internal(d) for c in d.get("children") or [])


def local_rtc():
    """True if the hardware clock runs in local time (like Windows) instead of UTC"""
    return _c("timedatectl", "show", "-p", "LocalRTC", "--value").stdout.strip() == "yes"


def timedatectl_cancelled(res):
    """timedatectl after a cancelled password dialog: exit 1, "Access denied" (not pkexec's 126/127)"""
    return getattr(res, "returncode", 1) != 0 and "Access denied" in (getattr(res, "stderr", "") or "")


def timezones():
    return [z.strip() for z in _c("timedatectl", "list-timezones").stdout.splitlines() if z.strip()]


# ------------------------------------------------------------------ Language & Region (#42)
LOCALE_FILE = Path(os.environ.get("SIMPLEOS_LOCALE_FILE", "/etc/default/locale"))
SUPPORTED = Path(os.environ.get("SIMPLEOS_SUPPORTED", "/usr/share/i18n/SUPPORTED"))
I18N_LOCALES = Path(os.environ.get("SIMPLEOS_I18N_LOCALES", "/usr/share/i18n/locales"))


def locale_source(loc):
    """de_CH.UTF-8 -> de_CH, ca_ES.UTF-8@valencia -> ca_ES@valencia (the name of glibc's locale source file)"""
    base, _, mod = loc.partition("@")
    return base.partition(".")[0] + (f"@{mod}" if mod else "")


def locale_key(loc):
    """Spellings of one locale compared: de_DE.UTF-8 = de_DE.utf8 (locale -a, older /etc/default/locale files)"""
    base, _, mod = loc.partition("@")
    name, _, cs = base.partition(".")
    return name + "." + re.sub(r"[^a-z0-9]", "", cs.lower()) + (f"@{mod}" if mod else "")


ISO_CODES = Path(os.environ.get("SIMPLEOS_ISO_CODES", "/usr/share/iso-codes/json"))


def iso_names(file, key, codes):
    """{code: English name} from an iso-codes table, without the "(macrolanguage)"-like additions"""
    import json
    try:
        entries = json.loads((ISO_CODES / file).read_text())[key]
    except (OSError, ValueError, KeyError):
        return {}
    names = {}
    for e in entries:
        for c in codes:
            if c in e:
                names.setdefault(e[c], re.sub(r"\s*\(.*\)$", "", e.get("common_name") or e.get("name", "")))
    return names


def locales():
    """{locale: (language, region)} – every UTF-8 locale Debian knows (SUPPORTED). English names from iso-codes ("German",
    "Switzerland"), the language's own name from glibc's locale source (lang_name "Deutsch") after it: "German – Deutsch".
    All locales of one language code share the same language name (one entry in the list, the countries below)."""
    try:
        lines = SUPPORTED.read_text(errors="replace").splitlines()
    except OSError:
        return {}
    langs = iso_names("iso_639-3.json", "639-3", ("alpha_2", "alpha_3"))
    langs.update({"el": "Greek"})
    countries = iso_names("iso_3166-1.json", "3166-1", ("alpha_2",))
    found, native = [], {}
    for line in lines:
        parts = line.split()
        if len(parts) != 2 or parts[1] != "UTF-8" or "_" not in parts[0]:
            continue
        src = locale_source(parts[0])
        info = {}
        try:
            with open(I18N_LOCALES / src, errors="replace") as fh:
                for l in fh:
                    m = re.match(r'\s*(language|territory|lang_name)\s+"([^"]*)"', l)
                    if m:
                        info.setdefault(m.group(1), re.sub(r"<U([0-9A-Fa-f]{4,8})>",
                                                           lambda u: chr(int(u.group(1), 16)), m.group(2)))
        except OSError:
            pass
        code, _, mod = src.partition("@")
        lang, _, cc = code.partition("_")
        if info.get("lang_name"):
            native.setdefault(lang, info["lang_name"])
        region = countries.get(cc) or info.get("territory") or cc
        found.append((parts[0], lang, info.get("language"), f"{region} ({mod.capitalize()})" if mod else region))
    result = {}
    for loc, lang, glibc_name, region in found:
        name = langs.get(lang) or glibc_name or lang
        own = native.get(lang, "")
        result[loc] = (f"{name} – {own}" if own and own.lower() != name.lower() else name, region)
    return result


def system_locale():
    """(language, formats) of the system (/etc/default/locale): LANG and LC_TIME (the installer and the helper write
    all format variables alike); nothing set -> en_US.UTF-8 like the image"""
    vals = {}
    try:
        for line in LOCALE_FILE.read_text(errors="replace").splitlines():
            k, sep, v = line.partition("=")
            if sep and re.fullmatch(r"[A-Z_]+", k.strip()):
                vals[k.strip()] = v.strip().strip("\"'")
    except OSError:
        pass
    lang = vals.get("LANG") or "en_US.UTF-8"
    return lang, vals.get("LC_TIME") or lang


def format_example(loc):
    """"Thursday, 29 October 2026 · 1,234.56 · €12.50" in the formats of loc; "" if it is not generated (locale -a)"""
    if locale_key(loc) not in {locale_key(l.strip()) for l in cmd("locale", "-a").stdout.splitlines()}:
        return ""
    env = dict(os.environ, LC_ALL=loc)
    full = re.search(r"^full=(.*)$", cmd("/usr/local/lib/simpleos/date-formats", env=env).stdout, re.M)
    date = cmd("date", "+" + (full.group(1) if full else "%x"), env=env).stdout.strip()
    k = dict(re.findall(r'^(\w+)="?(.*?)"?$', cmd("locale", "-k", "LC_NUMERIC", "LC_MONETARY", env=env).stdout, re.M))
    number = f"1{k.get('thousands_sep', '')}234{k.get('decimal_point', '.')}56"
    digits = int(k.get("frac_digits", "2")) if k.get("frac_digits", "2").isdigit() else 2
    amount = f"1{k.get('mon_thousands_sep', '')}234" + (f"{k.get('mon_decimal_point', '.')}{'50'[:digits]:0<{digits}}"
                                                        if 0 < digits < 9 else "")
    sym, space = k.get("currency_symbol", ""), " " if k.get("p_sep_by_space") == "1" else ""
    money = f"{sym}{space}{amount}" if k.get("p_cs_precedes", "1") == "1" else f"{amount}{space}{sym}"
    return " · ".join(x for x in (date, number, money if sym else "") if x)


def dnd_on():
    return cmd("simpleos-dnd", "--status").stdout.strip() == "on"


def dnd_no_effects():
    return cmd("simpleos-dnd", "--no-effects", "status").stdout.strip() == "on"


def dynamic_wallpaper_on():
    return cmd("simpleos-wallpaper-schedule", "--status").stdout.split("\n")[0].strip() == "on"


def dynamic_theme_on():
    return "theme=on" in cmd("simpleos-wallpaper-schedule", "--status").stdout.split()


def disk_usage(path="/"):
    """(used, total) in bytes"""
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        return total - st.f_bavail * st.f_frsize, total
    except OSError:
        return 0, 0


def human(n):
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000


def battery_text():
    if cmd("simpleos-battery", "--present").returncode != 0:
        return ""
    ps = os.environ.get("SIMPLEOS_POWER_SUPPLY", "/sys/class/power_supply")
    for bat in sorted(Path(ps).glob("BAT*")):
        try:
            cap = (bat / "capacity").read_text().strip()
            status = (bat / "status").read_text().strip()
            return f"{cap}% · {status.replace('Discharging', 'On battery').replace('Not charging', 'Plugged in')}"
        except OSError:
            continue
    return ""


def live_session():
    return cmd("/usr/local/bin/simpleos-live", "--check").returncode == 0


# simpleos-power --lock-now = dm-tool lock, noted so that xss-lock and the sleep hook do not lock a second time (#96)
LOCK_NOW = ("/usr/local/bin/simpleos-power", "--lock-now")


def power_action(what):
    if what == "lock":
        return cmd(*LOCK_NOW).returncode == 0 or cmd("loginctl", "lock-session").returncode == 0
    if what == "sleep" and not live_session():   # live session: password unknown -> do not lock
        cmd(*LOCK_NOW)
    verb = {"sleep": "suspend", "restart": "reboot", "shutdown": "poweroff"}[what]
    return cmd("systemctl", verb).returncode == 0 or cmd("loginctl", verb).returncode == 0


def os_version():
    """Simple OS version from os-release ("1.0.5"), "" if unknown"""
    for f in (os.environ.get("SIMPLEOS_OS_RELEASE", "/etc/os-release"), "/usr/lib/os-release"):
        try:
            m = re.search(r'^VERSION_ID="?([^"\n]*)"?$', Path(f).read_text(), re.M)
            if m:
                return m.group(1)
        except OSError:
            continue
    return ""


# ------------------------------------------------------------------ Apps: default apps, startup apps
def read_desktop(path):
    """Keys of the [Desktop Entry] group of a .desktop file ({} if unreadable); not localized"""
    entry, inside = {}, False
    try:
        lines = Path(path).read_text(errors="replace").splitlines()
    except OSError:
        return {}
    for line in lines:
        line = line.strip()
        if line.startswith("["):
            inside = line == "[Desktop Entry]"
        elif inside and "=" in line and not line.startswith("#"):
            k, _, v = line.partition("=")
            entry.setdefault(k.strip(), v.strip())
    return entry


def _true(entry, key):
    return entry.get(key, "").lower() == "true"


def app_dirs():
    """applications folders in XDG order (user first), Flatpak exports included"""
    home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    dirs = [home] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    dirs += [home + "/flatpak/exports/share", "/var/lib/flatpak/exports/share"]
    return [Path(d) / "applications" for d in dict.fromkeys(dirs) if d]


def installed_apps():
    """{desktop id: entry} – the first file of an id counts (a user copy hides the system one)"""
    apps = {}
    for d in app_dirs():
        for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
            if f.name in apps:
                continue
            e = read_desktop(f)
            if e.get("TryExec") and not shutil.which(e["TryExec"]):
                e["Hidden"] = "true"
            apps[f.name] = e
    return {k: e for k, e in apps.items() if e.get("Type") == "Application" and not _true(e, "Hidden")}


def mime_types(entry):
    return [m for m in entry.get("MimeType", "").split(";") if m]


# Office files (#75): no common prefix – the family is listed. Only the apps that can open the main type are offered.
OOXML = "application/vnd.openxmlformats-officedocument."
DOCUMENTS = ("application/vnd.oasis.opendocument.text", "application/vnd.oasis.opendocument.text-template",
             OOXML + "wordprocessingml.document", OOXML + "wordprocessingml.template", "application/msword",
             "application/vnd.ms-word.document.macroEnabled.12", "application/vnd.ms-word.template.macroEnabled.12",
             "application/rtf", "text/rtf")
SPREADSHEETS = ("application/vnd.oasis.opendocument.spreadsheet", "application/vnd.oasis.opendocument.spreadsheet-template",
                OOXML + "spreadsheetml.sheet", OOXML + "spreadsheetml.template", "application/vnd.ms-excel",
                "application/vnd.ms-excel.sheet.macroEnabled.12", "application/vnd.ms-excel.sheet.binary.macroEnabled.12",
                "text/csv")
PRESENTATIONS = ("application/vnd.oasis.opendocument.presentation",
                 "application/vnd.oasis.opendocument.presentation-template", OOXML + "presentationml.presentation",
                 OOXML + "presentationml.slideshow", OOXML + "presentationml.template", "application/vnd.ms-powerpoint",
                 "application/vnd.ms-powerpoint.presentation.macroEnabled.12")
# (key, title, subtitle, main type, family: a prefix ("image/") or a tuple of types – the whole family follows the choice;
# "" = the types Simple OS opens with the same app as the main type)
DEFAULT_APPS = [("browser", "Web browser", "Links and web pages", "x-scheme-handler/https", ""),
                ("mail", "Email", "Opens “send an email” links", "x-scheme-handler/mailto", ""),
                ("pdf", "PDF documents", None, "application/pdf", ""),
                ("image", "Pictures", None, "image/jpeg", "image/"),
                ("audio", "Music", None, "audio/mpeg", "audio/"),
                ("video", "Videos", None, "video/mp4", "video/"),
                ("text", "Text files", None, "text/plain", ""),
                ("documents", "Documents", "Word and Writer files (.docx, .odt, .doc …)", OOXML + "wordprocessingml.document",
                 DOCUMENTS),
                ("spreadsheets", "Spreadsheets", "Excel and Calc files (.xlsx, .ods, .csv …)", OOXML + "spreadsheetml.sheet",
                 SPREADSHEETS),
                ("presentations", "Presentations", "PowerPoint and Impress files (.pptx, .odp …)",
                 OOXML + "presentationml.presentation", PRESENTATIONS)]
SYSTEM_MIMEAPPS = os.environ.get("SIMPLEOS_SYSTEM_MIMEAPPS", "/etc/xdg/mimeapps.list")
CHOOSE = "simpleos-choose"   # combo id of "Choose an app…" (desktop ids end in .desktop)


def read_defaults(path):
    """{mime: desktop id} of the [Default Applications] group of a mimeapps.list/defaults.list"""
    result, inside = {}, False
    try:
        lines = Path(path).read_text(errors="replace").splitlines()
    except OSError:
        return {}
    for line in lines:
        line = line.strip()
        if line.startswith("["):
            inside = line == "[Default Applications]"
        elif inside and "=" in line and not line.startswith("#"):
            k, _, v = line.partition("=")
            ids = [i for i in v.split(";") if i.strip()]
            if ids:
                result.setdefault(k.strip(), ids[0].strip())
    return result


def user_mimeapps():
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mimeapps.list"


def user_defaults_list():
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "applications/defaults.list"


def current_default(mime, apps):
    """The app double click / xdg-open uses now: your choice, else Simple OS's – only an installed one"""
    for src in (user_mimeapps(), user_defaults_list(), Path(SYSTEM_MIMEAPPS)):
        app = read_defaults(src).get(mime)
        if app in apps:
            return app
    return ""


def family(group, app_id, apps):
    """Types the choice of APP_ID for GROUP (row of DEFAULT_APPS) is set for: the main type and its relatives
    (listed, same prefix, or the ones Simple OS opens with the same app) that the app can open"""
    _key, _t, _s, main, prefix = group
    system = read_defaults(SYSTEM_MIMEAPPS)
    can = set(mime_types(apps.get(app_id, {})))
    if isinstance(prefix, tuple):
        want = set(prefix) | {main}
    elif prefix:
        want = {m for m in list(system) + list(can) if m.startswith(prefix)}
    else:
        want = {m for m, a in system.items() if a == system.get(main)} | {main}
        if main.startswith("x-scheme-handler/http"):
            want |= {"x-scheme-handler/http", "x-scheme-handler/https", "text/html", "application/xhtml+xml"}
    return sorted(m for m in want if m in can or m == main)


def candidates(group, apps):
    """[(desktop id, name)] that can open the main type of GROUP, sorted by name"""
    main = group[3]
    found = [(i, e.get("Name") or i[:-8]) for i, e in apps.items()
             if main in mime_types(e) and not _true(e, "NoDisplay")]
    if group[0] == "browser":   # browsers that leave out the https scheme in MimeType – a browser takes a link (%u/%U);
        # without that it is a helper in the same category ("Tor Browser Launcher Settings"), and links would open it
        found += [(i, e.get("Name") or i[:-8]) for i, e in apps.items() if "WebBrowser" in e.get("Categories", "")
                  and not _true(e, "NoDisplay") and main not in mime_types(e) and re.search(r"%[uU]", e.get("Exec", ""))]
    return sorted(found, key=lambda x: x[1].lower())


def _set_lines(path, header, pairs):
    """Put "mime=value" lines of PAIRS into group HEADER of an ini-like file, everything else stays"""
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        lines = []
    keys = {k for k, _v in pairs}
    out, inside, done = [], False, False
    for line in lines:
        s = line.strip()
        if s.startswith("["):
            inside = s == header
            out.append(line)
            if inside and not done:   # the new lines right below the group header
                out += [f"{k}={v}" for k, v in pairs]
                done = True
        elif not (inside and "=" in s and s.partition("=")[0].strip() in keys):
            out.append(line)
    if not done:
        out += ([""] if out and out[-1].strip() else []) + [header] + [f"{k}={v}" for k, v in pairs]
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".simpleos-new")
    tmp.write_text("\n".join(out) + "\n")
    tmp.replace(path)


def set_default(group, app_id, apps):
    """Make APP_ID the default for GROUP: ~/.config/mimeapps.list (GIO: Files, browsers …; xdg-mime/xdg-open read it
    first) and ~/.local/share/applications/defaults.list (the older file – Debian's xdg-utils 1.1.3 reads it only after
    all mimeapps.list files; written too, so no tool that reads only that one keeps an old choice)"""
    types = family(group, app_id, apps)
    try:
        _set_lines(user_mimeapps(), "[Default Applications]", [(m, app_id + ";") for m in types])
        _set_lines(user_defaults_list(), "[Default Applications]", [(m, app_id) for m in types])
    except OSError:
        return False
    return True


# Autostart entries Simple OS starts or switches off itself (~/.config/openbox/autostart, /etc/skel overrides) – not
# shown: switching them here would start them twice or break the desktop
AUTOSTART_OWN = {"blueman.desktop", "calamares-desktop-icon.desktop", "nm-applet.desktop", "spice-vdagent.desktop",
                 "xdg-user-dirs.desktop", "xfce4-power-manager.desktop", "lxpolkit.desktop"}


def autostart_dirs():
    """(user folder, [system folders]) – XDG autostart, read by openbox-xdg-autostart at sign-in"""
    user = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "autostart"
    system = [Path(d) / "autostart" for d in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":") if d]
    return user, system


def startup_apps():
    """[(id, name, comment, enabled, own)] – own: only in your autostart folder (can be removed)"""
    user, system = autostart_dirs()
    ids = {}
    for d in [user] + system:
        for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
            ids.setdefault(f.name, []).append(f)
    result = []
    for i, files in ids.items():
        if i in AUTOSTART_OWN:
            continue
        mine = files[0].parent == user
        entry = read_desktop(files[0])
        sys_entry = read_desktop(next((f for f in files if f.parent != user), files[0]))
        info = entry if entry.get("Exec") else sys_entry   # a "Hidden=true" override has no Exec of its own
        # openbox-xdg-autostart runs without a desktop name: OnlyShowIn entries (GNOME, MATE …) never start
        if info.get("OnlyShowIn") or not info.get("Exec") or (info.get("TryExec") and not shutil.which(info["TryExec"])):
            continue
        result.append((i, info.get("Name") or i[:-8], info.get("Comment", ""), not _true(entry, "Hidden"),
                       mine and len(files) == 1))
    return sorted(result, key=lambda x: x[1].lower())


def set_startup(app_id, on):
    """Switch an autostart entry on/off for this account (Hidden=true in ~/.config/autostart)"""
    user, system = autostart_dirs()
    mine = user / app_id
    sysfile = next((d / app_id for d in system if (d / app_id).is_file()), None)
    try:
        if mine.is_file() and read_desktop(mine).get("Exec"):
            _set_lines(mine, "[Desktop Entry]", [("Hidden", "false" if on else "true")])
        elif on:
            mine.unlink(missing_ok=True)   # only our override hid the system entry
        elif sysfile:
            user.mkdir(parents=True, exist_ok=True)
            name = read_desktop(sysfile).get("Name", app_id)
            mine.write_text(f"[Desktop Entry]\nType=Application\nName={name}\n"
                            "# Simple OS: switched off in Control Center → Apps\nHidden=true\n")
        return True
    except OSError:
        return False


def autostart_exec(line):
    """An Exec line without file/URL field codes (%U, %f …) and Flatpak's file-forwarding markers (@@u … @@)"""
    line = re.sub(r"\s+@@u?\s+%[fFuU]\s+@@", "", line)
    line = re.sub(r"\s+@@u?\s+@@", "", line)
    line = re.sub(r"\s+%[fFuUdDnNickvm](?=\s|$)", "", line)
    return line.replace("%%", "%").strip()


def add_startup(app_id, apps):
    """Start an installed app at sign-in: a copy of its .desktop file in ~/.config/autostart"""
    user, _s = autostart_dirs()
    src = next((d / app_id for d in app_dirs() if (d / app_id).is_file()), None)
    if not src or app_id not in apps:
        return False
    try:
        user.mkdir(parents=True, exist_ok=True)
        text = re.sub(r"(?m)^(Hidden|NoDisplay|X-GNOME-Autostart-enabled)=.*\n?", "", src.read_text(errors="replace"))
        # openbox-xdg-autostart runs Exec as it is (sh -c): without this, "mousepad %U" would open a file named "%U"
        text = re.sub(r"(?m)^Exec=.*$", lambda m: "Exec=" + autostart_exec(m.group(0)[5:]), text)
        (user / app_id).write_text(text)
        return True
    except OSError:
        return False


def remove_startup(app_id):
    user, _s = autostart_dirs()
    try:
        (user / app_id).unlink(missing_ok=True)
        return True
    except OSError:
        return False


# ================================================================== Window
def load_gtk():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk
    return GLib, Gtk


def wizard_module():
    try:
        return importlib.machinery.SourceFileLoader("simpleos_wizard", WIZARD).load_module()
    except Exception:  # wizard missing/broken -> the page shows a hint
        return None


def main(argv):
    GLib, Gtk = load_gtk()

    def bg(work, done):
        """work() in the background, then done(result) in the GTK thread."""
        def run():
            try:
                res = work()
            except Exception as err:  # never let the window crash
                res = err
            GLib.idle_add(lambda: (done(res), False)[1])
        threading.Thread(target=run, daemon=True).start()

    def label(text, markup=False, dim=False, wrap=True, xalign=0.0):
        lab = Gtk.Label(xalign=xalign)
        lab.set_line_wrap(wrap)
        if markup:
            lab.set_markup(text)
        else:
            lab.set_text(text)
        if dim:
            lab.get_style_context().add_class("dim-label")
        return lab

    def card(rows):
        """Framed list: rows = [(title, subtitle|None, widget|None)]"""
        box = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        box.get_style_context().add_class("frame")
        for title, sub, widget in rows:
            row = Gtk.Box(spacing=12, margin=10)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            texts.pack_start(label(title), False, False, 0)
            if sub:
                texts.pack_start(label(sub, dim=True), False, False, 0)
            row.pack_start(texts, True, True, 0)
            if widget:
                widget.set_valign(Gtk.Align.CENTER)
                row.pack_end(widget, False, False, 0)
            box.add(row)
        return box

    def button(text, cb, style=None):
        b = Gtk.Button(label=text)
        b.connect("clicked", lambda *_: cb())
        if style:
            b.get_style_context().add_class(style)
        return b

    class Page(Gtk.ScrolledWindow):
        title = ""

        def __init__(self, win):
            super().__init__(hscrollbar_policy=Gtk.PolicyType.NEVER)
            self.win = win
            self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=24)
            Gtk.ScrolledWindow.add(self, self.box)

        def clear(self):
            for child in self.box.get_children():
                self.box.remove(child)
            self.box.pack_start(label(f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(self.title)}</span>", markup=True),
                                False, False, 0)

        def put(self, widget):
            self.box.pack_start(widget, False, False, 0)

        def note(self, text):
            self.put(label(text, dim=True))

        def refresh(self):
            pass

        def show_all_now(self):
            self.box.show_all()

    class SoundPage(Page):
        title = "Sound"

        def refresh(self):
            self.clear()
            if not shutil.which("pactl"):
                self.note("Sound control is not available (pactl missing).")
                return self.show_all_now()
            vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
            vol.set_value(volume())
            vol.set_size_request(260, -1)
            mute = Gtk.Switch(active=muted())
            mute.connect("notify::active", lambda s, _p: set_mute(s.get_active()))

            # dragging fires "value-changed" for every step and set_volume runs pactl: apply only when the slider rests
            # for a moment (otherwise the window stutters)
            pend = {}

            def debounced(widget, kind, after=None):
                def fire():
                    pend.pop(kind, None)
                    set_volume(widget.get_value(), kind)
                    if after:
                        after()
                    return False
                if kind in pend:
                    GLib.source_remove(pend[kind])
                pend[kind] = GLib.timeout_add(150, fire)

            def unmuted():                         # set_volume unmuted the output -> update the switch
                if mute.get_active():
                    mute.set_active(False)
            vol.connect("value-changed", lambda s: debounced(s, "sink", unmuted))
            outs = outputs()
            combo = Gtk.ComboBoxText()
            for i, (sink, port, lab, active) in enumerate(outs):
                combo.append(str(i), lab)
                if active:
                    combo.set_active_id(str(i))

            def changed(c):
                if c.get_active_id() is not None:
                    sink, port, _l, _a = outs[int(c.get_active_id())]
                    switch_output(sink, port)
            combo.connect("changed", changed)
            mic = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
            mic.set_value(volume("source"))
            mic.set_size_request(260, -1)
            mic.connect("value-changed", lambda s: debounced(s, "source"))
            self.put(card([("Volume", None, vol), ("Mute", None, mute),
                           ("Output", "Speakers, headphones, HDMI, Bluetooth" if outs else "No sound output found",
                            combo if outs else None)]))
            self.put(card([("Microphone", None, mic)]))
            self.put(card([("Advanced Audio Settings", "Per-app volume, inputs, profiles",
                            button("Open", lambda: spawn("pavucontrol")))]))
            self.show_all_now()

    class DisplayPage(Page):
        title = "Display"

        def refresh(self):
            self.clear()
            # Scale (#41): bigger text, taskbar, menus and pointer on screens with many pixels
            st = scale_status()
            if st.get("setting"):
                sc = Gtk.ComboBoxText()
                sc.append("auto", f"Automatic ({st.get('recommended', '100')} %)")
                for key, text in SCALES:
                    sc.append(key, text)
                sc.set_active_id(st["setting"])
                sc.connect("changed", lambda c: self.set_scale(c.get_active_id(), st["setting"]))
                self.put(card([("Scale", "Size of text, taskbar, menus and the mouse pointer", sc)]))
            scr = screens()
            if not scr:
                self.note("No display found (xrandr missing or not running in a desktop session).")
            for s in scr:
                res = Gtk.ComboBoxText()
                for m, _r in s["modes"]:
                    res.append(m, m)
                res.set_active_id(s["mode"] or None)
                rate = Gtk.ComboBoxText()

                def fill_rates(_c=None, s=s, res=res, rate=rate):
                    rate.remove_all()
                    rates = dict(s["modes"]).get(res.get_active_id() or "", [])
                    labels = rate_labels(rates, s["rate"])
                    for r, text in labels:
                        rate.append(r, text)
                    rate.set_active_id(s["rate"] if s["rate"] in rates else (labels[0][0] if labels else None))
                fill_rates()
                res.connect("changed", fill_rates)

                def apply(s=s, res=res, rate=rate):
                    args = ["--output", s["name"], "--mode", res.get_active_id() or s["mode"]]
                    if rate.get_active_id():
                        args += ["--rate", rate.get_active_id()]
                    self.apply(args)
                state = ("Main · " if s["primary"] and len(scr) > 1 else "") + (s["mode"] or "Off")
                self.put(label(f"<b>{GLib.markup_escape_text(pretty(s['name']))}</b>  "
                               f"<span alpha='55%'>{state}</span>", markup=True))
                self.put(card([("Resolution", None, res), ("Refresh rate", None, rate),
                               ("", None, button("Apply", apply, "suggested-action"))]))
            if len(scr) > 1:
                main = next((s["name"] for s in scr if s["primary"]), scr[0]["name"])
                lay = Gtk.ComboBoxText()
                for key, text in (("right", "Extend right"), ("left", "Extend left"), ("dup", "Duplicate"),
                                  ("only", f"Only {pretty(main)}")):
                    lay.append(key, text)
                lay.set_active_id("right")
                self.put(card([("Multiple displays", "Like Windows+P",
                                lay), ("", None, button("Apply", lambda: self.apply(
                                    layout_args(scr, main, lay.get_active_id() or "right")), "suggested-action"))]))
            # Brightness of the built-in screen (not every keyboard has brightness keys)
            level = brightness_get()
            if level is not None:
                bright = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 5)
                bright.set_value(level)
                bright.set_size_request(220, -1)
                bpending = [None]

                def apply_brightness():
                    bpending[0] = None
                    cmd("simpleos-osd", "brightness", "set", str(int(bright.get_value())))
                    return False

                def bright_changed(_s):
                    if bpending[0]:
                        GLib.source_remove(bpending[0])
                    bpending[0] = GLib.timeout_add(150, apply_brightness)
                bright.connect("value-changed", bright_changed)
                self.put(label("<b>Brightness</b>", markup=True))
                self.put(card([("Screen brightness", "The brightness keys do the same", bright)]))
            # Night light
            mode, temp = nightlight_status()
            nl = Gtk.ComboBoxText()
            for key, text in (("off", "Off"), ("on", "On"), ("auto", "Automatic (20:00–07:00)")):
                nl.append(key, text)
            nl.set_active_id(mode)
            nl.connect("changed", lambda c: cmd("simpleos-nightlight", f"--{c.get_active_id()}", timeout=20))
            warm = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 3000, 6000, 250)
            warm.set_inverted(True)
            warm.set_value(temp)
            warm.set_size_request(220, -1)
            # every change (mouse, keyboard, mouse wheel) – slightly delayed so dragging does not apply every intermediate value
            pending = [None]

            def apply_warmth():
                pending[0] = None
                cmd("simpleos-nightlight", "--temp", str(int(warm.get_value())), timeout=20)
                return False

            def warm_changed(_s):
                if pending[0]:
                    GLib.source_remove(pending[0])
                pending[0] = GLib.timeout_add(400, apply_warmth)
            warm.connect("value-changed", warm_changed)
            self.put(label("<b>Night light</b>", markup=True))
            self.put(card([("Night light", "Warmer colors in the evening", nl),
                           ("Warmth", "Right = warmer", warm)]))
            self.put(card([("Advanced Display Settings", "Drag screens into place",
                            button("Open", lambda: spawn("arandr") or spawn("lxrandr")))]))
            self.show_all_now()

        def apply(self, args):
            before = snapshot(screens())
            if cmd("xrandr", *args).returncode != 0:
                self.win.error("This display setting is not supported.")
                return
            dialog = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                       text="Keep these display settings?")
            dialog.add_buttons("Revert", Gtk.ResponseType.CANCEL, "Keep changes", Gtk.ResponseType.OK)
            left = [15]

            def tick():
                left[0] -= 1
                if left[0] <= 0:
                    dialog.response(Gtk.ResponseType.CANCEL)
                    return False
                dialog.format_secondary_text(f"Reverting in {left[0]} seconds…")
                return True
            dialog.format_secondary_text("Reverting in 15 seconds…")
            timer = GLib.timeout_add_seconds(1, tick)
            resp = dialog.run()
            GLib.source_remove(timer) if left[0] > 0 else None
            dialog.destroy()
            if resp == Gtk.ResponseType.OK:
                save_display(snapshot(screens()))
            else:
                cmd("xrandr", *before)
            cmd("simpleos-scale", "--refresh", timeout=30)   # the taskbar keeps the display scale (#41)
            self.refresh()

        def set_scale(self, value, current):
            if not value or value == current:
                return

            def done(res):
                self.refresh()
                if getattr(res, "returncode", 1) != 0:
                    return self.win.error("The scale could not be changed.")
                d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.INFO,
                                      text="The scale has changed")
                d.format_secondary_text("Apps that are open, like Firefox or the Terminal, use the new size after you "
                                        "close and open them again. Signing out applies it everywhere.")
                d.add_buttons("OK", Gtk.ResponseType.CANCEL, "Sign out", Gtk.ResponseType.OK)
                if d.run() == Gtk.ResponseType.OK:
                    spawn("openbox", "--exit")
                d.destroy()
            bg(lambda: cmd("simpleos-scale", "--set", value, timeout=60), done)

    class WifiPage(Page):
        title = "Wi-Fi"

        def refresh(self):
            self.clear()
            self.w = wizard_module()
            if not self.w:
                self.note("Wi-Fi settings are not available (Simple OS setup wizard missing).")
                return self.show_all_now()
            spin = Gtk.Spinner(active=True)
            self.put(spin)
            self.note("Searching for networks…")
            self.show_all_now()
            w = self.w

            def work():
                s = w.network_state()
                band = ""
                if s["kind"] == "wifi" and s["name"]:
                    band = w.nmcli("-g", "802-11-wireless.band", "connection", "show", s["name"]).stdout.strip()
                return s, (w.wifi_networks(s["wifi"]) if s["wifi"] and s["radio"] else []), band
            bg(work, self.show)

        def show(self, res):
            self.clear()
            if isinstance(res, Exception):
                self.note(f"Wi-Fi could not be read: {res}")
                return self.show_all_now()
            state, nets, band = res
            self.dev = state["wifi"]
            view = wifi_view(state, nets)
            radio = Gtk.Switch(active=bool(state["radio"]), sensitive=bool(state["wifi"]))
            radio.connect("notify::active", lambda s, _p: bg(
                lambda: self.w.nmcli("radio", "wifi", "on" if s.get_active() else "off"), lambda _r: self.refresh()))
            self.put(card([(view["status"], view["hint"], radio if state["wifi"] else None)]))
            if state["kind"] == "wifi" and state["name"]:
                # Some routers' 5 GHz channel (wide, with radar detection) is unstable: downloads drop to a few kB/s although
                # signal and link rate look perfect; 2.4 GHz is slower at best but steady (found on a Sunrise router)
                combo = Gtk.ComboBoxText()
                for key, text in (("auto", "Automatic"), ("a", "5 GHz only"), ("bg", "2.4 GHz only")):
                    combo.append(key, text)
                combo.set_active_id(band if band in ("a", "bg") else "auto")
                combo.connect("changed", lambda c: self.set_band(state["name"], c.get_active_id()))
                self.put(card([("Wi-Fi band", "If downloads keep dropping to a crawl although the signal is strong, try "
                                "2.4 GHz – the 5 GHz channel of some routers is unstable", combo)]))
            rows = []
            for ssid, info, secured, in_use, act in view["rows"]:
                rows.append((ssid, info, button(act, lambda s=ssid, sec=secured, u=in_use: self.click(s, sec, u),
                                                None if in_use else "suggested-action")))
            if rows:
                self.put(card(rows))
            self.put(card([("Search again", None, button("Refresh", self.refresh)),
                           ("More network options", "Wired, VPN, hidden networks",
                            button("Open", lambda: spawn("nm-connection-editor")))]))
            self.show_all_now()

        def set_band(self, name, key):
            if not key:
                return

            def work():
                r = self.w.nmcli("connection", "modify", name, "802-11-wireless.band", "" if key == "auto" else key)
                if r.returncode != 0:
                    return False
                return self.w.nmcli("--wait", "30", "connection", "up", name, timeout=45).returncode == 0
            bg(work, lambda ok: (None if ok is True else self.win.error("The Wi-Fi band could not be changed.")) or self.refresh())

        def click(self, ssid, secured, in_use, ask=False):
            dev = self.dev   # the Wi-Fi device of the shown list (rows only exist when there is one)
            if in_use:
                return bg(lambda: disconnect_wifi(self.w.nmcli, dev), self.done)
            password = ""
            # ask for the password: a new network – or the saved password just did not work (ask)
            if secured and (ask or ssid not in self.w.saved_networks()):
                password = self.win.ask_password(ssid)
                if password is None:
                    return self.refresh()
            retry = secured and not password   # saved profile tried without a new password

            def done(res):
                if retry and isinstance(res, tuple) and not res[0]:
                    return self.click(ssid, secured, False, ask=True)
                self.done(res)
            bg(lambda: self.w.connect_wifi(dev, ssid, password, secured), done)

        def done(self, res):
            if isinstance(res, tuple) and not res[0]:
                self.win.error(res[1])
            self.refresh()

    class BluetoothPage(Page):
        title = "Bluetooth"

        def refresh(self):
            self.clear()
            if not shutil.which("bluetoothctl"):
                self.note("Bluetooth is not available (bluez missing).")
                return self.show_all_now()
            self.show_all_now()
            bg(lambda: (bt_state(), bt_devices()), self.show)

        def show(self, res):
            self.clear()
            if isinstance(res, Exception):
                self.note(f"Bluetooth could not be read: {res}")
                return self.show_all_now()
            (adapter, powered), devs = res
            if not adapter:
                self.note("No Bluetooth adapter found. Virtual machines and many desktop PCs have none – "
                          "a USB Bluetooth stick adds it.")
                return self.show_all_now()
            sw = Gtk.Switch(active=powered)
            sw.connect("notify::active", lambda s, _p: bg(
                lambda: (cmd("rfkill", "unblock", "bluetooth") if s.get_active() else None,
                         bt("power", "on" if s.get_active() else "off")), lambda _r: self.refresh()))
            self.put(card([("Bluetooth", "On" if powered else "Off", sw)]))
            if powered:
                rows = []
                for mac, name, conn, kind, _p, battery in devs:
                    acts = Gtk.Box(spacing=6)
                    acts.pack_start(button("Disconnect" if conn else "Connect", lambda m=mac, c=conn: bg(
                        lambda: bt("disconnect" if c else "connect", m, timeout=30), lambda _r: self.refresh())),
                        False, False, 0)
                    acts.pack_start(button("Remove", lambda m=mac: bg(lambda: bt("remove", m), lambda _r: self.refresh()),
                                           "destructive-action"), False, False, 0)
                    rows.append((name, bt_subtitle(kind, conn, battery), acts))
                if rows:
                    self.put(label("<b>Your devices</b>", markup=True))
                    self.put(card(rows))
                self.put(card([("Add device", "Put your device in pairing mode first",
                                button("Search", self.scan, "suggested-action"))]))
            self.put(card([("More Bluetooth settings", None, button("Open", lambda: spawn("blueman-manager")))]))
            self.show_all_now()

        def scan(self):
            self.clear()
            self.put(Gtk.Spinner(active=True))
            self.note("Searching for devices (10 seconds)…")
            self.show_all_now()
            bg(lambda: bt_scan(10), self.found)

        def found(self, res):
            self.clear()
            devs = [] if isinstance(res, Exception) else res
            if not devs:
                self.note("Nothing found. Make sure the device is in pairing mode and nearby.")
            else:
                self.put(card([(name, kind, button("Pair", lambda m=mac, n=name: bg(
                    lambda: bt_pair(m), lambda ok, n=n: (None if ok is True else self.win.error(
                        f"Could not pair with {n}. Put it in pairing mode and try again."), self.refresh())),
                    "suggested-action")) for mac, name, _c, kind, _p, _b in devs]))
            self.put(card([("Search again", None, button("Search", self.scan)),
                           ("Back", None, button("Back", self.refresh))]))
            self.show_all_now()

    class AppearancePage(Page):
        title = "Appearance"

        def refresh(self):
            self.clear()
            mode, accent = theme_state()
            dark = Gtk.ComboBoxText()
            dark.append("dark", "Dark")
            dark.append("light", "Light")
            dark.set_active_id(mode)
            acc = Gtk.ComboBoxText()
            for a in ACCENTS:
                acc.append(a, a.capitalize())
            acc.set_active_id(accent)

            def apply_theme(*_):
                bg(lambda: cmd("simpleos-theme", "--mode", dark.get_active_id() or "dark",
                               "--accent", acc.get_active_id() or "blue", timeout=60), lambda _r: None)
            dark.connect("changed", apply_theme)
            acc.connect("changed", apply_theme)
            self.put(card([("Apps", "Dark or light windows", dark),
                           ("Accent color", "Menus, taskbar, window borders", acc)]))
            chooser = Gtk.FileChooserButton(title="Choose a picture", action=Gtk.FileChooserAction.OPEN)
            filt = Gtk.FileFilter()
            filt.set_name("Pictures")
            filt.add_mime_type("image/*")
            chooser.add_filter(filt)
            wp = current_wallpaper()
            if wp and os.path.exists(wp):
                chooser.set_filename(wp)
            pics = Path.home() / "Pictures"
            if pics.is_dir():
                chooser.set_current_folder(str(pics))
            chooser.connect("file-set", lambda c: cmd("simpleos-wallpaper", c.get_filename() or "", timeout=20))
            self.put(card([("Wallpaper", "Or right-click a picture in Files → Set as Wallpaper", chooser),
                           ("Default wallpaper", None,
                            button("Restore", lambda: (cmd("simpleos-wallpaper", "--default"), self.refresh())))]))
            dyn = Gtk.Switch(active=dynamic_wallpaper_on())
            dyn.connect("notify::active", lambda s, _p: bg(
                lambda: cmd("simpleos-wallpaper-schedule", "--on" if s.get_active() else "--off", timeout=30),
                lambda _r: None))
            follow = Gtk.Switch(active=dynamic_theme_on())
            follow.connect("notify::active", lambda s, _p: bg(
                lambda: cmd("simpleos-wallpaper-schedule", "--theme", "on" if s.get_active() else "off", timeout=60),
                lambda _r: self.refresh()))
            self.put(card([("Dynamic wallpaper (day/night)",
                            "Light during the day, dark in the evening and whenever night light is on", dyn),
                           ("Switch light/dark mode with it", "Apps, menus and taskbar follow the wallpaper", follow)]))
            self.put(card([("Taskbar", "Position, size, style",
                            button("Open", lambda: spawn("simpleos-taskbar-select")))]))
            self.show_all_now()

    class InputPage(Page):
        title = "Mouse & Touchpad"

        def refresh(self):
            self.clear()
            if not shutil.which("simpleos-input"):
                self.note("Mouse and touchpad settings are not available (simpleos-input missing).")
                return self.show_all_now()
            st = input_status()
            if st.get("touchpad") != "yes" and st.get("mouse") != "yes":
                self.note("No mouse or touchpad found. Settings for a device appear here once it is connected.")
                return self.show_all_now()
            pend = {}

            def speed_slider(key, cur):
                sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -1, 1, 0.1)
                sc.set_value(float(cur or 0))
                sc.set_size_request(220, -1)
                sc.add_mark(0, Gtk.PositionType.BOTTOM, None)

                def fire():
                    pend.pop(key, None)
                    cmd("simpleos-input", "--set", key, f"{sc.get_value():.1f}")
                    return False

                def moved(_s):   # dragging fires for every step: set the speed when the slider rests
                    if key in pend:
                        GLib.source_remove(pend[key])
                    pend[key] = GLib.timeout_add(150, fire)
                sc.connect("value-changed", moved)
                return sc

            def switch(key, on):
                sw = Gtk.Switch(active=on == "on")
                sw.connect("notify::active", lambda s, _p: cmd("simpleos-input", "--set", key,
                                                               "on" if s.get_active() else "off"))
                return sw
            if st.get("touchpad") == "yes":
                self.put(label("<b>Touchpad</b>", markup=True))
                self.put(card([("Tap to click", "Tap the touchpad instead of pressing it", switch("tap", st.get("tap"))),
                               ("Natural scrolling", "Content follows your fingers, like on a phone – turn off for "
                                "the Windows/classic direction", switch("natural", st.get("natural"))),
                               ("Pointer speed", None, speed_slider("tspeed", st.get("tspeed")))]))
            if st.get("mouse") == "yes":
                self.put(label("<b>Mouse</b>", markup=True))
                self.put(card([("Pointer speed", None, speed_slider("mspeed", st.get("mspeed"))),
                               ("Natural scrolling", "Scroll wheel in the opposite direction",
                                switch("mnatural", st.get("mnatural")))]))
            self.note("Your settings are kept for every device you connect later.")
            self.show_all_now()

    class PowerPage(Page):
        title = "Power"

        def refresh(self):
            self.clear()
            bat = battery_text()
            if bat:
                self.put(card([("Battery", bat, None)]))
            off = Gtk.ComboBoxText()
            for minutes, text in SCREEN_OFF:
                off.append(str(minutes), text)
            cur_off = screen_off()
            # another value (e.g. "simpleos-power --screen-off 20" in a terminal): as its own entry instead of an empty selection
            if not off.set_active_id(str(cur_off)):
                off.append(str(cur_off), f"{cur_off} minutes")
                off.set_active_id(str(cur_off))
            off.connect("changed", lambda c: cmd("simpleos-power", "--screen-off", c.get_active_id() or "10"))
            self.put(card([("Turn off the screen after", "When the computer is not used", off)]))
            lock = Gtk.Switch(active=lock_idle())
            lock.connect("notify::active", lambda sw, _p: cmd("simpleos-power", "--lock",
                                                              "on" if sw.get_active() else "off"))
            self.put(card([("Lock when the screen turns off", "Your password is asked when you come back", lock)]))
            cur, avail = power_profile()
            if cur != "unsupported":
                mode = Gtk.ComboBoxText()
                hints = {}
                for key, text, hint in PROFILES:
                    if key in avail:
                        mode.append(key, text)
                        hints[key] = hint
                mode.set_active_id(cur)
                mode.connect("changed", self.set_profile)
                self.put(card([("Power mode", hints.get(cur, ""), mode)]))
            limit = charge_limit()
            if limit != "unsupported":
                prot = Gtk.Switch(active=limit == "on")
                prot.connect("notify::active", self.set_limit)
                self.put(card([("Battery protection", "Stop charging at about 80 % – the battery lasts longer "
                                "if the laptop is mostly plugged in", prot)]))
            acts = Gtk.Box(spacing=6)
            for key, text, style in (("lock", "Lock", None), ("sleep", "Sleep", None),
                                     ("restart", "Restart", None), ("shutdown", "Shut down", "destructive-action")):
                acts.pack_start(button(text, lambda k=key: self.power(k), style), False, False, 0)
            self.put(card([("Power", None, acts)]))
            self.show_all_now()

        def set_profile(self, combo):
            key = combo.get_active_id()
            if key and cmd("simpleos-power", "--profile", key).returncode != 0:
                self.win.error("The power mode could not be changed.")
            self.refresh()   # subtitle matching the profile

        def set_limit(self, sw, _p):
            want = "on" if sw.get_active() else "off"
            if cmd("simpleos-power", "--charge-limit", want).returncode != 0:
                self.win.error("Battery protection could not be changed.")
                self.refresh()

        def power(self, what):
            if what in ("restart", "shutdown"):
                d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                      buttons=Gtk.ButtonsType.OK_CANCEL,
                                      text="Restart now?" if what == "restart" else "Shut down now?")
                d.format_secondary_text("Save your work first.")
                ok = d.run() == Gtk.ResponseType.OK
                d.destroy()
                if not ok:
                    return
            if not power_action(what):
                self.win.error("That did not work. Please try again.")

    class NotificationsPage(Page):
        title = "Notifications"

        def refresh(self):
            self.clear()
            dnd = Gtk.Switch(active=dnd_on())
            dnd.connect("notify::active", lambda s, _p: bg(
                lambda: cmd("simpleos-dnd", "--on" if s.get_active() else "--off", timeout=30), lambda _r: None))
            quiet = Gtk.Switch(active=dnd_no_effects())
            quiet.connect("notify::active", lambda s, _p: cmd("simpleos-dnd", "--no-effects",
                                                              "on" if s.get_active() else "off"))
            self.put(card([("Do Not Disturb", "Pause notifications until you turn it off", dnd),
                           ("Also turn off window effects", "No shadows or transparency while it is on", quiet)]))
            self.note("While Do Not Disturb is on, the taskbar shows a crossed-out bell – click it to turn Do Not Disturb off again.")
            self.show_all_now()

    class KeyboardPage(Page):
        title = "Keyboard"

        def refresh(self):
            self.clear()
            kb = Gtk.ComboBoxText()
            cur = keyboard_current()
            for key, name in keyboard_layouts():
                kb.append(key, name)
            if not kb.set_active_id(cur):
                kb.append(cur, cur.replace(":", " – ") or "Unknown")
                kb.set_active_id(cur)
            kb.connect("changed", lambda c: c.get_active_id() and bg(
                lambda: cmd("simpleos-keyboard-setup", "--set", c.get_active_id(), timeout=120), lambda _r: None))
            self.put(card([("Keyboard layout", "Applies right away – also on the login screen", kb)]))
            self.put(card([("Keyboard shortcuts", "Super+H shows them at any time",
                            button("Show", lambda: spawn("simpleos-help")))]))
            self.show_all_now()

    class PrintersPage(Page):
        title = "Printers & Scanners"

        def refresh(self):
            self.clear()
            self.put(card([("Printers", "Most printers on your network or USB are found automatically",
                            button("Open", lambda: spawn("system-config-printer"))),
                           ("Scan a document", "Scanners and printers with a scanner",
                            button("Scan", lambda: spawn("simple-scan")))]))
            self.show_all_now()

    class AppsPage(Page):
        title = "Apps"

        def refresh(self):
            self.clear()
            self.put(Gtk.Spinner(active=True))
            self.show_all_now()
            bg(lambda: (installed_apps(), startup_apps()), self.show)

        def show(self, res):
            self.clear()
            if isinstance(res, Exception):
                self.note(f"The apps could not be read: {res}")
                return self.show_all_now()
            apps, startup = res
            self.put(label("<b>Default apps</b>", markup=True))
            self.note("Which app opens a file when you double-click it, or a link.")
            rows = []
            for group in DEFAULT_APPS:
                key, title, sub, main, _prefix = group
                cands = candidates(group, apps)
                cur = current_default(main, apps)
                if not cands:
                    rows.append((title, "No app installed for this yet",
                                 button("Get one…", lambda: spawn("simpleos-software-center"))))
                else:
                    combo = Gtk.ComboBoxText()
                    for i, name in cands:
                        combo.append(i, name)
                    if cur and not combo.set_active_id(cur):
                        combo.append(cur, apps.get(cur, {}).get("Name") or cur[:-8])
                        combo.set_active_id(cur)
                    elif not cur and len(cands) == 1:
                        combo.set_active(0)   # nothing chosen, but the only app that can open it is the one used
                    elif not cur:             # several and nothing chosen (two office suites): not an empty field
                        combo.prepend(CHOOSE, "Choose an app…")
                        combo.set_active(0)
                    combo.connect("changed", lambda c, g=group: self.picked(c, g, apps))
                    rows.append((title, sub, combo))
                if key == "browser":
                    rows.append(("More browsers", "Install Chromium or Mullvad Browser",
                                 button("Choose…", lambda: spawn("simpleos-browser-select"))))
            self.put(card(rows))
            self.put(label("<b>Startup apps</b>", markup=True))
            self.note("Apps that start by themselves when you sign in. Fewer startup apps = a faster start.")
            rows = []
            for i, name, comment, on, own in startup:
                sw = Gtk.Switch(active=on)
                sw.connect("notify::active", lambda s, _p, i=i: set_startup(i, s.get_active()) or
                           self.win.error("This could not be changed."))
                if own:
                    box = Gtk.Box(spacing=6)
                    box.pack_start(sw, False, False, 0)
                    box.pack_start(button("Remove", lambda i=i: (remove_startup(i), self.refresh())), False, False, 0)
                    sw = box
                rows.append((name, comment or None, sw))
            if not rows:
                rows.append(("No startup apps", "Apps like Steam or Discord add themselves here when you allow it", None))
            rows.append(("Add an app", "Start an app every time you sign in", button("Add…", lambda: self.add(apps))))
            self.put(card(rows))
            self.note("Changes count from the next sign-in.")
            self.show_all_now()

        def picked(self, combo, group, apps):
            app_id = combo.get_active_id()
            if not app_id or app_id == CHOOSE:
                return
            if combo.get_model()[0][1] == CHOOSE:   # chosen now: the placeholder goes (picking it again would do nothing)
                combo.remove(0)
            if not set_default(group, app_id, apps):
                self.win.error("The default app could not be changed.")

        def add(self, apps):
            d = Gtk.Dialog(title="Add a startup app", transient_for=self.win, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.OK)
            d.set_default_size(360, -1)
            combo = Gtk.ComboBoxText()
            shown = sorted(((i, e.get("Name") or i[:-8]) for i, e in apps.items()
                            if not _true(e, "NoDisplay") and e.get("Exec")), key=lambda x: x[1].lower())
            for i, name in shown:
                combo.append(i, name)
            combo.set_active(0)
            box = d.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            box.add(label("Which app should start when you sign in?"))
            box.add(combo)
            d.show_all()
            ok = d.run() == Gtk.ResponseType.OK
            app_id = combo.get_active_id()
            d.destroy()
            if ok and app_id:
                if not add_startup(app_id, apps):
                    self.win.error("The app could not be added.")
                self.refresh()

    class DateTimePage(Page):
        title = "Date & Time"

        def refresh(self):
            self.clear()
            tz, ntp, can_ntp, synced = clock_info()
            auto = Gtk.Switch(active=ntp)
            auto.set_sensitive(can_ntp and bool(tz))
            auto.connect("notify::active", self.set_ntp)
            state = "Clock synchronized" if ntp and synced else ("Waiting for the internet…" if ntp else "Set by hand")
            self.put(card([("Set the time automatically", f"From the internet · {state}" if can_ntp else
                            "Not available on this system", auto),
                           ("Time zone", tz.replace("_", " ") if tz else "Unknown",
                            button("Change…", lambda: self.choose_timezone(tz)))]))
            if windows_present():
                win = Gtk.Switch(active=local_rtc())
                win.connect("notify::active", self.set_local_rtc)
                self.put(label("<b>Windows on this computer</b>", markup=True))
                self.put(card([("Keep the clock like Windows does", "Turn this on if the time is off by an hour or "
                                "more after you used Windows (Windows keeps the computer's clock in local time)", win)]))
                self.note("Can't open or change your files on the Windows drive? Windows was not shut down completely. "
                          "In Windows: Control Panel → Power Options → \"Choose what the power buttons do\" → switch off "
                          "\"Turn on fast startup\", then shut Windows down once.")
            self.show_all_now()

        def set_local_rtc(self, sw, _p):
            want = sw.get_active()
            if want == local_rtc():
                return
            sw.set_sensitive(False)

            def done(res):
                if local_rtc() != want and not timedatectl_cancelled(res):
                    self.win.error("The setting could not be changed.")
                self.refresh()
            # the clock is written in the new mode from the current (correct) system time
            bg(lambda: cmd("timedatectl", "set-local-rtc", "true" if want else "false", timeout=120), done)

        def set_ntp(self, sw, _p):
            want = sw.get_active()
            if want == clock_info()[1]:
                return
            sw.set_sensitive(False)

            def done(res):
                # Only the new state counts; password dialog cancelled ("Access denied") -> back silently
                if clock_info()[1] != want and not timedatectl_cancelled(res):
                    self.win.error("The setting could not be changed.")
                self.refresh()
            bg(lambda: cmd("timedatectl", "set-ntp", "true" if want else "false", timeout=120), done)

        def choose_timezone(self, current):
            zones = timezones()
            if not zones:
                return self.win.error("The list of time zones is not available.")
            by = {}
            for z in zones:
                by.setdefault(z.partition("/")[0], []).append(z)
            d = Gtk.Dialog(title="Time zone", transient_for=self.win, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Set", Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.OK)
            d.set_default_size(340, -1)   # at its natural width the title was cut to "T… ne"
            region, city = Gtk.ComboBoxText(), Gtk.ComboBoxText()
            for r in by:
                region.append(r, r.replace("_", " "))

            def fill(_c=None):
                city.remove_all()
                for z in by.get(region.get_active_id() or "", []):
                    city.append(z, z.partition("/")[2].replace("_", " ") or z)
                city.set_active(0)
            region.connect("changed", fill)
            region.set_active_id(current.partition("/")[0] if current.partition("/")[0] in by else next(iter(by)))
            fill()
            city.set_active_id(current)
            box = d.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            box.add(label("Where are you?"))
            box.add(region)
            box.add(city)
            d.show_all()
            ok = d.run() == Gtk.ResponseType.OK
            zone = city.get_active_id()
            d.destroy()
            if not ok or not zone or zone == current:
                return

            def done(res):
                if clock_info()[0] != zone and not timedatectl_cancelled(res):
                    self.win.error("The time zone could not be changed.")
                self.refresh()
            bg(lambda: cmd("timedatectl", "set-timezone", zone, timeout=120), done)

    class LanguagePage(Page):
        title = "Language & Region"
        names = {}

        def refresh(self):
            self.clear()
            self.put(Gtk.Spinner(active=True))
            self.show_all_now()
            bg(lambda: (locales(), system_locale(), format_example(system_locale()[1]), live_session()), self.show)

        def name(self, loc):
            lang, region = self.names.get(loc) or next((v for k, v in self.names.items()
                                                        if locale_key(k) == locale_key(loc)), (loc, ""))
            return f"{lang} ({region})" if region else lang

        def show(self, res):
            self.clear()
            if isinstance(res, Exception):
                self.note(f"The languages could not be read: {res}")
                return self.show_all_now()
            self.names, (lang, fmt), example, live = res
            same = locale_key(fmt) == locale_key(lang)
            rows = [("Language", f"{self.name(lang)} · menus and messages of the apps",
                     button("Change…", lambda: self.choose(False, lang, fmt))),
                    ("Formats", "Dates, numbers and currency · " + ("same as the language" if same else self.name(fmt)),
                     button("Change…", lambda: self.choose(True, lang, fmt)))]
            if example:
                rows.append(("Example", example, None))
            self.put(card(rows))
            self.note("Applies after you sign out and back in. When the computer is online, spell checking and the "
                      "languages for Firefox and LibreOffice are installed with it.")
            self.note("Simple OS's own windows, like this one, are still in English – translations are planned for "
                      "Simple OS 1.2.")
            if live:
                self.note("Live Mode: the change lasts until the computer shuts down.")
            self.put(card([("Keyboard layout", "Set separately, on the Keyboard page",
                            button("Open", lambda: self.win.open("keyboard")))]))
            self.show_all_now()

        def choose(self, formats, lang, fmt):
            if not self.names:
                return self.win.error("The list of languages is not available.")
            by = {}
            for loc, (lg, region) in sorted(self.names.items(), key=lambda kv: (kv[1][0], kv[1][1])):
                by.setdefault(lg, []).append((loc, region))
            current = fmt if formats else lang
            cur = next((k for k in self.names if locale_key(k) == locale_key(current)), current)
            d = Gtk.Dialog(title="Formats" if formats else "Language", transient_for=self.win, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Change", Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.OK)
            d.set_default_size(360, -1)
            language, region = Gtk.ComboBoxText(), Gtk.ComboBoxText()
            for lg in by:
                language.append(lg, lg)

            def fill(_c=None):
                region.remove_all()
                for loc, rg in by.get(language.get_active_id() or "", []):
                    region.append(loc, rg or loc)
                region.set_active(0)
            language.connect("changed", fill)
            language.set_active_id(self.names.get(cur, (next(iter(by)),))[0])
            fill()
            region.set_active_id(cur)
            box = d.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            same = Gtk.CheckButton(label="Same as the language", active=locale_key(fmt) == locale_key(lang))
            if formats:
                box.add(label("Show dates, numbers and currency like in …"))
                box.add(same)
                same.connect("toggled", lambda b: (language.set_sensitive(not b.get_active()),
                                                   region.set_sensitive(not b.get_active())))
                same.toggled()
            else:
                box.add(label("Which language should the apps use?"))
            box.add(language)
            box.add(region)
            d.show_all()
            ok = d.run() == Gtk.ResponseType.OK
            chosen, keep = region.get_active_id(), same.get_active()
            d.destroy()
            if not ok or not chosen:
                return
            if formats:
                new_lang, new_fmt = lang, lang if keep else chosen
            else:
                new_lang = chosen
                new_fmt = chosen if locale_key(fmt) == locale_key(lang) else fmt
            if (locale_key(new_lang), locale_key(new_fmt)) != (locale_key(lang), locale_key(fmt)):
                self.apply(new_lang, new_fmt, "formats" if formats else "language")

        def apply(self, lang, fmt, what):
            self.clear()
            box = Gtk.Box(spacing=10)
            box.pack_start(Gtk.Spinner(active=True), False, False, 0)
            box.pack_start(label("Changing the language…"), False, False, 0)
            self.put(box)
            self.show_all_now()
            args = ["--locale", lang] + (["--formats", fmt] if locale_key(fmt) != locale_key(lang) else [])

            def work():
                import tempfile
                log = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "simpleos-language.log"
                log.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile("w", prefix="simpleos-language.", delete=False) as out:
                    feed = out.name
                prog = None
                if os.access("/usr/local/bin/simpleos-progress", os.X_OK):
                    prog = subprocess.Popen(["/usr/local/bin/simpleos-progress", "--follow", feed, "--title",
                                             "Changing the language", "--done", "Language changed",
                                             "--hint", "Sign out to use it", "--app", "Control Center",
                                             "--icon-name", "preferences-desktop-locale", "--pid", str(os.getpid())],
                                            stderr=subprocess.DEVNULL)
                try:
                    with open(feed, "a") as fo, open(log, "a") as fl:
                        rc = subprocess.call(["pkexec", HELPER, *args], stdout=fo, stderr=fl)
                        fo.write(f"EXIT: {rc}\n")
                finally:
                    if prog:
                        prog.wait()
                    os.unlink(feed)
                return rc

            def done(rc):
                self.refresh()
                if rc in (126, 127):          # password dialog cancelled: nothing changed
                    return
                if rc != 0:
                    return self.win.error("The language could not be changed. Details: ~/.cache/simpleos-language.log")
                d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                      text=f"Sign out now to use the new {what}?")
                d.format_secondary_text("Save your work first – open apps will close.")
                d.add_buttons("Later", Gtk.ResponseType.CANCEL, "Sign out", Gtk.ResponseType.OK)
                if d.run() == Gtk.ResponseType.OK:
                    spawn("openbox", "--exit")
                d.destroy()
            bg(work, done)

    class StoragePage(Page):
        title = "Storage & Backups"

        def refresh(self):
            self.clear()
            used, total = disk_usage("/")
            bar = Gtk.LevelBar(min_value=0, max_value=1, value=(used / total) if total else 0)
            bar.set_size_request(240, 10)
            self.put(card([("System disk", f"{human(total - used)} free of {human(total)}", bar),
                           ("Free up space", "Package cache, unused apps, old logs, thumbnails",
                            button("Clean up", lambda: spawn("simpleos-cleaner"), "suggested-action")),
                           ("Disks & USB sticks", "Format a USB stick, write an ISO image, check disk health",
                            button("Open", lambda: spawn("gnome-disks")))]))
            self.put(label("<b>Backups</b>", markup=True))
            if live_session():
                self.note("Backups can only be created on an installed system.")
            else:
                self.put(card([("Restore points", "Undo system changes – your personal files are not touched",
                                button("Open", lambda: spawn("simpleos-backup"))),
                               ("Create a restore point now", "The first one can take 10–20 minutes",
                                button("Create", lambda: spawn("simpleos-backup", "--create"), "suggested-action"))]))
            self.show_all_now()

    class SecurityPage(Page):
        title = "Password & Security"

        def refresh(self):
            self.clear()
            if not live_session():
                self.put(card([("Password", "The password you sign in with",
                                button("Change…", lambda: spawn(
                                    "kitty", "--title", "Change password", "sh", "-c",
                                    "passwd; printf '\\nPress Enter to close.'; read -r _")))]))
            fw = Gtk.Switch(active=firewall_on())
            fw.connect("notify::active", self.set_firewall)
            self.put(card([("Firewall", "Blocks connections from other devices to this computer – "
                            "browsing, printing and games keep working", fw)]))
            self.put(card([("Screen lock", "Lock when the screen turns off: Power",
                            button("Open", lambda: self.win.open("power")))]))
            self.show_all_now()

        def set_firewall(self, sw, _p):
            want = sw.get_active()
            if want == firewall_on():
                return
            sw.set_sensitive(False)

            def done(res):
                # 126/127 = password dialog cancelled -> back silently; otherwise only the new state counts
                if getattr(res, "returncode", 1) not in (126, 127) and firewall_on() != want:
                    self.win.error("The firewall could not be changed.")
                self.refresh()
            bg(lambda: cmd("pkexec", HELPER, "--firewall", "on" if want else "off", timeout=120), done)

    class SystemPage(Page):
        title = "System & Updates"

        def refresh(self):
            self.clear()
            ver = os_version()
            self.put(card([(f"Simple OS {ver}".strip(), "Based on Debian 12 “bookworm”",
                            button("What's new", lambda: spawn("simpleos-whats-new"))),
                           ("Software Updates", "Simple OS, apps and security fixes",
                            button("Open", lambda: spawn("simpleos-update"), "suggested-action"))]))
            self.put(label("<b>Hardware &amp; Drivers</b>", markup=True))
            hw = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            hw.pack_start(card([("Checking graphics, Wi-Fi and CPU…", None, Gtk.Spinner(active=True))]),
                          False, False, 0)
            self.put(hw)
            bg(drivers_report, lambda rep: self.show_drivers(hw, rep))
            self.put(label("<b>Help</b>", markup=True))
            self.put(card([("Task Manager", "See what slows the computer down · Ctrl+Shift+Esc",
                            button("Open", lambda: spawn("simpleos-taskmanager"))),
                           ("Setup Wizard", "Run the first-start setup again (Wi-Fi, browser, apps)",
                            button("Open", lambda: spawn("simpleos-welcome-wizard"))),
                           ("Report a problem", "Saves details about this computer for a bug report",
                            button("Report", lambda: spawn("simpleos-report")))]))
            self.show_all_now()

        def show_drivers(self, hw, rep):
            for c in hw.get_children():
                hw.remove(c)
            if not isinstance(rep, dict):
                hw.pack_start(card([("Hardware could not be checked", str(rep) or None, None)]), False, False, 0)
                hw.show_all()
                return
            rows = []
            for g in rep.get("gpu") or [{"name": "No graphics card found", "status": ""}]:
                rows.append((f"Graphics · {g['name']}", g["status"] or None, None))
            for w in rep.get("wifi") or [{"name": "No Wi-Fi adapter found", "status": ""}]:
                rows.append((f"Wi-Fi · {w['name']}", w["status"] or None, None))
            cpu = rep.get("cpu") or {}
            rows.append((f"CPU · {cpu.get('name', 'Unknown')}", cpu.get("status"), None))
            todo = rep.get("recommended") or []
            if todo:
                b = button("Install Recommended Drivers", lambda: spawn("simpleos-drivers", "--install"),
                           "suggested-action")
                rows.append((f"{len(todo)} package{'s' if len(todo) != 1 else ''} recommended",
                             ", ".join(todo), b))
            else:
                rows.append(("All recommended drivers are installed", None, None))
            hw.pack_start(card(rows), False, False, 0)
            for n in rep.get("notes") or []:
                hw.pack_start(label(n, dim=True), False, False, 0)
            hw.show_all()

    def text_scale():
        """How much bigger the text is than GTK's pixel sizes: 1.5 at the display scale 150 % (#41: Xft/DPI 144, window
        scale 1 – only the text grows); at 200 % GTK scales everything itself (window scale 2, gtk-xft-dpi stays 96)"""
        try:
            dpi = Gtk.Settings.get_default().props.gtk_xft_dpi / 1024
        except Exception:  # no settings (tests): as before
            return 1.0
        return max(1.0, dpi / 96) if dpi > 0 else 1.0

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Control Center")
            ts = text_scale()
            w, h = int(900 * ts), int(680 * ts)
            try:   # never bigger than the screen (125 % on a 1366x768 laptop)
                import gi
                gi.require_version("Gdk", "3.0")
                from gi.repository import Gdk
                wa = Gdk.Display.get_default().get_primary_monitor().get_workarea()
                w, h = min(w, int(wa.width * 0.95)), min(h, int(wa.height * 0.9))
            except Exception:
                pass
            self.set_default_size(w, h)
            self.set_icon_name("preferences-system")
            self.set_position(Gtk.WindowPosition.CENTER)
            hb = Gtk.HeaderBar(show_close_button=True, title="Control Center")
            self.set_titlebar(hb)
            pane = Gtk.Box()
            self.side = Gtk.ListBox()
            self.side.get_style_context().add_class("sidebar")
            # a line between the groups of pages
            self.side.set_header_func(lambda row, before: row.set_header(
                Gtk.Separator() if before and row.key in GROUP_STARTS else None))
            side_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            side_scroll.set_size_request(int(220 * ts), -1)
            side_scroll.add(self.side)
            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            self.pages = {}
            classes = {"system": SystemPage, "notifications": NotificationsPage, "keyboard": KeyboardPage,
                       "printers": PrintersPage, "apps": AppsPage, "datetime": DateTimePage, "storage": StoragePage,
                       "security": SecurityPage, "language": LanguagePage,
                       "sound": SoundPage, "display": DisplayPage, "wifi": WifiPage, "bluetooth": BluetoothPage,
                       "appearance": AppearancePage, "input": InputPage, "power": PowerPage}
            for key, title, icon in PAGES:
                row = Gtk.ListBoxRow()
                row.key = key
                b = Gtk.Box(spacing=10, margin=7)
                b.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                b.pack_start(label(title), False, False, 0)
                row.add(b)
                self.side.add(row)
                page = classes[key](self)
                self.pages[key] = page
                self.stack.add_named(page, key)
            self.side.connect("row-selected", lambda _l, row: row and self.open(row.key, select=False))
            pane.pack_start(side_scroll, False, False, 0)
            pane.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
            pane.pack_start(self.stack, True, True, 0)
            self.add(pane)
            self.show_all()

        def open(self, key, select=True):
            key = ALIASES.get(key, key)
            key = key if key in self.pages else PAGES[0][0]
            if select:
                for row in self.side.get_children():
                    if row.key == key:
                        # an already selected row emits no "row-selected": show the page and refresh it directly
                        if self.side.get_selected_row() is row:
                            break
                        self.side.select_row(row)   # triggers open(select=False)
                        return
            self.stack.set_visible_child_name(key)
            self.pages[key].refresh()

        def error(self, text):
            d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                  buttons=Gtk.ButtonsType.OK, text=text)
            d.run()
            d.destroy()

        def ask_password(self, ssid):
            d = Gtk.Dialog(title=f"Connect to {ssid}", transient_for=self, modal=True)
            d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Connect", Gtk.ResponseType.OK)
            d.set_default_response(Gtk.ResponseType.OK)
            entry = Gtk.Entry(visibility=False, activates_default=True, placeholder_text="Wi-Fi password")
            box = d.get_content_area()
            box.set_spacing(8)
            box.set_border_width(12)
            box.add(label(f"Enter the password for “{ssid}”."))
            box.add(entry)
            d.show_all()
            ok = d.run() == Gtk.ResponseType.OK
            text = entry.get_text()
            d.destroy()
            return text if ok else None

    from gi.repository import Gio
    selftest = os.environ.get("SIMPLEOS_CC_SELFTEST") == "1"
    errors = []
    if selftest:
        def hook(etype, value, tb):
            errors.append(value)
            sys.__excepthook__(etype, value, tb)
        sys.excepthook = hook

    class App(Gtk.Application):
        def __init__(self):
            flags = Gio.ApplicationFlags.HANDLES_COMMAND_LINE
            if selftest:
                flags |= Gio.ApplicationFlags.NON_UNIQUE
            super().__init__(application_id="org.simpleos.ControlCenter", flags=flags)
            self.win = None

        def do_command_line(self, line):
            args = line.get_arguments()[1:]
            if not self.win:
                self.win = Window(self)
            self.win.open(args[0] if args else PAGES[0][0])
            self.win.present()
            if selftest:
                keys = [k for k, _t, _i in PAGES]

                def step():
                    if keys:
                        self.win.open(keys.pop(0))
                        return True
                    GLib.timeout_add(1500, self.quit)   # wait for the background calls of the last page
                    return False
                GLib.timeout_add(700, step)
            return 0

    rc = App().run(argv)
    if errors:
        print(f"simpleos-control-center: {len(errors)} error(s) in self-test", file=sys.stderr)
        return 1
    return rc


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        print("simpleos-control-center: no display", file=sys.stderr)
        sys.exit(1)
    sys.exit(main(sys.argv))
