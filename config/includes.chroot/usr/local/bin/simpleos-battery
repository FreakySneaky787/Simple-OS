#!/bin/sh
# Simple OS – battery check for the taskbar
#   simpleos-battery --present    exit 0 only with a real battery (battery display in tint2, simpleos-taskbar-select)
#   simpleos-battery --low-alert  "Battery low" notification (battery_low_cmd in tint2rc), only while discharging
#   simpleos-battery --run CMD…   start CMD only with a real battery (XDG autostart of battery programs like
#                                 xfce4-power-manager, cbatticon – hook 10_battery_guard), otherwise exit 0
# Real battery = /sys/class/power_supply/BAT* with type "Battery" and present "1". VMs and desktop PCs have
# none or only a dummy (present 0) -> no battery icon, no notification. Batteries of mice/keyboards
# (hidpp_battery_0, …) and UPSs (type "UPS") do not count. The notification additionally only comes with status
# "Discharging". A VM never has a battery: QEMU/VirtualBox/Hyper-V sometimes pass through
# dummies or the host's battery with present 1.
# Tests: SIMPLEOS_POWER_SUPPLY replaces /sys/class/power_supply, SIMPLEOS_VIRT the result of
# systemd-detect-virt --vm ("none" = real hardware).
PS=${SIMPLEOS_POWER_SUPPLY:-/sys/class/power_supply}

in_vm() {
    if [ -n "${SIMPLEOS_VIRT:-}" ]; then [ "$SIMPLEOS_VIRT" != none ]; return; fi
    command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q --vm
}

# Real batteries, one directory per line
batteries() {
    in_vm && return 0
    for b in "$PS"/BAT*; do
        [ -d "$b" ] || continue
        [ "$(cat "$b/type" 2>/dev/null)" = Battery ] && [ "$(cat "$b/present" 2>/dev/null)" = 1 ] && echo "$b"
    done
}

case "${1:-}" in
    --present) [ -n "$(batteries)" ] ;;
    --low-alert)
        for b in $(batteries); do
            [ "$(cat "$b/status" 2>/dev/null)" = Discharging ] || continue
            notify-send -u critical -i battery-caution "Battery low" "Plug in your charger soon." 2>/dev/null
            exit 0
        done
        exit 0 ;;
    --run)
        shift
        [ $# -gt 0 ] || exit 2
        [ -n "$(batteries)" ] || exit 0
        exec "$@" ;;
    *) echo "Usage: simpleos-battery --present | --low-alert | --run CMD…" >&2; exit 2 ;;
esac
