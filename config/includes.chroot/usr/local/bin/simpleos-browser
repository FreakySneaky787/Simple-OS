#!/bin/sh
# Simple OS – starts the default browser (Super+B). To change it: simpleos-browser-select
id=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
file=
if [ -n "$id" ]; then
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' ') \
            /var/lib/flatpak/exports/share; do
        if [ -f "$dir/applications/$id" ]; then file="$dir/applications/$id"; break; fi
    done
fi
if [ -z "$file" ]; then
    # No valid default: the first available browser (Firefox may have been removed by the Setup Wizard)
    for b in firefox-esr chromium; do
        command -v "$b" >/dev/null && exec "$b" "$@"
    done
    exec simpleos-browser-select
fi
# Exec line without field codes (%u, %U, ...) and Flatpak markers (@@u ... @@)
cmd=$(sed -n 's/^Exec=//p' "$file" | head -n1 | sed -e 's/@@[a-zA-Z]\{0,1\}//g' -e 's/%[a-zA-Z]//g')
# Broken launcher without an Exec line: otherwise "exec" without a command would end silently
[ -n "$(echo "$cmd" | tr -d ' ')" ] || exec simpleos-browser-select
eval "exec $cmd \"\$@\""
