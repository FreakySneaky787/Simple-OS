        # #155: one name for the place to get apps – the Software Center (it opens Bazaar/GNOME Software for more)
        box = self.page_box(_("Get more apps"),
                            _("The Software Center installs popular apps like Steam, Spotify or Zoom with one click."))
        card = self.card()
