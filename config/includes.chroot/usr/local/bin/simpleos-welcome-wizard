# ---------------------------------------------------------------- Systeminfos
def read_os_name():
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip('"')
    except OSError:
        pass
    return "Simple OS"


def read_cpu():
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                return f"{' '.join(line.split(':', 1)[1].split())} ({os.cpu_count()} threads)"
    except OSError:
        pass
    return f"{os.cpu_count()} threads"


def read_memory():
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return f"{int(line.split()[1]) / 1024 / 1024:.1f} GiB"
    except OSError:
        pass
    return "unknown"


def read_disk():
    usage = shutil.disk_usage("/")
    gib = 1024 ** 3
    return f"{usage.free / gib:.0f} GiB free of {usage.total / gib:.0f} GiB"


def system_info():
    return [
        ("System", read_os_name()),
        ("Computer", socket.gethostname()),
        ("Kernel", platform.release()),
        ("Processor", read_cpu()),
        ("Memory", read_memory()),
        ("Storage", read_disk()),
    ]


# ------------------------------------------------------- aktueller Zustand
def data_dirs():
    home = os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))
    dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    return [home, *dirs, "/var/lib/flatpak/exports/share"]


def is_installed(desktop_id):
    return any(Path(d, "applications", desktop_id).is_file() for d in data_dirs())


def current_browser():
    try:
        out = subprocess.run(["xdg-mime", "query", "default", "x-scheme-handler/https"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    return out or "firefox-esr.desktop"


def current_theme():
    state = {"mode": "dark", "accent": "blue"}
    try:
        out = subprocess.run(["simpleos-theme", "--show"], capture_output=True, text=True, timeout=5).stdout
        state.update(line.split("=", 1) for line in out.splitlines() if "=" in line)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return state


def current_office():
    for key, _name, _desc, desktop_id in OFFICE:
        if desktop_id and is_installed(desktop_id):
            return key
    return "none"


def gaming_installed():
    return is_installed("steam.desktop") or Path("/usr/games/steam").exists()


def run(cmd, wait=True):
    if DRYRUN:
        print("DRYRUN:", " ".join(cmd), flush=True)
        return
    try:
        if wait:
            subprocess.run(cmd)
        else:
            subprocess.Popen(cmd, start_new_session=True)
    except OSError as err:
        print(f"simpleos-welcome-wizard: {cmd[0]}: {err}", file=sys.stderr)


# ---------------------------------------------------------- Netzwerk (nmcli)
# Gleiche Logik wie simpleos-wifi, nur als GTK-Seite. Alle Aufrufe fangen Fehler ab: fehlt nmcli oder
# hängt es, zeigt die Seite "not connected" statt abzustürzen.
def nmcli(*args, timeout=15):
    try:
        return subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as err:
        return subprocess.CompletedProcess(["nmcli", *args], 1, "", str(err))


def split_terse(line):
    """nmcli -t: Felder durch ':' getrennt, ':' und '\\' in Werten mit '\\' maskiert."""
    fields, cur, escaped = [], "", False
    for ch in line:
        if escaped:
            cur, escaped = cur + ch, False
        elif ch == "\\":
            escaped = True
        elif ch == ":":
            fields.append(cur)
            cur = ""
        else:
            cur += ch
    fields.append(cur)
    return fields


def ipv4(dev):
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", dev, "scope", "global"],
                             capture_output=True, text=True, timeout=5).stdout.split()
        return out[3].split("/")[0] if len(out) > 3 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def network_state():
    """{'wifi': Gerät|None, 'radio': bool, 'kind': 'wifi'|'ethernet'|None, 'name': Verbindung, 'ip': IPv4}"""
    state = {"wifi": None, "radio": True, "kind": None, "name": "", "ip": ""}
    for line in nmcli("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device").stdout.splitlines():
        dev, typ, st, conn = (split_terse(line) + ["", "", "", ""])[:4]
        if typ == "wifi" and not state["wifi"]:
            state["wifi"] = dev
        if typ in ("wifi", "ethernet") and st.startswith("connected") and not state["kind"]:
            state.update(kind=typ, name=conn, ip=ipv4(dev))
    state["radio"] = nmcli("radio", "wifi").stdout.strip() != "disabled"
    return state


def wifi_networks(dev, rescan="auto"):
    """[(ssid, signal, secured, in_use)] – eine Zeile pro Netz, verbundenes und stärkstes zuerst."""
    best = {}
    out = nmcli("-t", "-f", "IN-USE,SIGNAL,SECURITY,SSID", "device", "wifi", "list", "ifname", dev,
                "--rescan", rescan, timeout=30).stdout
    for line in out.splitlines():
        in_use, signal, security, ssid = (split_terse(line) + ["", "", "", ""])[:4]
        if not ssid:
            continue  # versteckte Netze
        sig = int(signal) if signal.isdigit() else 0
        old = best.get(ssid)
        if not old or sig > old[1] or in_use == "*":
            best[ssid] = (ssid, max(sig, old[1] if old else 0), security not in ("", "--"),
                          in_use == "*" or bool(old and old[3]))
    return sorted(best.values(), key=lambda n: (not n[3], -n[1]))


def network_view(state, nets):
    """Was die Internet-Seite zeigt – wie bei Windows: oben der Status, darunter IMMER die WLAN-Liste
    (sobald WLAN-Hardware da ist), auch wenn der PC schon online ist. Das verbundene Netz steht oben und
    bietet "Disconnect", jedes andere "Connect" (= Netz wechseln). Keine Schnittstellennamen.
    Rückgabe: status, online, hint, show_list, rows [(ssid, info, secured, in_use, button)], action"""
    has_wifi, radio = bool(state.get("wifi")), bool(state.get("radio", True))
    current = next((n[0] for n in nets if n[3]), "")
    kind = state.get("kind")
    if kind == "wifi":
        status = f"Connected to {current or state.get('name') or 'Wi-Fi'}"
    elif kind == "ethernet":
        status = "Connected to Ethernet (network cable)"
    else:
        status = "Not connected"
    rows = [(ssid, "Connected" if in_use else signal_word(signal) + (" · password" if secured else " · open"),
             secured, in_use, "Disconnect" if in_use else "Connect")
            for ssid, signal, secured, in_use in nets]
    if not has_wifi:
        hint = ("This computer has no Wi-Fi hardware, so there are no Wi-Fi networks to show." if kind else
                "This computer has no Wi-Fi. Plug in a network cable – it connects by itself.")
        action = "Check again"
    elif not radio:
        hint = "Wi-Fi is turned off. Click \"Turn on Wi-Fi\" to see the networks around you."
        action = "Turn on Wi-Fi"
    elif not rows:
        hint = "No Wi-Fi networks found nearby. Click \"Search again\"."
        action = "Search again"
    elif kind:
        hint = "To switch networks, click another one and then Connect."
        action = "Search again"
    else:
        hint = ("Click your network, then Connect. Networks marked \"password\" need the Wi-Fi password "
                "(often on a sticker on your router).")
        action = "Search again"
    return {"status": status, "online": bool(kind), "hint": hint, "show_list": has_wifi and radio,
            "rows": rows, "action": action}


def disconnect_wifi(dev):
    if DRYRUN:
        print(f"DRYRUN: nmcli device disconnect {dev}", flush=True)
        return True, "Disconnected."
    ok = nmcli("device", "disconnect", dev, timeout=30).returncode == 0
    return ok, "Disconnected." if ok else "Could not disconnect. Please try again."


def signal_word(signal):
    return "Strong signal" if signal >= 70 else "Good signal" if signal >= 40 else "Weak signal"


def saved_networks():
    """Namen der gespeicherten Verbindungen (nmcli -t maskiert ':' und '\\')."""
    return [split_terse(line)[0] for line in nmcli("-t", "-f", "NAME", "connection", "show").stdout.splitlines()]


def connect_wifi(dev, ssid, password, secured=False):
    """(ok, Meldung in Alltagssprache). Gespeichertes Netz + neues Passwort: das Passwort des Profils ersetzen
    (sonst versuchte NetworkManager es weiter mit dem alten, falschen)."""
    if DRYRUN:
        print(f"DRYRUN: nmcli device wifi connect {ssid} ifname {dev}", flush=True)
        return True, f"Connected to {ssid}. You're online."
    saved = ssid in saved_networks()
    if saved and password:
        nmcli("connection", "modify", "id", ssid, "wifi-sec.psk", password)
    if saved and nmcli("--wait", "20", "connection", "up", "id", ssid, timeout=40).returncode == 0:
        return True, f"Connected to {ssid}. You're online."
    cmd = ["--wait", "30", "device", "wifi", "connect", ssid, "ifname", dev]
    if password:
        cmd += ["password", password]
    result = nmcli(*cmd, timeout=60)
    if result.returncode == 0:
        return True, f"Connected to {ssid}. You're online."
    print(f"simpleos-welcome-wizard: connect {ssid}: {result.stderr.strip()}", file=sys.stderr)
    if not saved:  # fehlgeschlagenes, neu angelegtes Profil nicht liegen lassen
        nmcli("connection", "delete", "id", ssid)
    if password:
        return False, "That didn't work. The password may be wrong – please check it and try again."
    if saved and secured:
        return False, "That didn't work. The saved password may be wrong – please type the password and try again."
    return False, "That didn't work. Move closer to your router and try again."


# ------------------------------------------------------------------ Fenster
class Wizard(Gtk.Window):
    def __init__(self):
        super().__init__(title="Simple OS Setup")
        self.set_default_size(760, 540)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("preferences-desktop")
        self.get_style_context().add_class("simpleos")
        self.connect("destroy", Gtk.main_quit)
        self.connect("delete-event", lambda *_: self.busy)  # während der Installation nicht schließen

        theme = current_theme()
        self.browser = current_browser()
        self.mode = theme["mode"] if theme["mode"] in ("dark", "light") else "dark"
        self.accent = theme["accent"] if theme["accent"] in dict(ACCENTS) else "blue"
        self.office = current_office()
        self.gaming = "ultimate" if gaming_installed() else "none"
        self.open_store = False
        self.busy = False

        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.apply_css()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # Schritt-Anzeige
        steps = Gtk.Box(spacing=20, halign=Gtk.Align.CENTER, margin_top=18, margin_bottom=6)
        self.step_labels = []
        for i, name in enumerate(STEPS):
            label = Gtk.Label(label=f"{i + 1}  {name}")
            label.get_style_context().add_class("step")
            steps.pack_start(label, False, False, 0)
            self.step_labels.append(label)
        root.pack_start(steps, False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               transition_duration=220)
        for page in (self.page_welcome(), self.page_network(), self.page_browser(), self.page_appearance(),
                     self.page_office(), self.page_gaming(), self.page_apps()):
            self.stack.add(page)
        self.progress_page = self.page_progress()  # nicht in STEPS: nur nach "Finish"
        self.stack.add(self.progress_page)
        root.pack_start(self.stack, True, True, 0)

        # Fußleiste
        footer = Gtk.Box(spacing=8)
        footer.get_style_context().add_class("footer")
        self.skip_btn = Gtk.Button(label="Skip setup")
        self.skip_btn.set_tooltip_text("Keep the defaults and don't show this again")
        self.skip_btn.connect("clicked", self.on_skip)
        footer.pack_start(self.skip_btn, False, False, 0)
        self.next_btn = Gtk.Button(label="Next")
        self.next_btn.get_style_context().add_class("suggested-action")
        self.next_btn.connect("clicked", self.on_next)
        footer.pack_end(self.next_btn, False, False, 0)
        self.back_btn = Gtk.Button(label="Back")
        self.back_btn.connect("clicked", self.on_back)
        footer.pack_end(self.back_btn, False, False, 0)
        root.pack_end(footer, False, False, 0)

        self.page = 0
        self.show_all()
        self.update_firefox_note()
        self.go_to(int(os.environ.get("SIMPLEOS_WIZARD_PAGE", "0")))
        self.next_btn.grab_focus()

    # ------------------------------------------------------------ Hilfen
    def apply_css(self):
        self.css.load_from_data(CSS.replace("@ACCENT@", dict(ACCENTS)[self.accent]).encode())

    @staticmethod
    def page_box(title, subtitle):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                      margin_start=48, margin_end=48, margin_top=18, margin_bottom=18)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("title")
        s = Gtk.Label(label=subtitle, xalign=0, wrap=True)
        s.get_style_context().add_class("subtitle")
        box.pack_start(t, False, False, 0)
        box.pack_start(s, False, False, 0)
        return box

    @staticmethod
    def card():
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        frame.get_style_context().add_class("card")
        return frame

    @staticmethod
    def dim(text):
        label = Gtk.Label(label=text, xalign=0, wrap=True)
        label.get_style_context().add_class("dim")
        return label

    # ------------------------------------------------------------ Seiten
    def page_welcome(self):
        box = self.page_box("Welcome to Simple OS",
                            "Let's set up a few things. This takes less than a minute.")
        logo_path = Path("/usr/share/simpleos/logo.png")
        if logo_path.exists():
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(str(logo_path), 72, 72)
            box.pack_start(Gtk.Image.new_from_pixbuf(pixbuf), False, False, 0)
            box.reorder_child(box.get_children()[-1], 0)
        card = self.card()
        grid = Gtk.Grid(column_spacing=24, row_spacing=8)
        for row, (key, value) in enumerate(system_info()):
            k = Gtk.Label(label=key, xalign=0)
            k.get_style_context().add_class("key")
            v = Gtk.Label(label=value, xalign=0, ellipsize=3)  # 3 = Pango END
            grid.attach(k, 0, row, 1, 1)
            grid.attach(v, 1, row, 1, 1)
        card.pack_start(grid, False, False, 0)
        box.pack_start(card, False, False, 0)
        return box

    def page_network(self):
        box = self.page_box("Connect to the internet",
                            "The next steps download software, so let's get you online first.")
        card = self.card()
        self.net_status = Gtk.Label(label="Checking your connection ...", xalign=0, wrap=True)
        self.net_status.get_style_context().add_class("option-name")
        card.pack_start(self.net_status, False, False, 0)
        self.net_hint = self.dim("")
        card.pack_start(self.net_hint, False, False, 0)

        # WLAN-Liste (nur mit WLAN-Adapter sichtbar)
        # Einfacher Klick wählt aus (Passwortfeld erscheint), Doppelklick/Enter verbindet
        self.net_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False)
        self.net_list.connect("row-selected", self.on_network_selected)
        self.net_list.connect("row-activated", lambda *_: self.on_network_connect(None))
        self.net_scroll = Gtk.ScrolledWindow(min_content_height=150, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.net_scroll.add(self.net_list)
        card.pack_start(self.net_scroll, True, True, 0)

        row = Gtk.Box(spacing=8)
        self.net_password = Gtk.Entry(visibility=False, placeholder_text="Wi-Fi password", hexpand=True)
        self.net_password.connect("activate", self.on_network_connect)
        row.pack_start(self.net_password, True, True, 0)
        self.net_connect_btn = Gtk.Button(label="Connect")
        self.net_connect_btn.connect("clicked", self.on_network_connect)
        row.pack_start(self.net_connect_btn, False, False, 0)
        self.net_action_btn = Gtk.Button(label="Search again")  # auch: "Turn on Wi-Fi", "Check again"
        self.net_action_btn.connect("clicked", self.on_network_action)
        row.pack_end(self.net_action_btn, False, False, 0)
        card.pack_start(row, False, False, 0)
        box.pack_start(card, True, True, 0)
        box.pack_start(self.dim("Not now? Just click Next. Later, click the network display in the taskbar "
                                "(bottom right) to connect."), False, False, 0)
        self.net_state = {}
        self.net_busy = False
        self.net_message = ""
        return box

    # --- Internet-Seite: Hintergrund-Threads für nmcli, GUI-Updates über GLib.idle_add
    def refresh_network(self, rescan="auto"):
        if self.net_busy:
            return
        self.net_busy = True
        self.net_status.set_text("Checking your connection ...")
        self.net_action_btn.set_sensitive(False)
        self.net_connect_btn.set_sensitive(False)

        def work():
            state = network_state()
            nets = wifi_networks(state["wifi"], rescan) if state["wifi"] and state["radio"] else []
            GLib.idle_add(self.show_network, state, nets)
        threading.Thread(target=work, daemon=True).start()

    def show_network(self, state, nets):
        self.net_busy = False
        self.net_state = state
        view = network_view(state, nets)
        self.net_status.set_text(view["status"])
        ctx = self.net_status.get_style_context()
        (ctx.add_class if view["online"] else ctx.remove_class)("online")
        (ctx.remove_class if view["online"] else ctx.add_class)("offline")
        self.net_hint.set_text(self.net_message or view["hint"])  # Erfolg/Fehler nach Connect hat Vorrang
        self.net_message = ""
        self.net_action_btn.set_label(view["action"])
        for child in self.net_list.get_children():
            self.net_list.remove(child)
        for ssid, info, secured, in_use, button in view["rows"]:
            line = Gtk.Box(spacing=12)
            if in_use:
                line.pack_start(Gtk.Label(label="✔"), False, False, 0)
            name = Gtk.Label(label=ssid, xalign=0, ellipsize=3)
            name.get_style_context().add_class("option-name")
            line.pack_start(name, True, True, 0)
            line.pack_end(self.dim(info), False, False, 0)
            row = Gtk.ListBoxRow()
            row.add(line)
            row.network = (ssid, secured, in_use, button)
            self.net_list.add(row)
        for widget in (self.net_scroll, self.net_connect_btn):
            widget.set_visible(view["show_list"])
        self.net_list.show_all()
        self.net_password.set_visible(False)  # erst bei Auswahl eines Netzes mit Passwort
        self.net_connect_btn.set_label("Connect")
        self.net_connect_btn.set_sensitive(False)
        self.net_action_btn.set_sensitive(True)
        return False

    def on_network_selected(self, _box, row):
        ssid, secured, in_use, button = getattr(row, "network", ("", False, False, "Connect")) if row else \
            ("", False, False, "Connect")
        self.net_password.set_visible(bool(row) and secured and not in_use)
        self.net_password.set_text("")
        self.net_connect_btn.set_label(button)
        self.net_connect_btn.set_sensitive(bool(row) and not self.net_busy)
        if row and secured and not in_use:
            self.net_password.grab_focus()

    def on_network_connect(self, _widget):
        row = self.net_list.get_selected_row()
        if not row or self.net_busy or not self.net_state.get("wifi"):
            return
        ssid, secured, in_use, _button = row.network
        dev = self.net_state["wifi"]
        if in_use:
            work = lambda: disconnect_wifi(dev)  # noqa: E731
            self.net_status.set_text(f"Disconnecting from {ssid} ...")
        else:
            password = self.net_password.get_text() if secured else ""
            if secured and not password and ssid not in saved_networks():
                self.net_hint.set_text(f"Please type the password for \"{ssid}\", then click Connect.")
                self.net_password.grab_focus()
                return
            work = lambda: connect_wifi(dev, ssid, password, secured)  # noqa: E731
            self.net_status.set_text(f"Connecting to {ssid} ...")
        self.net_busy = True
        self.net_connect_btn.set_sensitive(False)
        self.net_action_btn.set_sensitive(False)

        def run_work():
            ok, message = work()
            GLib.idle_add(self.network_connected, ok, message)
        threading.Thread(target=run_work, daemon=True).start()

    def network_connected(self, ok, message):
        self.net_busy = False
        if ok:
            self.net_message = message  # zeigt show_network nach dem Neuladen an
            self.refresh_network(rescan="no")
        else:
            self.net_status.set_text(message)
            self.net_connect_btn.set_sensitive(True)
            self.net_action_btn.set_sensitive(True)
            self.net_password.grab_focus()
        return False

    def on_network_action(self, _btn):
        if self.net_state.get("wifi") and not self.net_state.get("radio"):
            if not DRYRUN:
                nmcli("radio", "wifi", "on")
            GLib.timeout_add_seconds(3, lambda: self.refresh_network(rescan="yes") and False)
            self.net_status.set_text("Turning on Wi-Fi ...")
            return
        self.refresh_network(rescan="yes")

    def page_browser(self):
        box = self.page_box("Choose your web browser",
                            "Links and Super+B open this browser. Missing browsers are installed for you.")
        self.firefox_note = self.dim("")  # vor den Radios: deren "toggled" aktualisiert den Hinweis
        card = self.card()
        group = None
        for desktop_id, name, desc in BROWSERS:
            status = "installed" if is_installed(desktop_id) else "will be installed"
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            n = Gtk.Label(label=f"{name}   ·   {status}", xalign=0)
            n.get_style_context().add_class("option-name")
            text.pack_start(n, False, False, 0)
            text.pack_start(self.dim(desc), False, False, 0)
            radio.add(text)
            radio.set_active(desktop_id == self.browser)
            radio.connect("toggled", self.on_browser, desktop_id)
            card.pack_start(radio, False, False, 2)
        box.pack_start(card, False, False, 0)
        box.pack_start(self.firefox_note, False, False, 0)
        box.pack_start(self.dim("You can change this later in Settings → Default Browser."), False, False, 0)
        return box

    def page_appearance(self):
        box = self.page_box("Make it yours",
                            "Pick a style for your apps and an accent color for menus, panel and windows.")
        card = self.card()
        mode_label = Gtk.Label(label="Apps", xalign=0)
        mode_label.get_style_context().add_class("option-name")
        card.pack_start(mode_label, False, False, 0)
        modes = Gtk.Box(spacing=24)
        dark = Gtk.RadioButton.new_with_label(None, "Dark")
        light = Gtk.RadioButton.new_with_label_from_widget(dark, "Light")
        (light if self.mode == "light" else dark).set_active(True)
        dark.connect("toggled", self.on_mode, "dark")
        light.connect("toggled", self.on_mode, "light")
        modes.pack_start(dark, False, False, 0)
        modes.pack_start(light, False, False, 0)
        card.pack_start(modes, False, False, 0)
        card.pack_start(self.dim("The panel, menus and terminal always stay dark."), False, False, 0)

        accent_label = Gtk.Label(label="Accent color", xalign=0, margin_top=8)
        accent_label.get_style_context().add_class("option-name")
        card.pack_start(accent_label, False, False, 0)
        swatches = Gtk.Box(spacing=12)
        group = None
        provider = Gtk.CssProvider()
        provider.load_from_data("".join(
            f".simpleos .swatch-{n} {{ background-color: {h}; }}" for n, h in ACCENTS).encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        for name, _ in ACCENTS:
            swatch = Gtk.RadioButton.new_from_widget(group)
            group = group or swatch
            swatch.set_mode(False)  # als Button zeichnen, ohne Radio-Kreis
            swatch.set_tooltip_text(name.capitalize())
            ctx = swatch.get_style_context()
            ctx.add_class("swatch")
            ctx.add_class(f"swatch-{name}")
            swatch.set_active(name == self.accent)
            swatch.connect("toggled", self.on_accent, name)
            swatches.pack_start(swatch, False, False, 0)
        card.pack_start(swatches, False, False, 0)
        box.pack_start(card, False, False, 0)
        return box

    def option_card(self, options, current, callback, status=None):
        """Karte mit Radio-Optionen (Schlüssel, Name, Beschreibung, ...)."""
        card = self.card()
        group = None
        for key, name, desc, *_ in options:
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            suffix = status(key) if status else ""
            n = Gtk.Label(label=f"{name}   ·   {suffix}" if suffix else name, xalign=0)
            n.get_style_context().add_class("option-name")
            text.pack_start(n, False, False, 0)
            text.pack_start(self.dim(desc), False, False, 0)
            radio.add(text)
            radio.set_active(key == current)
            radio.connect("toggled", lambda r, k: r.get_active() and callback(k), key)
            card.pack_start(radio, False, False, 2)
        return card

    def page_office(self):
        box = self.page_box("Office suite",
                            "Documents, spreadsheets and presentations. Pick one or keep the system minimal.")

        def status(key):
            desktop_id = dict((k, d) for k, _n, _s, d in OFFICE)[key]
            if not desktop_id:
                return ""
            return "installed" if is_installed(desktop_id) else "will be installed"
        box.pack_start(self.option_card(OFFICE, self.office, lambda k: setattr(self, "office", k), status),
                       False, False, 0)
        box.pack_start(self.dim("Already installed office apps are not removed."), False, False, 0)
        return box

    def page_gaming(self):
        box = self.page_box("Gaming",
                            "Turn Simple OS into a gaming machine or keep it lean.")

        def status(key):
            if key != "ultimate":
                return ""
            return "installed" if gaming_installed() else "about 1 GB download"
        box.pack_start(self.option_card(GAMING, self.gaming, lambda k: setattr(self, "gaming", k), status),
                       False, False, 0)
        box.pack_start(self.dim("By choosing Ultimate Gaming you accept the Steam license agreement "
                                "(store.steampowered.com/subscriber_agreement).\n"
                                "Start games with \"gamemoderun %command%\" or \"mangohud %command%\" "
                                "in the Steam launch options."), False, False, 0)
        return box

    def page_progress(self):
        box = self.page_box("Installing your software",
                            "You will be asked for your password once. Please keep this window open.")
        card = self.card()
        row = Gtk.Box(spacing=12)
        self.spinner = Gtk.Spinner()
        row.pack_start(self.spinner, False, False, 0)
        self.status_label = Gtk.Label(label="Starting ...", xalign=0, wrap=True)
        self.status_label.get_style_context().add_class("option-name")
        row.pack_start(self.status_label, True, True, 0)
        card.pack_start(row, False, False, 0)
        # echter Fortschritt (PROGRESS-Zeilen von simpleos-system-setup: apt und Flatpak), sonst nur der Spinner
        self.stage_label = Gtk.Label(label="", xalign=0, wrap=True)
        self.stage_label.get_style_context().add_class("dim-label")
        card.pack_start(self.stage_label, False, False, 0)
        self.bar = Gtk.ProgressBar(show_text=True, no_show_all=True)
        card.pack_start(self.bar, False, False, 0)
        self.step_t0 = time.monotonic()
        self.helper_log = []
        self.log_view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                     wrap_mode=Gtk.WrapMode.CHAR)
        scroll = Gtk.ScrolledWindow(min_content_height=180)
        scroll.add(self.log_view)
        expander = Gtk.Expander(label="Details")
        expander.add(scroll)
        card.pack_start(expander, True, True, 0)
        box.pack_start(card, True, True, 0)
        return box

    def page_apps(self):
