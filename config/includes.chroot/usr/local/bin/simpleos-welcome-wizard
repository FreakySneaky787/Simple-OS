#!/usr/bin/env python3
"""Simple OS – Setup Wizard.

  simpleos-welcome-wizard              show the wizard (menu: Help -> Setup Wizard)
  simpleos-welcome-wizard --first-run  only at the first login: not in the live session
                                       and not if ~/.config/simpleos/wizard-done exists

Changes go through the existing tools: simpleos-theme, simpleos-browser-select --set,
simpleos-software. Installations/removals (browser, office, optional components, Firefox cleanup) are bundled into
a single call of "pkexec simpleos-system-setup" – one graphical password dialog, no terminal.
Step "Extras" (#126): optional components, all off by default – SOS Bridge (Bottles for Windows programs, #85),
Gaming Support, Developer Tools; without internet they wait for later (Software Center). One that fails does not
end in an error screen: the helper exits with 3 and the wizard says what can be added later.
Step "Internet": choose Wi-Fi and enter the password (nmcli, like simpleos-wifi) – before software is downloaded.
It is skipped when the computer is already online at the start (cable, known Wi-Fi).
Test helpers: SIMPLEOS_WIZARD_PAGE=<0-6> (start page), SIMPLEOS_WIZARD_DRYRUN=1.
"""
import os
import platform
import shutil
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path
import gettext

# Translations (#43): the system language from /usr/share/locale/<lang>/LC_MESSAGES/simpleos.mo, else English
_ = gettext.translation("simpleos", fallback=True).gettext


def N_(text):
    """marks a text for translation (tools/i18n.py) that is translated later, where it is shown"""
    return text

CONFIG_DIR = Path.home() / ".config/simpleos"
FLAG = CONFIG_DIR / "wizard-done"
DRYRUN = os.environ.get("SIMPLEOS_WIZARD_DRYRUN") == "1"


def is_live_session():
    try:
        return "boot=live" in Path("/proc/cmdline").read_text().split()
    except OSError:
        return False


if "--first-run" in sys.argv and (FLAG.exists() or is_live_session()):
    sys.exit(0)

