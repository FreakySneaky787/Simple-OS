#!/usr/bin/env python3
"""Simple OS – Einrichtungsassistent (Setup Wizard).

  simpleos-welcome-wizard              Assistent anzeigen (Menü: Help -> Setup Wizard)
  simpleos-welcome-wizard --first-run  nur beim ersten Login: nicht in der Live-Session
                                       und nicht, wenn ~/.config/simpleos/wizard-done existiert

Änderungen laufen über die vorhandenen Werkzeuge: simpleos-theme, simpleos-browser-select --set,
simpleos-software. Installationen/Entfernungen (Browser, Office, Gaming, Firefox-Bereinigung) bündelt
ein einziger Aufruf von "pkexec simpleos-system-setup" – ein grafischer Passwortdialog, kein Terminal.
Schritt "Internet": WLAN wählen und Passwort eingeben (nmcli, wie simpleos-wifi) – bevor Software geladen wird.
Test-Hilfen: SIMPLEOS_WIZARD_PAGE=<0-6> (Startseite), SIMPLEOS_WIZARD_DRYRUN=1.
"""
import os
import platform
import shutil
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

CONFIG_DIR = Path.home() / ".config/simpleos"
FLAG = CONFIG_DIR / "wizard-done"
DRYRUN = os.environ.get("SIMPLEOS_WIZARD_DRYRUN") == "1"


def is_live_session():
    try:
        return "boot=live" in Path("/proc/cmdline").read_text().split()
    except OSError:
        return False


if "--first-run" in sys.argv and (FLAG.exists() or is_live_session()):
    sys.exit(0)

import gi  # noqa: E402  (erst nach dem Schnell-Ausstieg laden)

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

BROWSERS = [
    ("firefox-esr.desktop", "Firefox ESR", "Preinstalled. Stable and privacy-friendly."),
    ("chromium.desktop", "Chromium", "Open-source base of Chrome. Installed from Debian (about 100 MB)."),
    ("net.mullvad.MullvadBrowser.desktop", "Mullvad Browser", "Built for privacy. Installed from Flathub."),
]
ACCENTS = [
    ("blue", "#89b4fa"), ("mauve", "#cba6f7"), ("pink", "#f5c2e7"),
    ("green", "#a6e3a1"), ("peach", "#fab387"), ("teal", "#94e2d5"),
]
# Office: (Schlüssel, Name, Beschreibung, Desktop-ID zur Erkennung)
OFFICE = [
    ("libreoffice", "LibreOffice", "The classic: Writer, Calc, Impress and Draw. Installed from Debian.",
     "libreoffice-writer.desktop"),
    ("onlyoffice", "ONLYOFFICE", "Modern alternative, very compatible with Microsoft Office. Installed from Flathub.",
     "org.onlyoffice.desktopeditors.desktop"),
    ("none", "Minimal", "No office suite. You can install one later from the Software Store.", None),
]
GAMING = [
    ("ultimate", "Ultimate Gaming", "Steam, Lutris and MangoHud with 32-bit support. GameMode is already built in."),
    ("none", "No gaming", "Keep the system lean. You can still get games from the Software Store."),
]
FIREFOX_ID = "firefox-esr.desktop"
HELPER = "/usr/local/sbin/simpleos-system-setup"
STEPS = ["Welcome", "Internet", "Browser", "Appearance", "Office", "Gaming", "Apps"]
NETWORK_PAGE = STEPS.index("Internet")

CSS = """
window.simpleos { background-color: #1e1e2e; }
