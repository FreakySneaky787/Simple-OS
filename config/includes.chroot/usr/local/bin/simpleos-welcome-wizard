        text.pack_start(self.dim(_("Its button \"More apps\" leads to thousands more from Flathub.")), False, False, 0)
        row.pack_start(text, True, True, 0)
        switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        switch.connect("notify::active", lambda sw, _p: setattr(self, "open_store", sw.get_active()))
        row.pack_end(switch, False, False, 0)
        card.pack_start(row, False, False, 0)
        box.pack_start(card, False, False, 0)
