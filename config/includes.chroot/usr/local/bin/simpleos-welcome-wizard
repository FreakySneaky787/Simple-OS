    # --------------------------------------------------------- Navigation
    def go_to(self, index):
        self.page = max(0, min(index, len(STEPS) - 1))
        self.stack.set_visible_child(self.stack.get_children()[self.page])
        self.status_label.set_text(_("Starting ..."))
        for i, label in enumerate(self.step_labels):
            ctx = label.get_style_context()
            (ctx.add_class if i == self.page else ctx.remove_class)("active")
        self.back_btn.set_sensitive(self.page > 0)
        self.next_btn.set_label(_("Finish") if self.page == len(STEPS) - 1 else _("Next"))
        if self.page == NETWORK_PAGE:
            self.refresh_network()
        if self.page == EXTRAS_PAGE:
            threading.Thread(target=lambda: GLib.idle_add(self.components_checked, network_state()),
                             daemon=True).start()

    def on_next(self, _btn):
        if (self.page == NETWORK_PAGE and self.net_password.get_visible() and self.net_password.get_text()
                and not self.net_busy):
            # typed the password but clicked Next instead of Connect: connect first, then continue
            self.net_then_next = True
            self.on_network_connect(None)
            return
        if self.page < len(STEPS) - 1:
            self.go_to(self.page + (2 if self.skip_network and self.page + 1 == NETWORK_PAGE else 1))
        else:
            self.finish()

    def on_back(self, _btn):
        if self.stack.get_visible_child() is self.progress_page:
            self.go_to(self.page)  # back to the last page
        else:
            self.go_to(self.page - (2 if self.skip_network and self.page - 1 == NETWORK_PAGE else 1))

    def on_browser(self, radio, desktop_id):
        if radio.get_active():
            self.browser = desktop_id
            self.update_firefox_note()

    def removes_firefox(self):
        return self.browser != FIREFOX_ID and is_installed(FIREFOX_ID)

    def update_firefox_note(self):
        self.firefox_note.set_text(_("Firefox ESR will be removed completely to free up space.")
                                   if self.removes_firefox() else "")

    def on_mode(self, radio, mode):
        if radio.get_active() and self.mode != mode:
            self.mode = mode
            self.apply_css()

    def on_accent(self, swatch, name):
        if swatch.get_active():
            self.accent = name
            self.apply_css()

    # ---------------------------------------------------------- Finish
    @staticmethod
    def mark_done():
        if DRYRUN:
            print(f"DRYRUN: touch {FLAG}", flush=True)
            return
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        FLAG.touch()

    def on_skip(self, _btn):
        self.mark_done()
        Gtk.main_quit()

    def system_changes(self):
        """Arguments for simpleos-system-setup; empty = nothing needs root."""
        args = []
        browser_key = {"firefox-esr.desktop": "firefox", "chromium.desktop": "chromium",
                       "net.mullvad.MullvadBrowser.desktop": "mullvad"}.get(self.browser)
        # Remove Firefox only for Chromium/Mullvad; the helper checks beforehand that the new browser is there
        purge = browser_key in ("chromium", "mullvad") and self.removes_firefox()
        if browser_key and (purge or not is_installed(self.browser)):
            args += ["--browser", browser_key]
        if purge:
            args.append("--purge-firefox")
        office_id = dict((k, d) for k, _n, _s, d in OFFICE)[self.office]
        if office_id and not is_installed(office_id):
            args += ["--office", self.office]
        for key, _name, _desc, _size, arg in COMPONENTS:
            if self.components.get(key) and not component_installed(key):
                args.append(arg)
        return args

    def finish(self):
        run(["simpleos-theme", "--mode", self.mode, "--accent", self.accent])
        args = self.system_changes()
        if not args:
            self.apply_user_settings()
            return
        # Progress page; a single pkexec call -> one graphical password dialog
        self.busy = True
        for btn in (self.back_btn, self.next_btn, self.skip_btn):
            btn.set_sensitive(False)
        self.stack.set_visible_child(self.progress_page)
        self.spinner.start()
        self.log_view.get_buffer().set_text("")
        self.helper_log = []
        self.stage_label.set_text("")
        self.bar.hide()
        self.status_label.set_text(_("Waiting for your password ..."))
        threading.Thread(target=self.run_helper, args=(["pkexec", HELPER, *args],), daemon=True).start()

    def run_helper(self, cmd):
        """Runs in the background thread; GUI updates only via GLib.idle_add."""
        GLib.idle_add(self.append_log, "$ " + " ".join(cmd))
        if DRYRUN:
            print("DRYRUN:", " ".join(cmd), flush=True)
            GLib.idle_add(self.helper_done, 0)
            return
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    stdin=subprocess.DEVNULL, text=True, bufsize=1)
        except OSError as err:
            GLib.idle_add(self.append_log, str(err))
            GLib.idle_add(self.helper_done, 127)
            return
        for line in proc.stdout:
            GLib.idle_add(self.append_log, line.rstrip("\n"))
        GLib.idle_add(self.helper_done, proc.wait())

    def append_log(self, line):
        self.helper_log.append(line)
        if line.startswith("STEP: "):
            self.status_label.set_text(line[6:])
            self.stage_label.set_text("")
            self.bar.hide()                       # new step: the bar only with its percentages
            self.step_t0 = time.monotonic()
        elif line.startswith("STAGE: "):
            self.stage_label.set_text(line[7:])
            return False                          # progress lines not into the detail log
        elif line.startswith("PROGRESS: "):
            # "PROGRESS: <percent> [<rest>]": rest = time left from the download speed (progress-filter, Flatpak)
            num, _sep, rest = line[10:].partition(" ")
            try:
                pct = max(0, min(100, int(float(num))))
            except ValueError:
                return False
            self.bar.set_fraction(pct / 100)
            rest = rest.strip()
            left = _(' · about {rest} left').format(rest=rest) if rest and pct < 100 else remaining_text(pct, self.step_t0)
            self.bar.set_text(f"{pct}%{left}")
            self.bar.show()
            return False
        buf = self.log_view.get_buffer()
        buf.insert(buf.get_end_iter(), line + "\n")
        self.log_view.scroll_to_mark(buf.get_insert(), 0, False, 0, 0)
        return False

    def helper_done(self, code):
        self.busy = False
        self.spinner.stop()
        for btn in (self.back_btn, self.next_btn, self.skip_btn):
            btn.set_sensitive(True)
        if code in (126, 127):  # pkexec: password dialog cancelled or not authorized
            self.status_label.set_text(_("No password entered – nothing was installed or removed. "
                                       "Click Finish to try again or Back to change your choices."))
            self.next_btn.set_label(_("Finish"))
            return False
        self.bar.hide()
        self.stage_label.set_text("")
        if code == 3:   # only optional components failed (#126): everything else is set up
            # the helper names them in English ("Gaming Support"): the same texts as COMPONENTS, translated
            missing = [_(line[17:].strip()) for line in self.helper_log if line.startswith("OPTIONAL-FAILED: ")]
            names = ", ".join(dict.fromkeys(missing)) or _("an optional component")
            self.status_label.set_text(_('Everything is set up – except {names}: it could not be installed (no internet or not enough '
                                         'space?). You can add it later in the Software Center.').format(names=names))
            self.back_btn.set_sensitive(False)
            self.skip_btn.set_sensitive(False)
            self.next_btn.set_label(_("Close"))
            self.next_btn.disconnect_by_func(self.on_next)
            self.next_btn.connect("clicked", lambda _b: self.apply_user_settings())
            return False
        if code != 0:
            self.status_label.set_text(failure_text(self.helper_log))
            self.back_btn.set_sensitive(False)
            self.skip_btn.set_sensitive(False)
            self.next_btn.set_label(_("Close"))
            self.next_btn.disconnect_by_func(self.on_next)
            self.next_btn.connect("clicked", lambda _b: self.apply_user_settings(done=False))
            return False
        self.apply_user_settings()
        return False

    def apply_user_settings(self, done=True):
        self.hide()
        while Gtk.events_pending():
            Gtk.main_iteration()
        # Set the browser only once it is installed – otherwise browser-select would install it itself
        if (self.browser != current_browser() and is_installed(self.browser)) or DRYRUN:
            run(["simpleos-browser-select", "--set", self.browser])
        # Office entries in this account's menu for whatever is installed now (also when the suite was there already)
        run([OFFICE_MENU])
        # SOS Bridge just installed: its launcher as "SOS Bridge" in the menu right away (#156)
        if component_installed("bridge"):
            run(["/usr/local/bin/simpleos-windows-app", "--sync-menu"])
        run(["openbox", "--reconfigure"])  # reload the menu (e.g. without the Firefox entry, with the office entries)
        if done:
            self.mark_done()
        if self.open_store:
            run(["simpleos-software-center"], wait=False)
        Gtk.main_quit()

def remaining_text(pct, t0):
    """' · about 4 min left' from the speed of this step so far (only from 3 %, before that too inaccurate)."""
    if pct < 3 or pct >= 100:
        return ""
    left = (time.monotonic() - t0) * (100 - pct) / pct
    return _(" · less than a minute left") if left < 60 else _(' · about {minutes} min left').format(minutes=int(left / 60 + 0.5))


def failure_text(lines):
    """Error message by the actual cause – before, every error was "Check your internet connection"."""
    text = "\n".join(lines).lower()
    again = _(" Run the wizard again from Menu → Help → Setup Wizard.")
    if ("not enough free space" in text or "min-free-space" in text or "no space left" in text
            or "not enough disk space" in text):
        return (_("Some software could not be installed: not enough free space. In Live mode, apps are kept in "
                "memory – install Simple OS first.") + again)
    if any(k in text for k in ("could not resolve", "temporary failure resolving", "failed to fetch",
                               "could not connect", "network is unreachable", "timeout was reached")):
        return _("Some software could not be installed: no internet connection. Check your network.") + again
    return _("Some software could not be installed (details below).") + again


def main():
    # Dark or light like the chosen mode (Wizard.apply_css) – before 1.2 it always stayed dark
    Wizard()
    Gtk.main()


if __name__ == "__main__":
    main()
