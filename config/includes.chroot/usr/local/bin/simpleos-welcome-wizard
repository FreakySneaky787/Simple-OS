# ---------------------------------------------------------------- System info
def read_os_name():
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip('"')
    except OSError:
        pass
    return "Simple OS"


def read_cpu():
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                return _('{model} ({threads} threads)').format(model=' '.join(line.split(':', 1)[1].split()),
                                                         threads=os.cpu_count())
    except OSError:
        pass
    return _('{threads} threads').format(threads=os.cpu_count())


def read_memory():
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return f"{int(line.split()[1]) / 1024 / 1024:.1f} GiB"
    except OSError:
        pass
    return "unknown"


def read_disk():
    usage = shutil.disk_usage("/")
    gib = 1024 ** 3
    return _('{free:.0f} GiB free of {total:.0f} GiB').format(free=usage.free / gib, total=usage.total / gib)


def system_info():
    return [
        (_("System"), read_os_name()),
        (_("Computer"), socket.gethostname()),
        (_("Kernel"), platform.release()),
        (_("Processor"), read_cpu()),
        (_("Memory"), read_memory()),
        (_("Storage"), read_disk()),
    ]


# ------------------------------------------------------- Current state
def data_dirs():
    home = os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))
    dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    return [home, *dirs, "/var/lib/flatpak/exports/share"]


def is_installed(desktop_id):
    return any(Path(d, "applications", desktop_id).is_file() for d in data_dirs())


def current_browser():
    try:
        out = subprocess.run(["xdg-mime", "query", "default", "x-scheme-handler/https"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    return out or "firefox-esr.desktop"


def current_theme():
    state = {"mode": "dark", "accent": "blue"}
    try:
        out = subprocess.run(["simpleos-theme", "--show"], capture_output=True, text=True, timeout=5).stdout
        state.update(line.split("=", 1) for line in out.splitlines() if "=" in line)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return state


def current_office():
    for key, _name, _desc, desktop_id in OFFICE:
        if desktop_id and is_installed(desktop_id):
            return key
    return "none"


def gaming_installed():
    return is_installed("steam.desktop") or Path("/usr/games/steam").exists()


def component_installed(key):
    if key == "gaming":
        return gaming_installed()
    if key == "bridge":
        # Flatpak's own file: SOS Bridge's renamed copy in ~/.local/share (#156) stays while Bottles is removed
        return Path("/var/lib/flatpak/exports/share/applications/com.usebottles.bottles.desktop").is_file()
    if key == "devtools":
        return bool(shutil.which("gcc")) and is_installed("com.vscodium.codium.desktop")
    return False


def run(cmd, wait=True):
    if DRYRUN:
        print("DRYRUN:", " ".join(cmd), flush=True)
        return
    try:
        if wait:
            subprocess.run(cmd)
        else:
            subprocess.Popen(cmd, start_new_session=True)
    except OSError as err:
        print(f"simpleos-welcome-wizard: {cmd[0]}: {err}", file=sys.stderr)


# ---------------------------------------------------------- Network (nmcli)
# The same logic as simpleos-wifi, only as a GTK page. All calls catch errors: if nmcli is missing or
# hangs, the page shows "not connected" instead of crashing.
def nmcli(*args, timeout=15, input=None):
    try:
        # English messages (states, "enabled"/"disabled" are compared below), UTF-8 for names with umlauts
        return subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout, input=input,
                              env=dict(os.environ, LC_ALL="C.UTF-8"))
    except (OSError, subprocess.TimeoutExpired) as err:
        return subprocess.CompletedProcess(["nmcli", *args], 1, "", str(err))


def split_terse(line):
    """nmcli -t: fields separated by ':', ':' and '\\' in values escaped with '\\'."""
    fields, cur, escaped = [], "", False
    for ch in line:
        if escaped:
            cur, escaped = cur + ch, False
        elif ch == "\\":
            escaped = True
        elif ch == ":":
            fields.append(cur)
            cur = ""
        else:
            cur += ch
    fields.append(cur)
    return fields


def ipv4(dev):
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", dev, "scope", "global"],
                             capture_output=True, text=True, timeout=5).stdout.split()
        return out[3].split("/")[0] if len(out) > 3 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def network_state():
    """{'wifi': device|None, 'radio': bool, 'kind': 'wifi'|'ethernet'|None, 'name': connection, 'ip': IPv4}"""
    state = {"wifi": None, "radio": True, "kind": None, "name": "", "ip": ""}
    for line in nmcli("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device").stdout.splitlines():
        dev, typ, st, conn = (split_terse(line) + ["", "", "", ""])[:4]
        if typ == "wifi" and not state["wifi"]:
            state["wifi"] = dev
        if typ in ("wifi", "ethernet") and st.startswith("connected") and not state["kind"]:
            state.update(kind=typ, name=conn, ip=ipv4(dev))
    state["radio"] = nmcli("radio", "wifi").stdout.strip() != "disabled"
    return state


def wifi_networks(dev, rescan="auto"):
    """[(ssid, signal, secured, in_use)] – one line per network, the connected and strongest first."""
    best = {}
    out = nmcli("-t", "-f", "IN-USE,SIGNAL,SECURITY,SSID", "device", "wifi", "list", "ifname", dev,
                "--rescan", rescan, timeout=30).stdout
    for line in out.splitlines():
        in_use, signal, security, ssid = (split_terse(line) + ["", "", "", ""])[:4]
        if not ssid:
            continue  # hidden networks
        sig = int(signal) if signal.isdigit() else 0
        old = best.get(ssid)
        if not old or sig > old[1] or in_use == "*":
            best[ssid] = (ssid, max(sig, old[1] if old else 0), security not in ("", "--"),
                          in_use == "*" or bool(old and old[3]))
    return sorted(best.values(), key=lambda n: (not n[3], -n[1]))


def network_view(state, nets, other_network=False):
    """What the Internet page shows. Online: only "You're online" and Next – the Wi-Fi list stays hidden until
    "Use a different network" is clicked (other_network). Offline: the Wi-Fi list with numbered steps. The
    connected network can't be disconnected here (nobody should end up offline in a setup wizard).
    No interface names. Returns: status, online, hint, show_list, rows [(ssid, info, secured, in_use)], action
    (button text or None = no button)"""
    has_wifi, radio = bool(state.get("wifi")), bool(state.get("radio", True))
    current = next((n[0] for n in nets if n[3]), "")
    kind = state.get("kind")
    if kind == "wifi":
        status = _("You're online – connected to {network}").format(network=current or state.get('name') or 'Wi-Fi')
    elif kind == "ethernet":
        status = _("You're online – connected with a network cable")
    else:
        status = _("Not connected yet")
    rows = [(ssid, _("Connected") if in_use else signal_word(signal) + (_(" · needs password") if secured else _(" · open")),
             secured, in_use)
            for ssid, signal, secured, in_use in nets]
    show_list = has_wifi and radio and (not kind or other_network)
    if kind and not show_list:
        hint = _("Click Next to continue.")
        action = _("Use a different network") if has_wifi and radio else None
    elif not has_wifi:
        hint = _("This computer has no Wi-Fi. Plug in a network cable – it connects by itself.")
        action = _("Check again")
    elif not radio:
        hint = _("Wi-Fi is turned off. Click \"Turn on Wi-Fi\" to see the networks around you.")
        action = _("Turn on Wi-Fi")
    elif not rows:
        hint = _("No Wi-Fi networks found nearby. Move closer to your router and click \"Search again\".")
        action = _("Search again")
    elif kind:
        hint = _("To switch, click another network, type its password if it needs one, then click Connect.")
        action = _("Search again")
    else:
        hint = (_("1. Click your Wi-Fi network.   2. Type its password (often on a sticker on your router).   "
                "3. Click Connect."))
        action = _("Search again")
    return {"status": status, "online": bool(kind), "hint": hint, "show_list": show_list,
            "rows": rows, "action": action}


def signal_word(signal):
    return _("Strong signal") if signal >= 70 else _("Good signal") if signal >= 40 else _("Weak signal")


def saved_networks():
    """Names of the saved connections (nmcli -t escapes ':' and '\\')."""
    return [split_terse(line)[0] for line in nmcli("-t", "-f", "NAME", "connection", "show").stdout.splitlines()]


def connect_wifi(dev, ssid, password, secured=False):
    """(ok, message in plain language). Saved network + new password: delete the old profile and connect again
    (otherwise NetworkManager would keep trying the old, wrong one)."""
    if DRYRUN:
        print(f"DRYRUN: nmcli device wifi connect {ssid} ifname {dev}", flush=True)
        return True, _("Connected to {ssid}. You're online.").format(ssid=ssid)
    saved = ssid in saved_networks()
    if saved and password:
        # a new password for a saved network: delete the old profile, the connection below creates a new one
        # (the password is given on stdin, never on the command line – visible in the process list)
        nmcli("connection", "delete", "id", ssid)
        saved = False
    if saved and nmcli("--wait", "20", "connection", "up", "id", ssid, timeout=40).returncode == 0:
        return True, _("Connected to {ssid}. You're online.").format(ssid=ssid)
    cmd = ["--wait", "30", "device", "wifi", "connect", ssid, "ifname", dev]
    if password:
        cmd = ["--ask", *cmd]    # nmcli asks for the password and reads it from stdin
    result = nmcli(*cmd, timeout=60, input=f"{password}\n" if password else None)
    if result.returncode == 0:
        return True, _("Connected to {ssid}. You're online.").format(ssid=ssid)
    print(f"simpleos-welcome-wizard: connect {ssid}: {result.stderr.strip()}", file=sys.stderr)
    if not saved:  # do not leave a failed, newly created profile behind
        nmcli("connection", "delete", "id", ssid)
    if password:
        return False, _("That didn't work. The password may be wrong – please check it and try again.")
    if saved and secured:
        return False, _("That didn't work. The saved password may be wrong – please type the password and try again.")
    return False, _("That didn't work. Move closer to your router and try again.")


# ------------------------------------------------------------------ Window
class Wizard(Gtk.Window):
    def __init__(self):
        super().__init__(title=_("Simple OS Setup"))
        self.set_default_size(760, 540)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("preferences-desktop")
        self.get_style_context().add_class("simpleos")
        self.connect("destroy", Gtk.main_quit)
        self.connect("delete-event", lambda *_: self.busy)  # do not close during the installation

        theme = current_theme()
        self.browser = current_browser()
        self.mode = theme["mode"] if theme["mode"] in ("dark", "light") else "dark"
        self.accent = theme["accent"] if theme["accent"] in dict(ACCENTS) else "blue"
        self.office = current_office()
        self.components = {key: False for key, *_ in COMPONENTS}   # what to add (#126) – never preselected
        self.online = True
        self.open_store = False
        self.busy = False

        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # radio buttons, switches, progress bar in the accent (gtk-accent's rules, below the wizard's own)
        self.accent_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self.accent_css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION - 1)
        self.apply_css()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # Step indicator
        steps = Gtk.Box(spacing=20, halign=Gtk.Align.CENTER, margin_top=18, margin_bottom=6)
        self.step_labels = []
        for i, name in enumerate(STEPS):
            label = Gtk.Label(label=f"{i + 1}  {_(name)}")
            label.get_style_context().add_class("step")
            steps.pack_start(label, False, False, 0)
            self.step_labels.append(label)
        root.pack_start(steps, False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               transition_duration=220)
        for page in (self.page_welcome(), self.page_network(), self.page_browser(), self.page_appearance(),
                     self.page_office(), self.page_components(), self.page_apps()):
            self.stack.add(page)
        self.progress_page = self.page_progress()  # not in STEPS: only after "Finish"
        self.stack.add(self.progress_page)
        root.pack_start(self.stack, True, True, 0)

        # Footer
        footer = Gtk.Box(spacing=8)
        footer.get_style_context().add_class("footer")
        self.skip_btn = Gtk.Button(label=_("Skip setup"))
        self.skip_btn.set_tooltip_text(_("Keep the defaults and don't show this again"))
        self.skip_btn.connect("clicked", self.on_skip)
        footer.pack_start(self.skip_btn, False, False, 0)
        self.next_btn = Gtk.Button(label=_("Next"))
        self.next_btn.get_style_context().add_class("suggested-action")
        self.next_btn.connect("clicked", self.on_next)
        footer.pack_end(self.next_btn, False, False, 0)
        self.back_btn = Gtk.Button(label=_("Back"))
        self.back_btn.connect("clicked", self.on_back)
        footer.pack_end(self.back_btn, False, False, 0)
        root.pack_end(footer, False, False, 0)

        self.page = 0
        self.skip_network = False  # online at the start -> the Internet step is skipped (#63)
        self.show_all()
        self.update_firefox_note()
        self.go_to(int(os.environ.get("SIMPLEOS_WIZARD_PAGE", "0")))
        self.next_btn.grab_focus()
        threading.Thread(target=lambda: GLib.idle_add(self.network_checked, network_state()), daemon=True).start()

    def network_checked(self, state):
        """Already online (cable, known Wi-Fi)? Then nobody needs the Internet step."""
        if state.get("kind") and self.page != NETWORK_PAGE:
            self.skip_network = True
            self.step_labels[NETWORK_PAGE].set_text(f"{NETWORK_PAGE + 1}  {_(STEPS[NETWORK_PAGE])} \u2714")
            self.step_labels[NETWORK_PAGE].set_tooltip_text(_("You're already online"))
        return False

    # ------------------------------------------------------------ Helpers
    def apply_css(self):
        """the chosen mode and accent, live (#158)"""
        light = self.mode == "light"
        colors = dict(PALETTES["light" if light else "dark"],
                      ACCENT=LATTE_ACCENTS[self.accent] if light else dict(ACCENTS)[self.accent])
        css = CSS
        for key, value in colors.items():
            css = css.replace(f"@{key}@", value)
        self.css.load_from_data(css.encode())
        settings = Gtk.Settings.get_default()
        settings.set_property("gtk-theme-name", "Arc-Lighter" if light else "Arc-Dark")
        settings.set_property("gtk-application-prefer-dark-theme", not light)
        rules = ""
        if os.access(GTK_ACCENT, os.X_OK) and not DRYRUN:
            try:
                rules = subprocess.run([GTK_ACCENT, "--accent", self.accent, "--mode", self.mode, "--show"],
                                       capture_output=True, text=True, timeout=10).stdout
            except (OSError, subprocess.TimeoutExpired):
                rules = ""
        try:
            self.accent_css.load_from_data(rules.encode())
        except GLib.Error:
            self.accent_css.load_from_data(b"")

    @staticmethod
    def page_box(title, subtitle):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                      margin_start=48, margin_end=48, margin_top=18, margin_bottom=18)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("title")
        s = Gtk.Label(label=subtitle, xalign=0, wrap=True, max_width_chars=WRAP_CHARS)
        s.get_style_context().add_class("subtitle")
        box.pack_start(t, False, False, 0)
        box.pack_start(s, False, False, 0)
        return box

    @staticmethod
    def card():
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        frame.get_style_context().add_class("card")
        return frame

    @staticmethod
    def dim(text):
        label = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=WRAP_CHARS)
        label.get_style_context().add_class("dim")
        return label

    # ------------------------------------------------------------ Pages
    def page_welcome(self):
        box = self.page_box(_("Welcome to Simple OS"),
                            _("Let's set up a few things. This takes less than a minute."))
        logo_path = Path("/usr/share/simpleos/logo.png")
        if logo_path.exists():
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(str(logo_path), 72, 72)
            box.pack_start(Gtk.Image.new_from_pixbuf(pixbuf), False, False, 0)
            box.reorder_child(box.get_children()[-1], 0)
        card = self.card()
        grid = Gtk.Grid(column_spacing=24, row_spacing=8)
        for row, (key, value) in enumerate(system_info()):
            k = Gtk.Label(label=key, xalign=0)
            k.get_style_context().add_class("key")
            v = Gtk.Label(label=value, xalign=0, ellipsize=3)  # 3 = Pango END
            grid.attach(k, 0, row, 1, 1)
            grid.attach(v, 1, row, 1, 1)
        card.pack_start(grid, False, False, 0)
        box.pack_start(card, False, False, 0)
        return box

    def page_network(self):
        box = self.page_box(_("Connect to the internet"),
                            _("The next steps download your browser and apps, so Simple OS needs the internet once."))
        card = self.card()
        self.net_status = Gtk.Label(label=_("Checking your connection ..."), xalign=0, wrap=True, max_width_chars=WRAP_CHARS)
        self.net_status.get_style_context().add_class("option-name")
        card.pack_start(self.net_status, False, False, 0)
        self.net_hint = self.dim("")
        card.pack_start(self.net_hint, False, False, 0)

        # Wi-Fi list (only visible with a Wi-Fi adapter)
        # A single click selects (the password field appears), double click/Enter connects
        self.net_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False)
        self.net_list.connect("row-selected", self.on_network_selected)
        self.net_list.connect("row-activated", lambda *_: self.on_network_connect(None))
        self.net_scroll = Gtk.ScrolledWindow(min_content_height=150, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.net_scroll.add(self.net_list)
        card.pack_start(self.net_scroll, True, True, 0)

        self.net_password_label = Gtk.Label(xalign=0)
        card.pack_start(self.net_password_label, False, False, 0)
        row = Gtk.Box(spacing=8)
        self.net_password = Gtk.Entry(visibility=False, placeholder_text=_("Wi-Fi password"), hexpand=True)
        self.net_password.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        self.net_password.set_icon_tooltip_text(Gtk.EntryIconPosition.SECONDARY, _("Show the password"))
        self.net_password.connect("icon-press", lambda e, *_: e.set_visibility(not e.get_visibility()))
        self.net_password.connect("activate", self.on_network_connect)
        row.pack_start(self.net_password, True, True, 0)
        self.net_connect_btn = Gtk.Button(label=_("Connect"))
        self.net_connect_btn.connect("clicked", self.on_network_connect)
        row.pack_start(self.net_connect_btn, False, False, 0)
        self.net_action_btn = Gtk.Button(label=_("Search again"))  # also: "Turn on Wi-Fi", "Check again", ...
        self.net_action_btn.connect("clicked", self.on_network_action)
        row.pack_end(self.net_action_btn, False, False, 0)
        card.pack_start(row, False, False, 0)
        self.net_card = card
        box.pack_start(card, True, True, 0)
        self.net_later = self.dim(_("Not now? Just click Next. Later, click the network display in the taskbar "
                                  "(bottom right) to connect."))
        box.pack_start(self.net_later, False, False, 0)
        self.net_state = {}
        self.net_busy = False
        self.net_message = ""
        self.net_other = False  # "Use a different network" was clicked
        self.net_then_next = False  # Next was clicked with a typed password: connect first, then continue
        return box

    # --- Internet page: background threads for nmcli, GUI updates via GLib.idle_add
    def refresh_network(self, rescan="auto"):
        if self.net_busy:
            return
        self.net_busy = True
        self.net_status.set_text(_("Checking your connection ..."))
        self.net_action_btn.set_sensitive(False)
        self.net_connect_btn.set_sensitive(False)

        def work():
            state = network_state()
            nets = wifi_networks(state["wifi"], rescan) if state["wifi"] and state["radio"] else []
            GLib.idle_add(self.show_network, state, nets)
        threading.Thread(target=work, daemon=True).start()

    def show_network(self, state, nets):
        self.net_busy = False
        self.net_state = state
        view = network_view(state, nets, self.net_other)
        self.net_status.set_text(view["status"])
        ctx = self.net_status.get_style_context()
        (ctx.add_class if view["online"] else ctx.remove_class)("online")
        (ctx.remove_class if view["online"] else ctx.add_class)("offline")
        self.net_hint.set_text(self.net_message or view["hint"])  # success/error after Connect takes precedence
        self.net_message = ""
        self.net_action_btn.set_label(view["action"] or "")
        self.net_action_btn.set_visible(bool(view["action"]))
        for child in self.net_list.get_children():
            self.net_list.remove(child)
        for ssid, info, secured, in_use in view["rows"]:
            line = Gtk.Box(spacing=12)
            if in_use:
                line.pack_start(Gtk.Label(label="✔"), False, False, 0)
            name = Gtk.Label(label=ssid, xalign=0, ellipsize=3)
            name.get_style_context().add_class("option-name")
            line.pack_start(name, True, True, 0)
            line.pack_end(self.dim(info), False, False, 0)
            row = Gtk.ListBoxRow()
            row.add(line)
            row.network = (ssid, secured, in_use)
            self.net_list.add(row)
        for widget in (self.net_scroll, self.net_connect_btn):
            widget.set_visible(view["show_list"])
        self.net_card.set_valign(Gtk.Align.FILL if view["show_list"] else Gtk.Align.START)
        self.net_later.set_visible(not view["online"])
        self.net_list.show_all()
        self.net_password.set_visible(False)  # only when a network with a password is selected
        self.net_password_label.set_visible(False)
        self.net_connect_btn.set_sensitive(False)
        self.net_action_btn.set_sensitive(True)
        if view["online"] and not view["show_list"] and self.page == NETWORK_PAGE:
            self.next_btn.grab_focus()  # Enter continues
        return False

    def on_network_selected(self, _box, row):
        ssid, secured, in_use = getattr(row, "network", ("", False, False)) if row else ("", False, False)
        ask = bool(row) and secured and not in_use
        self.net_password.set_visible(ask)
        self.net_password.set_visibility(False)
        self.net_password.set_text("")
        self.net_password_label.set_text(_('Password for “{ssid}”:').format(ssid=ssid) if ask else "")
        self.net_password_label.set_visible(ask)
        self.net_connect_btn.set_sensitive(bool(row) and not in_use and not self.net_busy)
        if ask:
            self.net_password.grab_focus()

    def on_network_connect(self, _widget):
        row = self.net_list.get_selected_row()
        if not row or self.net_busy or not self.net_state.get("wifi"):
            return
        ssid, secured, in_use = row.network
        if in_use:
            return
        dev = self.net_state["wifi"]
        password = self.net_password.get_text() if secured else ""
        if secured and not password and ssid not in saved_networks():
            self.net_hint.set_text(_('Please type the password for "{ssid}", then click Connect.').format(ssid=ssid))
            self.net_password.grab_focus()
            return
        work = lambda: connect_wifi(dev, ssid, password, secured)  # noqa: E731
        self.net_status.set_text(_('Connecting to {ssid} ...').format(ssid=ssid))
        self.net_busy = True
        self.net_connect_btn.set_sensitive(False)
        self.net_action_btn.set_sensitive(False)

        def run_work():
            ok, message = work()
            GLib.idle_add(self.network_connected, ok, message)
        threading.Thread(target=run_work, daemon=True).start()

    def network_connected(self, ok, message):
        self.net_busy = False
        then_next, self.net_then_next = self.net_then_next, False
        if ok:
            self.net_message = message + _(" Click Next to continue.")  # show_network shows it after reloading
            self.net_other = False
            if then_next and self.page == NETWORK_PAGE:
                self.go_to(NETWORK_PAGE + 1)
                return False
            self.refresh_network(rescan="no")
        else:
            self.net_status.set_text(message)
            self.net_connect_btn.set_sensitive(True)
            self.net_action_btn.set_sensitive(True)
            self.net_password.grab_focus()
        return False

    def on_network_action(self, _btn):
        if self.net_state.get("kind") and not self.net_other:  # "Use a different network"
            self.net_other = True
            self.refresh_network(rescan="yes")
            return
        if self.net_state.get("wifi") and not self.net_state.get("radio"):
            if not DRYRUN:
                nmcli("radio", "wifi", "on")
            GLib.timeout_add_seconds(3, lambda: self.refresh_network(rescan="yes") and False)
            self.net_status.set_text(_("Turning on Wi-Fi ..."))
            return
        self.refresh_network(rescan="yes")

    def page_browser(self):
        box = self.page_box(_("Choose your web browser"),
                            _("Links and Super+B open this browser. Missing browsers are installed for you."))
        self.firefox_note = self.dim("")  # before the radios: their "toggled" updates the hint
        card = self.card()
        group = None
        for desktop_id, name, desc in BROWSERS:
            status = _("installed") if is_installed(desktop_id) else _("will be installed")
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            n = Gtk.Label(label=f"{name}   ·   {status}", xalign=0)
            n.get_style_context().add_class("option-name")
            text.pack_start(n, False, False, 0)
            text.pack_start(self.dim(desc), False, False, 0)
            radio.add(text)
            radio.set_active(desktop_id == self.browser)
            radio.connect("toggled", self.on_browser, desktop_id)
            card.pack_start(radio, False, False, 2)
        box.pack_start(card, False, False, 0)
        box.pack_start(self.firefox_note, False, False, 0)
        box.pack_start(self.dim(_("You can change this later in Control Center → Apps.")), False, False, 0)
        return box

    def page_appearance(self):
        box = self.page_box(_("Make it yours"),
                            _("Pick a style for your apps and an accent color for menus, panel and windows."))
        card = self.card()
        mode_label = Gtk.Label(label=_("Apps"), xalign=0)
        mode_label.get_style_context().add_class("option-name")
        card.pack_start(mode_label, False, False, 0)
        modes = Gtk.Box(spacing=24)
        dark = Gtk.RadioButton.new_with_label(None, _("Dark"))
        light = Gtk.RadioButton.new_with_label_from_widget(dark, _("Light"))
        (light if self.mode == "light" else dark).set_active(True)
        dark.connect("toggled", self.on_mode, "dark")
        light.connect("toggled", self.on_mode, "light")
        modes.pack_start(dark, False, False, 0)
        modes.pack_start(light, False, False, 0)
        card.pack_start(modes, False, False, 0)
        card.pack_start(self.dim(_("The panel, menus and terminal always stay dark.")), False, False, 0)

        accent_label = Gtk.Label(label=_("Accent color"), xalign=0, margin_top=8)
        accent_label.get_style_context().add_class("option-name")
        card.pack_start(accent_label, False, False, 0)
        swatches = Gtk.Box(spacing=12)
        group = None
        provider = Gtk.CssProvider()
        provider.load_from_data("".join(
            f".simpleos .swatch-{n} {{ background-color: {h}; }}" for n, h in ACCENTS).encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        for name, _hex in ACCENTS:
            swatch = Gtk.RadioButton.new_from_widget(group)
            group = group or swatch
            swatch.set_mode(False)  # draw as a button, without the radio circle
            swatch.set_tooltip_text(_(ACCENT_NAMES[name]))
            ctx = swatch.get_style_context()
            ctx.add_class("swatch")
            ctx.add_class(f"swatch-{name}")
            swatch.set_active(name == self.accent)
            swatch.connect("toggled", self.on_accent, name)
            swatches.pack_start(swatch, False, False, 0)
        card.pack_start(swatches, False, False, 0)
        box.pack_start(card, False, False, 0)
        return box

    def option_card(self, options, current, callback, status=None):
        """Card with radio options (key, name, description, ...)."""
        card = self.card()
        group = None
        for key, name, desc, *_ in options:
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            suffix = status(key) if status else ""
            n = Gtk.Label(label=f"{name}   ·   {suffix}" if suffix else name, xalign=0)
            n.get_style_context().add_class("option-name")
            text.pack_start(n, False, False, 0)
            text.pack_start(self.dim(desc), False, False, 0)
            radio.add(text)
            radio.set_active(key == current)
            radio.connect("toggled", lambda r, k: r.get_active() and callback(k), key)
            card.pack_start(radio, False, False, 2)
        return card

    def page_office(self):
        box = self.page_box(_("Office suite"),
                            _("Documents, spreadsheets and presentations. Pick one or keep the system minimal."))

        def status(key):
            desktop_id = dict((k, d) for k, _n, _s, d in OFFICE)[key]
            if not desktop_id:
                return ""
            return _("installed") if is_installed(desktop_id) else _("will be installed")
        box.pack_start(self.option_card(OFFICE, self.office, lambda k: setattr(self, "office", k), status),
                       False, False, 0)
        box.pack_start(self.dim(_("Already installed office apps are not removed.")), False, False, 0)
        return box

    def page_components(self):
        box = self.page_box(_("Optional components"),
                            _("Add extras now or later in the Software Center. Nothing is installed unless you turn it on."))
        card = self.card()
        self.component_switches = {}
        for key, name, desc, size, _arg in COMPONENTS:
            row = Gtk.Box(spacing=16)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            done = component_installed(key)
            n = Gtk.Label(label=f"{name}   ·   {_('installed') if done else size}", xalign=0)
            n.get_style_context().add_class("option-name")
            text.pack_start(n, False, False, 0)
            text.pack_start(self.dim(desc), False, False, 0)
            row.pack_start(text, True, True, 0)
            switch = Gtk.Switch(valign=Gtk.Align.CENTER, active=done, sensitive=not done)
            switch.connect("notify::active", self.on_component, key)
            row.pack_end(switch, False, False, 0)
            self.component_switches[key] = switch
            card.pack_start(row, False, False, 4)
        box.pack_start(card, False, False, 0)
        self.components_note = self.dim("")
        self.components_note.set_max_width_chars(WRAP_CHARS)   # wrap inside the fixed 760 px window instead of widening it
        box.pack_start(self.components_note, False, False, 0)
        links = Gtk.Box(spacing=12)
        help_link = Gtk.LinkButton(uri="https://usebottles.com", label=_("What runs with SOS Bridge?"),
                                   halign=Gtk.Align.START)
        help_link.connect("activate-link", lambda *_: run(["simpleos-windows-app", "--help-page"], wait=False) or True)
        links.pack_start(help_link, False, False, 0)
        box.pack_start(links, False, False, 0)
        box.pack_start(self.dim(_("Gaming Support: by turning it on you accept the Steam license agreement "
                                "(store.steampowered.com/subscriber_agreement).")), False, False, 0)
        self.update_components_note()
        return box

    def on_component(self, switch, _param, key):
        if switch.get_sensitive():         # an installed component's switch is only shown, not chosen
            self.components[key] = switch.get_active()
        self.update_components_note()

    def update_components_note(self):
        if not self.online:
            text = (_("You're offline – connect to the internet (step 2) to add these now, "
                    "or add them later in the Software Center."))
        else:
            chosen = [name for key, name, *_ in COMPONENTS if self.components.get(key)]
            if not chosen:
                text = _("Nothing selected – you can add these later in the Software Center.")
            else:
                text = _('Selected: {components} – additional downloads, installed at the end of the '
                         'setup.').format(components=', '.join(chosen))
        self.components_note.set_text(text)

    def components_checked(self, state):
        """Online? Without internet the switches wait for later (a download would only fail)."""
        self.online = bool(state.get("kind")) or DRYRUN
        for key, switch in self.component_switches.items():
            if not component_installed(key):
                switch.set_sensitive(self.online)
                if not self.online:
                    switch.set_active(False)
                    self.components[key] = False
        self.update_components_note()
        return False

    def page_progress(self):
        box = self.page_box(_("Installing your software"),
                            _("You will be asked for your password once. Please keep this window open."))
        card = self.card()
        row = Gtk.Box(spacing=12)
        self.spinner = Gtk.Spinner()
        row.pack_start(self.spinner, False, False, 0)
        self.status_label = Gtk.Label(label=_("Starting ..."), xalign=0, wrap=True, max_width_chars=WRAP_CHARS)
        self.status_label.get_style_context().add_class("option-name")
        row.pack_start(self.status_label, True, True, 0)
        card.pack_start(row, False, False, 0)
        # real progress (PROGRESS lines from simpleos-system-setup: apt and Flatpak), otherwise only the spinner
        self.stage_label = Gtk.Label(label="", xalign=0, wrap=True, max_width_chars=WRAP_CHARS)
        self.stage_label.get_style_context().add_class("dim-label")
        card.pack_start(self.stage_label, False, False, 0)
        self.bar = Gtk.ProgressBar(show_text=True, no_show_all=True)
        card.pack_start(self.bar, False, False, 0)
        self.step_t0 = time.monotonic()
        self.helper_log = []
        self.log_view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                     wrap_mode=Gtk.WrapMode.CHAR)
        scroll = Gtk.ScrolledWindow(min_content_height=180)
        scroll.add(self.log_view)
        expander = Gtk.Expander(label=_("Details"))
        expander.add(scroll)
        card.pack_start(expander, True, True, 0)
        box.pack_start(card, True, True, 0)
        return box

