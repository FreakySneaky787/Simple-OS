#!/usr/bin/env python3
"""Simple OS – Camera (Menu → Apps → Camera): see the webcam and take photos (#44).

The camera works on most laptops, but nothing in the image could show it – you only found out in the first video call.
One window: the picture like a mirror, "Take Photo" (or Space) saves a JPEG (not mirrored, like others see you) to
Pictures/Camera, "Open Folder" shows them. Several cameras: a choice in the title bar. Cameras plugged in or removed
while the window is open appear/disappear by themselves (Gst.DeviceMonitor). No camera, or one busy in another app:
a plain explanation instead of an error.

  simpleos-camera

GTK 3 + GStreamer (gir1.2-gstreamer-1.0, gir1.2-gst-plugins-base-1.0, gstreamer1.0-gtk3; v4l2src/jpegdec from
gstreamer1.0-plugins-good). Picture: v4l2src ! capsfilter (best_caps: the largest size up to 1080p with at least
15 frames per second) ! decodebin ! videoconvert ! tee – one branch mirrored to gtksink, the other to an appsink that
always holds the newest frame for the photo.
Tests: SIMPLEOS_CAMERA_SELFTEST=1 builds the window, takes a photo after 2.5 s if there is a camera, ends after 5 s;
exit 1 on a Python exception or if a shown camera saved no photo (99_verify with Broadway).
SIMPLEOS_CAMERA_TEST_SOURCE=ELEMENT (e.g. "videotestsrc is-live=true") = one camera "Test camera" from that element.
"""
import datetime
import os
import re
import subprocess
import sys
from pathlib import Path

NO_CAMERA = ("No camera found",
             "Laptops: look for a camera switch on the side, a key with a camera symbol (often F8 or F10), or a small "
             "cover that slides over the lens.\nUSB cameras: plug it in – it appears here by itself.")
MAX_AREA = 1920 * 1080
# The picture like a mirror. Not "method=horizontal-flip": GStreamer 1.22 ignores that (deprecated) property – the
# preview stayed unmirrored (VM 2026-10-29)
MIRROR = "videoflip video-direction=horiz"


def photo_dir():
    """Pictures/Camera of the user (xdg-user-dir; it prints the home folder when Pictures is not set up)"""
    home = Path.home()
    try:
        pics = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pics = ""
    base = Path(pics) if pics and Path(pics) != home else home / "Pictures"
    return base / "Camera"


def photo_path(folder, now=None):
    """folder/"Photo 2026-10-29 20-31-05.jpg" – " (2)", " (3)" … when two photos are taken in the same second"""
    stem = (now or datetime.datetime.now()).strftime("Photo %Y-%m-%d %H-%M-%S")
    path, n = folder / f"{stem}.jpg", 2
    while path.exists():
        path, n = folder / f"{stem} ({n}).jpg", n + 1
    return path


def camera_label(name):
    """"Integrated Camera: Integrated C" (the driver repeats a shortened name) -> "Integrated Camera" """
    first, sep, second = (name or "").partition(": ")
    if sep and first.startswith(second.strip()):
        return first.strip()
    return (name or "Camera").strip() or "Camera"


def numbered(labels):
    """Two cameras of the same model ("vivid", "vivid") -> "vivid", "vivid 2" – the choice must tell them apart"""
    seen, out = {}, []
    for label in labels:
        seen[label] = seen.get(label, 0) + 1
        out.append(label if seen[label] == 1 else f"{label} {seen[label]}")
    return out


def _fps(text):
    """Frame rates of a caps structure: "framerate=(fraction){ 30/1, 15/1 }", "=(fraction)30/1", "[ 1/1, 60/1 ]"
    -> [(30, 1), (15, 1)] …"""
    m = re.search(r"framerate=\(fraction\)(\{[^}]*\}|\[[^\]]*\]|[0-9]+/[0-9]+)", text)
    if not m:
        return [], False
    rates = [(int(a), int(b)) for a, b in re.findall(r"([0-9]+)/([0-9]+)", m.group(1)) if int(b)]
    return rates, m.group(1).startswith("[")


def best_caps(structures):
    """From a camera's caps structures (strings) the caps to ask for: the largest size up to 1080p that comes with at
    least 15 frames per second (raw before MJPEG of the same size – no decoding), 30 fps if offered. Many webcams give
    their full size raw at only 5–10 fps – that picture stutters. None = let GStreamer choose."""
    cands = []
    for s in structures:
        media = s.split(",", 1)[0].strip()
        if media not in ("video/x-raw", "image/jpeg"):
            continue
        w, h = re.search(r"width=\(int\)([0-9]+)", s), re.search(r"height=\(int\)([0-9]+)", s)
        if not w or not h:
            continue
        w, h = int(w.group(1)), int(h.group(1))
        rates, is_range = _fps(s)
        if not rates:
            continue
        if is_range:
            lo, hi = min(rates, key=lambda r: r[0] / r[1]), max(rates, key=lambda r: r[0] / r[1])
            rate = (30, 1) if lo[0] / lo[1] <= 30 <= hi[0] / hi[1] else hi
        else:
            upto = [r for r in rates if r[0] / r[1] <= 30.5]
            rate = max(upto or rates, key=lambda r: r[0] / r[1])
        fmt = re.search(r"format=\(string\)([A-Za-z0-9_]+)", s)
        caps = f"{media},width={w},height={h},framerate={rate[0]}/{rate[1]}"
        if media == "video/x-raw" and fmt:
            caps = f"{media},format={fmt.group(1)},width={w},height={h},framerate={rate[0]}/{rate[1]}"
        fps = rate[0] / rate[1]
        cands.append(((fps >= 15, w * h <= MAX_AREA, min(w * h, MAX_AREA), min(fps, 30), media == "video/x-raw"), caps))
    return max(cands)[1] if cands else None


def explain(message, debug="", kind=""):
    """GStreamer's error -> (title, text) in plain language. kind = "busy"/"denied"/"gone" from the error code – the
    message itself is in the system language ("Gerät »/dev/video0« ist belegt"), the English words only match on
    English systems (VM 2026-10-29)"""
    text = f"{message} {debug}".lower()
    if kind == "busy" or "busy" in text:
        return ("The camera is in use",
                "Another app is using the camera right now – a video call or a browser tab. Close it and try again.")
    if kind == "denied" or "permission denied" in text:
        return ("The camera could not be opened", "Simple OS was not allowed to use the camera. Restart the computer "
                "and try again.")
    if kind == "gone" or "no such file" in text or "not found" in text or "disconnected" in text:
        return NO_CAMERA
    return ("The camera could not be started", f"Unplug and reconnect it, or restart the computer. ({message})")


def main():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("Pango", "1.0")
    from gi.repository import Gdk, GLib, Gtk, Pango
    try:
        gi.require_version("Gst", "1.0")
        gi.require_version("GstVideo", "1.0")
        from gi.repository import Gst, GstVideo
        Gst.init(None)
        missing = [e for e in ("gtksink", "v4l2src", "decodebin", "videoflip", "jpegenc", "appsink")
                   if not Gst.ElementFactory.find(e)]
    except (ValueError, ImportError) as err:
        missing = [str(err)]
    if missing:
        print(f"simpleos-camera: missing: {', '.join(missing)}", file=sys.stderr)
        if os.environ.get("SIMPLEOS_CAMERA_SELFTEST") == "1":
            return 1
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.OK,
                              text="Parts of the camera app are missing")
        d.format_secondary_text("Open Software Updates and install all updates, then try again. "
                                f"(missing: {', '.join(missing)})")
        d.run()
        return 1

    selftest = os.environ.get("SIMPLEOS_CAMERA_SELFTEST") == "1"
    test_source = os.environ.get("SIMPLEOS_CAMERA_TEST_SOURCE", "")
    errors = []
    if selftest:
        def hook(etype, value, tb):
            errors.append(value)
            sys.__excepthook__(etype, value, tb)
        sys.excepthook = hook

    class CameraWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="Camera")
            self.set_default_size(820, 640)
            self.set_icon_name("accessories-camera")
            self.pipeline = self.snap = None
            self.cameras = []          # [(label, path or None, source element description, caps or None)]
            self.current = None
            self.saved = []
            hb = Gtk.HeaderBar(show_close_button=True, title="Camera")
            self.choice = Gtk.ComboBoxText(no_show_all=True)
            self.choice_handler = self.choice.connect("changed", lambda c: self.start(c.get_active_id()))
            hb.pack_start(self.choice)
            self.set_titlebar(hb)

            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            self.overlay = Gtk.Overlay()
            self.view_box = Gtk.Box()
            self.overlay.add(self.view_box)
            self.flash = Gtk.Box(no_show_all=True)       # white for a moment when a photo is taken
            css = Gtk.CssProvider()
            css.load_from_data(b".simpleos-flash { background-color: rgba(255, 255, 255, 0.85); }")
            self.flash.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.flash.get_style_context().add_class("simpleos-flash")
            self.overlay.add_overlay(self.flash)
            self.stack.add_named(self.overlay, "view")
            msg = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, valign=Gtk.Align.CENTER, margin=40)
            msg.pack_start(Gtk.Image.new_from_icon_name("camera-web-symbolic", Gtk.IconSize.DIALOG), False, False, 0)
            self.msg_title = Gtk.Label()
            self.msg_text = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=60)
            self.msg_text.get_style_context().add_class("dim-label")
            msg.pack_start(self.msg_title, False, False, 0)
            msg.pack_start(self.msg_text, False, False, 0)
            # after "in use": close the other app, then try again here (no restart of the window)
            self.retry = Gtk.Button(label="Try Again", halign=Gtk.Align.CENTER, no_show_all=True)
            self.retry.connect("clicked", lambda *_: self.start(self.current))
            msg.pack_start(self.retry, False, False, 6)
            self.stack.add_named(msg, "message")

            bar = Gtk.Box(spacing=12, margin=12)
            self.status = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.status.get_style_context().add_class("dim-label")
            self.shutter = Gtk.Button(label="Take Photo", image=Gtk.Image.new_from_icon_name(
                "camera-photo-symbolic", Gtk.IconSize.BUTTON), always_show_image=True)
            self.shutter.get_style_context().add_class("suggested-action")
            self.shutter.connect("clicked", lambda *_: self.take_photo())
            folder = Gtk.Button(label="Open Folder")
            folder.connect("clicked", lambda *_: self.open_folder())
            bar.pack_start(self.status, True, True, 0)
            bar.set_center_widget(self.shutter)
            bar.pack_end(folder, False, False, 0)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.pack_start(self.stack, True, True, 0)
            box.pack_start(Gtk.Separator(), False, False, 0)
            box.pack_start(bar, False, False, 0)
            self.add(box)
            self.connect("key-press-event", self.on_key)
            self.connect("destroy", lambda *_: (self.stop(), Gtk.main_quit()))

            self.monitor = None
            if not test_source:
                self.monitor = Gst.DeviceMonitor()
                self.monitor.add_filter("Video/Source", None)
                self.monitor.get_bus().add_watch(GLib.PRIORITY_DEFAULT, self.on_device_event)
                self.monitor.start()
            self.show_all()
            self.refresh_cameras()

        # ---------------------------------------------------------------- cameras
        def list_cameras(self):
            if test_source:
                return [("Test camera", None, test_source, None)]
            found, seen = [], set()
            for dev in self.monitor.get_devices() or []:
                props = dev.get_properties()
                path = None
                for key in ("api.v4l2.path", "device.path"):
                    if props and props.has_field(key):
                        path = props.get_string(key)
                        break
                if not path or not path.startswith("/dev/video") or path in seen:
                    continue
                seen.add(path)
                caps = dev.get_caps()
                structs = [caps.get_structure(i).to_string() for i in range(caps.get_size())] if caps else []
                found.append((camera_label(dev.get_display_name()), path, f"v4l2src device={path}", best_caps(structs)))
            found.sort()
            return [(lab, *rest) for lab, (_l, *rest) in zip(numbered([f[0] for f in found]), found)]

        def refresh_cameras(self):
            self.cameras = self.list_cameras()
            self.choice.handler_block(self.choice_handler)
            self.choice.remove_all()
            for label, path, src, _caps in self.cameras:
                self.choice.append(src, label)
            self.choice.set_visible(len(self.cameras) > 1)
            self.choice.handler_unblock(self.choice_handler)
            ids = [c[2] for c in self.cameras]
            if not ids:
                self.stop()
                return self.message(*NO_CAMERA)
            if self.current not in ids or not self.pipeline:
                self.start(ids[0])
            else:
                self.choice.handler_block(self.choice_handler)
                self.choice.set_active_id(self.current)
                self.choice.handler_unblock(self.choice_handler)

        def on_device_event(self, _bus, message):
            if message.type in (Gst.MessageType.DEVICE_ADDED, Gst.MessageType.DEVICE_REMOVED):
                GLib.timeout_add(300, lambda: (self.refresh_cameras(), False)[1])
            return True

        # ---------------------------------------------------------------- picture
        def message(self, title, text):
            self.msg_title.set_markup(f"<span size='large' weight='bold'>{GLib.markup_escape_text(title)}</span>")
            self.msg_text.set_text(text)
            self.retry.set_visible((title, text) != NO_CAMERA and any(c[2] == self.current for c in self.cameras))
            self.stack.set_visible_child_name("message")
            self.shutter.set_sensitive(False)

        def stop(self):
            if self.pipeline:
                self.pipeline.set_state(Gst.State.NULL)
                self.pipeline.get_bus().remove_signal_watch()
            self.pipeline = self.snap = None
            for child in self.view_box.get_children():
                self.view_box.remove(child)

        def start(self, src):
            cam = next((c for c in self.cameras if c[2] == src), None)
            if not cam:
                return
            self.stop()
            self.current = src
            self.choice.handler_block(self.choice_handler)
            self.choice.set_active_id(src)
            self.choice.handler_unblock(self.choice_handler)
            caps = f" ! {cam[3]}" if cam[3] else ""
            desc = (f"{src}{caps} ! decodebin ! videoconvert ! tee name=t "
                    f"t. ! queue ! {MIRROR} ! videoconvert ! gtksink name=view sync=false "
                    "t. ! queue leaky=downstream max-size-buffers=1 ! videoconvert ! appsink name=snap max-buffers=1 "
                    "drop=true sync=false")
            try:
                self.pipeline = Gst.parse_launch(desc)
            except GLib.Error as err:
                return self.message(*explain(err.message))
            self.snap = self.pipeline.get_by_name("snap")
            widget = self.pipeline.get_by_name("view").props.widget
            self.view_box.pack_start(widget, True, True, 0)
            widget.show()
            bus = self.pipeline.get_bus()
            bus.add_signal_watch()
            bus.connect("message::error", self.on_error)
            self.stack.set_visible_child_name("view")
            self.shutter.set_sensitive(True)
            if self.pipeline.set_state(Gst.State.PLAYING) == Gst.StateChangeReturn.FAILURE:
                self.message(*explain("could not start"))

        def on_error(self, _bus, message):
            err, debug = message.parse_error()
            print(f"simpleos-camera: {err.message} ({debug})", file=sys.stderr)
            rq = Gst.ResourceError.quark()
            kind = ("busy" if err.matches(rq, Gst.ResourceError.BUSY) else
                    "denied" if err.matches(rq, Gst.ResourceError.NOT_AUTHORIZED) else
                    "gone" if err.matches(rq, Gst.ResourceError.NOT_FOUND) else "")
            self.stop()
            self.message(*explain(err.message, debug or "", kind))

        def take_photo(self):
            """The newest frame (not mirrored) as JPEG to Pictures/Camera; False if there was none"""
            sample = self.snap.emit("try-pull-sample", Gst.SECOND // 2) if self.snap else None
            if not sample:
                self.status.set_text("No picture yet – try again in a moment.")
                return False
            try:
                jpeg = GstVideo.video_convert_sample(sample, Gst.Caps.from_string("image/jpeg"), Gst.SECOND)
                ok, info = jpeg.get_buffer().map(Gst.MapFlags.READ)
                data = bytes(info.data) if ok else b""
                if ok:
                    jpeg.get_buffer().unmap(info)
                folder = photo_dir()
                folder.mkdir(parents=True, exist_ok=True)
                path = photo_path(folder)
                path.write_bytes(data)
            except (GLib.Error, OSError) as err:
                self.status.set_text(f"The photo could not be saved: {getattr(err, 'message', err)}")
                return False
            self.saved.append(path)
            self.status.set_text(f"Saved to {folder.parent.name}/{folder.name}: {path.name}")
            self.flash.show()
            GLib.timeout_add(120, lambda: (self.flash.hide(), False)[1])
            return True

        def open_folder(self):
            folder = photo_dir()
            folder.mkdir(parents=True, exist_ok=True)
            try:
                subprocess.Popen(["xdg-open", str(folder)], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                self.status.set_text(f"Your photos are in {folder}")

        def on_key(self, _w, event):
            if event.keyval in (Gdk.KEY_space, Gdk.KEY_Return, Gdk.KEY_KP_Enter) and self.shutter.get_sensitive():
                self.take_photo()
                return True
            return False

    win = CameraWindow()
    if selftest:
        def snap():
            if win.pipeline:
                win.take_photo()
            return False

        def end():
            if win.pipeline and not any(p.is_file() and p.stat().st_size > 1000 for p in win.saved):
                errors.append(RuntimeError("camera shown, but no photo saved"))
                print("simpleos-camera: self-test: no photo saved", file=sys.stderr)
            win.destroy()
            return False
        GLib.timeout_add(2500, snap)
        GLib.timeout_add(5000, end)
    Gtk.main()
    if errors:
        print(f"simpleos-camera: {len(errors)} error(s) in self-test", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        print("simpleos-camera: no display", file=sys.stderr)
        sys.exit(1)
    sys.exit(main())
