#!/bin/sh
# Simple OS – Browser Selector: choose the default browser, install missing browsers
#   simpleos-browser-select                  selection via Rofi
#   simpleos-browser-select --set <id>       set/install directly (e.g. chromium.desktop; used by the Setup Wizard)
# List: name<TAB>desktop ID<TAB>source (apt:<package> | flatpak:<app-id> | empty = selectable only if installed)
list=$(mktemp)
trap 'rm -f "$list"' EXIT
TAB=$(printf '\t')
dirs="${XDG_DATA_HOME:-$HOME/.local/share} $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' ') /var/lib/flatpak/exports/share"

installed() {
    for dir in $dirs; do
        [ -f "$dir/applications/$1" ] && return 0
    done
    return 1
}

# Supported browsers – even if they are not installed yet
printf '%s\t%s\t%s\n' \
    "Firefox ESR"     firefox-esr.desktop               apt:firefox-esr \
    "Chromium"        chromium.desktop                  apt:chromium \
    "Mullvad Browser" net.mullvad.MullvadBrowser.desktop flatpak:net.mullvad.MullvadBrowser >> "$list"

# Other installed browsers (e.g. from the Software Store)
for dir in $dirs; do
    for f in "$dir"/applications/*.desktop; do
        [ -f "$f" ] || continue
        grep -q '^Categories=.*WebBrowser' "$f" || continue
        grep -qi '^NoDisplay=true' "$f" && continue
        id=${f##*/}
        cut -f2 "$list" | grep -qxF "$id" && continue
        printf '%s\t%s\t\n' "$(sed -n 's/^Name=//p' "$f" | head -n1)" "$id" >> "$list"
    done
done

current=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
# rofi-retry: grab error -> new attempt, rofi missing/does not start -> notification instead of a silent end
rofi_cmd=/usr/local/lib/simpleos/rofi-retry
[ -x "$rofi_cmd" ] || rofi_cmd=rofi
count=$(wc -l < "$list")

if [ "$1" = "--set" ]; then
    idx=$(cut -f2 "$list" | grep -nxF "$2" | cut -d: -f1)
    [ -n "$idx" ] || { echo "Unknown browser: $2" >&2; exit 2; }
    idx=$((idx - 1))
else
idx=$( { while IFS=$TAB read -r name id src; do
        if ! installed "$id"; then
            echo "$name   (not installed – select to install)"
        elif [ "$id" = "$current" ]; then
            echo "$name   (current)"
        else
            echo "$name"
        fi
    done < "$list"; echo "Find more browsers in the Software Store ..."; } |
    SOS_NAME=simpleos-browser-select SOS_TITLE="Browser Selector" "$rofi_cmd" -dmenu -i -no-custom -format i -p "Browser" -mesg "Choose your default web browser" \
        -theme-str 'window { width: 520px; } listview { lines: 7; } element-icon { enabled: false; }')
case "$idx" in ''|*[!0-9]*) exit 0 ;; esac
[ "$idx" -ge "$count" ] && exec simpleos-software
fi

line=$(sed -n "$((idx + 1))p" "$list")
name=$(echo "$line" | cut -f1)
id=$(echo "$line" | cut -f2)

if ! installed "$id"; then
    # Password via the graphical polkit dialog (pkexec), not in the terminal
    case "$id" in
        firefox-esr.desktop)               cmd="pkexec /usr/local/sbin/simpleos-system-setup --browser firefox" ;;
        chromium.desktop)                  cmd="pkexec /usr/local/sbin/simpleos-system-setup --browser chromium" ;;
        net.mullvad.MullvadBrowser.desktop) cmd="pkexec /usr/local/sbin/simpleos-system-setup --browser mullvad" ;;
        *)                                 exit 1 ;;
    esac
    if ! command -v kitty >/dev/null; then
        notify-send -u critical -i dialog-error "Browser Selector" "$name could not be installed (terminal missing)." 2>/dev/null
        exit 1
    fi
    # kitty only shows the progress and returns only when the window is closed
    kitty --title "Install $name" sh -c "echo 'Installing $name ...'; echo; $cmd; echo; echo 'Done. Press Enter to close.'; read -r _"
    if ! installed "$id"; then
        notify-send -u critical -i dialog-error "Browser Selector" "$name could not be installed."
        exit 1
    fi
fi

# mimeapps.list (GIO apps) + our own defaults.list: without a desktop environment xdg-mime 1.1.3 only reads
# defaults.list (user before system) and would otherwise keep reporting the system default
xdg-mime default "$id" x-scheme-handler/http x-scheme-handler/https text/html 2>/dev/null ||
    echo "simpleos-browser-select: xdg-mime default $id failed" >&2
user_defaults="${XDG_DATA_HOME:-$HOME/.local/share}/applications/defaults.list"
mkdir -p "${user_defaults%/*}"
[ -f "$user_defaults" ] || echo "[Default Applications]" > "$user_defaults"
for mime in x-scheme-handler/http x-scheme-handler/https text/html; do
    sed -i "\|^$mime=|d" "$user_defaults"
    echo "$mime=$id" >> "$user_defaults"
done
notify-send -i web-browser "Browser Selector" "$name is now your default browser."
