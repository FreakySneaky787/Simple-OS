#!/bin/sh
# Simple OS – sound flyout (Super+A, Settings → Sound)
# Rofi menu like Windows 11 on the right above the taskbar:
#   heading     active output and volume ("Speakers · 40%")
#   volume      "Volume up" / "Volume down" (±10 %, at most 100 %, the menu stays open), "Set volume…" (0–100 %), Mute/Unmute
#   outputs     all output devices (HDMI, USB, Bluetooth) and ports of a device (speakers /
#               headphones); a click switches and moves running playback along
#   at the bottom "Advanced Audio Settings" -> pavucontrol
# Robust like simpleos-wifi: no set -e, exit 0, errors as a notification, details in ~/.cache/simpleos-volume.log.
# Talks to pipewire-pulse via pactl.

SOS_NAME=simpleos-volume SOS_TITLE=Sound SOS_ICON=audio-volume-high SOS_PROMPT=Sound SOS_CORNER=1
TAB=$(printf '\t')
LIB=/usr/local/lib/simpleos/common.sh
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || { notify-send "Sound" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"

advanced() {
    if command -v pavucontrol >/dev/null; then
        pavucontrol >/dev/null 2>&1 &
    else
        sos_notify "The advanced sound settings are not installed (pavucontrol missing)." critical
    fi
    exit 0
}
sos_rofi_failed() {
    sos_notify "The sound menu could not open. Opening the advanced sound settings instead."
    advanced
}

command -v pactl >/dev/null || { sos_notify "Sound control is not available (pactl missing)." critical; exit 0; }
command -v rofi >/dev/null || { sos_log "rofi missing"; sos_rofi_failed; }

# Volume of the default output in percent (first channel)
volume() {
    LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | sed -n 's/^[^/]*\/ *\([0-9]*\)%.*/\1/p' | head -n 1
}
muted() { LC_ALL=C pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes'; }
set_volume() {
    pactl set-sink-mute @DEFAULT_SINK@ 0 >&2 2>&1
    pactl set-sink-volume @DEFAULT_SINK@ "$1" >&2 2>&1 || sos_notify "The volume could not be changed." critical
}
# ±10 %, like the Fn keys (simpleos-osd) never above 100 % (distorts otherwise) and never below 0 %
step_volume() {  # $1 = +10 | -10
    old=$(volume); sos_is_num "$old" || old=0
    v=$((old + $1))
    [ "$v" -gt 100 ] && v=100
    [ "$v" -lt 0 ] && v=0
    # already above 100 % (e.g. set in pavucontrol): "Volume up" keeps it instead of lowering it to 100 %
    [ "$1" -gt 0 ] && [ "$v" -lt "$old" ] && v=$old
    set_volume "$v%"
}
# Outputs: "device<TAB>port<TAB>label<TAB>active(1/0)", one entry per port or per device
# without ports; unavailable ports (headphones not plugged in) are missing
outputs() {
    default=$(pactl get-default-sink 2>/dev/null)
    LC_ALL=C pactl list sinks 2>/dev/null | awk -v def="$default" -v OFS='\t' '
        function flush() {
            if (name == "") return
            if (nports == 0) print name, "", desc, (name == def)
            for (i = 1; i <= nports; i++) {
                label = (nports > 1) ? desc " – " pdesc[i] : desc
                print name, port[i], label, (name == def && (active == port[i] || nports == 1))
            }
            name = ""; nports = 0; active = ""; inports = 0
        }
        /^Sink #/ { flush(); next }
        /^\tName: / { name = substr($0, 8); next }
        /^\tDescription: / { desc = substr($0, 15); next }
        /^\tPorts:/ { inports = 1; next }
        /^\tActive Port: / { active = substr($0, 15); inports = 0; next }
        /^\t[A-Za-z]/ { inports = 0 }
        inports && /^\t\t[^\t]/ {
            line = substr($0, 3)
            if (line ~ /not available/) next
            p = line; sub(/:.*/, "", p)
            d = line; sub(/^[^:]*: /, "", d); sub(/ \(type:.*$/, "", d); sub(/ \(priority.*$/, "", d)
            nports++; port[nports] = p; pdesc[nports] = d
        }
        END { flush() }'
}
switch_output() {
    pactl set-default-sink "$1" >&2 2>&1 || { sos_notify "This output could not be selected." critical; return; }
    [ -n "$2" ] && { pactl set-sink-port "$1" "$2" >&2 2>&1 || sos_notify "This output could not be selected." critical; }
    # Move running playback (browser, music) along
    pactl list short sink-inputs 2>/dev/null | cut -f1 | while read -r id; do
        sos_is_num "$id" && pactl move-sink-input "$id" "$1" >&2 2>&1
    done
    sos_notify "Sound now plays on $3." low
}

# FontAwesome 4: volume-up U+F028, volume-down U+F027, volume-off U+F026, sliders U+F1DE, check U+F00C,
# headphones U+F025, cog U+F013
I_UP='\357\200\250' I_DOWN='\357\200\247' I_OFF='\357\200\246' I_SLIDERS='\357\207\236' I_CHECK='\357\200\214'
I_PHONES='\357\200\245' I_COG='\357\200\223'

while :; do
    vol=$(volume); sos_is_num "$vol" || vol=0
    out_list=$(outputs)
    current=$(printf '%s\n' "$out_list" | awk -F'\t' '$4 == 1 { print $3; exit }')
    state="$vol%"; muted && state="Muted"
    sos_add "$(sos_fa "$I_UP")  Volume up  $(sos_dim "$state")" "up"
    sos_add "$(sos_fa "$I_DOWN")  Volume down" "down"
    sos_add "$(sos_fa "$I_SLIDERS")  Set volume…" "level"
    if muted; then sos_add "$(sos_fa "$I_UP")  Unmute" "mute"; else sos_add "$(sos_fa "$I_OFF")  Mute" "mute"; fi
    n=$(printf '%s\n' "$out_list" | grep -c .)
    if [ "$n" -gt 0 ]; then
        while IFS="$TAB" read -r sink port label active; do
            [ -n "$sink" ] || continue
            if [ "$active" = 1 ]; then
                sos_add "$(sos_fa "$I_CHECK")  $(sos_esc "$label")  $(sos_dim "Active")" "noop"
            else
                sos_add "$(sos_fa "$I_PHONES")  $(sos_esc "$label")" "output$TAB$sink$TAB$port"
            fi
        done <<EOF
$out_list
EOF
    else
        sos_add "$(sos_fa "$I_OFF")  No sound output found" "noop"
    fi
    sos_add "$(sos_fa "$I_COG")  Advanced Audio Settings" "advanced"
    sos_pick "<b>Sound</b>   $(sos_dim "${current:-No output} · $state")" 420

    case "$action" in
        up)       step_volume 10 ;;
        down)     step_volume -10 ;;
        mute)     pactl set-sink-mute @DEFAULT_SINK@ toggle >&2 2>&1 || sos_notify "Mute could not be changed." critical ;;
        level)
            for l in 100 80 60 50 40 30 20 10 0; do sos_add "$l%" "set$TAB$l"; done
            sos_pick "<b>Set volume</b>   $(sos_dim "now $state")" 300
            [ "$action" = set ] && sos_is_num "$arg1" && set_volume "$arg1%" ;;
        output)
            label=$(printf '%s\n' "$out_list" | awk -F'\t' -v s="$arg1" -v p="$arg2" '$1 == s && $2 == p { print $3; exit }')
            switch_output "$arg1" "$arg2" "${label:-the selected output}" ;;
        advanced) advanced ;;
        noop)     ;;
        *)        break ;;
    esac
done
exit 0
