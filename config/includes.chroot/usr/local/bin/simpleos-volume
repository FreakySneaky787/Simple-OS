#!/bin/sh
# Simple OS – sound flyout (Super+A, launcher "Sound", taskbar speaker icon) – one Rofi window in script mode (1.1.2)
# Rofi menu like Windows 11 on the right above the taskbar:
#   heading     active output and volume ("Speakers · 40%")
#   volume      "Volume up" / "Volume down" (±10 %, at most 100 %, the menu stays open), "Set volume…" (0–100 %), Mute/Unmute
#   outputs     all output devices (HDMI, USB, Bluetooth) and ports of a device (speakers /
#               headphones); a click switches and moves running playback along
#   at the bottom "Advanced Audio Settings" -> pavucontrol
#   simpleos-volume --panel   the speaker icon of the taskbar (tint2 executor, runs as long as the taskbar; 1.1.1,
#                             #104): one line of markup per change – volume up/down/off icon, dimmed when muted
#                             or when there is no sound server. Follows "pactl subscribe", so volume keys, the
#                             flyout and other apps update it at once. Replaces volumeicon: its left click muted the
#                             sound, its slider and menu closed again after a slow click. Clicks: tint2rc
#                             (simpleos-taskbar-select --apply): left/right = this flyout, wheel/middle = simpleos-osd.
#                             Tests: SIMPLEOS_VOLUME_ONCE=1 prints the line once and ends.
# Robust like simpleos-wifi: no set -e, exit 0, errors as a notification, details in ~/.cache/simpleos-volume.log.
# Talks to pipewire-pulse via pactl.

# ---- taskbar icon (before common.sh: it runs for hours and needs nothing of it)
if [ "${1:-}" = --panel ]; then
    panel_line() {
        v= m=no
        if command -v pactl >/dev/null; then
            v=$(LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | sed -n 's/^[^/]*\/ *\([0-9]*\)%.*/\1/p' | head -n 1)
            LC_ALL=C pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q yes && m=yes
        fi
        # FontAwesome 4: volume-off U+F026, volume-down U+F027, volume-up U+F028
        if [ -z "$v" ] || [ "$m" = yes ] || [ "$v" -eq 0 ]; then
            icon=$(printf '\357\200\246') color=" foreground='#7f849c'"
        elif [ "$v" -lt 50 ]; then
            icon=$(printf '\357\200\247') color=
        else
            icon=$(printf '\357\200\250') color=
        fi
        # the same width for all three, so the taskbar does not jump
        printf "<span font_desc='FontAwesome 12'%s>%s</span>\n" "$color" "$icon"
    }
    if [ "${SIMPLEOS_VOLUME_ONCE:-}" = 1 ]; then panel_line; exit 0; fi
    last=
    while kill -0 "$PPID" 2>/dev/null; do
        line=$(panel_line)
        [ "$line" != "$last" ] && { printf '%s\n' "$line" || exit 0; last=$line; }
        if command -v pactl >/dev/null && LC_ALL=C pactl info >/dev/null 2>&1; then
            # one line per sink/server event; the icon only changes when the state does. Ends when the sound server
            # restarts (Bluetooth, an update) -> the loop starts it again
            LC_ALL=C pactl subscribe 2>/dev/null | while read -r ev; do
                case "$ev" in *" sink "*|*" server "*) ;; *) continue ;; esac
                kill -0 "$PPID" 2>/dev/null || exit 0
                line=$(panel_line)
                [ "$line" != "$last" ] && { printf '%s\n' "$line" || exit 0; last=$line; }
            done
        fi
        sleep 3    # no sound server (yet): look again in a moment
    done
    exit 0
fi

SOS_NAME=simpleos-volume SOS_TITLE=Sound SOS_ICON=audio-volume-high SOS_PROMPT=Sound SOS_CORNER=1
TAB=$(printf '\t')
LIB=/usr/local/lib/simpleos/common.sh
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || { notify-send "Sound" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"

advanced() {
    if command -v pavucontrol >/dev/null; then
        pavucontrol >/dev/null 2>&1 &
    else
        sos_notify "The advanced sound settings are not installed (pavucontrol missing)." critical
    fi
    exit 0
}
sos_rofi_failed() {
    sos_notify "The sound menu could not open. Opening the advanced sound settings instead."
    advanced
}

command -v pactl >/dev/null || { sos_notify "Sound control is not available (pactl missing)." critical; exit 0; }
command -v rofi >/dev/null || { sos_log "rofi missing"; sos_rofi_failed; }

# Volume of the default output in percent (first channel)
volume() {
    LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | sed -n 's/^[^/]*\/ *\([0-9]*\)%.*/\1/p' | head -n 1
}
muted() { LC_ALL=C pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes'; }
set_volume() {
    pactl set-sink-mute @DEFAULT_SINK@ 0 >&2 2>&1
    pactl set-sink-volume @DEFAULT_SINK@ "$1" >&2 2>&1 || sos_notify "The volume could not be changed." critical
}
# ±10 % (the Fn keys step 5 %, simpleos-osd), never above 100 % (distorts otherwise) and never below 0 %
step_volume() {  # $1 = +10 | -10
    old=$(volume); sos_is_num "$old" || old=0
    v=$((old + $1))
    [ "$v" -gt 100 ] && v=100
    [ "$v" -lt 0 ] && v=0
    # already above 100 % (e.g. set in pavucontrol): "Volume up" keeps it instead of lowering it to 100 %
    [ "$1" -gt 0 ] && [ "$v" -lt "$old" ] && v=$old
    set_volume "$v%"
}
# Outputs: "device<TAB>port<TAB>label<TAB>active(1/0)", one entry per port or per device
# without ports; unavailable ports (headphones not plugged in) are missing
outputs() {
    default=$(pactl get-default-sink 2>/dev/null)
    LC_ALL=C pactl list sinks 2>/dev/null | awk -v def="$default" -v OFS='\t' '
        function flush() {
            if (name == "") return
            if (nports == 0) print name, "", desc, (name == def)
            for (i = 1; i <= nports; i++) {
                label = (nports > 1) ? desc " – " pdesc[i] : desc
                print name, port[i], label, (name == def && (active == port[i] || nports == 1))
            }
            name = ""; nports = 0; active = ""; inports = 0
        }
        /^Sink #/ { flush(); next }
        /^\tName: / { name = substr($0, 8); next }
        /^\tDescription: / { desc = substr($0, 15); next }
        /^\tPorts:/ { inports = 1; next }
        /^\tActive Port: / { active = substr($0, 15); inports = 0; next }
        /^\t[A-Za-z]/ { inports = 0 }
        inports && /^\t\t[^\t]/ {
            line = substr($0, 3)
            if (line ~ /not available/) next
            p = line; sub(/:.*/, "", p)
            d = line; sub(/^[^:]*: /, "", d); sub(/ \(type:.*$/, "", d); sub(/ \(priority.*$/, "", d)
            nports++; port[nports] = p; pdesc[nports] = d
        }
        END { flush() }'
}
switch_output() {
    pactl set-default-sink "$1" >&2 2>&1 || { sos_notify "This output could not be selected." critical; return; }
    [ -n "$2" ] && { pactl set-sink-port "$1" "$2" >&2 2>&1 || sos_notify "This output could not be selected." critical; }
    # Move running playback (browser, music) along
    pactl list short sink-inputs 2>/dev/null | cut -f1 | while read -r id; do
        sos_is_num "$id" && pactl move-sink-input "$id" "$1" >&2 2>&1
    done
    sos_notify "Sound now plays on $3." low
}

# FontAwesome 4: volume-up U+F028, volume-down U+F027, volume-off U+F026, sliders U+F1DE, check U+F00C,
# headphones U+F025, cog U+F013, arrow-left U+F060
I_UP='\357\200\250' I_DOWN='\357\200\247' I_OFF='\357\200\246' I_SLIDERS='\357\207\236' I_CHECK='\357\200\214'
I_PHONES='\357\200\245' I_COG='\357\200\223' I_BACK='\357\201\240'

# Rofi script mode (1.1.2): Rofi runs "simpleos-volume --rofi" at the start and after every selection, and shows the rows
# that come back – the window stays open (until 1.1.1 every "Volume up" closed the menu and opened a new one: a flicker
# and a short wait each time). Row = "text\0info\x1faction<TAB>data"; no rows = Rofi closes.
vrow() { printf '%s\000info\037%s\n' "$1" "$2"; }
vhead() { printf '\000prompt\037Sound\n\000markup-rows\037true\n\000no-custom\037true\n\000message\037%s\n' "$1"; }
main_rows() {
    vol=$(volume); sos_is_num "$vol" || vol=0
    out_list=$(outputs)
    current=$(printf '%s\n' "$out_list" | awk -F'\t' '$4 == 1 { print $3; exit }')
    state="$vol%"; muted && state="Muted"
    vhead "<b>Sound</b>   $(sos_dim "${current:-No output} · $state")"
    vrow "$(sos_fa "$I_UP")  Volume up  $(sos_dim "$state")" "up"
    vrow "$(sos_fa "$I_DOWN")  Volume down" "down"
    vrow "$(sos_fa "$I_SLIDERS")  Set volume…" "level"
    if muted; then vrow "$(sos_fa "$I_UP")  Unmute" "mute"; else vrow "$(sos_fa "$I_OFF")  Mute" "mute"; fi
    if [ -n "$out_list" ]; then
        while IFS="$TAB" read -r sink port label active; do
            [ -n "$sink" ] || continue
            if [ "$active" = 1 ]; then
                vrow "$(sos_fa "$I_CHECK")  $(sos_esc "$label")  $(sos_dim "Active")" "noop"
            else
                vrow "$(sos_fa "$I_PHONES")  $(sos_esc "$label")" "output$TAB$sink$TAB$port"
            fi
        done <<EOF
$out_list
EOF
    else
        vrow "$(sos_fa "$I_OFF")  No sound output found" "noop"
    fi
    vrow "$(sos_fa "$I_COG")  Advanced Audio Settings" "advanced"
}
level_rows() {
    state="$(volume)%"; muted && state="Muted"
    vhead "<b>Set volume</b>   $(sos_dim "now $state")"
    for l in 100 80 60 50 40 30 20 10 0; do vrow "$l%" "set$TAB$l"; done
    vrow "$(sos_fa "$I_BACK")  Back" "back"
}

if [ "${1:-}" = --rofi ]; then
    info=
    [ "${ROFI_RETV:-0}" = 1 ] && info=${ROFI_INFO:-}
    action=$(printf '%s' "$info" | cut -f1) arg1=$(printf '%s' "$info" | cut -f2) arg2=$(printf '%s' "$info" | cut -f3)
    case "$action" in
        up)       step_volume 10 ;;
        down)     step_volume -10 ;;
        mute)     pactl set-sink-mute @DEFAULT_SINK@ toggle >&2 2>&1 || sos_notify "Mute could not be changed." critical ;;
        level)    level_rows; exit 0 ;;
        set)      sos_is_num "$arg1" && set_volume "$arg1%" ;;
        output)
            label=$(outputs | awk -F'\t' -v s="$arg1" -v p="$arg2" '$1 == s && $2 == p { print $3; exit }')
            switch_output "$arg1" "$arg2" "${label:-the selected output}" ;;
        advanced) advanced ;;    # pavucontrol in the background, no rows -> Rofi closes
    esac
    main_rows
    exit 0
fi

# The flyout itself: one Rofi window in script mode (see above), retries/errors via sos_rofi
SELF=${SIMPLEOS_VOLUME_SELF:-/usr/local/bin/simpleos-volume}
sos_rofi -show sound -modi "sound:$SELF --rofi" -i \
    -theme-str "window { width: 420px; $(sos_position) } mainbox { children: [ message, listview ]; }
                listview { lines: 12; } element-icon { enabled: false; } textbox { text-color: @fg; }" </dev/null >/dev/null
exit 0
