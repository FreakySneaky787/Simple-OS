#!/bin/sh
# Simple OS – start/stop the compositor (picom): one place for the Openbox autostart and Do Not Disturb
#   simpleos-picom --start     start it if it is not running (shadows, rounded corners, short fades)
#   simpleos-picom --stop      stop it (Do Not Disturb with --no-effects on: without shadows/transparency)
#   simpleos-picom --running   exit 0 if picom is running
#   simpleos-picom --mode      shows how it would start: "glx <renderer>" or "software <renderer>"
# OpenGL check (glxinfo): hardware renderer -> GLX with ~/.config/picom/picom.conf. Software rendering only
# (llvmpipe/softpipe/swrast, e.g. a VM without 3D) or no GLX at all -> xrender with picom-software.conf without shadows,
# fades and rounded corners – with the full effects picom computed every frame on the CPU (~55 % CPU).
# Without glxinfo: VM = software rendering, otherwise hardware.
# Real hardware: --unredir-if-possible – full-screen games/videos bypass the compositor (less latency,
# no extra VSync, variable refresh rate possible). Not in VMs (the mouse pointer disappeared under QEMU/virtio).
# picom 9.1 aborts if VSync or GLX is not available -> without VSync, if need be with xrender.
# No set -e, exit 0 (except --running).
SW_CONF=/usr/share/simpleos/picom-software.conf
running() { pgrep -x picom >/dev/null 2>&1; }
is_vm() { command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q --vm; }
# prints "glx <renderer>" or "software <renderer>"
gl_mode() {
    if command -v glxinfo >/dev/null; then
        renderer=$(glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p' | head -n1)
        case "$renderer" in
            "")                                                   echo "software (no GLX)" ;;
            *llvmpipe*|*softpipe*|*swrast*|*"Software Rasterizer"*) echo "software $renderer" ;;
            *)                                                    echo "glx $renderer" ;;
        esac
    elif is_vm; then
        echo "software (VM, glxinfo missing)"
    else
        echo "glx (glxinfo missing)"
    fi
}
case "${1:-}" in
    --start)
        running && exit 0
        command -v picom >/dev/null || exit 0
        case "$(gl_mode)" in
            glx*)
                opts=--unredir-if-possible
                is_vm && opts=
                # shellcheck disable=SC2086
                picom -b $opts 2>/dev/null || picom -b $opts --no-vsync 2>/dev/null ||
                    picom -b --backend xrender --no-vsync 2>/dev/null ;;
            *)
                { [ -r "$SW_CONF" ] && picom -b --config "$SW_CONF" 2>/dev/null; } ||
                    picom -b --backend xrender --no-vsync 2>/dev/null ;;
        esac
        exit 0 ;;
    --stop)
        running || exit 0
        pkill -x picom 2>/dev/null
        # wait up to 2 s, so an immediate --start does not hit the old process
        i=0; while running && [ "$i" -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
        exit 0 ;;
    --running) running; exit $? ;;
    --mode) gl_mode; exit 0 ;;
    *) echo "Usage: simpleos-picom --start | --stop | --running | --mode" >&2; exit 2 ;;
esac
