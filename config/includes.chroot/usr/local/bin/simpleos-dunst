#!/bin/sh
# Simple OS – Starter für dunst (Openbox-Autostart, D-Bus-Aktivierung, systemd-User-Dienst dunst.service)
# Ohne echten Akku (VM oder "simpleos-battery --present" schlägt fehl) hängt er den Akku-Filter
# /etc/xdg/dunst/simpleos-battery-filter.conf an die dunst-Konfiguration: jede fremde Meldung mit
# Battery/Akku/Power (Titel, Text, Symbol, Absender) wird verworfen – egal, welcher Dienst sie schickt.
# Mit echtem Akku startet dunst unverändert (Akku-Warnung über tint2 + simpleos-battery --low-alert).
#   simpleos-dunst [dunst-Optionen]   dunst starten
#   simpleos-dunst --print-config     Pfad der Konfiguration ausgeben, die dunst bekäme (Tests)
# Tests: SIMPLEOS_VIRT (none = echte Hardware) und SIMPLEOS_POWER_SUPPLY wie bei simpleos-battery,
# SIMPLEOS_DUNST = dunst-Programm.
# Nie ohne Meldungen: fehlt etwas oder geht das Zusammenbauen schief, startet dunst mit seiner Vorgabe.
DUNST=${SIMPLEOS_DUNST:-/usr/bin/dunst}
FILTER=/etc/xdg/dunst/simpleos-battery-filter.conf

in_vm() {
    if [ -n "${SIMPLEOS_VIRT:-}" ]; then [ "$SIMPLEOS_VIRT" != none ]; return; fi
    command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q --vm
}
# Filter nötig: VM, oder kein echter Akku (fehlt simpleos-battery, gilt das als "kein Akku")
need_filter() {
    in_vm && return 0
    [ -x /usr/local/bin/simpleos-battery ] || return 0
    ! /usr/local/bin/simpleos-battery --present
}

# Konfiguration wie dunst sie sucht: ~/.config/dunst/dunstrc, sonst /etc/xdg/dunst/dunstrc
base=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/dunst/dunstrc
[ -r "$base" ] || base=/etc/xdg/dunst/dunstrc

config=
if [ -r "$FILTER" ] && need_filter; then
    dir=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}}
    mkdir -p "$dir" 2>/dev/null
    out=$dir/simpleos-dunstrc
    if { [ -r "$base" ] && cat "$base"; cat "$FILTER"; } > "$out.tmp" 2>/dev/null && mv -f "$out.tmp" "$out"; then
        config=$out
    else
        rm -f "$out.tmp" 2>/dev/null
    fi
fi

if [ "${1:-}" = --print-config ]; then
    echo "${config:-$base}"
    exit 0
fi
# Eigene -config/-conf des Aufrufers haben Vorrang
case " $* " in *" -config "*|*" -conf "*) config= ;; esac
if [ -n "$config" ]; then exec "$DUNST" -config "$config" "$@"; fi
exec "$DUNST" "$@"
