#!/bin/sh
# Simple OS – launcher for dunst (Openbox autostart, D-Bus activation, systemd user service dunst.service)
# Without a real battery (VM or "simpleos-battery --present" fails) it appends the battery filter
# /etc/xdg/dunst/simpleos-battery-filter.conf to the dunst configuration: every foreign notification with
# Battery/Akku/Power (title, text, icon, sender) is discarded – no matter which service sends it.
# With a real battery dunst starts unchanged (battery warning via tint2 + simpleos-battery --low-alert).
#   simpleos-dunst [dunst options]    start dunst
#   simpleos-dunst --print-config     print the path of the configuration dunst would get (tests)
# Tests: SIMPLEOS_VIRT (none = real hardware) and SIMPLEOS_POWER_SUPPLY as in simpleos-battery,
# SIMPLEOS_DUNST = dunst program.
# Never without notifications: if something is missing or assembling fails, dunst starts with its default.
DUNST=${SIMPLEOS_DUNST:-/usr/bin/dunst}
FILTER=/etc/xdg/dunst/simpleos-battery-filter.conf

in_vm() {
    if [ -n "${SIMPLEOS_VIRT:-}" ]; then [ "$SIMPLEOS_VIRT" != none ]; return; fi
    command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q --vm
}
# Filter needed: VM, or no real battery (if simpleos-battery is missing, that counts as "no battery")
need_filter() {
    in_vm && return 0
    [ -x /usr/local/bin/simpleos-battery ] || return 0
    ! /usr/local/bin/simpleos-battery --present
}

# Configuration as dunst looks for it: ~/.config/dunst/dunstrc, otherwise /etc/xdg/dunst/dunstrc
base=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/dunst/dunstrc
[ -r "$base" ] || base=/etc/xdg/dunst/dunstrc

config=
if [ -r "$FILTER" ] && need_filter; then
    dir=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}}
    mkdir -p "$dir" 2>/dev/null
    out=$dir/simpleos-dunstrc
    if { [ -r "$base" ] && cat "$base"; cat "$FILTER"; } > "$out.tmp" 2>/dev/null && mv -f "$out.tmp" "$out"; then
        config=$out
    else
        rm -f "$out.tmp" 2>/dev/null
    fi
fi

if [ "${1:-}" = --print-config ]; then
    echo "${config:-$base}"
    exit 0
fi
# The caller's own -config/-conf take precedence
case " $* " in *" -config "*|*" -conf "*) config= ;; esac
if [ -n "$config" ]; then exec "$DUNST" -config "$config" "$@"; fi
exec "$DUNST" "$@"
