#!/usr/bin/python3
"""Simple OS – Task Manager (Ctrl+Shift+Esc, Menu → System → Task Manager, Control Center → System).

List of programs with CPU (share of all cores, like on Windows), memory and user, read again from /proc
every 2 s. Rows are updated in place (selection and scroll position stay).
"End task" (button, Delete key, right-click) – end_process():
  1. SIGTERM (the program may end cleanly, e.g. save),
  2. if it is still alive after 1.5 s: SIGKILL automatically,
  3. if the process belongs to another user (e.g. root): the same via
     pkexec /usr/local/sbin/simpleos-taskmanager-helper (password), instead of failing silently.
  Before every signal it is checked that the PID is still the same process (start time, field 22 of /proc/PID/stat).
  The list is read again right after the signal and the result is shown directly; the selection jumps to the
  next row – no second click needed.
System-critical processes (Xorg, openbox, lightdm, systemd …) only after a confirmation; PID 1 and kernel threads never.
Test: SIMPLEOS_TM_SELFTEST=1 starts two test processes (one ignores SIGTERM), ends them via the interface
and ends with exit 0 only if both are gone and the list has caught up without a second click.
"""
import os
import pwd
import re
import signal
import subprocess
import sys
import threading
import time

HELPER = "/usr/local/sbin/simpleos-taskmanager-helper"
TERM_WAIT = 1.5
KILL_WAIT = 2.0
CRITICAL = {"Xorg", "X", "openbox", "lightdm", "systemd", "systemd-logind", "dbus-daemon", "dbus-broker", "tint2",
            "NetworkManager", "polkitd", "pipewire", "wireplumber", "lxpolkit", "Xwayland"}
CLK = os.sysconf("SC_CLK_TCK")
NCPU = os.cpu_count() or 1
PAGE = os.sysconf("SC_PAGE_SIZE")


# ---------------------------------------------------------------- /proc
def read_stat(pid):
    """(state, parent process, utime+stime, start time) or None. Robust against ') ' in the program name."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            s = f.read()
    except OSError:
        return None
    rest = s[s.rfind(")") + 2:].split()
    try:
        return rest[0], int(rest[1]), int(rest[11]) + int(rest[12]), int(rest[19])
    except (IndexError, ValueError):
        return None


def is_alive(pid, start):
    st = read_stat(pid)
    return bool(st) and st[0] not in ("Z", "X") and st[3] == start


def is_interpreter(exe):
    """python, python3, python3.11, sh, bash, dash – not shotwell, bashtop, …"""
    return exe in ("sh", "bash", "dash") or re.fullmatch(r"python\d*(\.\d+)?", exe) is not None


def processes(all_users=False):
    """User processes (without kernel threads): a list of dicts."""
    me = os.getuid()
    out = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            uid = os.stat(f"/proc/{pid}").st_uid
            if not all_users and uid != me:
                continue
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().split(b"\0")
            if not cmd or not cmd[0]:
                continue  # kernel thread
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip()
            with open(f"/proc/{pid}/statm") as f:
                rss = int(f.read().split()[1]) * PAGE
        except (OSError, ValueError, IndexError):
            continue
        st = read_stat(pid)
        if not st or st[0] in ("Z", "X"):
            continue
        try:
            user = pwd.getpwuid(uid).pw_name
        except KeyError:
            user = str(uid)
        exe = os.path.basename(cmd[0].decode(errors="replace"))
        # Show scripts (python3 /usr/local/bin/simpleos-…) under their own name – only real interpreters:
        # startswith("sh") also matched shotwell/shutter/shotcut, which then appeared as their first argument ("photo.jpg")
        if is_interpreter(exe) and len(cmd) > 1 and cmd[1] and not cmd[1].startswith(b"-"):
            label = os.path.basename(cmd[1].decode(errors="replace"))
        else:
            label = comm or exe
        out.append({"pid": pid, "name": label, "user": user, "uid": uid, "ticks": st[2], "start": st[3], "rss": rss})
    return out


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} GB"


# ---------------------------------------------------------------- Ending
def end_process(pid, start, on_signal=None, kill=os.kill, runner=subprocess.run, term_wait=TERM_WAIT,
                kill_wait=KILL_WAIT, poll=0.05):
    """SIGTERM -> SIGKILL after term_wait; other users' processes via pkexec + helper.
    Returns: "terminated" | "killed" | "gone" | "failed" | "denied" (password cancelled/refused).
    on_signal() is called right after the first signal (the interface then reads again immediately)."""
    if not is_alive(pid, start):
        return "gone"
    try:
        kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return "gone"
    except PermissionError:
        try:
            r = runner(["pkexec", HELPER, "--end", str(pid), str(start)], capture_output=True, text=True,
                       timeout=60)
        except (OSError, subprocess.SubprocessError):
            return "failed"
        if on_signal:
            on_signal()
        if r.returncode == 0:
            return "killed" if "killed" in (r.stdout or "") else "terminated"
        if r.returncode == 3:
            return "gone"
        if r.returncode in (126, 127):
            return "denied"
        return "failed"
    if on_signal:
        on_signal()
    end = time.monotonic() + term_wait
    while time.monotonic() < end:
        if not is_alive(pid, start):
            return "terminated"
        time.sleep(poll)
    if not is_alive(pid, start):
        return "terminated"
    try:
        kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return "terminated"
    except PermissionError:
        return "failed"
    end = time.monotonic() + kill_wait
    while time.monotonic() < end:
        if not is_alive(pid, start):
            return "killed"
        time.sleep(poll)
    return "failed"


# ---------------------------------------------------------------- Interface
def run_gui(selftest=False):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, GObject, Gtk, Pango

    COLS = ("pid", "name", "user", "cpu", "mem", "cpu_s", "mem_s", "start", "uid")

    class Win(Gtk.Window):
        def __init__(self):
            super().__init__(title="Task Manager")
            self.set_default_size(760, 540)
            self.set_icon_name("utilities-system-monitor")
            self.set_position(Gtk.WindowPosition.CENTER)
            hb = Gtk.HeaderBar(show_close_button=True, title="Task Manager")
            self.set_titlebar(hb)
            self.hb = hb
            self.prev = {}          # pid -> (ticks, time) for the CPU share
            self.rows = {}          # pid -> Gtk.TreeRowReference
            self.busy = set()       # pids that are being ended right now
            self.all_users = False

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
            top = Gtk.Box(spacing=8)
            self.search = Gtk.SearchEntry(placeholder_text="Search processes")
            self.search.connect("search-changed", lambda *_: self.filter.refilter())
            top.pack_start(self.search, True, True, 0)
            allu = Gtk.CheckButton(label="All users")
            allu.connect("toggled", self.on_all_users)
            top.pack_start(allu, False, False, 0)
            box.pack_start(top, False, False, 0)

            # pid, name, user, CPU (sort value), memory (sort value), CPU text, memory text, start, uid
            # start (ticks since boot) 64 bit: in a 32-bit column it overflowed after ~248 days of uptime
            # (OverflowError, the list froze)
            self.store = Gtk.ListStore(int, str, str, float, float, str, str, GObject.TYPE_INT64, int)
            self.filter = self.store.filter_new()
            self.filter.set_visible_func(self.visible)
            self.sorted = Gtk.TreeModelSort(model=self.filter)
            self.sorted.set_sort_column_id(3, Gtk.SortType.DESCENDING)
            self.view = Gtk.TreeView(model=self.sorted)
            # Fixed widths for the numbers, only Name stretches (and gives way): with all columns sized by their content
            # the list came out wider than the window and the Memory column was cut off
            for title, col, sort, xalign, expand, width in (("Name", 1, 1, 0.0, True, 0), ("PID", 0, 0, 1.0, False, 70),
                                                            ("User", 2, 2, 0.0, False, 100), ("CPU", 5, 3, 1.0, False, 80),
                                                            ("Memory", 6, 4, 1.0, False, 100)):
                r = Gtk.CellRendererText(xalign=xalign)
                c = Gtk.TreeViewColumn(title, r, text=col)
                c.set_sort_column_id(sort)
                c.set_expand(expand)
                c.set_resizable(True)
                if expand:
                    r.set_property("ellipsize", Pango.EllipsizeMode.END)
                    c.set_min_width(120)
                else:
                    r.set_property("ellipsize", Pango.EllipsizeMode.END)
                    c.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
                    c.set_fixed_width(width)
                self.view.append_column(c)
            self.view.connect("button-press-event", self.on_button)
            self.view.connect("key-press-event", self.on_key)
            self.view.get_selection().connect("changed", lambda *_: self.update_button())
            sw = Gtk.ScrolledWindow()
            # No horizontal scrolling: the view takes the window's width and the Name column gives way – otherwise
            # a long process name made the list wider than the window and cut off the Memory column
            sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sw.add(self.view)
            box.pack_start(sw, True, True, 0)

            bottom = Gtk.Box(spacing=8)
            self.status = Gtk.Label(xalign=0)
            self.status.get_style_context().add_class("dim-label")
            bottom.pack_start(self.status, True, True, 0)
            self.end_btn = Gtk.Button(label="End task")
            self.end_btn.get_style_context().add_class("destructive-action")
            self.end_btn.connect("clicked", lambda *_: self.end_selected())
            bottom.pack_end(self.end_btn, False, False, 0)
            box.pack_start(bottom, False, False, 0)
            self.add(box)

            self.refresh()
            GLib.timeout_add(2000, self.refresh)
            self.update_button()

        # -------- List
        def visible(self, model, it, _data):
            q = self.search.get_text().strip().lower()
            return not q or q in model[it][1].lower() or q == str(model[it][0])

        def on_all_users(self, b):
            self.all_users = b.get_active()
            self.refresh()

        def refresh(self):
            now = time.monotonic()
            procs = processes(self.all_users)
            seen = set()
            total_cpu = 0.0
            for p in procs:
                pid = p["pid"]
                seen.add(pid)
                last = self.prev.get(pid)
                cpu = 0.0
                if last and last[2] == p["start"] and now > last[1]:
                    cpu = max(0.0, (p["ticks"] - last[0]) / CLK / (now - last[1]) / NCPU * 100)
                self.prev[pid] = (p["ticks"], now, p["start"])
                total_cpu += cpu
                name = p["name"] + (" – ending…" if pid in self.busy else "")
                vals = (pid, name, p["user"], cpu, float(p["rss"]), f"{cpu:.1f} %", human(p["rss"]), p["start"],
                        p["uid"])
                ref = self.rows.get(pid)
                if ref and ref.valid() and self.store[ref.get_path()][7] != p["start"]:
                    self.remove_row(pid)  # the PID now belongs to another process
                    ref = None
                if ref and ref.valid():
                    it = self.store.get_iter(ref.get_path())
                    self.store.set(it, list(range(len(COLS))), list(vals))
                else:
                    it = self.store.append(list(vals))
                    self.rows[pid] = Gtk.TreeRowReference.new(self.store, self.store.get_path(it))
            for pid in [pid for pid in self.rows if pid not in seen]:
                self.remove_row(pid)
            for pid in [pid for pid in self.prev if pid not in seen]:
                del self.prev[pid]
            mem = self.meminfo()
            self.hb.set_subtitle(f"{len(procs)} processes · CPU {total_cpu:.0f} %" + (f" · Memory {mem}" if mem else ""))
            self.update_button()
            return True

        def remove_row(self, pid):
            ref = self.rows.pop(pid, None)
            if ref and ref.valid():
                self.store.remove(self.store.get_iter(ref.get_path()))

        @staticmethod
        def meminfo():
            try:
                with open("/proc/meminfo") as f:
                    m = {l.split(":")[0]: int(l.split()[1]) * 1024 for l in f}
                return f"{human(m['MemTotal'] - m['MemAvailable'])} of {human(m['MemTotal'])}"
            except (OSError, KeyError, ValueError, IndexError):
                return ""

        # -------- Selection / ending
        def selected(self):
            model, it = self.view.get_selection().get_selected()
            if not it:
                return None
            row = model[it]
            return {"pid": row[0], "name": row[1].replace(" – ending…", ""), "start": row[7], "uid": row[8]}

        def update_button(self):
            sel = self.selected()
            self.end_btn.set_sensitive(bool(sel) and sel["pid"] not in self.busy)

        def select_neighbour(self):
            """Move the selection to the next (otherwise previous) row before removing."""
            model, it = self.view.get_selection().get_selected()
            if not it:
                return
            nxt = model.iter_next(it) or model.iter_previous(it)
            if nxt:
                self.view.get_selection().select_iter(nxt)
                self.view.scroll_to_cell(model.get_path(nxt), None, False, 0, 0)

        def on_key(self, _w, ev):
            if ev.keyval == Gdk.KEY_Delete:
                self.end_selected()
                return True
            return False

        def on_button(self, view, ev):
            if ev.type == Gdk.EventType.BUTTON_PRESS and ev.button == 3:
                hit = view.get_path_at_pos(int(ev.x), int(ev.y))
                if hit:
                    view.get_selection().select_path(hit[0])
                    menu = Gtk.Menu()
                    item = Gtk.MenuItem(label="End task")
                    item.connect("activate", lambda *_: self.end_selected())
                    menu.append(item)
                    menu.show_all()
                    menu.popup_at_pointer(ev)
                return True
            return False

        def end_selected(self):
            sel = self.selected()
            if not sel or sel["pid"] in self.busy:
                return
            if sel["pid"] <= 1:
                self.status.set_text("This process can't be ended.")
                return
            if sel["name"] in CRITICAL or sel["pid"] == os.getppid():
                d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                      buttons=Gtk.ButtonsType.OK_CANCEL, text=f"End {sel['name']}?")
                d.format_secondary_text("It is part of the desktop or the system. Ending it can close your session "
                                        "or stop the network or sound.")
                ok = d.run() == Gtk.ResponseType.OK
                d.destroy()
                if not ok:
                    return
            self.busy.add(sel["pid"])
            self.select_neighbour()
            self.status.set_text(f"Ending {sel['name']}…")
            self.refresh()

            def after_signal():
                GLib.idle_add(self.refresh)

            def work():
                res = end_process(sel["pid"], sel["start"], on_signal=after_signal)
                GLib.idle_add(self.finished, sel, res)

            threading.Thread(target=work, daemon=True).start()

        def finished(self, sel, res):
            self.busy.discard(sel["pid"])
            text = {"terminated": f"{sel['name']} was closed.",
                    "killed": f"{sel['name']} did not respond and was forced to close.",
                    "gone": f"{sel['name']} had already closed.",
                    "denied": f"{sel['name']} was not ended – no password entered.",
                    "failed": f"{sel['name']} could not be ended."}[res]
            self.status.set_text(text)
            if res in ("terminated", "killed", "gone"):
                self.remove_row(sel["pid"])
            self.refresh()
            if selftest:
                self.selftest_results.append((sel["pid"], res))
            return False

    win = Win()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()

    if selftest:
        return selftest_run(win, GLib, Gtk)
    Gtk.main()
    return 0


def selftest_run(win, GLib, Gtk):
    """End two test processes – one reacts to SIGTERM, one ignores it (SIGKILL after 1.5 s)."""
    # absolute paths: in the verify hook a sleep dummy that ends immediately is first in PATH
    soft = subprocess.Popen(["/bin/sleep", "300"])
    hard = subprocess.Popen(["/bin/sh", "-c", "trap '' TERM; while :; do /bin/sleep 0.2; done"])
    time.sleep(0.3)
    win.selftest_results = []
    state = {"rc": 1, "phase": 0, "t": time.monotonic(), "clicks": 0}
    for p in (soft, hard):
        threading.Thread(target=p.wait, daemon=True).start()  # collect zombies

    def select(pid):
        win.refresh()
        model = win.view.get_model()
        it = model.get_iter_first()
        while it:
            if model[it][0] == pid:
                win.view.get_selection().select_iter(it)
                return True
            it = model.iter_next(it)
        return False

    def step():
        ph = state["phase"]
        if ph in (0, 2):
            pid = soft.pid if ph == 0 else hard.pid
            if not select(pid):
                print(f"selftest: PID {pid} not in the list", file=sys.stderr)
                Gtk.main_quit()
                return False
            state["sel_before"] = pid
            win.end_btn.clicked()  # exactly ONE click
            state["clicks"] += 1
            sel = win.selected()
            if sel and sel["pid"] == pid:
                print("selftest: the selection stayed on the ended process", file=sys.stderr)
                Gtk.main_quit()
                return False
            state["phase"] += 1
            state["t"] = time.monotonic()
            return True
        if ph in (1, 3):
            pid = soft.pid if ph == 1 else hard.pid
            done = any(p == pid for p, _ in win.selftest_results)
            if done:
                in_list = pid in win.rows
                res = dict(win.selftest_results)[pid]
                want = "terminated" if ph == 1 else "killed"
                if in_list or res != want:
                    print(f"selftest: PID {pid}: {res} (expected {want}), still in the list: {in_list}",
                          file=sys.stderr)
                    Gtk.main_quit()
                    return False
                if ph == 3:
                    state["rc"] = 0
                    Gtk.main_quit()
                    return False
                state["phase"] += 1
                return True
            if time.monotonic() - state["t"] > 6:
                print(f"selftest: PID {pid} not ended after 6 s", file=sys.stderr)
                Gtk.main_quit()
                return False
            return True
        return False

    GLib.timeout_add(300, step)
    Gtk.main()
    for p in (soft, hard):
        if p.poll() is None:
            p.kill()
    if state["rc"] == 0:
        print("selftest: OK (SIGTERM process ended, SIGTERM-ignoring one via SIGKILL, one click each)")
    return state["rc"]


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print("Usage: simpleos-taskmanager")
        return 0
    try:
        return run_gui(selftest=os.environ.get("SIMPLEOS_TM_SELFTEST") == "1")
    except Exception as err:  # e.g. no display
        print(f"simpleos-taskmanager: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
