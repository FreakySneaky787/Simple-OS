#!/bin/sh
# Simple OS – Fn keys with OSD (Openbox: XF86Audio*/XF86MonBrightness*). A small notification with a bar that
# replaces itself on every key press instead of stacking (dunst: category x-simpleos-osd, stack tag simpleos-osd, bar
# in Catppuccin Mocha, briefly visible, not in the history – rule [simpleos-osd] in ~/.config/dunst/dunstrc).
#   simpleos-osd volume up|down|mute     ±5 %, at most 100 % (pactl, pipewire-pulse); mute on/off
#   simpleos-osd brightness up|down      ±5 % of the screen brightness, at least 5 % (never completely black)
# Brightness: /sys/class/backlight (preferably "raw"/"platform" like intel_backlight, amdgpu_bl0, otherwise "firmware"
# like acpi_video0), set via logind (org.freedesktop.login1.Session.SetBrightness) – the logged-in session may do that
# without root and without udev rules. Without a backlight (desktop monitor, VM): a short hint.
# No set -e, exit 0; details in ~/.cache/simpleos-osd.log.
# Tests: SIMPLEOS_BACKLIGHT replaces /sys/class/backlight, SIMPLEOS_ICONS /usr/share/icons.

SOS_NAME=simpleos-osd SOS_TITLE=OSD SOS_ICON=audio-volume-high
LIB=/usr/local/lib/simpleos/common.sh
[ -r "$LIB" ] || exit 0
. "$LIB"
sos_log_init "$@"
BL=${SIMPLEOS_BACKLIGHT:-/sys/class/backlight}
STEP=5

# Icon as a file path: Papirus has the notification icons only in 48 px, dunst looks up names only up to max_icon_size (40)
icon_path() {
    for d in "${SIMPLEOS_ICONS:-/usr/share/icons}"/Papirus-Dark/48x48/*/ "${SIMPLEOS_ICONS:-/usr/share/icons}"/Papirus/48x48/*/; do
        [ -f "$d$1.svg" ] && { echo "$d$1.svg"; return; }
    done
    echo "$1"
}
osd() {  # $1 title, $2 text, $3 value 0–100, $4 icon
    command -v notify-send >/dev/null || return 0
    # the same app name for all OSDs: dunst replaces via stack tag only within the same app
    notify-send -u low -t 1500 -c x-simpleos-osd -a simpleos-osd -i "$(icon_path "$4")" \
        -h string:x-dunst-stack-tag:simpleos-osd -h "int:value:$3" "$1" "$2" 2>/dev/null || true
}

volume() {
    command -v pactl >/dev/null || { sos_log "pactl missing"; exit 0; }
    case "$1" in
        up|down)
            pactl set-sink-mute @DEFAULT_SINK@ 0 2>/dev/null
            cur=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -n 1 | tr -d %)
            sos_is_num "$cur" || cur=0
            if [ "$1" = up ]; then new=$((cur + STEP)); else new=$((cur - STEP)); fi
            [ "$new" -gt 100 ] && new=100      # like Windows: never above 100 % (distorts otherwise)
            [ "$new" -lt 0 ] && new=0
            # already above 100 % (e.g. set in pavucontrol): "up" keeps it instead of lowering it to 100 %
            # (like "Volume up" in the sound menu, simpleos-volume)
            [ "$1" = up ] && [ "$new" -lt "$cur" ] && new=$cur
            pactl set-sink-volume @DEFAULT_SINK@ "$new%" 2>/dev/null ;;
        mute)
            pactl set-sink-mute @DEFAULT_SINK@ toggle 2>/dev/null ;;
        *) echo "Usage: simpleos-osd volume up|down|mute" >&2; exit 2 ;;
    esac
    vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -n 1 | tr -d %)
    sos_is_num "$vol" || vol=0
    if pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes'; then
        osd Volume "Muted" 0 notification-audio-volume-muted
    else
        # notification-*: Papirus has these in notification size (48 px); audio-volume-* only as 16–24 px panel icons
        if [ "$vol" -eq 0 ]; then icon=notification-audio-volume-muted
        elif [ "$vol" -lt 34 ]; then icon=notification-audio-volume-low
        elif [ "$vol" -lt 67 ]; then icon=notification-audio-volume-medium
        else icon=notification-audio-volume-high; fi
        osd Volume "$vol%" "$vol" "$icon"
    fi
}

# Best backlight device: raw/platform before firmware (acpi_video often has no effect when both exist)
backlight() {
    best= rank=9
    for d in "$BL"/*; do
        [ -r "$d/max_brightness" ] || continue
        case "$(cat "$d/type" 2>/dev/null)" in raw) r=1 ;; platform) r=2 ;; firmware) r=3 ;; *) r=4 ;; esac
        [ "$r" -lt "$rank" ] && { best=$d; rank=$r; }
    done
    echo "$best"
}

brightness() {
    case "$1" in up|down) ;; *) echo "Usage: simpleos-osd brightness up|down" >&2; exit 2 ;; esac
    dev=$(backlight)
    if [ -z "$dev" ]; then
        osd Brightness "This screen's brightness can't be changed here – use the buttons on the monitor." 0 notification-display-brightness
        exit 0
    fi
    max=$(cat "$dev/max_brightness" 2>/dev/null) cur=$(cat "$dev/brightness" 2>/dev/null)
    sos_is_num "$max" && sos_is_num "$cur" && [ "$max" -gt 0 ] || { sos_log "unlesbar: $dev"; exit 0; }
    step=$((max * STEP / 100)); [ "$step" -lt 1 ] && step=1
    floor=$((max * 5 / 100)); [ "$floor" -lt 1 ] && floor=1
    if [ "$1" = up ]; then new=$((cur + step)); else new=$((cur - step)); fi
    [ "$new" -gt "$max" ] && new=$max
    [ "$new" -lt "$floor" ] && new=$floor
    name=${dev##*/}
    if busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto org.freedesktop.login1.Session \
        SetBrightness ssu backlight "$name" "$new" >&2 2>&1; then
        :
    else
        sos_log "SetBrightness $name $new failed"
        new=$cur
    fi
    pct=$(( (new * 100 + max / 2) / max ))
    osd Brightness "$pct%" "$pct" notification-display-brightness
}

case "${1:-}" in
    volume)     volume "${2:-}" ;;
    brightness) brightness "${2:-}" ;;
    *) echo "Usage: simpleos-osd volume up|down|mute | brightness up|down" >&2; exit 2 ;;
esac
exit 0
