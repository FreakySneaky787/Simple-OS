#!/bin/sh
# Simple OS – window snapping like Windows 11 (Openbox shortcuts in rc.xml)
#   simpleos-snap left|right   Super+Left/Right: left/right half of the screen. If the window is already
#                              on the left and there is another screen to the left, it moves there (right
#                              half); if it is on the right, Super+Left returns it to its old size.
#   simpleos-snap up           Super+Up: maximize
#   simpleos-snap down         Super+Down: snapped/maximized -> old size and position; otherwise minimize
#   simpleos-snap corner-left|corner-right|corner-up|corner-down
#                              Super+Alt+arrows: a quarter of the screen. Left/right chooses the column,
#                              up/down the row (the window "walks" through the four corners)
# Screen = the one the window center is on (several monitors). Usable area = monitor intersected
# with _NET_WORKAREA (the taskbar stays free). Window borders (_NET_FRAME_EXTENTS) are subtracted so the
# whole frame fits exactly into the tile. State per window (tile + original size) in
# $XDG_RUNTIME_DIR/simpleos-snap/<window ID>; if the window has been moved by hand since, it counts as
# free again. No set -e; if something is missing (no active window, desktop, taskbar), nothing happens. Exit 0.
# Tests: SIMPLEOS_SNAP_WIN replaces the active window.

LOG=${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/simpleos-snap.log
mkdir -p "${LOG%/*}" 2>/dev/null
log() { echo "$(date '+%F %T' 2>/dev/null) $*" >> "$LOG" 2>/dev/null; }
action=${1:-}
case "$action" in
    left|right|up|down|corner-left|corner-right|corner-up|corner-down) ;;
    *) echo "Usage: simpleos-snap left|right|up|down|corner-left|corner-right|corner-up|corner-down" >&2; exit 2 ;;
esac
for tool in xdotool wmctrl xprop xwininfo xrandr; do
    command -v "$tool" >/dev/null || { log "$tool missing"; exit 0; }
done

win=${SIMPLEOS_SNAP_WIN:-$(xdotool getactivewindow 2>/dev/null)}
case "$win" in ''|*[!0-9]*) log "no active window"; exit 0 ;; esac
# Do not touch the desktop (pcmanfm), taskbar, menus
case "$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null)" in
    *DESKTOP*|*DOCK*|*MENU*|*SPLASH*|*NOTIFICATION*|*TOOLTIP*) exit 0 ;;
esac

# Number list of an xprop property ("NAME(CARDINAL) = 1, 2, 3") -> "1 2 3"
xnums() { sed -n 's/^[^=]*= *//p' | tr -d ',' | head -n 1; }

# ---- Window: client geometry (xwininfo: absolute position; xdotool getwindowgeometry counts the frame twice
#      with Openbox) + frame -> outer frame geometry fx fy fw fh
eval "$(xwininfo -id "$win" 2>/dev/null | awk -F: '
    /Absolute upper-left X/ { printf "X=%d\n", $2 } /Absolute upper-left Y/ { printf "Y=%d\n", $2 }
    /^ *Width/ { printf "WIDTH=%d\n", $2 }        /^ *Height/ { printf "HEIGHT=%d\n", $2 }')"
[ -n "${WIDTH:-}" ] || { log "no geometry for $win"; exit 0; }
set -- $(xprop -id "$win" _NET_FRAME_EXTENTS 2>/dev/null | xnums)
el=${1:-0} er=${2:-0} et=${3:-0} eb=${4:-0}
fx=$((X - el)) fy=$((Y - et)) fw=$((WIDTH + el + er)) fh=$((HEIGHT + et + eb))
cx=$((fx + fw / 2)) cy=$((fy + fh / 2))

# ---- Screens: "x y w h" per line (xrandr --listactivemonitors: " 0: +*DP-1 2560/597x1440/336+0+0  DP-1")
monitors() {
    xrandr --listactivemonitors 2>/dev/null |
        sed -n 's/^ *[0-9]*: [^ ]* \([0-9]*\)\/[0-9]*x\([0-9]*\)\/[0-9]*+\([0-9]*\)+\([0-9]*\).*/\3 \4 \1 \2/p'
}
MONS=$(monitors)
[ -n "$MONS" ] || { log "no monitors"; exit 0; }
# Monitor with the window center (otherwise the first one)
mon=$(printf '%s\n' "$MONS" | awk -v x="$cx" -v y="$cy" '$1 <= x && x < $1 + $3 && $2 <= y && y < $2 + $4 { print; exit }')
[ -n "$mon" ] || mon=$(printf '%s\n' "$MONS" | head -n 1)

# Usable area: monitor ∩ _NET_WORKAREA (first rectangle = current work area of all monitors)
area() {  # $1..$4 = monitor x y w h
    set -- "$@" $(xprop -root _NET_WORKAREA 2>/dev/null | xnums)
    if [ $# -ge 8 ]; then
        ax=$(( $1 > $5 ? $1 : $5 )) ay=$(( $2 > $6 ? $2 : $6 ))
        ax2=$(( $1 + $3 < $5 + $7 ? $1 + $3 : $5 + $7 )) ay2=$(( $2 + $4 < $6 + $8 ? $2 + $4 : $6 + $8 ))
        if [ "$ax2" -gt "$ax" ] && [ "$ay2" -gt "$ay" ]; then
            echo "$ax $ay $((ax2 - ax)) $((ay2 - ay))"
            return
        fi
    fi
    echo "$1 $2 $3 $4"
}
set -- $(area $mon)
mx=$1 my=$2 mw=$3 mh=$4

# ---- State
SD=${XDG_RUNTIME_DIR:-${HOME:-/tmp}/.cache}/simpleos-snap
mkdir -p "$SD" 2>/dev/null
SF=$SD/$win
pos= orig= target= oext=
[ -r "$SF" ] && . "$SF" 2>/dev/null
# Moved/resized by hand (deviation > 8 px) -> no longer snapped
if [ -n "$pos" ] && [ "$pos" != max ]; then
    set -- $target
    if [ $# -ne 4 ] || [ $(( (fx - $1) * (fx - $1) + (fy - $2) * (fy - $2) )) -gt 64 ] ||
       [ $(( fw - $3 )) -gt 8 ] || [ $(( $3 - fw )) -gt 8 ] || [ $(( fh - $4 )) -gt 8 ] || [ $(( $4 - fh )) -gt 8 ]; then
        pos= orig=
    fi
fi
maximized() { xprop -id "$win" _NET_WM_STATE 2>/dev/null | grep -q '_NET_WM_STATE_MAXIMIZED_HORZ'; }
[ "$pos" = max ] && ! maximized && pos=
[ -z "$pos" ] && maximized && pos=max
# Remember the original size only for free windows (Openbox restores windows maximized by hand itself)
had_orig=0
# oext: frame sizes in the free state (when maximized Openbox removes the side borders)
if [ -n "$orig" ]; then had_orig=1; else orig="$fx $fy $fw $fh" oext="$el $er $et $eb"; fi

save() { printf 'pos=%s\norig="%s"\noext="%s"\ntarget="%s"\n' "$1" "$orig" "$oext" "$2" > "$SF" 2>/dev/null; }
unmax() { wmctrl -i -r "$win" -b remove,maximized_vert,maximized_horz 2>/dev/null; }
# Set the frame to x y w h: wmctrl expects the client size; gravity 1 (NorthWest) = x/y is the top left
# corner of the frame (with 0 Openbox takes the window's own gravity and offsets by the title bar)
place() {
    unmax
    wmctrl -i -r "$win" -e "1,$1,$2,$(($3 - el - er)),$(($4 - et - eb))" 2>/dev/null
}
# Tile name -> "x y w h" on the area mx my mw mh
cell() {
    hw=$((mw / 2)) hh=$((mh / 2))
    case "$1" in
        left)         echo "$mx $my $hw $mh" ;;
        right)        echo "$((mx + hw)) $my $((mw - hw)) $mh" ;;
        top-left)     echo "$mx $my $hw $hh" ;;
        top-right)    echo "$((mx + hw)) $my $((mw - hw)) $hh" ;;
        bottom-left)  echo "$mx $((my + hh)) $hw $((mh - hh))" ;;
        bottom-right) echo "$((mx + hw)) $((my + hh)) $((mw - hw)) $((mh - hh))" ;;
    esac
}
snap() {
    g=$(cell "$1")
    place $g
    save "$1" "$g"
    log "snap $win $1 -> $g"
}
restore() {
    set -- $oext
    [ $# -eq 4 ] && el=$1 er=$2 et=$3 eb=$4
    set -- $orig
    unmax
    [ "$had_orig" = 1 ] && [ $# -eq 4 ] && wmctrl -i -r "$win" -e "1,$1,$2,$(($3 - el - er)),$(($4 - et - eb))" 2>/dev/null
    rm -f "$SF"
    log "restore $win -> $orig"
}
# Neighbor screen left/right of the current one (vertically overlapping) -> "x y w h"
neighbour() {
    set -- $mon
    printf '%s\n' "$MONS" | awk -v x="$1" -v y="$2" -v w="$3" -v h="$4" -v d="$NEIGHBOUR_DIR" '
        { ov = ($2 < y + h && y < $2 + $4) }
        ov && d == "left"  && $1 + $3 <= x && (best == "" || $1 > bx) { best = $0; bx = $1 }
        ov && d == "right" && $1 >= x + w  && (best == "" || $1 < bx) { best = $0; bx = $1 }
        END { if (best != "") print best }'
}
# Column/row of the window (for the corners): from the tile, otherwise from the position of the window center
col() { case "$pos" in *left) echo left ;; *right) echo right ;; *) [ "$cx" -lt $((mx + mw / 2)) ] && echo left || echo right ;; esac; }
row() { case "$pos" in bottom-*) echo bottom ;; *) echo top ;; esac; }

case "$action" in
    left|right)
        other=right; [ "$action" = right ] && other=left
        if [ "$pos" = "$action" ]; then
            nb=$(NEIGHBOUR_DIR=$action neighbour)
            if [ -n "$nb" ]; then
                mon=$nb
                set -- $(area $nb)
                mx=$1 my=$2 mw=$3 mh=$4
                snap "$other"
            fi
        elif [ "$pos" = "$other" ]; then
            restore
        else
            snap "$action"
        fi ;;
    up)
        [ "$pos" = max ] && exit 0
        save max ""
        wmctrl -i -r "$win" -b add,maximized_vert,maximized_horz 2>/dev/null
        log "maximize $win" ;;
    down)
        if [ -n "$pos" ]; then
            restore
        else
            xdotool windowminimize "$win" 2>/dev/null
            log "minimize $win"
        fi ;;
    corner-left)  snap "$(row)-left" ;;
    corner-right) snap "$(row)-right" ;;
    corner-up)    snap "top-$(col)" ;;
    corner-down)  snap "bottom-$(col)" ;;
esac
exit 0
