#!/bin/sh
# Simple OS – graphical system update (Menu → Settings → Software Updates)
#   simpleos-update           Rofi window: available updates, "Install now" -> pkexec (password dialog)
#   simpleos-update --check   counts updates; if there are any, a notification with "Install" appears -> opens the
#                             window above. Not in the live session.
#   simpleos-update --watch   background (Openbox autostart): --check 2 minutes after sign-in, then every 12 hours as long
#                             as the session runs (runs only once per session). Before, the only check was the one after
#                             sign-in – a laptop that is only ever closed and opened again never heard of updates.
#                             The clock is read every minute: after sleep/hibernation a check that became due runs
#                             2 minutes after waking up (time for the network).
# Counted is what the root helper would really install ("apt-get -s full-upgrade" if it removes nothing,
# otherwise "apt-get -s upgrade --with-new-pkgs" – the same choice as the helper; only new versions, no new
# dependencies) from the package lists that apt-daily.timer downloads daily (/etc/apt/apt.conf.d/20simpleos-periodic),
# plus firmware/BIOS updates from fwupd (metadata: fwupd-refresh.timer) and apps from the Software Store (Flatpak,
# system installation – the helper updates them along with the rest; before they were not counted, so updates of only
# e.g. the Mullvad Browser were never offered). Before, "apt list --upgradable" also counted updates the helper does
# not install at all -> after updating and restarting they were there again.
# Installation only goes through the fixed root helper "simpleos-system-setup --upgrade" (polkit action, no free
# package names, never removes packages); it reports "FIRMWARE: installed|needs-power|failed" and "HELD: <count>".
# Opening the window = checking by itself: if the package lists are older than 30 minutes, "simpleos-system-setup
# --refresh" downloads them again (without a password: polkit rule /etc/polkit-1/rules.d/50-simpleos-update-refresh.rules,
# hook 14_update_refresh), then the result with "Install now" comes right away – before, you had to open the window
# twice (once "Check now", once install). Without updates only a notification "up to date".
# Restart: never directly from the notification – a click on it asks first ("Restart now" / "Later"), so nobody
# is interrupted in the middle of their work.
# BIOS updates run during the restart; if the same device is in the list again afterwards, applying it failed
# -> an honest notification (marker ~/.cache/simpleos/firmware-installed).
# New Simple OS edition: the package "simpleos" (APT source simpleos.sources, GitHub release "latest") is listed as
# "Simple OS <version>" at the top; the packages that edition adds come with it (edition --todo-packages). Afterwards
# a hint that the account's settings follow at the next sign-in (edition --user).
# Tests: SIMPLEOS_REBOOT_FLAG replaces /var/run/reboot-required, SIMPLEOS_APT_STAMPS the time stamps of the last
# check (list; empty/old = check again); --watch: SIMPLEOS_UPDATE_FIRST/_EVERY/_NAP (seconds until the first check,
# between checks, between looks at the clock), SIMPLEOS_UPDATE_ROUNDS (stop after that many checks).
# Robust like simpleos-wifi: no set -e, every path ends with exit 0 and a clear notification;
# output of the installation in ~/.cache/simpleos-update.log.

SOS_NAME=simpleos-update SOS_TITLE="Software Updates" SOS_ICON=system-software-update SOS_PROMPT=Updates
LIB=/usr/local/lib/simpleos/common.sh
HELPER=/usr/local/sbin/simpleos-system-setup
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || { notify-send "Software Updates" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"

sos_rofi_failed() {
    sos_notify "The update window could not open. Please try again from Settings → Software Updates." critical
    exit 0
}
is_live() { grep -qw 'boot=live' /proc/cmdline 2>/dev/null; }

# ---- Background (Openbox autostart): --check after sign-in, then every 12 hours. Before the lock below: this loop runs
# all session long, the lock is only taken by each --check.
if [ "${1:-}" = --watch ]; then
    is_live && exit 0
    pidf=${XDG_RUNTIME_DIR:-$SOS_LOG_DIR}/simpleos-update-watch.pid
    if [ -r "$pidf" ] && kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null; then exit 0; fi
    echo $$ > "$pidf" 2>/dev/null
    nap=${SIMPLEOS_UPDATE_NAP:-60} every=${SIMPLEOS_UPDATE_EVERY:-43200} rounds=0
    last=$(date +%s); due=$((last + ${SIMPLEOS_UPDATE_FIRST:-120}))
    while :; do
        sleep "$nap"
        # Signed out: the X server is gone -> end (a process of the old session would otherwise keep running)
        [ -n "${DISPLAY:-}" ] && ! xprop -root -notype _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1 && exit 0
        now=$(date +%s)
        # The clock jumped (woken up from sleep): a due check waits 2 minutes for the network
        [ $((now - last)) -gt $((nap * 5 + 60)) ] && [ "$due" -lt $((now + 120)) ] && due=$((now + 120))
        last=$now
        [ "$now" -ge "$due" ] || continue
        "$0" --check
        due=$(($(date +%s) + every))
        rounds=$((rounds + 1))
        [ -n "${SIMPLEOS_UPDATE_ROUNDS:-}" ] && [ "$rounds" -ge "$SIMPLEOS_UPDATE_ROUNDS" ] && exit 0
    done
fi

# Only one update window/run at a time (e.g. notification clicked and menu opened)
LOCK=${XDG_RUNTIME_DIR:-/tmp}/simpleos-update.$(id -u 2>/dev/null || echo 0).lock
if ! mkdir "$LOCK" 2>/dev/null; then
    # take over an orphaned lock (process gone)
    pid=$(cat "$LOCK/pid" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        [ "${1:-}" = --check ] || sos_notify "Updates are already being checked or installed."
        exit 0
    fi
    rm -rf "$LOCK"; mkdir "$LOCK" 2>/dev/null || exit 0
fi
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT
trap 'exit 0' INT TERM HUP

REBOOT_FLAG=${SIMPLEOS_REBOOT_FLAG:-/var/run/reboot-required}
FW_MARK=${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/simpleos/firmware-installed
# Last checked: the helper (apt-get update) or apt-daily
APT_STAMPS=${SIMPLEOS_APT_STAMPS-/var/lib/simpleos/apt-refreshed /var/lib/apt/periodic/update-success-stamp}
# Package names with updates (one line per package): what the helper would install (see above). "Inst package [old]
# (new …)" = new version; new packages without "[old]" (e.g. the kernel package behind linux-image-amd64) do not count.
# apt-get -s needs no root. The edition package comes first as "Simple OS <new version>".
upgradable() {
    sim=$(LC_ALL=C apt-get -s full-upgrade 2>/dev/null) || sim=
    printf '%s\n' "$sim" | grep -q '^Remv ' && sim=$(LC_ALL=C apt-get -s upgrade --with-new-pkgs 2>/dev/null)
    printf '%s\n' "$sim" | awk '$1 == "Inst" && $3 ~ /^\[/ {
        if ($2 == "simpleos") { v = $4; sub(/^\(/, "", v); print "Simple OS " v } else rest = rest $2 "\n" }
        END { printf "%s", rest }'
}
# Packages of the installed edition that are still missing (an earlier installation of them failed)
EDITION=/usr/local/lib/simpleos/edition
edition_todo() { [ -x "$EDITION" ] && "$EDITION" --todo-packages 2>/dev/null; }
# Devices with a firmware update (one line per device). --json never asks, --no-authenticate: no password dialog
# just for checking. In the JSON output the device name comes before "Releases" (release names only follow after it).
firmware() {
    command -v fwupdmgr >/dev/null || return 0
    timeout 30 fwupdmgr get-updates --json --no-authenticate --no-unreported-check --no-metadata-check \
        --no-remote-check 2>/dev/null |
        awk '/"Name" *:/ { n = $0; sub(/^[^:]*: *"/, "", n); sub(/",? *$/, "", n) }
             /"Releases" *: *\[/ { if (n != "") print n; n = "" }'
}
# Apps from the Software Store (Flatpak, system installation) with an update, one line per name. Needs the network (it
# asks Flathub) and no root; offline the list stays empty. The helper installs them with "flatpak update --system".
apps() {
    command -v flatpak >/dev/null || return 0
    flatpak remotes --system 2>/dev/null | grep -q . || return 0
    timeout 60 flatpak remote-ls --updates --system --columns=name 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' |
        grep . | sort -u
}
# Everything pending: a new Simple OS edition, firmware (with a hint), packages, then apps (with a hint)
pending() {
    up=$(upgradable)
    printf '%s\n' "$up" | grep '^Simple OS '
    firmware | sed 's/$/ (firmware)/'
    printf '%s\n' "$up" | grep -v -e '^Simple OS ' -e '^$'
    apps | sed 's/$/ (app)/'
    edition_todo
}
# After a restart: a BIOS/firmware update the helper had installed is still pending -> not applied during the
# restart. One notification, then the marker is gone (the update stays in the list as usual).
firmware_check() {
    [ -s "$FW_MARK" ] || return 0
    # Marker from this session (no restart yet): say nothing
    [ -e "$REBOOT_FLAG" ] && return 0
    still=$(firmware | grep -Fxf "$FW_MARK")
    rm -f "$FW_MARK"
    [ -n "$still" ] || return 0
    sos_notify "The firmware update ($(printf '%s' "$still" | head -n 1)) was not applied during the restart. Keep the charger plugged in and try again from Settings → Software Updates. Details: ~/.cache/simpleos-update.log" critical
}
# Offer a restart: notification with "Restart…"; a click asks first – never restart right away
offer_restart() {  # $1 text
    # Release the lock first: the notification can stay open for a long time, Software Updates should still open
    rm -rf "$LOCK"; trap - EXIT
    sos_ask "Updates installed" "$1" "Restart…" || return 0
    sos_add "$(sos_fa '\357\200\241')  Restart now" "restart"
    sos_add "$(sos_fa '\357\200\215')  Later" "later"
    sos_pick "<b>Restart now?</b>${SOS_NL}$(sos_dim "Save your work first – open windows will close.")" 440
    [ "$action" = restart ] || return 0
    systemctl reboot >&2 2>&1 || loginctl reboot >&2 2>&1 || sos_notify "Please restart your computer to finish the update."
}
# Package lists downloaded within the last 30 minutes?
lists_fresh() {
    now=$(date +%s)
    for f in $APT_STAMPS; do
        t=$(date -r "$f" +%s 2>/dev/null) || continue
        [ $((now - t)) -lt 1800 ] && return 0
    done
    return 1
}

install_updates() {
    if [ ! -x "$HELPER" ] || ! command -v pkexec >/dev/null; then
        sos_notify "Updates cannot be installed on this system (update helper missing)." critical
        return 0
    fi
    # Remember the devices with a firmware update BEFORE installing: fwupd no longer lists a scheduled UEFI capsule
    # update under get-updates afterwards (it waits for the restart) – read afterwards, the list stayed empty and the
    # check after the restart (firmware_check) never took effect. The list is already in the window ($pkgs, "… (firmware)").
    fw_before=$(printf '%s\n' "${pkgs:-}" | sed -n 's/ (firmware)$//p')
    edition=$(printf '%s\n' "${pkgs:-}" | sed -n 's/^Simple OS //p' | head -n 1)
    # Progress window with real progress (PROGRESS/STAGE from the helper); appears only after the password dialog.
    # Without --title: the helper's STEP lines are the heading ("Checking for updates" -> "Installing updates"),
    # otherwise it also said "Installing updates" when just checking. Nothing to do -> the helper reports "DONE: Already up to date"
    out=$(mktemp) || out=/dev/null
    PROGRESS=/usr/local/bin/simpleos-progress
    ppid=
    if [ -x "$PROGRESS" ] && [ "$out" != /dev/null ]; then
        "$PROGRESS" --follow "$out" --done "Updates installed" \
            --hint "You can keep working – don't turn off the computer" --app Updates \
            --icon-name system-software-update --pid $$ 2>>"$SOS_LOG" &
        ppid=$!
    else
        sos_notify "Installing updates … You can keep working. Don't turn off the computer."
    fi
    pkexec "$HELPER" --upgrade >"$out" 2>&1
    rc=$?
    [ "$out" != /dev/null ] && { cat "$out" >>"$SOS_LOG"; echo "EXIT: $rc" >>"$out"; }
    [ -n "$ppid" ] && wait "$ppid" 2>/dev/null
    log=$(cat "$out" 2>/dev/null); [ "$out" != /dev/null ] && rm -f "$out"
    sos_log "helper exit $rc"
    case "$rc" in
        0)  fwnote=
            case "$log" in
                *"FIRMWARE: needs-power"*)
                    fwnote="A firmware update (BIOS) is waiting: plug in the charger, then open Software Updates again." ;;
                *"FIRMWARE: failed"*)
                    fwnote="The firmware update could not be installed. Details: ~/.cache/simpleos-update.log" ;;
            esac
            [ -n "$fwnote" ] && sos_notify "$fwnote" critical
            # Updates that would only work by removing other software – never skip them silently
            held=$(printf '%s\n' "$log" | sed -n 's/^HELD: *\([0-9][0-9]*\)$/\1/p' | head -n 1)
            if [ -n "$held" ]; then
                if [ "$held" -eq 1 ]; then n="1 update"; else n="$held updates"; fi
                sos_notify "$n could not be installed automatically: they would remove other software. Details: ~/.cache/simpleos-update.log" critical
            fi
            restart="Your computer needs a restart to finish the update. Restart when it suits you."
            [ -n "$edition" ] && restart="Simple OS $edition is installed. Your computer needs a restart to finish the update. Restart when it suits you."
            if printf '%s\n' "$log" | grep -qx 'FIRMWARE: installed'; then
                restart="Your computer needs a restart to finish the update. Firmware is installed during the restart – keep the charger plugged in."
                # Remember the devices: if they are still pending after the restart, applying them did not work
                [ -n "$fw_before" ] && mkdir -p "${FW_MARK%/*}" 2>/dev/null &&
                    printf '%s\n' "$fw_before" > "$FW_MARK" 2>/dev/null
            fi
            if [ -e "$REBOOT_FLAG" ]; then
                offer_restart "$restart"
            elif [ -n "$edition" ]; then
                sos_notify "Simple OS $edition is installed. Sign out and back in to see everything that is new."
            elif [ -n "$fwnote$held" ]; then
                :
            elif printf '%s\n' "$log" | grep -qx 'UPTODATE: 1'; then
                sos_notify "Your system is up to date – there was nothing to install."
            else
                sos_notify "Your system is up to date."
            fi ;;
        126|127) sos_notify "No password entered – nothing was changed." ;;
        *)  # the cause instead of always "internet": space, network, otherwise the log
            case "$log" in
                *"No space left"*|*"not enough free space"*|*"min-free-space"*|*"You don't have enough free space"*)
                    sos_notify "Some updates could not be installed: not enough free disk space. Free up space with the Storage Cleaner and try again." critical ;;
                *"Temporary failure resolving"*|*"Could not resolve"*|*"Failed to fetch"*|*"Could not connect"*|*"Network is unreachable"*)
                    sos_notify "Some updates could not be installed: no internet connection. Check your network and try again from Settings → Software Updates." critical ;;
                *"Could not get lock"*|*"Unable to acquire"*|*"is locked by another process"*)
                    sos_notify "Some updates could not be installed: another installation was still running. Try again in a few minutes." critical ;;
                *)  # send the first apt/dpkg error line along instead of only pointing to the log; if a restart is
                    # pending (new kernel), often only a restart helps
                    reason=$(printf '%s\n' "$log" | sed -n 's/^E: //p; s/^dpkg: error[^:]*: //p; s/^error: //p' | head -n 1 | cut -c1-140)
                    reason=$(sos_esc "$reason")
                    hint=
                    [ -e "$REBOOT_FLAG" ] && hint=" Restart your computer first, then try again."
                    sos_notify "Some updates could not be installed${reason:+: $reason}.$hint Details: ~/.cache/simpleos-update.log" critical ;;
            esac ;;
    esac
}

# Check: download package lists/firmware metadata (without a password, polkit rule). If it fails (no network),
# the window shows the last known state. Exit 0 = freshly downloaded
refresh_lists() {
    if [ ! -x "$HELPER" ] || ! command -v pkexec >/dev/null; then
        sos_log "refresh: helper/pkexec missing"
        return 1
    fi
    sos_notify "Checking for updates…" low
    pkexec "$HELPER" --refresh >>"$SOS_LOG" 2>&1
    rc=$?
    sos_log "refresh exit $rc"
    [ "$rc" -eq 0 ]
}

# ---- Background check (autostart)
if [ "${1:-}" = --check ]; then
    is_live && exit 0
    command -v apt-get >/dev/null || exit 0
    firmware_check
    count=$(pending | grep -c . || true)
    sos_is_num "$count" || count=0
    [ "$count" -gt 0 ] || exit 0
    if [ "$count" -eq 1 ]; then text="1 update is ready to install."; else text="$count updates are ready to install."; fi
    # Release the lock before waiting: the notification can stay open for a long time, the menu should still work
    rm -rf "$LOCK"; trap - EXIT
    sos_ask "Updates available" "$text Click to install." "Install" || exit 0
    exec /usr/local/bin/simpleos-update
fi

# ---- Window
if is_live; then
    sos_notify "Updates can be installed after Simple OS is installed on your computer."
    exit 0
fi
command -v apt-get >/dev/null || { sos_notify "Updates are not available on this system (apt missing)." critical; exit 0; }
firmware_check

# Check by itself first (lists older than 30 minutes), then the result right away – one call for everything
online=1
lists_fresh || refresh_lists || online=0
pkgs=$(pending)
count=$(printf '%s\n' "$pkgs" | grep -c . || true)
sos_is_num "$count" || count=0
if [ "$count" -eq 0 ]; then
    if [ "$online" = 1 ]; then
        sos_notify "Your system is up to date."
    else
        sos_notify "Updates could not be checked right now – are you connected to the internet? Details: ~/.cache/simpleos-update.log" critical
    fi
    exit 0
fi
# FontAwesome 4: download U+F019, times U+F00D
# Join lines with ", " – firmware names contain spaces ("System Firmware (firmware)")
names=$(printf '%s\n' "$pkgs" | head -n 4 | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
[ "$count" -gt 4 ] && names="$names, …"
if [ "$count" -eq 1 ]; then head="1 update available"; else head="$count updates available"; fi
[ "$online" = 1 ] || head="$head $(sos_dim "(could not check online – last known state)")"
sos_add "$(sos_fa '\357\200\231')  Install now" "install"
sos_add "$(sos_fa '\357\200\215')  Not now" "close"
sos_pick "<b>$head</b>${SOS_NL}$(sos_esc "$names")" 480
[ "$action" = install ] && install_updates
exit 0
