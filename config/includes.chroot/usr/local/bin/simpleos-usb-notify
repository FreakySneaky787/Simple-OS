#!/bin/sh
# Simple OS – notifications for USB sticks and drives. udiskie (Openbox autostart) mounts plugged-in
# drives automatically and calls this script on every event (--notify-command):
#   simpleos-usb-notify <event> <mount_path> <id_label> <drive_label>
#   device_mounted   -> "USB drive is ready" with the buttons "Open" (a click on the notification is enough) -> file manager
#                       and "Safely remove" -> unmount + power off the drive (udiskie-umount --detach)
#   device_unmounted -> "can be removed safely" (only for a drive announced above)
#   only mounts below /media (udiskie's own); the installer's or other programs' mounts are not announced
#   job_failed       -> a clear error message
# Other events are ignored. No set -e, always exit 0; details in ~/.cache/simpleos-usb-notify.log.

SOS_NAME=simpleos-usb-notify SOS_TITLE="USB drive" SOS_ICON=drive-removable-media
LIB=/usr/local/lib/simpleos/common.sh
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || exit 0
. "$LIB"
sos_log_init "$@"

event=${1:-} path=${2:-} label=${3:-} drive=${4:-}
# Display name: volume label, otherwise drive name, otherwise neutral; udiskie sends "None" for empty fields
[ "$label" = None ] && label=
[ "$drive" = None ] && drive=
name=${label:-${drive:-USB drive}}

open_files() {
    if command -v thunar >/dev/null; then exec thunar "$1"; fi
    if command -v xdg-open >/dev/null; then exec xdg-open "$1"; fi
    sos_notify "Your files are in $1"
    exit 0
}

# Safely remove: unmount and power off the drive. The notification "can be removed safely" comes by
# itself afterwards (udiskie reports device_unmounted). Files still open -> a clear hint.
eject() {
    if command -v udiskie-umount >/dev/null; then
        udiskie-umount --detach "$1" >&2 2>&1 && return 0
    elif command -v udisksctl >/dev/null; then
        dev=$(findmnt -n -o SOURCE --target "$1" 2>/dev/null)
        [ -n "$dev" ] && udisksctl unmount -b "$dev" >&2 2>&1 && { udisksctl power-off -b "$dev" >&2 2>&1; return 0; }
    fi
    sos_notify "\"$name\" is still in use. Close all files and windows from it, then try again." critical
}

# Drives this script announced as ready (one name per line): only those get "can be removed safely" later
SEEN=${XDG_RUNTIME_DIR:-$SOS_LOG_DIR}/simpleos-usb-notify.mounted

case "$event" in
    device_mounted)
        [ -n "$path" ] && [ "$path" != None ] || exit 0
        # Only what udiskie itself opened (/media/<user>/…). udiskie also reports mounts of other programs – the
        # installer mounts the new system at /tmp/calamares-root-…: "USB drive is ready" with "Safely remove"
        # (unmount + power off the disk) appeared in the middle of the installation
        case "$path" in /media/*|/run/media/*) ;; *) sos_log "ignored: $name mounted at $path (not by udiskie)"; exit 0 ;; esac
        command -v notify-send >/dev/null || exit 0
        seen=$(grep -vxF "$name" "$SEEN" 2>/dev/null)
        printf '%s\n%s\n' "$seen" "$name" | grep . > "$SEEN" 2>/dev/null
        sos_log "ask: $name mounted at $path"
        # yes/default = Open (a click on the notification itself), eject = Safely remove; waits for the click
        answer=$(notify-send -c x-simpleos -a "$SOS_TITLE" -i "$SOS_ICON" -A "yes=Open" -A "eject=Safely remove" \
                     -A "default=Open" "\"$name\" is ready" "Open it in the file manager or remove it safely." 2>/dev/null)
        case "$answer" in
            yes|default) open_files "$path" ;;
            eject)       eject "$path" ;;
        esac ;;
    device_unmounted)
        # only a drive we announced (the installer unmounting its partitions said "SYSTEM can now be removed safely")
        grep -qxF "$name" "$SEEN" 2>/dev/null || { sos_log "ignored: $name unmounted (not announced)"; exit 0; }
        seen=$(grep -vxF "$name" "$SEEN" 2>/dev/null)
        printf '%s\n' "$seen" | grep . > "$SEEN" 2>/dev/null
        sos_notify "\"$name\" can now be removed safely." ;;
    job_failed)
        sos_notify "\"$name\" could not be opened. It may be damaged or use a format Simple OS can't read." critical ;;
esac
exit 0
