#!/bin/sh
# Simple OS – display settings (Super+P, Settings → Display)
# Rofi menu in plain language instead of output names (eDP-1 -> "Built-in display", HDMI-1 -> "HDMI 1"):
#   one screen         "Resolution", "Refresh rate"
#   several            a submenu per screen (resolution, refresh rate, main display, off) and
#                      "Duplicate", "Extend right", "Extend left", "Only <screen>" (like Windows+P)
#   at the bottom      "Advanced Display Settings" -> arandr (lxrandr as a fallback)
# Every change must be confirmed ("Keep changes"); without an answer within 15 s (picture black/unreadable) or
# on "Revert" the script restores the old state – like on Windows. Confirmed settings
# go to ~/.config/simpleos/display and are applied at login with "simpleos-display --restore".
# Robust like simpleos-wifi: no set -e, exit 0, errors as a notification, details in ~/.cache/simpleos-display.log.
#   simpleos-display            menu
#   simpleos-display --restore  apply the saved setting (Openbox autostart), silently. Without a saved
#                               setting: --best (otherwise Xorg takes the monitor's preferred mode, 60 Hz on
#                               many 120/144/165 Hz monitors)
#   simpleos-display --best     every active screen: the highest refresh rate of the current resolution
#   simpleos-display --watch    (Openbox autostart) plug in a monitor/projector or TV -> it is switched on and extends
#                               the desktop to the right, with a hint (Xorg only reports a new screen, it stays dark
#                               until someone configures it); unplugged -> released; nothing left on -> all on again.
#                               Waits for udev's DRM events, uses no CPU in between.
#   simpleos-display --hotplug  one such check against the outputs remembered last (what --watch does per event)
# Tests: SIMPLEOS_DISPLAY_TIMEOUT = seconds until the automatic revert, SIMPLEOS_DISPLAY_STATE = file with the outputs.

SOS_NAME=simpleos-display SOS_TITLE=Display SOS_ICON=video-display SOS_PROMPT=Display
TAB=$(printf '\t')
SAVED=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/simpleos/display
TIMEOUT=${SIMPLEOS_DISPLAY_TIMEOUT:-15}
HP_STATE=${SIMPLEOS_DISPLAY_STATE:-${XDG_RUNTIME_DIR:-/tmp}/simpleos-display.outputs}
LIB=/usr/local/lib/simpleos/common.sh
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || { notify-send "Display" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"

advanced() {
    for tool in arandr lxrandr; do
        command -v "$tool" >/dev/null && { "$tool" >/dev/null 2>&1 & exit 0; }
    done
    sos_notify "The advanced display settings are not installed." critical
    exit 0
}
sos_rofi_failed() {
    sos_notify "The display menu could not open. Opening the advanced display settings instead."
    advanced
}

case "${1:-}" in
    --restore|--best|--watch|--hotplug) command -v xrandr >/dev/null || exit 0 ;;
    *) command -v xrandr >/dev/null || { sos_notify "Display settings are not available (xrandr missing)." critical; exit 0; } ;;
esac

# ---- Read xrandr. Q = output of "xrandr --query" (once per menu round)
query() { Q=$(LC_ALL=C xrandr --query 2>/dev/null); }
connected() { printf '%s\n' "$Q" | awk '$2 == "connected" { print $1 }'; }
# Output active (has a geometry WxH+X+Y)?
is_on() { printf '%s\n' "$Q" | awk -v o="$1" '$1 == o { for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) f = 1 } END { exit !f }'; }
is_primary() { printf '%s\n' "$Q" | awk -v o="$1" '$1 == o && $3 == "primary" { f = 1 } END { exit !f }'; }
# Mode lines of an output: "mode<TAB>rate<TAB>active(1/0)" (one line per rate)
mode_lines() {
    printf '%s\n' "$Q" | awk -v o="$1" -v OFS='\t' '
        /^[^ \t]/ { inside = ($1 == o); next }
        inside && /^ +[0-9]+x[0-9]+/ {
            for (i = 2; i <= NF; i++) {
                r = $i; cur = (r ~ /\*/); gsub(/[*+]/, "", r)
                if (r == "") continue
                print $1, r, cur
            }
        }'
}
modes() { mode_lines "$1" | cut -f1 | awk '!seen[$0]++'; }
cur_mode() { mode_lines "$1" | awk -F'\t' '$3 == 1 { print $1; exit }'; }
cur_rate() { mode_lines "$1" | awk -F'\t' '$3 == 1 { print $2; exit }'; }
rates() { mode_lines "$1" | awk -F'\t' -v m="$2" '$1 == m { print $2 }'; }
# Highest rate of the current resolution per active screen (only if it is higher than the current one)
best() {
    query
    for o in $(connected); do
        is_on "$o" || continue
        m=$(cur_mode "$o") cur=$(cur_rate "$o")
        [ -n "$m" ] || continue
        top=$(rates "$o" "$m" | sort -gr | head -n 1)
        [ -n "$top" ] || continue
        if awk -v a="$top" -v b="${cur:-0}" 'BEGIN { exit !(a > b + 0.5) }'; then
            sos_log "best: $o $m ${cur:-?} -> $top Hz"
            xrandr --output "$o" --mode "$m" --rate "$top" >&2 2>&1 || sos_log "best: $o $top Hz rejected"
        fi
    done
}
hz() { printf '%s' "$1" | awk '{ printf "%d Hz", $1 + 0.5 }'; }
# Display name instead of the output name
pretty() {
    n=${1##*-}; sos_is_num "$n" || n=
    case "$1" in
        eDP*|LVDS*|DSI*)            echo "Built-in display" ;;
        HDMI*)                      echo "HDMI${n:+ $n}" ;;
        DP*|DisplayPort*)           echo "DisplayPort${n:+ $n}" ;;
        DVI*)                       echo "DVI${n:+ $n}" ;;
        VGA*)                       echo "VGA${n:+ $n}" ;;
        Virtual*|qxl*|default|XWAYLAND*) echo "Screen${n:+ $n}" ;;
        *)                          echo "$1" ;;
    esac
}

# Plugged in / unplugged since the last check ($HP_STATE: line 1 = connected outputs, line 2 = every output seen in this
# session). New: if the saved layout (~/.config/simpleos/display, confirmed in Super+P) knows it, that layout is applied
# again – a monitor that drops its signal when it goes to standby comes back where it was; otherwise it is switched on
# to the right of an active screen (the same as "Extend right" in the menu), several new ones next to each other.
# Gone: release the output. Nothing active afterwards (e.g. only the external screen was on and was unplugged): all on.
# The hint only for an output not seen before in this session.
hotplug() {
    query
    now=$(connected | tr '\n' ' ')
    if [ ! -e "$HP_STATE" ]; then printf '%s\n%s\n' "$now" "$now" > "$HP_STATE"; return 0; fi
    prev=$(sed -n 1p "$HP_STATE" 2>/dev/null)
    seen=$(sed -n 2p "$HP_STATE" 2>/dev/null)
    [ "$now" = "$prev" ] && return 0
    sos_log "hotplug: [$prev] -> [$now]"
    args= added= anchor= known=
    for o in $prev; do
        case " $now " in *" $o "*) ;; *) args="$args --output $o --off" ;; esac
    done
    for o in $(connected); do
        case " $prev " in *" $o "*) is_on "$o" && { anchor=$o; break; } ;; esac
    done
    for o in $(connected); do
        case " $prev " in *" $o "*) continue ;; esac
        added="$added $o"
        if [ -s "$SAVED" ] && head -n 1 "$SAVED" | grep -q -- "--output $o " && ! head -n 1 "$SAVED" | grep -q -- "--output $o --off"; then
            known=1
            continue
        fi
        if [ -n "$anchor" ]; then args="$args --output $o --auto --right-of $anchor"
        else args="$args --output $o --auto --pos 0x0"; fi
        anchor=$o
    done
    # shellcheck disable=SC2086
    [ -n "$args" ] && { xrandr $args >&2 2>&1 || sos_log "hotplug: xrandr rejected: $args"; }
    if [ -n "$known" ]; then
        # shellcheck disable=SC2046
        xrandr $(head -n 1 "$SAVED") >&2 2>&1 || sos_log "hotplug: saved layout rejected"
    fi
    query
    on=0
    for o in $(connected); do is_on "$o" && on=1; done
    if [ "$on" -eq 0 ] && [ -n "$(connected)" ]; then
        args= anchor=
        for o in $(connected); do
            if [ -n "$anchor" ]; then args="$args --output $o --auto --right-of $anchor"
            else args="$args --output $o --auto --primary --pos 0x0"; fi
            anchor=$o
        done
        # shellcheck disable=SC2086
        xrandr $args >&2 2>&1 || sos_log "hotplug: switching all on failed: $args"
    fi
    fresh=
    for o in $added; do
        case " $seen " in *" $o "*) ;; *) fresh="$fresh $o"; seen="$seen $o " ;; esac
    done
    printf '%s\n%s\n' "$now" "$seen" > "$HP_STATE"
    if [ -n "$fresh" ]; then
        names=
        for o in $fresh; do names="${names:+$names, }$(pretty "$o")"; done
        sos_notify "Display connected: $names. The desktop now extends onto it – Super+P changes that." low
    fi
}
watch_displays() {
    command -v udevadm >/dev/null || { sos_log "udevadm missing"; return 0; }
    query
    now=$(connected | tr '\n' ' ')
    printf '%s\n%s\n' "$now" "$now" > "$HP_STATE"
    udevadm monitor --udev --subsystem-match=drm 2>/dev/null | while read -r _ _ ev _; do
        [ "$ev" = change ] || continue
        sleep 1
        hotplug
    done
}
case "${1:-}" in
    --restore)
        if [ -s "$SAVED" ]; then
            # Saved outputs that no longer exist (monitor unplugged) -> xrandr fails, everything stays;
            # then at least the highest refresh rate as without a saved setting (otherwise often 60 Hz)
            # shellcheck disable=SC2046
            if ! xrandr $(head -n 1 "$SAVED") >&2 2>&1; then
                sos_log "restore failed: $(head -n 1 "$SAVED")"
                best
            fi
        else
            best
        fi
        exit 0 ;;
    --best) best; exit 0 ;;
    --hotplug) hotplug; exit 0 ;;
    --watch) watch_displays; exit 0 ;;
esac
command -v rofi >/dev/null || { sos_log "rofi missing"; sos_rofi_failed; }
# Current state of all connected outputs as xrandr arguments (for reverting/saving)
snapshot() {
    args=
    for o in $(connected); do
        if is_on "$o"; then
            pos=$(printf '%s\n' "$Q" | awk -v o="$o" '$1 == o { for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, a, "+"); print a[2] "x" a[3]; exit } }')
            args="$args --output $o --mode $(cur_mode "$o") --rate $(cur_rate "$o") --pos ${pos:-0x0}"
            is_primary "$o" && args="$args --primary"
        else
            args="$args --output $o --off"
        fi
    done
    printf '%s' "${args# }"
}

# Question with a time limit: exit 0 only on "Keep changes". Grab errors right after the mode change
# -> new attempt; no Rofi, Esc or time is up -> revert.
confirm() {
    try=0
    while [ "$try" -lt 3 ]; do
        try=$((try + 1))
        err=$(mktemp 2>/dev/null) || err=/dev/null
        answer=$(printf 'Keep changes\nRevert\n' | timeout "$TIMEOUT" rofi -dmenu -i -no-custom -format i -p "$SOS_TITLE" \
            -mesg "<b>Keep these display settings?</b>   Reverting in $TIMEOUT seconds…" -markup \
            -theme-str 'window { width: 420px; location: center; anchor: center; } mainbox { children: [ message, listview ]; }
                        listview { lines: 2; } element-icon { enabled: false; }' 2>"$err")
        rc=$?
        grab=0; [ "$err" != /dev/null ] && grep -qi grab "$err" && grab=1
        [ "$err" != /dev/null ] && { cat "$err" >&2; rm -f "$err"; }
        [ "$rc" -ne 0 ] && [ "$grab" = 1 ] && { sleep 0.3; continue; }
        break
    done
    [ "$answer" = 0 ]          # row 0 = "Keep changes"
}
# apply "xrandr arguments": apply, let the user confirm, otherwise revert; confirmed -> save
apply() {
    prev=$(snapshot)
    sos_log "apply: $1 (previous: $prev)"
    # shellcheck disable=SC2086
    if ! xrandr $1 >&2 2>&1; then
        sos_notify "This display setting is not supported." critical
        return
    fi
    if confirm; then
        query
        mkdir -p "${SAVED%/*}" 2>/dev/null && snapshot > "$SAVED" 2>/dev/null && echo >> "$SAVED"
        sos_notify "Display settings saved." low
    else
        # shellcheck disable=SC2086
        xrandr $prev >&2 2>&1 || sos_log "revert failed"
        sos_notify "Display settings restored." low
    fi
}

# FontAwesome 4: desktop U+F108, expand U+F065, refresh U+F021, clone U+F24D, arrow-right U+F061,
# arrow-left U+F060, cog U+F013, star U+F005, power-off U+F011, check U+F00C
I_SCREEN='\357\204\210' I_RES='\357\201\245' I_RATE='\357\200\241' I_DUP='\357\211\215' I_RIGHT='\357\201\241'
I_LEFT='\357\201\240' I_COG='\357\200\223' I_STAR='\357\200\205' I_OFF='\357\200\221' I_CHECK='\357\200\214'

pick_resolution() {
    cur=$(cur_mode "$1")
    for m in $(modes "$1"); do
        if [ "$m" = "$cur" ]; then sos_add "$(sos_fa "$I_CHECK")  $m  $(sos_dim "Current")" "noop"
        else sos_add "      $m" "set$TAB$m"; fi
    done
    sos_pick "<b>Resolution</b>   $(sos_dim "$(pretty "$1")")" 360
    [ "$action" = set ] && apply "--output $1 --mode $arg1"
}
pick_rate() {
    cur=$(cur_mode "$1") rate=$(cur_rate "$1")
    [ -n "$cur" ] || { sos_notify "This display is off."; return; }
    for r in $(rates "$1" "$cur"); do
        if [ "$r" = "$rate" ]; then sos_add "$(sos_fa "$I_CHECK")  $(hz "$r")  $(sos_dim "Current")" "noop"
        else sos_add "      $(hz "$r")" "set$TAB$r"; fi
    done
    sos_pick "<b>Refresh rate</b>   $(sos_dim "$(pretty "$1") · $cur")" 360
    [ "$action" = set ] && apply "--output $1 --mode $cur --rate $arg1"
}
# Submenu of a screen (only with several)
screen_menu() {
    sos_add "$(sos_fa "$I_RES")  Resolution  $(sos_dim "$(cur_mode "$1")")" "res"
    sos_add "$(sos_fa "$I_RATE")  Refresh rate  $(sos_dim "$(hz "$(cur_rate "$1")")")" "rate"
    is_primary "$1" || sos_add "$(sos_fa "$I_STAR")  Make main display" "primary"
    if is_on "$1"; then sos_add "$(sos_fa "$I_OFF")  Turn off" "off"
    else sos_add "$(sos_fa "$I_SCREEN")  Turn on" "on"; fi
    sos_pick "<b>$(sos_esc "$(pretty "$1")")</b>" 360
    case "$action" in
        res)     pick_resolution "$1" ;;
        rate)    pick_rate "$1" ;;
        primary) apply "--output $1 --primary" ;;
        off)     apply "--output $1 --off" ;;
        on)      apply "--output $1 --auto --right-of $(connected | grep -vx "$1" | head -n 1)" ;;
    esac
}
# Largest mode all screens support (for "Duplicate")
common_mode() {
    first=1 list=
    for o in $(connected); do
        m=$(modes "$o")
        if [ "$first" = 1 ]; then list=$m; first=0
        else list=$(printf '%s\n' "$list" | grep -Fx "$m"); fi
    done
    printf '%s\n' "$list" | awk -Fx 'NF == 2 { p = $1 * $2; if (p > best) { best = p; m = $0 } } END { print m }'
}
layout() {
    main=$1 prevo=$1 m=
    # The main display keeps its resolution; if it is off, it takes its preferred mode
    if is_on "$1"; then args="--output $1 --primary"; else args="--output $1 --auto --primary --pos 0x0"; fi
    for o in $(connected); do
        [ "$o" = "$main" ] && continue
        case "$2" in
            dup)   m=$(common_mode)
                   if [ -n "$m" ]; then args="--output $main --mode $m --primary --pos 0x0"; break; fi
                   args="$args --output $o --auto --same-as $main" ;;
            right) args="$args --output $o --auto --right-of $prevo"; prevo=$o ;;
            left)  args="$args --output $o --auto --left-of $prevo"; prevo=$o ;;
            only)  args="$args --output $o --off" ;;
        esac
    done
    # Duplicate with a common resolution: all other screens to the same mode and the same position
    if [ "$2" = dup ] && [ -n "$m" ]; then
        for o in $(connected); do [ "$o" = "$main" ] || args="$args --output $o --mode $m --same-as $main"; done
    fi
    apply "$args"
}

while :; do
    query
    outs=$(connected)
    n=$(printf '%s\n' "$outs" | grep -c .)
    if [ "$n" -eq 0 ]; then
        sos_notify "No display found." critical
        exit 0
    fi
    main=$(for o in $outs; do is_primary "$o" && echo "$o"; done | head -n 1)
    [ -n "$main" ] || main=$(for o in $outs; do is_on "$o" && echo "$o"; done | head -n 1)
    [ -n "$main" ] || main=$(printf '%s\n' "$outs" | head -n 1)
    if [ "$n" -eq 1 ]; then
        sos_add "$(sos_fa "$I_RES")  Resolution  $(sos_dim "$(cur_mode "$main")")" "res$TAB$main"
        sos_add "$(sos_fa "$I_RATE")  Refresh rate  $(sos_dim "$(hz "$(cur_rate "$main")")")" "rate$TAB$main"
        head="<b>Display</b>   $(sos_dim "$(pretty "$main") · $(cur_mode "$main")")"
    else
        for o in $outs; do
            if is_on "$o"; then state="$(cur_mode "$o") · $(hz "$(cur_rate "$o")")"; else state="Off"; fi
            is_primary "$o" && state="$state · Main"
            sos_add "$(sos_fa "$I_SCREEN")  $(sos_esc "$(pretty "$o")")  $(sos_dim "$state")" "screen$TAB$o"
        done
        sos_add "$(sos_fa "$I_DUP")  Duplicate" "layout${TAB}dup"
        sos_add "$(sos_fa "$I_RIGHT")  Extend right" "layout${TAB}right"
        sos_add "$(sos_fa "$I_LEFT")  Extend left" "layout${TAB}left"
        for o in $outs; do
            sos_add "$(sos_fa "$I_SCREEN")  Only $(sos_esc "$(pretty "$o")")" "only$TAB$o"
        done
        head="<b>Display</b>   $(sos_dim "$n displays")"
    fi
    sos_add "$(sos_fa "$I_COG")  Advanced Display Settings" "advanced"
    sos_pick "$head" 440

    case "$action" in
        res)      pick_resolution "$arg1" ;;
        rate)     pick_rate "$arg1" ;;
        screen)   screen_menu "$arg1" ;;
        layout)   layout "$main" "$arg1" ;;
        only)     layout "$arg1" only ;;
        advanced) advanced ;;
        *)        break ;;
    esac
done
exit 0
