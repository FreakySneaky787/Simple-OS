#!/bin/sh
# Simple OS – power menu (Super+X, red button on the right of the taskbar, Menu → Power)
# Rofi flyout: Lock, Sleep, Restart, Shut down, Sign out. Esc closes without an action.
#   simpleos-powermenu --lock    lock the screen right away (Super+L)
# Robust like simpleos-wifi: no set -e, every path ends with exit 0, errors as a clear notification,
# details in ~/.cache/simpleos-powermenu.log. If Rofi does not start, a notification explains the way via the menu.

SOS_NAME=simpleos-powermenu SOS_TITLE=Power SOS_ICON=system-shutdown SOS_PROMPT=Power SOS_CORNER=1
LIB=/usr/local/lib/simpleos/common.sh
# "." on a missing file would end dash immediately -> check first
[ -r "$LIB" ] || { notify-send "Power" "Simple OS is incomplete (missing $LIB)." 2>/dev/null; exit 0; }
. "$LIB"
sos_log_init "$@"

sos_rofi_failed() {
    sos_notify "The power menu could not open. Right-click the desktop and choose Power instead." critical
    exit 0
}

is_live() { [ -x /usr/local/bin/simpleos-live ] && /usr/local/bin/simpleos-live --check; }
# Lock the screen: LightDM (dm-tool), otherwise logind. Not in the live session: hardly anyone knows the live account's
# password ("live"), the session – maybe with the installer running – would be lost behind the lock screen
lock_screen() {
    if is_live; then
        sos_notify "The screen is not locked in Live Mode – there is nothing to protect, and unlocking would ask for the live password."
        return 0
    fi
    command -v dm-tool >/dev/null && dm-tool lock >&2 2>&1 && return 0
    command -v loginctl >/dev/null && loginctl lock-session >&2 2>&1 && return 0
    return 1
}
# $1 = systemctl verb, $2 = notification on error
power() {
    systemctl "$1" >&2 2>&1 || loginctl "$1" >&2 2>&1 || sos_notify "$2" critical
}

# Super+L: lock at once, without the menu
if [ "${1:-}" = --lock ]; then
    lock_screen || sos_notify "The screen could not be locked." critical
    exit 0
fi

# FontAwesome 4: lock U+F023, moon U+F186, refresh U+F021, power-off U+F011, sign-out U+F08B
sos_add "$(sos_fa '\357\200\243')  Lock" "lock"
sos_add "$(sos_fa '\357\206\206')  Sleep" "sleep"
sos_add "$(sos_fa '\357\200\241')  Restart" "restart"
sos_add "$(sos_fa '\357\200\221')  Shut down" "shutdown"
sos_add "$(sos_fa '\357\202\213')  Sign out" "logout"
sos_pick "<b>Power</b>" 300

# The installer is working (#62, #64): switching off while it resizes or formats a partition can leave every system
# on the disk unable to start. logind's inhibitor (simpleos-install) does not stop us – the live user may override
# it – so ask once more; Esc or "Keep installing" does nothing.
case "$action" in restart|shutdown|sleep|logout)
    if pgrep -x calamares >/dev/null 2>&1; then
        sos_log "installer running, asking before $action"
        case "$action" in
            restart) anyway="Restart anyway" ;;
            shutdown) anyway="Shut down anyway" ;;
            sleep) anyway="Sleep anyway" ;;
            logout) anyway="Sign out anyway" ;;
        esac
        sos_add "$(sos_fa '\357\200\214')  Keep installing" "keep"
        sos_add "$(sos_fa '\357\201\261')  $anyway" "$action"
        sos_pick "<b>The installer is still working</b>
Wait until it is finished. Stopping it now can leave
the systems on this disk unable to start." 420
    fi ;;
esac

case "$action" in
    lock)     lock_screen || sos_notify "The screen could not be locked." critical ;;
    # locked when waking up, like on Windows – but not in the live session: nobody knows the password there
    # (like /usr/lib/systemd/system-sleep/simpleos-lock)
    sleep)    if is_live; then
                  sos_log "Live session: not locked before sleep"
              else
                  lock_screen || sos_log "lock before suspend failed"
              fi
              power suspend "Sleep is not available on this computer." ;;
    restart)  power reboot "The computer could not restart. Please save your work and try again." ;;
    shutdown) power poweroff "The computer could not shut down. Please save your work and try again." ;;
    logout)   openbox --exit >&2 2>&1 || sos_notify "Could not sign out. Please try again." critical ;;
esac
exit 0
