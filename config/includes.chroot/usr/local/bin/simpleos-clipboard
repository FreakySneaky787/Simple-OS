#!/usr/bin/python3
"""Simple OS – clipboard history (Super+V, like Windows+V).

  simpleos-clipboard            Rofi list of the most recently copied texts; the selection goes back into the
                                clipboard (Ctrl+V pastes it), "Clear history" empties the history
  simpleos-clipboard --daemon   remembers every copied text (Openbox autostart, GTK3 owner-change,
                                no polling); runs only once per session
  simpleos-clipboard --list     history as JSON (tests)
  simpleos-clipboard --add TEXT add an entry (tests)
  simpleos-clipboard --clear    empty the history

Text only, at most 50 entries of 100 000 characters each, identical texts move to the top. History in
~/.cache/simpleos/clipboard.json (readable only by the user). Contents from password managers
(target x-kde-passwordManagerHint) never end up in the history.
Robust like the shell tools: errors as a notification, always exit 0 (except on wrong usage).
Tests: SIMPLEOS_CLIPBOARD_FILE replaces the path of the history.
"""
import json
import os
import shutil
import subprocess
import sys

MAX_ITEMS = 50
MAX_CHARS = 100_000
TITLE = "Clipboard"
CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.environ.get("HOME") or "/tmp", ".cache")
HISTORY = os.environ.get("SIMPLEOS_CLIPBOARD_FILE") or os.path.join(CACHE, "simpleos", "clipboard.json")
ROFI_RETRY = "/usr/local/lib/simpleos/rofi-retry"


def notify(text, urgency="normal"):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", urgency, "-c", "x-simpleos", "-a", TITLE, "-i", "edit-paste",
                        TITLE, text], stderr=subprocess.DEVNULL, check=False)


def load():
    try:
        with open(HISTORY, encoding="utf-8") as f:
            items = json.load(f)
        return [i for i in items if isinstance(i, str) and i.strip()][:MAX_ITEMS]
    except (OSError, ValueError):
        return []


def save(items):
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    tmp = HISTORY + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(items[:MAX_ITEMS], f, ensure_ascii=False)
    os.replace(tmp, HISTORY)


def add(text):
    if not text or not text.strip() or len(text) > MAX_CHARS:
        return False
    items = load()
    if items and items[0] == text:
        return False
    save([text] + [i for i in items if i != text])
    return True


def label(text, width=90):
    """One line per entry: line breaks as ⏎, tabs as spaces, long texts shortened."""
    one = " ⏎ ".join(part.strip() for part in text.strip().splitlines() if part.strip())
    one = one.replace("\t", " ")
    return one if len(one) <= width else one[: width - 1] + "…"


def set_clipboard(text):
    """Text into the clipboard (xclip, otherwise xsel); both keep the selection in the background."""
    for cmd in (["xclip", "-selection", "clipboard", "-in"], ["xsel", "--clipboard", "--input"]):
        if shutil.which(cmd[0]):
            try:
                p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
                p.communicate(text.encode("utf-8"), timeout=5)
                if p.returncode == 0:
                    return True
            except (OSError, subprocess.SubprocessError):
                pass
    return False


def pick():
    items = load()
    if not items:
        notify("Nothing copied yet. Copy some text and press Super+V again.")
        return
    rows = [label(i) for i in items] + ["Clear history"]
    rofi = ROFI_RETRY if os.access(ROFI_RETRY, os.X_OK) else shutil.which("rofi")
    if not rofi:
        notify("The clipboard history could not open (rofi missing).", "critical")
        return
    env = dict(os.environ, SOS_NAME="simpleos-clipboard", SOS_TITLE=TITLE)
    out = subprocess.run(
        [rofi, "-dmenu", "-i", "-no-custom", "-format", "i", "-p", TITLE,
         "-mesg", "<b>Clipboard history</b>   ·   Enter pastes into the clipboard", "-markup",
         "-theme-str", "window { width: 640px; location: center; anchor: center; } "
                       "listview { lines: 12; } element-icon { enabled: false; }"],
        input="\n".join(rows) + "\n", capture_output=True, text=True, env=env, check=False).stdout.strip()
    if not out.isdigit():
        return
    idx = int(out)
    if idx == len(items):
        save([])
        notify("Clipboard history cleared.", "low")
    elif 0 <= idx < len(items):
        if set_clipboard(items[idx]):
            add(items[idx])
        else:
            notify("The text could not be copied (xclip missing).", "critical")


def daemon():
    import fcntl
    if not os.environ.get("DISPLAY"):
        return  # only in the X session (Openbox autostart)
    os.environ["GDK_BACKEND"] = "x11"
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    lock = open(HISTORY + ".lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already running
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, Gtk
    except (ImportError, ValueError):
        return
    if not Gtk.init_check(sys.argv[:1])[0]:  # no screen
        return
    clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)

    def on_text(_clip, text):
        if text:
            add(text)

    def on_targets(_clip, atoms, ok):
        names = [a.name() for a in (atoms or [])] if ok else []
        if "x-kde-passwordManagerHint" in names:
            return
        clip.request_text(on_text)

    clip.connect("owner-change", lambda c, _ev: c.request_targets(on_targets))
    Gtk.main()


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "":
        pick()
    elif cmd == "--daemon":
        daemon()
    elif cmd == "--list":
        print(json.dumps(load(), ensure_ascii=False))
    elif cmd == "--add" and len(argv) > 2:
        add(argv[2])
    elif cmd == "--clear":
        save([])
    else:
        print("Usage: simpleos-clipboard [--daemon | --list | --add TEXT | --clear]", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # never abort silently
        notify(f"The clipboard history ran into a problem: {e}", "critical")
        sys.exit(0)
