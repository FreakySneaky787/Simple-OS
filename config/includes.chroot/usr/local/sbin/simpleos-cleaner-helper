#!/bin/sh
# Simple OS – root part of simpleos-cleaner (called via pkexec; polkit action org.simpleos.cleaner).
# Only fixed cleanup actions, combinable at will:
#   --apt-cache    apt-get clean (downloaded .deb files)
#   --autoremove   apt-get autoremove (dependencies no longer needed; configuration files stay)
#   --flatpak      flatpak uninstall --unused (orphaned runtimes of the system installation)
#   --journal      journalctl --vacuum-time=7d (archived logs older than 7 days)
# Lines "STEP: <text>" = progress. Exit 0 = everything done, 1 = at least one step failed,
# 2 = invalid usage.
set -u
export DEBIAN_FRONTEND=noninteractive
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ $# -gt 0 ] || { echo "Usage: $0 --apt-cache|--autoremove|--flatpak|--journal …" >&2; exit 2; }
for a in "$@"; do
    case "$a" in --apt-cache|--autoremove|--flatpak|--journal) ;; *) echo "unknown: $a" >&2; exit 2 ;; esac
done
[ "$(id -u)" -eq 0 ] || { echo "simpleos-cleaner-helper: must run as root (pkexec)" >&2; exit 1; }
failed=0
for a in "$@"; do
    case "$a" in
        --apt-cache)
            echo "STEP: Removing downloaded package files"
            apt-get -o DPkg::Lock::Timeout=120 clean || failed=1 ;;
        --autoremove)
            echo "STEP: Removing packages that are no longer needed"
            apt-get -y -o DPkg::Lock::Timeout=120 autoremove || failed=1 ;;
        --flatpak)
            if command -v flatpak >/dev/null; then
                echo "STEP: Removing unused Flatpak runtimes"
                flatpak uninstall --system --unused -y --noninteractive || failed=1
            fi ;;
        --journal)
            echo "STEP: Removing system logs older than 7 days"
            journalctl --vacuum-time=7d || failed=1 ;;
    esac
done
exit "$failed"
