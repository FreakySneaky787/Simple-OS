#!/bin/sh
# Simple OS – root part of simpleos-report (called via pkexec; polkit action org.simpleos.report).
# Only prints logs that a normal user may not read; cleaning (names, addresses) happens
# afterwards in simpleos-report, before anything is saved. No arguments, no changes to the system.
#   system log of this boot (errors), of the previous boot (errors – after a crash/freeze the most important),
#   kernel warnings, the last apt operations
# Exit 0, except on wrong usage (2) or without root (1).
set -u
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ $# -eq 0 ] || { echo "Usage: $0 (no arguments)" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "simpleos-report-helper: must run as root (pkexec)" >&2; exit 1; }

echo "--- Errors, this boot:"
timeout 20 journalctl -b 0 -p err -n 200 --no-pager -o short-monotonic 2>&1
echo "--- Errors, previous boot (last 80):"
timeout 20 journalctl -b -1 -p err -n 80 --no-pager -o short-monotonic 2>&1
echo "--- How the previous boot ended (last 15 lines):"
timeout 20 journalctl -b -1 -n 15 --no-pager -o short-monotonic 2>&1
echo "--- Kernel warnings and errors (last 120):"
timeout 20 dmesg --level=emerg,alert,crit,err,warn 2>&1 | tail -n 120
echo "--- Recent package changes:"
tail -n 40 /var/log/apt/history.log 2>/dev/null || echo "(none)"
exit 0
