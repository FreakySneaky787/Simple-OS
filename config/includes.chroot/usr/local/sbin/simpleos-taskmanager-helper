#!/bin/sh
# Simple OS – end a process of another user (e.g. root): root part of simpleos-taskmanager,
# called via pkexec (polkit action org.simpleos.taskmanager, password).
#   simpleos-taskmanager-helper --end PID STARTTIME
# Same steps as in the Task Manager: SIGTERM, wait up to 1.5 s, then SIGKILL. STARTTIME = field 22 of /proc/PID/stat
# (sent along by the Task Manager): if it does not match, the PID now belongs to another process -> do nothing.
# Never: PID 1, kernel threads (no program behind /proc/PID/exe or parent process kthreadd).
# Output "terminated" (reacted to SIGTERM) or "killed" (SIGKILL needed).
# Exit 0 ended, 1 still running, 2 invalid usage/protected, 3 does not exist (any more) or PID reused.
# Tests: in the verify hook as root with its own test processes (one ignores SIGTERM).
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin

usage() { echo "Usage: simpleos-taskmanager-helper --end PID STARTTIME" >&2; exit 2; }
[ $# -eq 3 ] && [ "$1" = --end ] || usage
pid=$2 start=$3
case "$pid" in ''|*[!0-9]*) usage ;; esac
case "$start" in ''|*[!0-9]*) usage ;; esac
[ "$pid" -gt 1 ] || { echo "PID $pid is protected" >&2; exit 2; }

# Field 22 (starttime) and field 3 (state), robust against spaces/brackets in the program name (field 2)
stat_of() { s=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1; s=${s##*) }; echo "$s"; }
# Still running = exists, is no zombie and is still the same process
alive() {
    rest=$(stat_of) || return 1
    set -- $rest
    [ "$1" != Z ] && [ "$1" != X ] && [ "${20}" = "$start" ]
}

rest=$(stat_of) || { echo "Process $pid no longer exists" >&2; exit 3; }
set -- $rest
[ "${20}" = "$start" ] || { echo "PID $pid now belongs to another process" >&2; exit 3; }
ppid=$2
if [ "$ppid" = 2 ] || [ "$pid" = 2 ] || ! [ -e "/proc/$pid/exe" ]; then
    echo "PID $pid is a kernel thread" >&2; exit 2
fi

kill -TERM "$pid" 2>/dev/null || { alive || { echo terminated; exit 0; }; }
i=0
while [ "$i" -lt 15 ]; do      # 15 x 0.1 s = 1.5 s
    alive || { echo terminated; exit 0; }
    sleep 0.1
    i=$((i + 1))
done
kill -KILL "$pid" 2>/dev/null
i=0
while [ "$i" -lt 20 ]; do
    alive || { echo killed; exit 0; }
    sleep 0.1
    i=$((i + 1))
done
echo "PID $pid does not react to SIGKILL either (e.g. hanging I/O)" >&2
exit 1
