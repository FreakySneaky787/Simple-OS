#!/bin/sh
# Simple OS – Prozess eines anderen Benutzers (z.B. root) beenden: root-Teil von simpleos-taskmanager,
# Aufruf per pkexec (Polkit-Aktion org.simpleos.taskmanager, Passwort).
#   simpleos-taskmanager-helper --end PID STARTZEIT
# Ablauf wie im Task-Manager: SIGTERM, bis 1,5 s warten, dann SIGKILL. STARTZEIT = Feld 22 aus /proc/PID/stat
# (vom Task-Manager mitgeschickt): passt sie nicht, gehört die PID inzwischen einem anderen Prozess -> nichts tun.
# Nie: PID 1, Kernel-Threads (kein Programm hinter /proc/PID/exe bzw. Elternprozess kthreadd).
# Ausgabe "terminated" (hat auf SIGTERM reagiert) oder "killed" (SIGKILL nötig).
# Exit 0 beendet, 1 läuft noch, 2 ungültiger Aufruf/geschützt, 3 gibt es nicht (mehr) bzw. PID wiederverwendet.
# Tests: im Verify-Hook als root mit eigenen Testprozessen (einer ignoriert SIGTERM).
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin

usage() { echo "Aufruf: simpleos-taskmanager-helper --end PID STARTZEIT" >&2; exit 2; }
[ $# -eq 3 ] && [ "$1" = --end ] || usage
pid=$2 start=$3
case "$pid" in ''|*[!0-9]*) usage ;; esac
case "$start" in ''|*[!0-9]*) usage ;; esac
[ "$pid" -gt 1 ] || { echo "PID $pid ist geschützt" >&2; exit 2; }

# Feld 22 (starttime) und Feld 3 (Zustand), robust gegen Leerzeichen/Klammern im Programmnamen (Feld 2)
stat_of() { s=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1; s=${s##*) }; echo "$s"; }
# Läuft noch = existiert, ist kein Zombie und ist noch derselbe Prozess
alive() {
    rest=$(stat_of) || return 1
    set -- $rest
    [ "$1" != Z ] && [ "$1" != X ] && [ "${20}" = "$start" ]
}

rest=$(stat_of) || { echo "Prozess $pid gibt es nicht mehr" >&2; exit 3; }
set -- $rest
[ "${20}" = "$start" ] || { echo "PID $pid gehört inzwischen einem anderen Prozess" >&2; exit 3; }
ppid=$2
if [ "$ppid" = 2 ] || [ "$pid" = 2 ] || ! [ -e "/proc/$pid/exe" ]; then
    echo "PID $pid ist ein Kernel-Thread" >&2; exit 2
fi

kill -TERM "$pid" 2>/dev/null || { alive || { echo terminated; exit 0; }; }
i=0
while [ "$i" -lt 15 ]; do      # 15 x 0,1 s = 1,5 s
    alive || { echo terminated; exit 0; }
    sleep 0.1
    i=$((i + 1))
done
kill -KILL "$pid" 2>/dev/null
i=0
while [ "$i" -lt 20 ]; do
    alive || { echo killed; exit 0; }
    sleep 0.1
    i=$((i + 1))
done
echo "PID $pid reagiert auch auf SIGKILL nicht (z.B. hängende Ein-/Ausgabe)" >&2
exit 1
