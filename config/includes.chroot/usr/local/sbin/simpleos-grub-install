#!/bin/sh
# Simple OS – grub-install for Calamares (/etc/calamares/modules/bootloader.conf: grubInstall), runs in the target system.
# UEFI (--target=x86_64-efi): always --uefi-secure-boot as long as shim-signed and grub-efi-amd64-signed are
# installed -> EFI/debian/shimx64.efi (signed by Microsoft) loads the GRUB signed by Debian, which loads the signed
# kernel. Otherwise Debian's grub-install only does that if the installation was already started with Secure Boot
# – anyone who switches Secure Boot off to install and back on afterwards would have a system that does not start.
# BIOS and everything else: passed to grub-install unchanged.
efi=0
for a in "$@"; do
    case "$a" in --target=x86_64-efi) efi=1 ;; esac
done
prev=
for a in "$@"; do
    [ "$prev" = --target ] && [ "$a" = x86_64-efi ] && efi=1
    prev=$a
done
if [ "$efi" = 1 ] && [ -e /usr/lib/shim/shimx64.efi.signed ] && [ -e /usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed ]; then
    echo "simpleos-grub-install: UEFI with Secure Boot chain (shim + signed GRUB)"
    exec grub-install --uefi-secure-boot "$@"
fi
exec grub-install "$@"
