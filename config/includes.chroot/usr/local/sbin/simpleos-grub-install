#!/bin/sh
# Simple OS – grub-install für Calamares (/etc/calamares/modules/bootloader.conf: grubInstall), läuft im Zielsystem.
# UEFI (--target=x86_64-efi): immer --uefi-secure-boot, solange shim-signed und grub-efi-amd64-signed installiert
# sind -> EFI/debian/shimx64.efi (von Microsoft signiert) lädt das von Debian signierte GRUB, das den signierten
# Kernel lädt. Debians grub-install macht das sonst nur, wenn schon die Installation mit Secure Boot gestartet
# wurde – wer Secure Boot zum Installieren ausschaltet und danach wieder ein, hätte ein nicht startendes System.
# BIOS und alles andere: unverändert an grub-install.
efi=0
for a in "$@"; do
    case "$a" in --target=x86_64-efi) efi=1 ;; esac
done
prev=
for a in "$@"; do
    [ "$prev" = --target ] && [ "$a" = x86_64-efi ] && efi=1
    prev=$a
done
if [ "$efi" = 1 ] && [ -e /usr/lib/shim/shimx64.efi.signed ] && [ -e /usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed ]; then
    echo "simpleos-grub-install: UEFI mit Secure-Boot-Kette (shim + signiertes GRUB)"
    exec grub-install --uefi-secure-boot "$@"
fi
exec grub-install "$@"
