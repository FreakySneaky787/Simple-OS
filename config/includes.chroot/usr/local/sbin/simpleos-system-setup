#!/bin/sh
# Simple OS – system changes of the Setup Wizard (runs as root, called via pkexec with a GUI password dialog)
#   pkexec simpleos-system-setup [--browser firefox|chromium|mullvad] [--purge-firefox]
#                                [--office libreoffice|onlyoffice|none] [--gaming]
#   pkexec simpleos-system-setup --upgrade   system update (simpleos-update): download package lists, install all
#                                    updates without removing packages; then Flatpak apps (system), finally
#                                    firmware/BIOS from LVFS (fwupd; not in VMs). Before that a restore point,
#                                    if switched on in simpleos-backup. Firmware result as the line
#                                    "FIRMWARE: installed|needs-power|failed" – a firmware error does not make the
#                                    system update invalid (the exit code stays 0). Updates that would only work by
#                                    removing other packages are left alone: line "HELD: <count>".
#                                    kernel, microcode, firmware, libc, systemd updated -> /run/reboot-required
#   pkexec simpleos-system-setup --refresh   only check (simpleos-update when opening): download package lists and
#                                    firmware metadata, install nothing. Without a password for active
#                                    administrators (polkit rule 50-simpleos-update-refresh.rules, hook 14)
#   pkexec simpleos-system-setup --firewall on|off   switch the firewall (ufw) on/off (Control Center → System)
#   pkexec simpleos-system-setup --drivers PACKAGE…   install drivers/firmware/microcode (simpleos-drivers
#                                    --install); only packages from the fixed list DRIVER_PACKAGES, the sources get
#                                    contrib/non-free added (nvidia-driver, broadcom-sta-dkms). Live lines
#                                    "STAGE: …" / "PROGRESS: <percent>" for the progress window (simpleos-progress).
#                                    Test: SIMPLEOS_SETUP_DRYRUN=1 only prints the apt calls (pkexec clears the
#                                    environment, cannot be set from outside)
#   simpleos-system-setup --repos    only enable contrib/non-free/non-free-firmware in the APT sources
#                                    (from simpleos-post-install, because Calamares' sources-final only writes
#                                    "main non-free-firmware" – Steam is in contrib)
# Only fixed actions, no free package names. The wizard shows lines "STEP: <text>" as its status.
# Polkit action: /usr/share/polkit-1/actions/org.simpleos.system-setup.policy
set -u
export DEBIAN_FRONTEND=noninteractive
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

usage() { echo "Usage: $0 [--browser firefox|chromium|mullvad] [--purge-firefox] [--office libreoffice|onlyoffice|none] [--gaming] | --repos | --upgrade | --refresh | --firewall on|off | --drivers PACKAGE…" >&2; exit 2; }
# The only packages --drivers may install (the same list as ALLOWED in simpleos-drivers)
# Kernel/headers/firmware come from bookworm-backports via pinning (/etc/apt/preferences.d/simpleos-backports.pref)
DRIVER_PACKAGES="firmware-linux-nonfree firmware-misc-nonfree firmware-intel-graphics firmware-amd-graphics
firmware-realtek firmware-iwlwifi firmware-atheros firmware-brcm80211 broadcom-sta-dkms nvidia-driver
nvidia-tesla-470-driver linux-image-amd64 linux-headers-amd64 intel-microcode amd64-microcode"

[ "$(id -u)" -eq 0 ] || [ "${SIMPLEOS_SETUP_DRYRUN:-}" = 1 ] || { echo "simpleos-system-setup: must run as root (pkexec)" >&2; exit 1; }

browser= purge_firefox=0 office=none gaming=0 repos_only=0 upgrade=0 refresh=0 drivers=0 firewall=
while [ $# -gt 0 ]; do
    case "$1" in
        --drivers)       [ $# -ge 2 ] || usage; drivers=1; shift; break ;;   # rest = package names
        --browser)       [ $# -ge 2 ] || usage; browser=$2; shift ;;
        --purge-firefox) purge_firefox=1 ;;
        --office)        [ $# -ge 2 ] || usage; office=$2; shift ;;
        --gaming)        gaming=1 ;;
        --repos)         repos_only=1 ;;
        --upgrade)       upgrade=1 ;;
        --refresh)       refresh=1 ;;
        --firewall)      [ $# -ge 2 ] || usage; firewall=$2; shift ;;
        *)               usage ;;
    esac
    shift
done
case "$browser" in ""|firefox|chromium|mullvad) ;; *) usage ;; esac
case "$office" in libreoffice|onlyoffice|none) ;; *) usage ;; esac
case "$firewall" in ""|on|off) ;; *) usage ;; esac
# Allowed combinations in ONE place: at most one action (--repos, --upgrade, --refresh, --firewall,
# --drivers), and never together with wizard options (--browser, --purge-firefox, --office, --gaming).
# Before, every section checked itself via a string ("$browser$gaming…" = "000") – after adding
# --refresh a count of zeros no longer matched, and every --upgrade ended as an "invalid call" (exit 2).
actions=0
for a in "$repos_only" "$upgrade" "$refresh" "$drivers"; do [ "$a" = 1 ] && actions=$((actions + 1)); done
[ -n "$firewall" ] && actions=$((actions + 1))
wizard=0
if [ -n "$browser" ] || [ "$purge_firefox" = 1 ] || [ "$office" != none ] || [ "$gaming" = 1 ]; then wizard=1; fi
[ "$actions" -le 1 ] || usage
[ "$actions" -eq 0 ] || [ "$wizard" -eq 0 ] || usage
# Test (verify hook): only check the arguments; pkexec clears the environment
[ "${SIMPLEOS_SETUP_ARGCHECK:-}" = 1 ] && { echo "ARGS: ok"; exit 0; }

failed=0
step() { echo "STEP: $*"; }
fail() { echo "ERROR: $*" >&2; failed=1; }
# Wait instead of aborting if another apt process is running right now
# Progress for the wizard/progress window: "STAGE: …" and "PROGRESS: <percent>" per operation (new after every "STEP:").
# apt reports it via status fd 3 ("dlstatus:…:<percent>:…" download 0–40 %, "pmstatus:<package>:<percent>:…"
# installation 40–100 %), its normal output goes to stderr (log/details). The exit code comes out of the pipe
# through a file (POSIX sh has no pipefail).
aptget() {
    _rcf=$(mktemp)
    { apt-get -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
          -o APT::Status-Fd=3 "$@" 3>&1 1>&2; echo $? > "$_rcf"; } | /usr/local/lib/simpleos/progress-filter apt
    _rc=$(cat "$_rcf" 2>/dev/null); rm -f "$_rcf"
    return "${_rc:-1}"
}
# Wait until no other apt/dpkg operation is running: after the first boot apt-daily downloads the package lists
# in the background and holds /var/lib/apt/lists/lock – "apt-get update" then failed immediately (DPkg::Lock::Timeout
# only applies to the dpkg lock), Gaming went on installing without 32-bit lists ("Unable to locate package libgl1:i386")
# and Software Updates reported "Some updates could not be installed". At most 10 min, with a hint in the progress window.
apt_wait() {
    _w=0
    while systemctl is-active --quiet apt-daily.service apt-daily-upgrade.service 2>/dev/null ||
          pgrep -x 'apt-get|apt|dpkg' >/dev/null 2>&1; do
        [ "$_w" -eq 0 ] && echo "STAGE: Waiting for a background update to finish"
        _w=$((_w + 1))
        [ "$_w" -ge 300 ] && return 0
        sleep 2
    done
}
# apt-get update after apt_wait; if it fails (lock, a short network dropout), a second attempt after 5 s
# Success -> time stamp $APT_STAMP (simpleos-update only checks again when opening if it is older than 30 minutes)
APT_STAMP=/var/lib/simpleos/apt-refreshed
apt_get_update() {
    apt_wait
    if ! ${APT_GET:-apt-get} -o DPkg::Lock::Timeout=300 update; then
        sleep 5
        apt_wait
        ${APT_GET:-apt-get} -o DPkg::Lock::Timeout=300 update || return 1
    fi
    [ -n "${APT_STAMP:-}" ] && mkdir -p "${APT_STAMP%/*}" 2>/dev/null && : > "$APT_STAMP" 2>/dev/null
    return 0
}
# Restart needed? stdin = package names that were just updated/installed. Debian creates /run/reboot-required
# only for dbus itself (unattended-upgrades is missing) – without this marker simpleos-update reported "up to date"
# after a kernel update instead of asking for a restart.
REBOOT_FLAG=/var/run/reboot-required
REBOOT_PKGS='^(linux-image-|intel-microcode|amd64-microcode|firmware-|nvidia-|libc6|systemd|libsystemd0|udev|dbus)'
mark_reboot() {
    _pk=$(grep -E "$REBOOT_PKGS" | sort -u)
    [ -n "$_pk" ] || return 0
    : > "$REBOOT_FLAG" 2>/dev/null
    printf '%s\n' "$_pk" >> "$REBOOT_FLAG.pkgs" 2>/dev/null
    return 0
}
# What "apt-get -s" would install: package names (stdin = simulation, only "Inst" lines)
sim_pkgs() { awk '$1 == "Inst" { print $2 }'; }
installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
# Flatpak without --noninteractive: only then does it print progress (-y answers all questions); the filter turns
# that into STAGE/PROGRESS (weighted by the size of the parts) and passes error texts through.
FP_PROGRESS=/usr/local/lib/simpleos/flatpak-progress
# flatpak_install ID [MB]: check space first (default 1200 MB; live mode: RAM overlay), otherwise a clear message
flatpak_install() {
    _need=${2:-1200}
    _free=${SIMPLEOS_SETUP_FREE_MB:-$(flatpak_free_mb)}
    if [ -n "$_free" ] && [ "$_free" -lt "$_need" ]; then
        step "Not enough free space: $_free MB free, about $_need MB needed"
        echo "ERROR: $1: not enough free space ($_free MB free, ~$_need MB needed)" >&2
        return 1
    fi
    _rcf=$(mktemp)
    { flatpak install --system -y flathub "$1" </dev/null 2>&1; echo $? > "$_rcf"; } |
        if [ -x "$FP_PROGRESS" ]; then "$FP_PROGRESS"; else cat; fi
    _rc=$(cat "$_rcf" 2>/dev/null); rm -f "$_rcf"
    return "${_rc:-1}"
}
# Free space for Flatpak in MB (live mode: RAM overlay)
flatpak_free_mb() { df -Pm /var/lib/flatpak 2>/dev/null | awk 'NR == 2 { print $4 }'; }

# Debian sources: add contrib, non-free and non-free-firmware (classic format and deb822).
# Only entries with "main" from Debian servers; the live medium (file:) and third-party repos stay untouched.
ensure_repos() {
    rc=1
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
        [ -f "$f" ] || continue
        deb822=0
        grep -q '^URIs:.*debian' "$f" && ! grep -q '^URIs:.*file:' "$f" && deb822=1
        new=$(mktemp)
        awk -v deb822="$deb822" '
            function add(line,   n, i, c) {
                sub(/[ \t]+$/, "", line)
                n = split("contrib non-free non-free-firmware", c, " ")
                for (i = 1; i <= n; i++)
                    if (line !~ ("[ \t]" c[i] "([ \t]|$)")) line = line " " c[i]
                return line
            }
            /^[ \t]*deb(-src)?[ \t]/ && /debian/ && !/file:/ && /[ \t]main([ \t]|$)/ { print add($0); next }
            deb822 && /^Components:.*[ \t]main([ \t]|$)/ { print add($0); next }
            { print }' "$f" > "$new"
        if ! cmp -s "$f" "$new"; then
            cat "$new" > "$f"  # replace the content, permissions/owner stay
            echo "APT sources completed: $f"
            rc=0
        fi
        rm -f "$new"
    done
    return "$rc"  # 0 = something changed
}

if [ "$repos_only" -eq 1 ]; then
    ensure_repos || true
    exit 0
fi

# install_drivers PACKAGE…: download package lists, install; success = apt without errors AND all packages installed.
# The exit code of apt counts too: linux-image-amd64 (newer kernel from backports) is always installed already as a
# meta package – a failed update would otherwise report "Drivers installed". Exit code via a file, because the
# group in the pipe is a subshell (an "exit" there only ended the subshell).
install_drivers() {
    _drc=$(mktemp)
    echo 1 > "$_drc"
    {
        # apt_wait first on stdout: its "STAGE: Waiting for a background update" should go to the progress window,
        # the output of apt-get update to the log instead (stderr)
        if [ "${dry:-0}" = 1 ]; then $APT_GET update >&2; else apt_wait; apt_get_update >&2; fi ||
            { echo "package lists could not be downloaded" >&2; exit 1; }
        echo "STAGE: Downloading drivers" >&3
        $APT_GET -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef \
            -o Dpkg::Options::=--force-confold -o APT::Status-Fd=3 install "$@" >&2
        echo $? > "$_drc"
    } 3>&1 | /usr/local/lib/simpleos/progress-filter apt --dl 5 40 --inst 40 100
    _arc=$(cat "$_drc" 2>/dev/null); rm -f "$_drc"
    _rc=0
    [ "${_arc:-1}" -eq 0 ] || { echo "apt-get failed (exit ${_arc:-?})" >&2; _rc=1; }
    if [ "${dry:-0}" != 1 ]; then
        for _p in "$@"; do
            installed "$_p" || { echo "not installed: $_p" >&2; _rc=1; }
        done
        [ "$_rc" -eq 0 ] && printf '%s\n' "$@" | mark_reboot
    fi
    [ "$_rc" -eq 0 ] && { echo "PROGRESS: 100"; step "Done"; }
    return "$_rc"
}

# ------------------------------------------------------------ Drivers (simpleos-drivers --install)
# Only packages from DRIVER_PACKAGES; nvidia-driver/broadcom-sta-dkms are in non-free/contrib -> complete the sources.
# apt reports progress via status fd 3 ("dlstatus:…:<percent>:…", "pmstatus:<package>:<percent>:…") ->
# "STAGE:"/"PROGRESS:" (download 5–40 %, installation 40–100 %; progress-filter streams immediately). Success = all
# packages really installed.
if [ "$drivers" -eq 1 ]; then
    [ $# -ge 1 ] || usage
    for p in "$@"; do
        case " $(echo $DRIVER_PACKAGES) " in *" $p "*) ;; *) echo "package not allowed: $p" >&2; exit 2 ;; esac
    done
    dry=${SIMPLEOS_SETUP_DRYRUN:-0}
    APT_GET=apt-get
    [ "$dry" = 1 ] && APT_GET="echo apt-get"
    echo "STAGE: Checking package sources"
    echo "PROGRESS: 2"
    [ "$dry" = 1 ] || ensure_repos >&2 || true
    install_drivers "$@"
    exit $?
fi

# ------------------------------------------------------------ Firewall (ufw)
# Only allowed on its own. "ufw --force enable" does not ask (there are no existing SSH connections here)
if [ -n "$firewall" ]; then
    command -v ufw >/dev/null || { echo "ERROR: ufw missing" >&2; exit 1; }
    if [ "$firewall" = on ]; then
        step "Turning on the firewall"
        ufw --force enable
    else
        step "Turning off the firewall"
        ufw disable
    fi
    exit $?
fi

# ------------------------------------------------------------ Firmware (fwupd, LVFS)
# fw_pending: 0 = firmware updates available. Refresh the metadata first (exit 2 = already current, without a network
# it fails – then the ones from fwupd-refresh.timer apply). In VMs there is nothing to update.
# fw_update: installs all of them and reports "FIRMWARE: …"; BIOS capsules (UEFI) run at the next restart ->
# restart hint via $REBOOT_FLAG. Without a charger/with a too empty battery fwupd refuses itself -> needs-power.
FWUPD_OPTS="--assume-yes --no-unreported-check --no-reboot-check --no-device-prompt --no-security-fix"
fw_pending() {
    command -v fwupdmgr >/dev/null || return 1
    systemd-detect-virt -q --vm 2>/dev/null && return 1
    # shellcheck disable=SC2086
    timeout 120 fwupdmgr refresh $FWUPD_OPTS >/dev/null 2>&1
    # shellcheck disable=SC2086
    timeout 60 fwupdmgr get-updates --json $FWUPD_OPTS 2>/dev/null | grep -q '"Releases"'
}
fw_update() {
    # shellcheck disable=SC2086
    _fw=$(timeout 1800 fwupdmgr update $FWUPD_OPTS 2>&1)
    _rc=$?
    printf '%s\n' "$_fw" >&2
    if [ "$_rc" -eq 0 ]; then
        echo "FIRMWARE: installed"
        : > "$REBOOT_FLAG" 2>/dev/null
    else
        case "$_fw" in
            *[Pp]ower*|*[Bb]attery*|*" AC "*) echo "FIRMWARE: needs-power" ;;
            *) echo "FIRMWARE: failed" ;;
        esac
    fi
    return 0
}

# ------------------------------------------------------------ System update
# Safe: repair interrupted installations first, wait if apt is busy (aptget: lock timeout),
# "upgrade --with-new-pkgs" never removes packages, changed configuration files stay (force-confold).
# Exit != 0 -> simpleos-update reports "Some updates could not be installed".
# ------------------------------------------------------------ Only check (simpleos-update when opening)
if [ "$refresh" -eq 1 ]; then
    step "Checking for updates"
    apt_get_update || { fail "package lists could not be downloaded"; exit 1; }
    if command -v fwupdmgr >/dev/null && ! systemd-detect-virt -q --vm 2>/dev/null; then
        # shellcheck disable=SC2086
        timeout 120 fwupdmgr refresh $FWUPD_OPTS >/dev/null 2>&1
    fi
    exit 0
fi

# Which apt command installs everything without removing anything? "full-upgrade" also pulls in updates that
# have new or changed dependencies (e.g. split firmware packages from backports) – "upgrade
# --with-new-pkgs" held them back, but simpleos-update counted them: after the update (and restart) the same
# updates were pending again. Only if the simulation removes nothing (and to be safe with --no-remove);
# otherwise "upgrade --with-new-pkgs", which never removes. Output: "full" or "safe".
upgrade_mode() {
    _sim=$(LC_ALL=C ${APT_GET:-apt-get} -s full-upgrade 2>/dev/null) || { echo safe; return 0; }
    if printf '%s\n' "$_sim" | grep -q '^Remv '; then echo safe; else echo full; fi
}
# What is still pending afterwards would only work by removing other packages -> "HELD: <count>" (simpleos-update says
# so honestly instead of reporting "up to date" and offering the same updates again at the next login)
report_held() {
    _held=$(LC_ALL=C ${APT_GET:-apt-get} -s full-upgrade 2>/dev/null | awk '$1 == "Inst" && $3 ~ /^\[/ { print $2 }')
    [ -n "$_held" ] || return 0
    echo "Held back (would need other packages removed):" $_held >&2
    echo "HELD: $(printf '%s\n' "$_held" | grep -c .)"
}
upgrade_sim() {  # $1 full|safe -> simulation on stdout
    if [ "$1" = full ]; then LC_ALL=C ${APT_GET:-apt-get} -s full-upgrade 2>/dev/null
    else LC_ALL=C ${APT_GET:-apt-get} -s upgrade --with-new-pkgs 2>/dev/null; fi
}

if [ "$upgrade" -eq 1 ]; then
    step "Checking for updates"
    dpkg --configure -a || fail "an interrupted installation could not be repaired"
    apt_get_update || { fail "package lists could not be downloaded"; exit 1; }
    # Check first what is pending: without system and app updates done right away ("UPTODATE: 1", the progress window
    # shows "Already up to date") – before, everything still ran with a progress bar ("Nothing to do").
    # If Flatpak cannot check (network), rather update normally.
    mode=$(upgrade_mode)
    planned=$(upgrade_sim "$mode" | sim_pkgs)
    apt_pending=0
    [ -n "$planned" ] && apt_pending=1
    fp_pending=0
    if command -v flatpak >/dev/null && flatpak remotes --system 2>/dev/null | grep -q .; then
        _ls=$(flatpak remote-ls --updates --system --columns=ref 2>/dev/null) || _ls=unknown
        [ -n "$_ls" ] && fp_pending=1
    fi
    fw=0
    fw_pending && fw=1
    if [ "$apt_pending$fp_pending$fw" = 000 ] && [ "$failed" -eq 0 ]; then
        echo "UPTODATE: 1"
        report_held
        echo "DONE: Already up to date"
        step "Done"
        exit 0
    fi
    if [ "$apt_pending" -eq 1 ]; then
        # Restore point (simpleos-backup → "Restore point before updates: On"), only if system updates are
        # really pending; if it fails, the update still runs (hint in the log)
        if [ -x /usr/local/sbin/simpleos-backup-helper ]; then
            /usr/local/sbin/simpleos-backup-helper --before-update ||
                echo "restore point before the update failed – the update runs anyway" >&2
        fi
        step "Installing updates"
        if [ "$mode" = full ]; then
            aptget --no-remove full-upgrade
        else
            aptget upgrade --with-new-pkgs
        fi
        # Restart marker only after success – otherwise the error message would wrongly say "Restart first"
        if [ $? -eq 0 ]; then
            printf '%s\n' "$planned" | mark_reboot
        else
            fail "updates could not be installed"
        fi
    fi
    report_held
    if [ "$fp_pending" -eq 1 ]; then
        step "Updating apps from the Software Store"
        _rcf=$(mktemp)
        { flatpak update --system -y </dev/null 2>&1; echo $? > "$_rcf"; } | if [ -x "$FP_PROGRESS" ]; then "$FP_PROGRESS"; else cat; fi
        _rc=$(cat "$_rcf" 2>/dev/null); rm -f "$_rcf"
        [ "${_rc:-1}" -eq 0 ] || fail "Flatpak apps could not be updated"
    fi
    # Last: firmware often needs a restart, and a failed BIOS update should not hold up the others
    if [ "$fw" -eq 1 ]; then
        step "Updating firmware (BIOS and devices)"
        echo "STAGE: Don't turn off the computer"
        fw_update
    fi
    [ "$failed" -eq 0 ] && step "Done"
    exit "$failed"
fi

updated=0
apt_update() {
    ensure_repos && updated=0
    [ "$updated" -eq 1 ] && return 0
    step "Updating package lists"
    # If it fails, browser/office work with the existing lists (the amd64 packages are already in them);
    # gaming needs fresh lists (32-bit just enabled) and checks the return value
    apt_get_update && { updated=1; return 0; }
    echo "package lists could not be downloaded – using the existing ones" >&2
    return 1
}

# ------------------------------------------------------------------ Browser
case "$browser" in
    firefox)
        # e.g. back again after an earlier switch to Chromium/Mullvad
        if ! installed firefox-esr; then
            apt_update
            step "Installing Firefox ESR"
            aptget install firefox-esr || fail "Firefox ESR could not be installed"
        fi ;;
    chromium)
        if ! installed chromium; then
            apt_update
            step "Installing Chromium"
            aptget install chromium || fail "Chromium could not be installed"
        fi ;;
    mullvad)
        if ! flatpak info --system net.mullvad.MullvadBrowser >/dev/null 2>&1; then
            step "Installing Mullvad Browser"
            flatpak_install net.mullvad.MullvadBrowser || fail "Mullvad Browser could not be installed"
        fi ;;
esac

# Remove Firefox only if the new browser is really there – never leave the system without a browser
if [ "$purge_firefox" -eq 1 ] && installed firefox-esr; then
    case "$browser" in
        chromium) new_id=chromium.desktop;                   ok=$(installed chromium && echo 1) ;;
        mullvad)  new_id=net.mullvad.MullvadBrowser.desktop; ok=$(flatpak info --system net.mullvad.MullvadBrowser >/dev/null 2>&1 && echo 1) ;;
        *)        new_id=;                                   ok= ;;
    esac
    if [ -n "$ok" ]; then
        step "Removing Firefox ESR"
        if aptget purge firefox-esr; then
            aptget autoremove --purge
            rm -rf /usr/share/firefox-esr
            # Switch the system-wide defaults to the new browser (for new users and xdg-mime)
            # (The Openbox menu needs nothing: "Web Browser" starts simpleos-browser, i.e. the default browser)
            for f in /etc/xdg/mimeapps.list /usr/share/applications/defaults.list; do
                [ -f "$f" ] && sed -i "s|=firefox-esr\.desktop|=$new_id|" "$f"
            done
        else
            fail "Firefox ESR could not be removed"
        fi
    elif [ -n "$browser" ] && [ "$browser" != firefox ]; then
        echo "Firefox ESR stays installed because the new browser is missing." >&2
    fi
fi

# ------------------------------------------------------------------- Office
# Entries in the Openbox menu (Office) for skel and all user homes, once; sed -i keeps the owner
menu_add_office() {  # $1 = id, stdin = <item> lines
    items=$(mktemp)
    { echo "      <!-- simpleos-office-$1 -->"; cat; } > "$items"
    for f in /etc/skel/.config/openbox/menu.xml /home/*/.config/openbox/menu.xml; do
        [ -f "$f" ] || continue
        grep -q "simpleos-office-$1 " "$f" && continue
        sed -i "/<!-- simpleos-office:/r $items" "$f"
    done
    rm -f "$items"
}
office_menu() {
    case "$office" in
        libreoffice)
            installed libreoffice-writer || return 0
            menu_add_office libreoffice <<'ITEMS'
      <item label="LibreOffice Writer">
        <action name="Execute"><command>libreoffice --writer</command></action>
      </item>
      <item label="LibreOffice Calc">
        <action name="Execute"><command>libreoffice --calc</command></action>
      </item>
      <item label="LibreOffice Impress">
        <action name="Execute"><command>libreoffice --impress</command></action>
      </item>
      <item label="LibreOffice Draw">
        <action name="Execute"><command>libreoffice --draw</command></action>
      </item>
ITEMS
            ;;
        onlyoffice)
            flatpak info --system org.onlyoffice.desktopeditors >/dev/null 2>&1 || return 0
            menu_add_office onlyoffice <<'ITEMS'
      <item label="ONLYOFFICE">
        <action name="Execute"><command>flatpak run org.onlyoffice.desktopeditors</command></action>
      </item>
ITEMS
            ;;
    esac
}

case "$office" in
    libreoffice)
        if ! installed libreoffice-writer; then
            apt_update
            step "Installing LibreOffice (this can take a while)"
            aptget install libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw \
                libreoffice-gtk3 hunspell-de-de hunspell-en-us \
                || fail "LibreOffice could not be installed"
        fi ;;
    onlyoffice)
        if ! flatpak info --system org.onlyoffice.desktopeditors >/dev/null 2>&1; then
            # ~615 MB download, ~1.3 GB installed + runtime/graphics extensions (~1.2 GB) if not there yet
            need=1600
            flatpak info --system org.freedesktop.Platform//25.08 >/dev/null 2>&1 || need=2900
            step "Installing ONLYOFFICE (about 1 GB download – this takes several minutes)"
            flatpak_install org.onlyoffice.desktopeditors "$need" || fail "ONLYOFFICE could not be installed"
        fi ;;
esac
office_menu

# ------------------------------------------------------------------- Gaming
if [ "$gaming" -eq 1 ]; then
    # Order: sources (Steam is in contrib) -> i386 -> apt-get update -> installation
    if ensure_repos; then
        step "Enabling contrib and non-free repositories"
        updated=0
    fi
    if ! dpkg --print-foreign-architectures | grep -qx i386; then
        step "Enabling 32-bit support"
        dpkg --add-architecture i386
        updated=0
    fi
    if ! apt_update; then
        fail "Gaming package: package lists (32-bit) could not be downloaded – check the internet connection"
    else
        # Accept the license in the background beforehand (choosing "Ultimate Gaming" in the wizard is the consent).
        # bookworm does not ask during installation (Steam shows the license graphically on first start),
        # older/newer steam-installer versions do so via debconf – then without a terminal prompt.
        for owner in steam steam-installer; do
            printf '%s steam/question select I AGREE\n%s steam/license note \n' "$owner" "$owner" | debconf-set-selections
        done
        # NVIDIA driver active: Steam needs its 32-bit libraries (otherwise it does not start)
        nvidia=
        if [ -e /sys/module/nvidia/version ]; then
            nvidia="nvidia-driver-libs:i386"
        fi
        step "Installing Steam, Lutris and MangoHud (this can take a while)"
        # 32-bit graphics drivers explicitly: Steam and many games are 32-bit
        aptget install steam-installer steam-libs-i386 lutris mangohud gamemode \
            libgl1-mesa-dri:i386 libgl1:i386 mesa-vulkan-drivers mesa-vulkan-drivers:i386 $nvidia \
            || fail "Gaming package could not be installed completely"
    fi
fi

if [ "$failed" -eq 0 ]; then
    step "Done"
else
    step "Finished with errors"
fi
exit "$failed"
