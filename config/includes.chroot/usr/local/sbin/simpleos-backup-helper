#!/bin/sh
# Simple OS – restore points (root part of simpleos-backup, called via pkexec; polkit action
# org.simpleos.backup). Wrapper around timeshift (RSYNC mode on the system partition, Btrfs if the system
# is on it). By default timeshift does NOT back up personal files in /home – only the system.
#   simpleos-backup-helper --list                 points: "name<TAB>tags<TAB>description", newest first
#   simpleos-backup-helper --create TEXT          create a new point (description: letters, digits, . , : - _ ( ) spaces)
#   simpleos-backup-helper --restore NAME         restore a point (timeshift restarts the PC afterwards)
#   simpleos-backup-helper --delete NAME          delete a point
#   simpleos-backup-helper --check NAME           integrity: point listed, folder + info.json + system files present
#   simpleos-backup-helper --auto on|off|status   a point before every system update (simpleos-system-setup --upgrade)
#   simpleos-backup-helper --before-update        from simpleos-system-setup: create a point if --auto on;
#                                                 keeps the 3 newest "Before system update" points
#   simpleos-backup-helper --setup                first-time setup (runs by itself before --list/--create/--restore)
#   simpleos-backup-helper --space                check space without creating anything: "FREE: <bytes>", "NEED: <bytes>",
#                                                 "PATH: <mount point>"; exit 0 = enough (or not measurable), 6 = too little
# Free space: Python shutil.disk_usage() at timeshift's target – mount point of the configured target device
# (findmnt), otherwise "/" (target device = system partition), otherwise timeshift's own mount points
# /run/timeshift/*/backup. If a path returns an error or a total size of 0 bytes, the next one is tried; if
# all are unusable, the space counts as "not measurable" and there is NO space warning (timeshift decides).
# Minimum free: 5 GB before the first point (full copy of the system), 1 GB before further ones (changes only).
# First-time setup: if timeshift has no (valid) target device, /etc/timeshift/timeshift.json is created minimally
# or completed: RSYNC mode on the partition of "/" (UUID via findmnt; with LUKS also the UUID of the
# encrypted container), no schedules, home folders excluded (/home/*/**, /root/**) – otherwise
# timeshift would back up personal files too and overwrite them when restoring.
# Only fixed actions; NAME must look exactly like timeshift names (YYYY-MM-DD_hh-mm-ss) and exist.
# simpleos-backup shows the lines "STEP: <text>", "STAGE: <text>", "PROGRESS: <percent> [<rest>]" live in the
# progress window (simpleos-progress), "FREE:/NEED: <bytes>" the space on exit 6.
# timeshift exits with 0 even on failures -> success of --create/--delete is checked against the snapshot
# list, timeshift's error texts are classified (so "not enough space" never appears when the cause
# is actually something else):
# Exit 0 ok, 1 other error, 2 invalid usage, 3 timeshift missing, 4 live session,
#      5 no target device (system partition cannot be determined/not available), 6 not enough space.
# Tests: SIMPLEOS_BACKUP_ROOT replaces "/" for the state file, timeshift.json and snapshot folder; its bin/
# comes first in PATH (dummies for timeshift/findmnt/lsblk/blkid). Only then SIMPLEOS_FAKE_DISK applies too
# ("path=total:free;…", path missing = error when querying) instead of shutil.disk_usage. pkexec clears the environment.
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ROOT=${SIMPLEOS_BACKUP_ROOT:-}
# Test root: its bin/ (timeshift dummy) first – can only be set directly as root, pkexec clears the environment
[ -n "$ROOT" ] && PATH=$ROOT/bin:$PATH
AUTO=$ROOT/etc/simpleos/backup-before-updates
SNAPDIR=$ROOT/timeshift/snapshots
KEEP_UPDATE=3
UPDATE_COMMENT="Before system update"
CONF=$ROOT/etc/timeshift/timeshift.json
MIN_FIRST=5000000000   # 5 GB before the first point (full copy)
MIN_NEXT=1000000000    # 1 GB before further points (rsync hard links: only changed files take space)
TSOUT=$(mktemp) || exit 1
trap 'rm -f "$TSOUT" "$TSOUT.rc"' EXIT

step() { echo "STEP: $*"; }
die() { echo "simpleos-backup-helper: $*" >&2; exit "${2:-1}"; }
usage() { die "Usage: --list | --create TEXT | --restore NAME | --delete NAME | --check NAME | --auto on|off|status | --before-update" 2; }

[ "$(id -u)" -eq 0 ] || [ -n "$ROOT" ] || die "must run as root (pkexec)"
live() { [ -x /usr/local/bin/simpleos-live ] && /usr/local/bin/simpleos-live --check; }
need_ts() { command -v timeshift >/dev/null || die "timeshift missing" 3; }
valid_name() { printf '%s' "$1" | grep -qxE '[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}'; }
valid_text() { [ ${#1} -le 60 ] && printf '%s' "$1" | grep -qxE "[[:alnum:] .,:()_-]*"; }

# timeshift --list -> TSV (newest first). Lines: "0    >  2026-10-01_14-30-00  O     Before update"
list() {
    need_ts
    timeshift --list --scripted 2>/dev/null |
        sed -n 's/^[0-9][0-9]* *> *\([0-9]\{4\}-[0-9-]*_[0-9-]*\) *\([OBHDWM]*\) *\(.*\)$/\1\t\2\t\3/p' |
        sed 's/ *$//' | sort -r
}
exists() { list | cut -f1 | grep -qx "$1"; }

# ---- First-time setup: target device = partition of "/"
# Exit 0 = target device present/configured, 5 = none determinable (overlay/live, no UUID)
device_ok() {  # the UUID exists as a device
    [ -n "$1" ] || return 1
    [ -e "/dev/disk/by-uuid/$1" ] && return 0
    command -v blkid >/dev/null && blkid -U "$1" >/dev/null 2>&1
}
ensure_config() {
    current=$(python3 -c 'import json, sys
try: print(json.load(open(sys.argv[1])).get("backup_device_uuid", ""))
except Exception: print("")' "$CONF" 2>/dev/null)
    device_ok "$current" && return 0
    # -P: SOURCE="…" UUID="…" FSTYPE="…" (empty fields would otherwise shift the columns)
    SOURCE= UUID= FSTYPE=
    eval "$(findmnt -n -P -o SOURCE,UUID,FSTYPE --target / 2>/dev/null | grep -E '^SOURCE="[^"`$\\]*" UUID="[^"`$\\]*" FSTYPE="[^"`$\\]*"$')"
    src=$SOURCE uuid=$UUID fstype=$FSTYPE
    case "$fstype" in ''|overlay|squashfs|tmpfs|aufs|ramfs) echo "system partition cannot be determined ($fstype)" >&2; return 5 ;; esac
    [ -n "$uuid" ] || { echo "system partition $src without UUID" >&2; return 5; }
    parent=
    case "$src" in
        /dev/mapper/*|/dev/dm-*)  # LUKS/LVM: timeshift also wants to know the container
            pk=$(lsblk -ndo PKNAME "$src" 2>/dev/null | head -n 1)
            [ -n "$pk" ] && parent=$(lsblk -ndo UUID "/dev/$pk" 2>/dev/null | head -n 1) ;;
    esac
    mkdir -p "${CONF%/*}" || return 1
    python3 - "$CONF" "$uuid" "$parent" <<'PY' || return 1
import json, sys
path, uuid, parent = sys.argv[1:4]
try:
    conf = json.load(open(path))
    if not isinstance(conf, dict):
        conf = {}
except Exception:
    conf = {}
conf.update({"backup_device_uuid": uuid, "parent_device_uuid": parent, "do_first_run": "false",
             "btrfs_mode": "false", "include_btrfs_home": "false", "stop_cron_emails": "true"})
for k in ("monthly", "weekly", "daily", "hourly", "boot"):
    conf.setdefault("schedule_" + k, "false")
conf.setdefault("count_monthly", "2"); conf.setdefault("count_weekly", "3"); conf.setdefault("count_daily", "5")
conf.setdefault("count_hourly", "6"); conf.setdefault("count_boot", "5")
if not conf.get("exclude"):
    conf["exclude"] = ["/root/**", "/home/*/**"]
conf.setdefault("exclude-apps", [])
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(conf, f, indent=2)
import os
os.replace(tmp, path)
PY
    echo "timeshift: target device $src ($uuid) configured" >&2
    return 0
}
# Mount points of the backup target (best first), one line per path
target_paths() {
    uuid=$(python3 -c 'import json, sys
try: print(json.load(open(sys.argv[1])).get("backup_device_uuid", ""))
except Exception: print("")' "$CONF" 2>/dev/null)
    if [ -n "$uuid" ]; then
        findmnt -rn -o TARGET -S "UUID=$uuid" 2>/dev/null | head -n 1
        root_uuid=$(findmnt -n -P -o UUID --target / 2>/dev/null | sed -n 's/^UUID="\(.*\)"$/\1/p')
        [ "$uuid" = "$root_uuid" ] && echo /
    else
        echo /
    fi
    for d in /run/timeshift/*/backup /run/timeshift/backup; do [ -d "$d" ] && echo "$d"; done
}
# Space at the target: "FREE: n" "NEED: n" "PATH: p" (FREE empty = not measurable). Exit 0 enough/unknown, 6 too little
space_report() {
    if [ -n "$(list | head -n 1)" ]; then need=$MIN_NEXT; else need=$MIN_FIRST; fi
    target_paths | FAKE=$( [ -n "$ROOT" ] && printf '%s' "${SIMPLEOS_FAKE_DISK:-}" ) python3 -c '
import os, shutil, sys
fake = os.environ.get("FAKE", "")
table = {}
for item in filter(None, fake.split(";")):
    path, _, sizes = item.partition("=")
    total, _, free = sizes.partition(":")
    table[path] = (int(total), int(free))
def usage(path):
    if fake:
        if path not in table:
            raise OSError("no such mount")
        return table[path]
    du = shutil.disk_usage(path)
    return du.total, du.free
need = int(sys.argv[1])
seen, full = [], None
for path in (line.strip() for line in sys.stdin):
    if not path or path in seen:
        continue
    seen.append(path)
    try:
        total, free = usage(path)
    except OSError as err:
        print(f"{path}: {err}", file=sys.stderr)
        continue
    if total <= 0:
        print(f"{path}: total size 0 – next path", file=sys.stderr)
        continue
    if free <= 0:            # really full – or an outlier: check further paths of the same device
        full = full or path
        continue
    print(f"FREE: {free}\nNEED: {need}\nPATH: {path}")
    sys.exit(0 if free >= need else 6)
if full:
    print(f"FREE: 0\nNEED: {need}\nPATH: {full}")
    sys.exit(6)
print(f"FREE: \nNEED: {need}\nPATH: ")   # not measurable -> no space warning
sys.exit(0)
' "$need"
}
# Classify timeshift's output ($TSOUT) -> exit code 4/5/6/1
classify() {
    if grep -qiE 'Live CD mode|live (session|mode)' "$TSOUT"; then echo "timeshift: live system" >&2; return 4; fi
    if grep -qiE 'not enough (disk )?space|no space left|space.*required|low disk space|insufficient (disk )?space' "$TSOUT"; then
        # timeshift has the last word: exit 6 even if our minimum would be met – then without
        # NEED (our limit would be met; how much timeshift exactly wants is in the log)
        if space_report >/dev/null 2>&1; then space_report 2>/dev/null | grep -v '^NEED:'; else space_report 2>/dev/null; fi
        return 6
    fi
    if grep -qiE 'device not (selected|available|found|mounted|specified)|location not (selected|available)|Device *: *Not Selected|failed to (find|mount) (device|backup)' "$TSOUT"; then
        echo "timeshift: no target device" >&2; return 5
    fi
    return 1
}
# timeshift output (lines with \r) -> live lines for the progress window (simpleos-progress):
#   "STAGE: <text>"                  section in plain language
#   "PROGRESS: <percent> [<rest>]"   from "12.34% complete (5m 10s remaining)"
progress_filter() {
    # Python instead of awk: mawk buffers pipes – the progress only arrived at the end
    /usr/local/lib/simpleos/progress-filter timeshift
}
# timeshift ARGS… -> output in $TSOUT (and into the caller's log via stderr), exit code of timeshift.
# Runs through progress_filter at the same time so the window counts along live (stdbuf: otherwise timeshift
# only writes into the pipe at the end).
ts() {
    rcf=$TSOUT.rc
    unbuf=; command -v stdbuf >/dev/null && unbuf="stdbuf -o0 -e0"
    { $unbuf timeshift "$@" 2>&1; echo $? > "$rcf"; } | tee "$TSOUT" | progress_filter
    trc=$(cat "$rcf" 2>/dev/null); rm -f "$rcf"
    cat "$TSOUT" >&2
    return "${trc:-1}"
}
create_point() {  # $1 description -> 0 only if there really is a new point in the list afterwards
    before=$(list | cut -f1)
    # without --tags: timeshift 22.11 rejects "--tags O" ("Unknown value"), the default is O (on demand) anyway
    ts --create --comments "${1:-Restore point}" --scripted
    after=$(list | cut -f1)
    [ -n "$(printf '%s\n' "$after" | grep -vxF -e "$before" -e '' | head -n 1)" ] && return 0
    [ -z "$before" ] && [ -n "$after" ] && return 0
    classify; rc=$?
    echo "timeshift --create: no new point (reason $rc)" >&2
    return "$rc"
}
precheck() {  # before creating: live, target device, minimum space
    live && { echo "Live-Session" >&2; return 4; }
    ensure_config || return $?
    report=$(space_report) || { printf '%s\n' "$report"; return 6; }
    return 0
}

case "${1:-}" in
    --space)
        [ $# -eq 1 ] || usage
        need_ts
        live && die "Live-Session" 4
        ensure_config || exit $?
        space_report; exit $? ;;
    --setup)
        [ $# -eq 1 ] || usage
        live && die "Live-Session" 4
        ensure_config || exit $? ;;
    --list)
        [ $# -eq 1 ] || usage
        need_ts
        # first-time setup on the side (live/no device: the list simply stays empty)
        live || ensure_config 2>/dev/null
        list ;;
    --create)
        [ $# -eq 2 ] || usage
        valid_text "$2" || die "invalid description" 2
        need_ts
        precheck || exit $?
        step "Creating a restore point (the first one can take 10–20 minutes)"
        create_point "$2" || exit $?
        step "Done" ;;
    --restore)
        [ $# -eq 2 ] && valid_name "$2" || usage
        live && die "Live-Session" 4
        need_ts
        ensure_config || exit $?
        exists "$2" || die "point $2 not found"
        step "Restoring $2 – the computer restarts when it is done"
        # target device = running system (default), GRUB stays as it is; --yes answers the question
        ts --restore --snapshot "$2" --scripted --yes --skip-grub; trc=$?
        # Classified errors (live, device, space) count even with exit 0; otherwise the exit code decides
        classify; rc=$?
        [ "$rc" -eq 1 ] || exit "$rc"
        [ "$trc" -eq 0 ] || die "timeshift --restore failed"
        step "Done" ;;
    --delete)
        [ $# -eq 2 ] && valid_name "$2" || usage
        exists "$2" || die "point $2 not found"
        step "Deleting $2"
        ts --delete --snapshot "$2" --scripted --yes
        exists "$2" && { classify; rc=$?; die "timeshift --delete: $2 still there" "$rc"; }
        step "Done" ;;
    --check)
        [ $# -eq 2 ] && valid_name "$2" || usage
        exists "$2" || die "point $2 not found"
        d=$SNAPDIR/$2
        if [ -d "$d" ]; then
            [ -s "$d/info.json" ] || die "$2: info.json missing"
            python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$d/info.json" 2>/dev/null || die "$2: info.json damaged"
            [ -s "$d/localhost/etc/os-release" ] || die "$2: system files missing (localhost/etc/os-release)"
            [ -d "$d/localhost/usr/bin" ] || die "$2: system files missing (localhost/usr/bin)"
            echo "ok"
        else
            # another device or Btrfs: the folder is only mounted while timeshift runs -> the list is enough
            echo "listed"
        fi ;;
    --auto)
        [ $# -eq 2 ] || usage
        case "$2" in
            on)     mkdir -p "${AUTO%/*}" && echo on > "$AUTO" ;;
            off)    rm -f "$AUTO" ;;
            status) if [ -f "$AUTO" ]; then echo on; else echo off; fi ;;
            *)      usage ;;
        esac ;;
    --before-update)
        [ $# -eq 1 ] || usage
        [ -f "$AUTO" ] || exit 0
        live && exit 0
        command -v timeshift >/dev/null || exit 0
        precheck || exit $?
        step "Creating a restore point before the update"
        create_point "$UPDATE_COMMENT" || exit $?
        # Keep only the newest points before updates (own, manual points stay untouched)
        list | awk -F'\t' -v c="$UPDATE_COMMENT" '$3 == c { n++; if (n > '"$KEEP_UPDATE"') print $1 }' |
            while read -r old; do
                timeshift --delete --snapshot "$old" --scripted --yes >/dev/null 2>&1 || echo "deleting $old failed" >&2
            done ;;
    *) usage ;;
esac
exit 0
