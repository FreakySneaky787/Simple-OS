#!/bin/sh
# Simple OS – runs via Calamares (shellprocess) in the chroot of the installed system
set -e
export DEBIAN_FRONTEND=noninteractive

# Remove the installer
apt-get purge -y calamares calamares-settings-debian

# Calamares (sources-final) writes only "main non-free-firmware" -> add contrib/non-free,
# otherwise the Setup Wizard does not find e.g. steam-installer (contrib)
/usr/local/sbin/simpleos-system-setup --repos

# Remove the menu entry "Install Simple OS" from skel and all user homes
for f in /etc/skel/.config/openbox/menu.xml /home/*/.config/openbox/menu.xml; do
    [ -f "$f" ] && sed -i '/simpleos-installer-begin/,/simpleos-installer-end/d' "$f"
done
# Installer launchers (launcher, desktop icons); simpleos-taskbar-select --apply removes the taskbar badge
# at the next login (no live medium any more)
rm -f /usr/share/applications/simpleos-install.desktop /etc/skel/Desktop/simpleos-install.desktop \
      /home/*/Desktop/simpleos-install.desktop /home/*/Desktop/install-debian.desktop

# Leftovers of the live session: autologin of the live user and its NOPASSWD sudo
rm -f /etc/lightdm/lightdm.conf.d/01_autologin.conf /etc/sudoers.d/simple-nopasswd

# Offline packages for bootloader-config (grub-pc/grub-efi-amd64/cryptsetup-initramfs) are no longer needed
rm -rf /usr/share/simpleos/bootloader-debs

rm -f "$0"
