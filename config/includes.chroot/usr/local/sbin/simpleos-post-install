#!/bin/sh
# Simple OS – runs via Calamares (shellprocess) in the chroot of the installed system
set -e
export DEBIAN_FRONTEND=noninteractive

# Remove the installer
apt-get purge -y calamares calamares-settings-debian
# Calamares pulled in ~100 packages only it needs (Qt5, KDE Frameworks, kio, WebKit …, ~175 MB) – they would stay
# installed and receive updates forever. Only packages nobody depends on (apt marks them automatic) go; a failure
# here must not fail the installation.
apt-get -y autoremove --purge || echo "simpleos-post-install: autoremove failed (ignored)" >&2

# Calamares (sources-final) writes only "main non-free-firmware" -> add contrib/non-free,
# otherwise the Setup Wizard does not find e.g. steam-installer (contrib)
/usr/local/sbin/simpleos-system-setup --repos

# Dictionary and Firefox/LibreOffice language packs for the language chosen in the installer (the image itself is English).
# Needs the internet; without it nothing happens here and Software Updates installs them later. Limited in time so an
# unreachable network cannot hold up the installation.
timeout 300 /usr/local/sbin/simpleos-system-setup --language || echo "simpleos-post-install: language packs skipped" >&2

# Remove the menu entry "Install Simple OS" from skel and all user homes
for f in /etc/skel/.config/openbox/menu.xml /home/*/.config/openbox/menu.xml; do
    [ -f "$f" ] && sed -i '/simpleos-installer-begin/,/simpleos-installer-end/d' "$f"
done
# Installer launchers (launcher, desktop icons); simpleos-taskbar-select --apply removes the taskbar badge
# at the next login (no live medium any more)
rm -f /usr/share/applications/simpleos-install.desktop /etc/skel/Desktop/simpleos-install.desktop \
      /home/*/Desktop/simpleos-install.desktop /home/*/Desktop/install-debian.desktop

# Leftovers of the live session: autologin of the live user, its NOPASSWD sudo and its polkit rule (hook 16)
rm -f /etc/lightdm/lightdm.conf.d/01_autologin.conf /etc/sudoers.d/simple-nopasswd /etc/polkit-1/rules.d/49-simpleos-live.rules

# Update channel of Simple OS (package "simpleos"): hook 98 switches it off in the image if GitHub was not
# reachable during the build – the installed system needs it to get new Simple OS editions
SOS_SRC=/etc/apt/sources.list.d/simpleos.sources
[ -f "$SOS_SRC" ] && sed -i '/^Enabled: no$/d' "$SOS_SRC"

# Installer links as the live user (hook 15) – no longer needed, root keeps its normal defaults
rm -f /root/.config/mimeapps.list /root/.local/share/applications/simpleos-open-as-user.desktop /usr/local/lib/simpleos/open-as-user

# Offline packages for bootloader-config (grub-pc/grub-efi-amd64/cryptsetup-initramfs) are no longer needed
rm -rf /usr/share/simpleos/bootloader-debs

# Fallback loader on the EFI partition (\EFI\BOOT\BOOTX64.EFI) and the current shim/GRUB in EFI/Simple_OS (Calamares runs
# this after the bootloader module; /boot/efi is mounted in the target). Does nothing on BIOS systems.
/usr/local/sbin/simpleos-efi-refresh || true

rm -f "$0"
