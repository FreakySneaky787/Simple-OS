#!/bin/sh
# Simple OS – Rofi with retries for scripts that cannot include common.sh (set -e: sos_rofi
# would abort there on the first failure). Called like rofi: menu on stdin, selection on stdout.
#   Esc                    -> empty output
#   grab error / "Rofi already running" -> up to 6 attempts (a click holds keyboard/pointer, or the
#                          start menu Rofi is just closing)
#   rofi missing / does not start -> a clear notification, empty output
# Always exit 0; details in ~/.cache/$SOS_NAME.log (SOS_NAME/SOS_TITLE from the caller, otherwise simpleos-rofi).
SOS_NAME=${SOS_NAME:-simpleos-rofi} SOS_TITLE=${SOS_TITLE:-Simple OS}
LIB=/usr/local/lib/simpleos/common.sh
if [ ! -r "$LIB" ]; then
    command -v rofi >/dev/null || exit 0
    rofi "$@" 2>/dev/null
    exit 0
fi
. "$LIB"
sos_log_init "$@"
sos_rofi "$@"
exit 0
