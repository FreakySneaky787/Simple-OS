#!/usr/bin/python3
"""Simple OS – translate the progress of flatpak / apt / timeshift into live lines for progress windows and the wizard.

    flatpak install --system -y flathub APP 2>&1 | progress-filter flatpak
    apt-get -o APT::Status-Fd=3 … 3>&1 1>&2   | progress-filter apt [--dl FROM TO] [--inst FROM TO] [--updates N]
    timeshift --create … 2>&1                 | progress-filter timeshift

Output: "PROGRESS: <percent> [<rest>]" and "STAGE: <text>", immediately and one by one (flush). All other lines pass
through unchanged (error texts!), repetitions only once.
Why Python instead of awk: mawk reads pipes in large blocks – the progress only arrived at the end; with
"-W interactive" it streams, but then no longer splits the \\r-separated progress lines.

flatpak (WITHOUT --noninteractive, otherwise Flatpak prints no progress): overview " 1.  ref … < 148.0 MB" ->
  weights ("(partial)" = upper limit, in reality usually only a few MB -> 5 %); "Installing 2/3… ███ 45%  2.3 MB/s  00:12" ->
  overall progress weighted by size; the speed is in the section ("Downloading part 2 of 8 · 80 kB/s"), so a
  slow Flathub download (e.g. a runtime at ~36 kB/s) does not look stuck. Deliberately NO time left:
  Flatpak reports the speed only for the current part, and it varies extremely per part (GL drivers from many small
  files ~80 kB/s, large runtimes as deltas several MB/s) – extrapolated that gave "2 h left" for minutes.
apt: "dlstatus:…:<percent>:…" -> download share (default 0–40 %), "pmstatus:<package>:<percent>:…" -> installation
  (default 40–100 %), STAGE "Downloading" / "Installing" – plain words, no package names or versions (#120); the bar
  never goes back within a phase (apt's download percentage jumps). --updates N (Software Updates, N = planned
  packages; the heading already says "Installing updates", #129): "Downloading 3 of 14" from apt's "Retrieving file 3 of
  14", "Update 5 of 14" counted from apt's overall percentage, "Finishing up" for the triggers (initramfs, GRUB, man-db …)
  once the last update is reached – and it stays. pmerror:/pmconffile: lines are swallowed (#131).
flatpak also: the table header, "Info:" end-of-life blocks and "Looking for updates" (-> "Checking for app updates") never
  reach the window (#131) – they are in the log.
timeshift: "12.34% complete (5m 10s remaining)" -> percent + rest; sections in plain language. While Timeshift has no
  measure yet ("0.00% complete (??? remaining)" – the first restore point copies the whole system and can sit there for
  20 minutes, #119) there is NO "PROGRESS: 0" (the window glides instead of standing at 0 %) and never "???"; instead the
  files rsync has handled so far, counted from its --log-file (/run/timeshift/<pid>/backup/timeshift/snapshots/<name>/
  rsync-log), as "STAGE: Copying system files · 12,340 files" every few seconds, and "HINT: <text>" for the window's hint
  line: the wait is normal, later "still working". "HINT:" (empty) = back to the window's own hint.
"""
import glob
import select
import time
import os
import re
import sys

UNIT = {"": 1, "k": 1e3, "m": 1e6, "g": 1e9}
# Speed only together with Flatpak's own estimate ("00:12"): it only appears once the speed has settled
SPEED = re.compile(r"\d+%\s+([\d.]+)\s*([kMG]?)(?:B|bytes)/s\s+\d+:\d\d")
PARTIAL = 0.05
RSYNC_LOGS = "/run/timeshift/*/backup/timeshift/snapshots/*/rsync-log"
TS_HINT = "This can take 10–20 minutes – don't turn off the computer"
TS_HINT_LATE = "Still working, this is normal – don't turn off the computer"
TS_LATE = 180          # s without a real percentage -> TS_HINT_LATE
TS_TICK = 2.0          # s between two looks at the rsync log
TS_STAGES = (
    (re.compile(r"Estimating system size"), "Measuring the system"),
    (re.compile(r"Mounted|Mounting|Saving to device|Creating new snapshot"), "Preparing the backup disk"),
    (re.compile(r"Synching files"), "Copying system files"),
    (re.compile(r"Restoring"), "Putting system files back"),
    (re.compile(r"Removing|Deleting"), "Removing old files"),
    (re.compile(r"[Ss]napshot saved|Tagged snapshot|Updating GRUB|Restore completed"), "Finishing up"),
)


def speed_text(bps):
    """Speed rounded to 2 digits ("80 kB/s", "1.5 MB/s", "12 MB/s"), so not every fluctuation becomes a line."""
    for unit, f in (("MB/s", 1e6), ("kB/s", 1e3)):
        if bps >= f:
            v = bps / f
            return f"{v:.1f} {unit}" if v < 10 else f"{round(v, -1 if v >= 100 else 0):.0f} {unit}"
    return f"{bps:.0f} B/s"


def out(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


class Filter:
    def __init__(self, mode, args):
        self.mode = mode
        self.last_line = self.last_stage = self.last_pct = None
        self.weights, self.count, self.speed, self.speed_part = {}, 0, "", None
        self.dl = (0.0, 40.0)
        self.inst = (40.0, 100.0)
        self.updates = 0          # --updates N: number of planned packages (0 = generic texts)
        # timeshift: waiting without a percentage since (monotonic), hint sent, rsync log being counted
        self.ts_wait, self.ts_hint, self.ts_measured = None, None, False
        self.ts_log, self.ts_pos, self.ts_files, self.ts_shown, self.ts_next = None, 0, 0, -1, 0.0
        self.started = time.time()
        self.rsync_logs = os.environ.get("SIMPLEOS_RSYNC_LOGS", RSYNC_LOGS)   # test: another glob
        self.apt_phase, self.apt_max = None, 0.0
        self.finishing = False    # --updates: "Finishing up" reached (stays)
        self.fp_info = False      # flatpak: inside an "Info:" block (end-of-life notice and its indented lines)
        it = iter(args)
        for a in it:
            if a == "--updates":
                self.updates = max(0, int(next(it)))
            elif a in ("--dl", "--inst"):
                rng = (float(next(it)), float(next(it)))
                if a == "--dl":
                    self.dl = rng
                else:
                    self.inst = rng

    def stage(self, text):
        if text != self.last_stage:
            out("STAGE: " + text)
            self.last_stage = text

    def pct(self, value, rest=""):
        v = int(max(0, min(100, value)))
        key = (v, rest)
        if key != self.last_pct:
            out(f"PROGRESS: {v}" + (f" {rest}" if rest else ""))
            self.last_pct = key

    def passthrough(self, line):
        if line.strip() and line != self.last_line:
            out(line)
            self.last_line = line

    # ------------------------------------------------------------ flatpak
    def flatpak(self, line):
        # #131: technical lines never as the description (they stay in the log): the table header, the end-of-life
        # notices ("Info: runtime … is end-of-life, with reason:" + indented lines, "Info: applications using this
        # runtime:" + the app IDs) and the column/ref lines
        if self.fp_info:
            # the block ends with the first line that is not indented – or with the overview (" 1.\tref …")
            if (re.match(r"^\s", line) or not line.strip()) and not re.match(r"^\s*\d+\.\t", line):
                return
            self.fp_info = False
        if line.startswith("Info:"):
            self.fp_info = True
            return
        if re.match(r"^\s*ID\s+Branch\b", line) or re.match(r"^\s*ID\s+Arch\b", line):
            return
        if re.match(r"^Looking for (app )?updates", line):
            self.stage("Checking for app updates")
            return
        m = re.match(r"^\s*(\d+)\.\t", line)
        if m:
            i = int(m.group(1))
            self.count = max(self.count, i)
            s = re.search(r"<\s*([\d.]+)\D{0,3}?([kMG]?)B", line)
            if s:
                self.weights[i] = float(s.group(1)) * UNIT[s.group(2).lower()] * (PARTIAL if "(partial)" in line else 1)
            return
        if re.match(r"^(Installing|Updating|Downloading)", line) and "%" in line:
            p = re.search(r"(\d+)%", line)
            if not p:
                return
            cur, cnt = 1, max(self.count, 1)
            m = re.search(r"(\d+)/(\d+)", line)
            if m:
                cur, cnt = int(m.group(1)), int(m.group(2))
            frac = int(p.group(1)) / 100
            total = sum(self.weights.values())
            if total > 0 and cur in self.weights:
                done = sum(w for k, w in self.weights.items() if k < cur)
                overall = (done + self.weights[cur] * frac) / total * 100
            else:
                overall = ((cur - 1) + frac) / cnt * 100
            if cur != self.speed_part:
                self.speed, self.speed_part = "", cur     # new part: the old speed no longer applies
            v = SPEED.search(line)
            if v and float(v.group(1)) > 0:
                self.speed = speed_text(float(v.group(1)) * UNIT[v.group(2).lower()])
            label = f"Downloading part {cur} of {cnt}" if cnt > 1 else "Downloading"
            self.stage(label + (f" · {self.speed}" if self.speed else ""))
            self.pct(min(overall, 99))           # 100 only with "Installation complete."
            return
        if re.match(r"^(Installing|Updating)[^%]*$", line):
            return
        if re.match(r"^(Installation complete|Changes complete|Updates complete)", line):
            self.pct(100)
        self.passthrough(line)

    # ------------------------------------------------------------ apt
    def apt(self, line):
        parts = line.split(":", 3)
        if len(parts) >= 3 and parts[0] in ("dlstatus", "pmstatus"):
            try:
                p = float(parts[2])
            except ValueError:
                return
            kind, desc = parts[0], parts[3] if len(parts) > 3 else ""
            if kind != self.apt_phase:            # new phase: its own maximum
                self.apt_phase, self.apt_max = kind, 0.0
            self.apt_max = p = max(self.apt_max, min(100.0, p))
            lo, hi = self.dl if kind == "dlstatus" else self.inst
            if kind == "dlstatus":
                # with --updates the heading already says "Installing updates": the description only counts (#129)
                text = "Downloading"
                m = re.match(r"Retrieving file (\d+) of (\d+)", desc)
                if self.updates and m:
                    text = f"Downloading {m.group(1)} of {m.group(2)}"
                self.stage(text)
            elif parts[1] == "dpkg-exec":
                pass                              # "Running dpkg": the current text stays
            elif self.updates:
                n = min(self.updates, int(p / 100 * self.updates) + 1)
                if desc.startswith("Running"):    # a trigger: "Finishing up" only once the last update is reached –
                    if n >= self.updates:         # a trigger in the middle flickered "Finishing up" <-> "Update 3 of 5"
                        self.finishing = True
                if self.finishing:
                    self.stage("Finishing up")
                else:
                    self.stage(f"Update {n} of {self.updates}")
            elif desc.startswith("Running"):      # "Running post-installation trigger …"
                self.stage("Finishing up")
            else:
                self.stage("Installing")
            self.pct(lo + (hi - lo) * p / 100)
            return
        # pmerror:/pmconffile:/pmhalt … – apt's other status lines: never as the description (#131); the error itself
        # reaches the log and the notification through apt's stderr
        if re.match(r"^pm[a-z]+:", line):
            return
        self.passthrough(line)

    # ------------------------------------------------------------ timeshift
    def hint(self, text):
        if text != self.ts_hint:
            out(("HINT: " + text).rstrip())
            self.ts_hint = text

    def timeshift(self, line):
        m = re.search(r"(\d+(?:\.\d+)?)% complete", line)
        if m:
            rest = re.search(r"\(([^()]*?) remaining\)", line)
            v = m.group(1)
            left = rest.group(1).strip() if rest else ""
            if not re.search(r"\d", left):
                left = ""                         # "???" is not a time
            if float(v) <= 0:                     # nothing measurable yet: no frozen 0 %, explain the wait
                if self.ts_wait is None:
                    self.ts_wait = time.monotonic()
                if not self.ts_measured:
                    self.hint(TS_HINT)
                self.tick()
                return
            if not self.ts_measured:
                self.ts_measured = True
                if self.ts_hint:
                    self.hint("")                 # back to the window's own hint
            key = (v, left)
            if key != self.last_pct:
                out(f"PROGRESS: {v}" + (f" {left}" if left else ""))
                self.last_pct = key
            return
        for rx, text in TS_STAGES:
            if rx.search(line):
                self.stage(text)
                return
        # do not pass other timeshift lines through (they are in the log)

    def tick(self):
        """timeshift while waiting: count rsync's log lines (one per file) and send them; the late hint."""
        if self.mode != "timeshift" or self.ts_wait is None or self.ts_measured:
            return
        now = time.monotonic()
        if now < self.ts_next:
            return
        self.ts_next = now + TS_TICK
        if now - self.ts_wait >= TS_LATE:
            self.hint(TS_HINT_LATE)
        if self.ts_log is None:
            # only a log of THIS run (an old snapshot's log is complete and would count wrong)
            logs = [f for f in glob.glob(self.rsync_logs) if os.path.getmtime(f) >= self.started - 5]
            if not logs:
                return
            self.ts_log = max(logs, key=os.path.getmtime)
        try:
            with open(self.ts_log, "rb") as fh:
                fh.seek(self.ts_pos)
                data = fh.read(16 << 20)          # at most 16 MB per look, the rest next time
        except OSError:
            return
        self.ts_pos += len(data)
        self.ts_files += data.count(b"\n")
        if self.ts_files != self.ts_shown and self.ts_files > 0:
            self.stage(f"Copying system files · {self.ts_files:,} files")
            self.ts_shown = self.ts_files

    def feed(self, line):
        getattr(self, self.mode)(line.rstrip())


def main(argv):
    if len(argv) < 2 or argv[1] not in ("flatpak", "apt", "timeshift"):
        print("Usage: progress-filter flatpak|apt|timeshift [--dl A B] [--inst A B] [--updates N]", file=sys.stderr)
        return 2
    f = Filter(argv[1], argv[2:])
    rest = b""
    while True:
        # timeshift: also look at the rsync log while timeshift prints nothing new
        if f.mode == "timeshift":
            try:
                ready, _, _ = select.select([0], [], [], TS_TICK)
            except InterruptedError:
                continue
            if not ready:
                f.tick()
                continue
        try:
            chunk = os.read(0, 65536)
        except InterruptedError:
            continue
        if not chunk:
            break
        data = (rest + chunk).replace(b"\r", b"\n").split(b"\n")
        rest = data.pop()
        for raw in data:
            f.feed(raw.decode("utf-8", "replace"))
    if rest:
        f.feed(rest.decode("utf-8", "replace"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        sys.exit(0)
