#!/usr/bin/env python3
"""Simple OS – the accent color in GTK 3 apps too (#158): radio buttons, check boxes, switches, progress bars, the
selected row (Control Center, Thunar, file dialogs), focus borders …

The app theme is Arc-Lighter / Arc-Dark, whose accent is a fixed blue (#5294e2 and lighter/darker shades of it, also inside
the PNG images of check boxes, radio buttons and switches). simpleos-theme calls this with the chosen accent and mode:
  - blue (Arc's own color): the block below is removed – apps look exactly like plain Arc
  - other accents: every rule of Arc's CSS that uses that blue is written again with the accent (same lightness and
    saturation relation, so hover/insensitive shades stay shades) into a block in ~/.config/gtk-3.0/gtk.css, and
    the images that contain the blue are recolored into ~/.local/share/simpleos/gtk-accent/<accent>-<mode>/.
    Only declarations whose value is the same in Arc and Arc-Dark are taken (the colors), the images from the
    current mode's theme – so a running app that switches light/dark live (XSETTINGS) keeps right colors; only the
    tick/knob color of its check boxes follows after the app is started again (GTK reads gtk.css once per program).
    That is also why the previous folder stays: an open app loads an image of its old block only when it first draws
    that state (a check box on a page not shown yet) – deleted, the widget would have no image (#169). Older
    folders are removed.
Your own lines in gtk.css outside the block stay. Link colors and Arc's blue "info" color are not changed.

  gtk-accent --accent green --mode light     write the block (or remove it for blue)
  gtk-accent --show                          print the block that would be written (tests)
Tests: SIMPLEOS_GA_HOME (home folder), SIMPLEOS_GA_THEMES (instead of /usr/share/themes).
Never fails: exit 0, a problem is logged to ~/.cache/simpleos-theme.log.
"""
import colorsys
import os
import re
import sys
from pathlib import Path

HOME = Path(os.environ.get("SIMPLEOS_GA_HOME") or Path.home())
THEMES = Path(os.environ.get("SIMPLEOS_GA_THEMES") or "/usr/share/themes")
GTK_CSS = HOME / ".config/gtk-3.0/gtk.css"
DATA = HOME / ".local/share/simpleos/gtk-accent"
LOG = HOME / ".cache/simpleos-theme.log"
BEGIN = "/* simpleos-accent begin – written by simpleos-theme (Control Center → Appearance); changes inside are lost */"
END = "/* simpleos-accent end */"
BASE = "#5294e2"
# The accent in app windows: Catppuccin's colors with enough contrast for white text and ticks on them in both modes
# (the pastel Mocha colors of the menus are too light for that, Latte's are)
ACCENTS = {"blue": None, "mauve": "#8839ef", "pink": "#d55cb2", "green": "#40a02b", "peach": "#e5600a",
           "teal": "#179299"}
COLOR = re.compile(r"#([0-9a-fA-F]{6})\b|rgba\((\d+), ?(\d+), ?(\d+), ?([\d.]+)\)")


def log(text):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write("gtk-accent: " + text + "\n")
    except OSError:
        pass


def hls(hexcolor):
    r, g, b = (int(hexcolor[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return colorsys.rgb_to_hls(r, g, b)


SUGGESTED = "#4dadd4"   # Arc's "suggested action" buttons (Install, Apply …): its info color, ~197°


def in_family(h, l, s, lo=0.565, hi=0.61):
    """Arc's accent blue and its shades (hue ~212°); not its info color (~197°) nor greys"""
    return s > 0.45 and lo < h < hi and 0.25 < l < 0.985


class Mapper:
    def __init__(self, target, base=BASE, hue=(0.565, 0.61)):
        self.bh, self.bl, self.bs = hls(base[1:])
        self.th, self.tl, self.ts = hls(target[1:])
        self.hue = hue

    def rgb(self, r, g, b):
        """(r, g, b) 0-255 -> mapped (r, g, b), or None if not an accent shade"""
        h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        if not in_family(h, l, s, *self.hue):
            return None
        if l >= self.bl:
            nl = self.tl + (l - self.bl) * (1 - self.tl) / (1 - self.bl)
        else:
            nl = l * self.tl / self.bl
        ns = max(0.0, min(1.0, s * self.ts / self.bs))
        nr, ng, nb = colorsys.hls_to_rgb(self.th, nl, ns)
        return round(nr * 255), round(ng * 255), round(nb * 255)

    def css(self, value):
        """value with every accent shade replaced; None if it has none"""
        changed = False

        def sub(m):
            nonlocal changed
            if m.group(1):
                h = m.group(1)
                new = self.rgb(*(int(h[i:i + 2], 16) for i in (0, 2, 4)))
                if new is None:
                    return m.group(0)
                changed = True
                return "#%02x%02x%02x" % new
            new = self.rgb(int(m.group(2)), int(m.group(3)), int(m.group(4)))
            if new is None:
                return m.group(0)
            changed = True
            return "rgba(%d, %d, %d, %s)" % (*new, m.group(5))
        out = COLOR.sub(sub, value)
        return out if changed else None


def load_theme(name, css_name):
    """(css text, Gio.Resource) of an Arc theme from its gtk.gresource"""
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
    res = Gio.Resource.load(str(THEMES / name / "gtk-3.0/gtk.gresource"))
    data = res.lookup_data(f"/org/gnome/arc-theme/{css_name}", Gio.ResourceLookupFlags.NONE)
    return data.get_data().decode("utf-8"), res


def declarations(css):
    """[(selector, property, value)] in file order (Arc's compiled CSS: no nesting, @define-color left out)"""
    css = re.sub(r"/\*.*?\*/", "", css, flags=re.S)
    found = []
    for m in re.finditer(r"([^{}@;]+)\{([^{}]*)\}", css):
        selector = " ".join(m.group(1).split())
        for decl in m.group(2).split(";"):
            if ":" in decl:
                prop, value = decl.split(":", 1)
                found.append((selector, prop.strip(), value.strip()))
    return found


def recolor_asset(res, name, mapper, folder):
    """assets/NAME recolored into folder; True if it contained the accent"""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf, Gio, GLib
    try:
        data = res.lookup_data(f"/org/gnome/arc-theme/assets/{name}", Gio.ResourceLookupFlags.NONE)
    except GLib.Error:
        return False
    loader = GdkPixbuf.PixbufLoader.new_with_type("png")
    loader.write(data.get_data())
    loader.close()
    pix = loader.get_pixbuf()
    if not pix.get_has_alpha():
        pix = pix.add_alpha(False, 0, 0, 0)
    w, h, stride, n = pix.get_width(), pix.get_height(), pix.get_rowstride(), pix.get_n_channels()
    px = bytearray(pix.get_pixels())
    hit = False
    cache = {}
    for y in range(h):
        row = y * stride
        for x in range(w):
            i = row + x * n
            if px[i + 3] == 0:
                continue
            key = bytes(px[i:i + 3])
            if key not in cache:
                cache[key] = mapper.rgb(*key)
            new = cache[key]
            if new:
                px[i:i + 3] = bytes(new)
                hit = True
    if not hit:
        return False
    out = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(px)), GdkPixbuf.Colorspace.RGB, True, 8, w, h, stride)
    folder.mkdir(parents=True, exist_ok=True)
    out.savev(str(folder / name), "png", [], [])
    return True


def block(accent, mode):
    target = ACCENTS.get(accent)
    if target is None:
        return None
    mapper = Mapper(target)
    # the suggested-action buttons get the accent too (with Arc's turquoise they stood out next to green radios)
    suggested = Mapper(target, SUGGESTED, (0.52, 0.565))
    light_css, light_res = load_theme("Arc-Lighter", "gtk-main-lighter.css")
    dark_css, dark_res = load_theme("Arc-Dark", "gtk-main-dark.css")
    light = declarations(light_css)
    dark = {(s, p): v for s, p, v in declarations(dark_css)}
    own, res = (light, light_res) if mode == "light" else (declarations(dark_css), dark_res)
    folder = DATA / f"{accent}-{mode}"
    rules, seen_assets = {}, {}
    order = []
    # colors: the same value in both modes (links differ – not touched)
    for sel, prop, value in light:
        if "url(" in value or dark.get((sel, prop)) != value or "link" in sel:
            continue
        new = mapper.css(value)
        if "suggested-action" in sel:
            new = suggested.css(new or value) or new
        if new:
            if sel not in rules:
                rules[sel] = []
                order.append(sel)
            rules[sel].append(f"{prop}: {new}")
    # images with the accent in them, of the current mode
    for sel, prop, value in own:
        names = re.findall(r'url\("assets/([^"/]+\.png)"\)', value)
        if not names:
            continue
        ok = True
        for name in names:
            if name not in seen_assets:
                seen_assets[name] = recolor_asset(res, name, mapper, folder)
            ok = ok and seen_assets[name]
        if not any(seen_assets[n] for n in names):
            continue
        new = re.sub(r'url\("assets/([^"/]+\.png)"\)',
                     lambda m: f'url("{(folder / m.group(1)).as_uri()}")' if seen_assets.get(m.group(1))
                     else m.group(0), value)
        if sel not in rules:
            rules[sel] = []
            order.append(sel)
        rules[sel].append(f"{prop}: {new}")
    lines = [BEGIN, f"/* accent {accent} ({target}), {mode} mode */",
             f"@define-color theme_selected_bg_color {target};", f"@define-color selected_bg_color {target};"]
    lines += [f"{sel} {{ {'; '.join(decls)}; }}" for sel in order for decls in [rules[sel]]]
    lines.append(END)
    return "\n".join(lines) + "\n"


def previous_folder():
    """<accent>-<mode> the current block's images are in ("" if none)"""
    try:
        found = re.search(r"/gtk-accent/([a-z]+-(?:light|dark))/", GTK_CSS.read_text())
    except OSError:
        return ""
    return found.group(1) if found else ""


def write(text):
    try:
        old = GTK_CSS.read_text()
    except OSError:
        old = ""
    start, stop = old.find(BEGIN), old.find(END)
    if start >= 0 and stop > start:
        rest = old[:start] + old[stop + len(END):].lstrip("\n")
    else:
        rest = old
    new = (text or "") + rest
    if new == old:
        return
    if not new.strip():
        if GTK_CSS.exists():
            GTK_CSS.unlink()
        return
    GTK_CSS.parent.mkdir(parents=True, exist_ok=True)
    tmp = GTK_CSS.with_name("gtk.css.tmp")
    tmp.write_text(new)
    tmp.replace(GTK_CSS)


def main(argv):
    accent, mode, show = "blue", "dark", False
    args = list(argv[1:])
    while args:
        a = args.pop(0)
        if a == "--accent" and args:
            accent = args.pop(0)
        elif a == "--mode" and args:
            mode = args.pop(0)
        elif a == "--show":
            show = True
    if accent not in ACCENTS or mode not in ("light", "dark"):
        log(f"unknown accent/mode {accent}/{mode}")
        return 0
    try:
        text = block(accent, mode)
    except Exception as err:  # noqa: BLE001 – a missing theme or GTK must never stop simpleos-theme
        log(f"{accent}/{mode}: {err}")
        return 0
    if show:
        sys.stdout.write(text or "")
        return 0
    try:
        keep = {f"{accent}-{mode}", previous_folder()}
        write(text)
        # older images are not needed any more – the previous ones are, by apps that are still open (#169)
        if DATA.is_dir():
            import shutil
            for d in DATA.iterdir():
                if d.name not in keep:
                    shutil.rmtree(d, ignore_errors=True)
    except OSError as err:
        log(f"write: {err}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
