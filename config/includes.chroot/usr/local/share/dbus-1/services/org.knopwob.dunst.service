# Simple OS: dunst via D-Bus only through simpleos-dunst (battery filter in VMs / without a real battery).
# /usr/local/share comes before /usr/share in XDG_DATA_DIRS -> this file replaces dunst's.
[D-BUS Service]
Name=org.freedesktop.Notifications
Exec=/usr/local/bin/simpleos-dunst
SystemdService=dunst.service
