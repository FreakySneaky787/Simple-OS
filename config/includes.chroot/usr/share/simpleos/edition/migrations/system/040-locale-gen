#!/bin/sh
# Simple OS 1.0.4 – generate the system language (runs once, as root, from the postinst of the package simpleos via
# "edition --system"). Up to 1.0.3 the image's /etc/locale.gen listed only en_US.UTF-8, so the installer could not
# switch on another language: /etc/default/locale named e.g. de_DE.UTF-8, but it was never generated (programs fell
# back to English, apt printed perl locale warnings). Every locale named in /etc/default/locale that Debian knows is
# switched on in /etc/locale.gen; locale-gen runs if one of them is missing (/usr/local/lib/simpleos/locale-enable,
# since 1.1 shared with Control Center → Language & Region). Exit != 0 -> again next time.
# Tests: SIMPLEOS_LOCALE_FILE, SIMPLEOS_LOCALE_ENABLE + the variables of locale-enable (SIMPLEOS_LOCALE_GEN,
# SIMPLEOS_SUPPORTED, SIMPLEOS_LOCALE_GEN_CMD, SIMPLEOS_LOCALE_A_CMD)
DEFAULT=${SIMPLEOS_LOCALE_FILE:-/etc/default/locale}
ENABLE=${SIMPLEOS_LOCALE_ENABLE:-/usr/local/lib/simpleos/locale-enable}
[ -f "$DEFAULT" ] && [ -f "${SIMPLEOS_SUPPORTED:-/usr/share/i18n/SUPPORTED}" ] || exit 0
# shellcheck disable=SC2046
exec "$ENABLE" $(sed -n 's/^[A-Z_]*=//p' "$DEFAULT" | tr -d "\"'" | sort -u)
