#!/bin/sh
# Simple OS 1.1.1 – each software store its own icon (#117). Runs once per account at sign-in. If Bazaar (the
# Software Store) is already installed, its own launcher is hidden and gets the Software Store's icon, so the menu and
# the search show one store, not two with different icons (simpleos-software writes the same copy at every start).
# Never fails (exit 0).
[ -x /usr/local/bin/simpleos-software ] && /usr/local/bin/simpleos-software --hide-launcher >/dev/null 2>&1
exit 0
