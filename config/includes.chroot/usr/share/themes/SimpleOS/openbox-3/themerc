# Simple OS – Openbox theme (Catppuccin Mocha)
border.width: 1
padding.width: 8
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

window.active.border.color: #89b4fa
window.inactive.border.color: #313244
window.active.client.color: #1e1e2e
window.inactive.client.color: #181825

window.active.title.bg: flat solid
window.active.title.bg.color: #1e1e2e
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #181825
window.active.title.separator.color: #313244
window.inactive.title.separator.color: #181825
# Window buttons (#121): Openbox makes them as big as the title label minus 2 px – with a plain label (title font
# height) that was 14 px at 100 %. A bevel adds 2 px on each side of the label = 18 px buttons; highlight and shadow 0
# and the title's own color keep it invisible. The images (iconify/max/max_toggled/close.xbm, 10 px instead of
# Openbox's built-in 6 px) come from tools/gen-openbox-buttons.py; simpleos-theme copies the set for 125/150/200 %.
window.active.label.bg: raised solid bevel2
window.active.label.bg.color: #1e1e2e
window.active.label.bg.highlight: 0
window.active.label.bg.shadow: 0
window.active.label.text.color: #cdd6f4
window.inactive.label.bg: raised solid bevel2
window.inactive.label.bg.color: #181825
window.inactive.label.bg.highlight: 0
window.inactive.label.bg.shadow: 0
window.inactive.label.text.color: #6c7086
window.label.text.justify: center

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1e1e2e
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #181825
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1e1e2e
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #181825

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #cdd6f4
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #313244
window.active.button.hover.image.color: #89b4fa
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #45475a
window.active.button.pressed.image.color: #89b4fa
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #45475a
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #89b4fa
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #6c7086
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #313244
window.inactive.button.hover.image.color: #cdd6f4
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #45475a
window.inactive.button.pressed.image.color: #cdd6f4
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #313244
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #6c7086
# Close: red under the pointer, like on Windows, so it is clear which button closes (#121). Own red, not the accent
# (simpleos-theme replaces only #89b4fa).
window.active.button.close.hover.bg: flat solid
window.active.button.close.hover.bg.color: #d20f39
window.active.button.close.hover.image.color: #ffffff
window.active.button.close.pressed.bg: flat solid
window.active.button.close.pressed.bg.color: #a50d2d
window.active.button.close.pressed.image.color: #ffffff
window.inactive.button.close.hover.bg: flat solid
window.inactive.button.close.hover.bg.color: #d20f39
window.inactive.button.close.hover.image.color: #ffffff
window.inactive.button.close.pressed.bg: flat solid
window.inactive.button.close.pressed.bg.color: #a50d2d
window.inactive.button.close.pressed.image.color: #ffffff

# Menus (right-click, window menu) – Catppuccin Mocha:
#   Base #1e1e2e, text #cdd6f4, selection Surface0 #313244 with Mauve #cba6f7, separators Surface1 #45475a.
# Openbox 3.6 has no padding for menu entries -> a wide border in the background color serves as padding
# (the selection floats as an area in the menu instead of sticking to the edge). The outline comes from picom: rounded
# corners (10 px) and a soft shadow instead of a hard, square line. Its own mauve color, so simpleos-theme (replaces
# only the window accent #89b4fa) does not recolor the menus.
menu.border.width: 6
menu.border.color: #1e1e2e
menu.overlap.x: -8
menu.overlap.y: -6
menu.title.bg: flat solid
menu.title.bg.color: #1e1e2e
menu.title.text.color: #cba6f7
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #1e1e2e
menu.items.text.color: #cdd6f4
menu.items.disabled.text.color: #6c7086
menu.items.active.bg: flat solid
menu.items.active.bg.color: #313244
menu.items.active.text.color: #cba6f7
menu.items.active.disabled.text.color: #6c7086
menu.separator.width: 1
menu.separator.color: #45475a
menu.separator.padding.width: 6
menu.separator.padding.height: 6
menu.bullet.image.color: #a6adc8
menu.bullet.selected.image.color: #cba6f7

osd.border.width: 1
osd.border.color: #313244
osd.bg: flat solid
osd.bg.color: #1e1e2e
osd.label.bg: parentrelative
osd.label.text.color: #cdd6f4
osd.hilight.bg: flat solid
osd.hilight.bg.color: #89b4fa
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #313244
