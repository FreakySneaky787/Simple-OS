# Simple OS – default applications (double click in the file manager, xdg-open)
#   Web         firefox-esr (simpleos-browser-select writes your own choice to ~/.config/mimeapps.list)
#   Pictures    viewnior (webp/avif/heif: feh)     PDF/e-books/comics  atril
#   Audio/video mpv                                Archives            file-roller (Archive Manager)
#   Text        mousepad                           Folders             thunar
# Generated from the MimeType lines of the .desktop files; 99_verify checks the most important ones via xdg-mime.
[Default Applications]
x-scheme-handler/http=firefox-esr.desktop
x-scheme-handler/https=firefox-esr.desktop
