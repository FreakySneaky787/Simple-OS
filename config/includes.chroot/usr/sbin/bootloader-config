#!/bin/bash
# Simple OS – replaces /usr/sbin/bootloader-config from calamares-settings-debian (Calamares job before
# grubcfg/bootloader). The original installs grub-pc/grub-efi-amd64 with apt from the medium's package
# pool; the Simple OS ISO has no pool -> apt failed (unnoticed), then update-grub was missing
# and the job ended with exit 127.
# Here: the GRUB binary packages (BIOS + UEFI) are in the image (package-lists/55-bootloader) and thus already in the
# target system; the meta packages are stored as .deb in $DEBS (hook 08_bootloader_debs) and installed offline.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
DEBS=/usr/share/simpleos/bootloader-debs

die() { echo "bootloader-config: ERROR: $*" >&2; exit 1; }

# Tools in the live system
for c in mount findmnt grep awk sed chroot; do
    command -v "$c" >/dev/null || die "program $c missing in the live system"
done

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g" | head -n1 || true)
[ -n "$CHROOT" ] && [ -d "$CHROOT" ] || die "target system (Calamares chroot) not found"

# Command available in the target system? (PATH including sbin, independent of the Calamares environment)
in_target() { chroot "$CHROOT" /usr/bin/env PATH=/usr/sbin:/usr/bin:/sbin:/bin "$@"; }
need() {
    for c in "$@"; do
        in_target sh -c "command -v '$c'" >/dev/null || die "program $c missing in the target system"
    done
}
# Install a .deb from $DEBS (without network, dependencies are preinstalled)
install_deb() {
    local deb
    deb=$(cd "$CHROOT$DEBS" 2>/dev/null && ls "$1"_*.deb 2>/dev/null | head -n1 || true)
    [ -n "$deb" ] || die "package file $1_*.deb missing in $DEBS"
    echo " * Installing $1 (offline: $deb)"
    in_target dpkg -i "$DEBS/$deb" || die "installation of $1 failed"
}

need dpkg sh

# Encryption: luks tools into the initramfs and safe permissions for the initramfs (Calamares recreates it
# later, here only the setting)
if [ "$(findmnt -n -o SOURCE "$CHROOT" | cut -c -16)" = "/dev/mapper/luks" ]; then
    need cryptsetup keyctl update-initramfs
    echo "UMASK=0077" > "$CHROOT/etc/initramfs-tools/conf.d/initramfs-permissions"
    install_deb cryptsetup-initramfs
fi

# Small initramfs (#47): MODULES=dep if a test build works in the new system – Calamares' initramfs job comes later and
# then builds it in seconds instead of a minute. Never stops the installation (MODULES=most stays otherwise).
in_target /usr/local/lib/simpleos/initramfs-dep --try || true

echo "Running bootloader-config..."
if [ -d /sys/firmware/efi/efivars ]; then
    echo " * UEFI detected"
    [ -d "$CHROOT/usr/lib/grub/x86_64-efi" ] || die "GRUB modules for UEFI missing (grub-efi-amd64-bin)"
    install_deb grub-efi-amd64
    need efibootmgr
else
    echo " * BIOS detected"
    [ -d "$CHROOT/usr/lib/grub/i386-pc" ] || die "GRUB modules for BIOS missing (grub-pc-bin)"
    install_deb grub-pc
fi
# Commands that this job and then the Calamares modules grubcfg/bootloader call
need grub-install grub-mkconfig grub-probe update-grub

# os-prober (GRUB 2.06 disables it by default), so other systems end up in the menu: the image carries
# /etc/default/grub.d/simpleos-os-prober.cfg. Not in /etc/default/grub – every GRUB update from Debian turns an os-prober
# line there into "off" again (grub-pc.config sets grub2/enable_os_prober=false for any GRUB_DISABLE_OS_PROBER line).
OS_PROBER_CFG="$CHROOT/etc/default/grub.d/simpleos-os-prober.cfg"
if ! grep -qx 'GRUB_DISABLE_OS_PROBER=false' "$OS_PROBER_CFG" 2>/dev/null; then
    mkdir -p "${OS_PROBER_CFG%/*}"
    echo 'GRUB_DISABLE_OS_PROBER=false' > "$OS_PROBER_CFG"
fi

in_target update-grub || die "update-grub failed"
