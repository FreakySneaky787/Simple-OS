#!/bin/sh
set -e
# Battery programs only with a real battery: false "Battery low" alarms in VMs/on desktop PCs come from services
# that report phantom batteries (UPower, the VM's ACPI dummies). All start paths are covered:
#   XDG autostart  Exec via "simpleos-battery --run" (starts only with a real battery, never in VMs);
#                  xfce4-power-manager additionally Hidden=true (~/.config/openbox/autostart starts it itself)
#   systemd        upower/acpid: ConditionVirtualization=!vm (drop-ins under /etc/systemd/system)
#   dunst          simpleos-dunst (autostart, D-Bus, systemd user service) filters whatever still comes
# This does not apply automatically to packages with the same names installed later -> 99_verify checks all
# start paths again.
BATT_RE='xfce4-power-manager|cbatticon|mate-power-manager|gnome-power-manager|gsd-power|powerdevil|batterymon|fdpowermon|batti|statnot|acpid'
for f in /etc/xdg/autostart/*.desktop; do
    [ -f "$f" ] || continue
    exec_line=$(sed -n 's/^Exec=//p' "$f" | head -n 1)
    printf '%s\n%s\n' "${f##*/}" "$exec_line" | grep -qE "$BATT_RE" || continue
    case "$exec_line" in */usr/local/bin/simpleos-battery\ --run\ *) continue ;; esac
    sed -i "s|^Exec=\(.*\)\$|Exec=/usr/local/bin/simpleos-battery --run \1|" "$f"
    grep -q '^Exec=/usr/local/bin/simpleos-battery --run ' "$f"
done
XFPM=/etc/xdg/autostart/xfce4-power-manager.desktop
if [ -f "$XFPM" ]; then
    sed -i '/^Hidden=/d' "$XFPM"
    sed -i '/^\[Desktop Entry\]/a Hidden=true' "$XFPM"
    grep -qx 'Hidden=true' "$XFPM"
fi
