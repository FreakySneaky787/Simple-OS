#!/bin/sh
set -e
# Put the bootloader meta packages of the installed system into the image as .deb: grub-pc (BIOS) and
# grub-efi-amd64 (UEFI) exclude each other and cannot both be preinstalled; cryptsetup-initramfs
# only with encryption. /usr/sbin/bootloader-config installs them offline with dpkg -i,
# simpleos-post-install deletes the directory afterwards. Versions matching the installed *-bin packages.
DEBS=/usr/share/simpleos/bootloader-debs
GRUB_VER=$(dpkg-query -W -f='${Version}' grub-pc-bin)
CRYPT_VER=$(dpkg-query -W -f='${Version}' cryptsetup)
rm -rf "$DEBS"
mkdir -p "$DEBS"
cd "$DEBS"
apt-get download "grub-pc=$GRUB_VER" "grub-efi-amd64=$GRUB_VER" "cryptsetup-initramfs=$CRYPT_VER"
chmod 0644 ./*.deb
