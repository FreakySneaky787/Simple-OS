#!/bin/sh
set -e
# Live session without passwords: the live user "simple" may do every administrator action without a password
# dialog (start the installer, Setup Wizard installations, Software Store, drivers …). Its sudo is already
# without a password (/etc/sudoers.d/simple-nopasswd); polkit (pkexec) asked for "live". Debian's live-config only
# writes a .pkla file, which polkitd 122 no longer reads.
# Only the live image: simpleos-post-install deletes the rule (and Calamares removes the user "simple").
# Written here instead of includes.chroot: rules.d belongs to polkitd (0700), copying the includes would change it.
RULES=/etc/polkit-1/rules.d/49-simpleos-live.rules
cat > "$RULES" <<'RULE'
// Simple OS live session: the live user may do everything without a password (removed by simpleos-post-install)
polkit.addRule(function(action, subject) {
    if (subject.user == "simple" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
RULE
chmod 0644 "$RULES"
grep -q 'subject.user == "simple"' "$RULES"
