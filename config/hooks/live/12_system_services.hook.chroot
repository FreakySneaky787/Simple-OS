#!/bin/sh
set -e
# Protection and maintenance (package list 15-system), after the package installation, because these are the packages' configuration files.
# Firewall (ufw): on from the first boot. ufw's default rules: incoming DROP, outgoing open; mDNS (printer discovery)
# and UPnP replies already pass through /etc/ufw/before*.rules, DHCP as well. "ufw enable" does not work in the chroot
# (no netfilter tables) – ENABLED=yes makes ufw.service load the rules at boot.
# Switch: Control Center → System → Firewall (pkexec simpleos-system-setup --firewall on|off)
sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
grep -qx 'ENABLED=yes' /etc/ufw/ufw.conf
grep -qx 'DEFAULT_INPUT_POLICY="DROP"' /etc/default/ufw
# earlyoom: only steps in when RAM (5 %) AND swap/zram (10 %) are almost full; never ends the desktop itself.
# systemd splits $EARLYOOM_ARGS at spaces and does not evaluate quotes -> patterns without spaces/quotes
cat > /etc/default/earlyoom <<'CONF'
# Simple OS: when memory is almost full, end the program using the most memory (browser tabs
# first, they raise their own score), never the display, windows, taskbar, sound or network.
EARLYOOM_ARGS="-m 5 -s 10 -r 3600 --avoid (^|/)(init|systemd|Xorg|X|lightdm|openbox|tint2|pipewire|wireplumber|dbus-daemon|NetworkManager)$"
CONF
# Switch services on explicitly (package defaults could change)
systemctl enable ufw.service earlyoom.service power-profiles-daemon.service thermald.service fwupd-refresh.timer
