#!/bin/sh
groupadd -r autologin 2>/dev/null || true
useradd -m -s /bin/bash simple 2>/dev/null || true
usermod -aG autologin,sudo simple 2>/dev/null || true
# Set up printers (lpadmin, CUPS) and use scanners – a separate call: if a group is missing, sudo would
# otherwise fail too
for g in lpadmin scanner; do usermod -aG "$g" simple 2>/dev/null || true; done
echo "simple:live" | chpasswd
# Also copy the skel files in case the user already existed before
cp -rn /etc/skel/. /home/simple/
chown -R simple:simple /home/simple
# sudo ignores sudoers files that are not owned by root or not 0440
chown root:root /etc/sudoers.d/simple-nopasswd
chmod 0440 /etc/sudoers.d/simple-nopasswd
visudo -cf /etc/sudoers.d/simple-nopasswd
