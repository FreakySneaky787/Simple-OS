#!/bin/sh
set -e
# Re-run on Simple OS updates (package simpleos, edition --system): must stay idempotent.
# Software Updates may look for updates without a password: "pkexec simpleos-system-setup --refresh" only downloads
# package lists and firmware metadata, it installs nothing. Allowed for the active, local session of an
# administrator (group sudo) – exactly this command line, everything else (installing, --upgrade, drivers …) still
# asks for the password. The file comes from a hook instead of includes.chroot: rules.d belongs to polkitd (0700),
# copying the includes would change the folder's permissions.
RULES=/etc/polkit-1/rules.d/50-simpleos-update-refresh.rules
cat > "$RULES" <<'RULE'
// Simple OS – Software Updates: look for updates without a password (only download package lists, install nothing)
polkit.addRule(function(action, subject) {
    if (action.id == "org.simpleos.system-setup" &&
        action.lookup("command_line") == "/usr/local/sbin/simpleos-system-setup --refresh" &&
        subject.active && subject.local && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
RULE
chmod 0644 "$RULES"
grep -q 'simpleos-system-setup --refresh' "$RULES"
