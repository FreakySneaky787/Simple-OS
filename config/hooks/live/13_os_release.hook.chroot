#!/bin/sh
# Simple OS – /usr/lib/os-release comes from the package "simpleos" and is protected against Debian updates:
# the file belongs to base-files and is not a conffile – every point release (12.x) would replace it, along with
# /etc/os-release, by "Debian GNU/Linux 12" (name, version and BUG_REPORT_URL for simpleos-report gone).
# The package's preinst diverts it (dpkg-divert --package simpleos): Debian's version goes to /usr/lib/os-release.debian.
# /etc/os-release stays a link to it, as on Debian (base-files recreates it unchanged on updates).
set -e
OSR=/usr/lib/os-release
grep -q '^ID=simpleos$' "$OSR"
[ "$(dpkg-divert --listpackage "$OSR")" = simpleos ] ||
    { echo "13_os_release: $OSR is not diverted by the package simpleos (preinst)" >&2; exit 1; }
ln -sfn ../usr/lib/os-release /etc/os-release
