#!/bin/sh
set -e
# Launcher (Rofi) entrümpeln: doppelte und rohe System-Werkzeuge ausblenden. Kopien mit NoDisplay=true in
# /usr/local/share/applications haben Vorrang vor /usr/share/applications und überleben Paket-Updates.
# Einstellungen laufen über Menü → Settings (Display, Sound, Network, Appearance, Setup Wizard).
#   arandr (doppelt zu lxrandr), lxappearance/obconf/tint2conf (rohe Theme-/WM-Editoren, überschreiben
#   simpleos-theme), pcmanfm (zweiter Dateimanager, nur für Desktop-Icons), Hilfsprogramme ohne eigenen Nutzen.
DEST=/usr/local/share/applications
mkdir -p "$DEST"
for id in arandr lxappearance obconf tint2 tint2conf picom feh pcmanfm blueman-adapters \
          thunar-settings thunar-bulk-rename org.xfce.mousepad-settings software-properties-gtk \
          python3.11 vim kcm_trash ktelnetservice5 org.kde.kded5 org.kde.kwalletd5 install-debian \
          timeshift-gtk; do
    src=/usr/share/applications/$id.desktop
    [ -f "$src" ] || continue
    sed -e '/^NoDisplay=/d' -e '/^\[Desktop Entry\]/a NoDisplay=true' "$src" > "$DEST/$id.desktop"
done
update-desktop-database -q "$DEST" 2>/dev/null || true
