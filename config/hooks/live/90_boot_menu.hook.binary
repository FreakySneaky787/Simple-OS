#!/bin/sh
# Simple OS – labels of the ISO's UEFI boot menu (GRUB). live-build hard-codes "Live system (amd64)";
# the BIOS menu (isolinux) comes from config/bootloaders/isolinux/live.cfg.in, the background image of both menus
# from tools/gen_branding.py. Runs in binary/ after the menus are created, before checksums and the ISO.
# If the hook does not find the entries (new live-build), the build aborts instead of silently showing "Live system".
set -e
CFG=boot/grub/grub.cfg
grep -q '^menuentry "Live system (amd64)"' "$CFG"
grep -q '^menuentry "Live system (amd64 fail-safe mode)"' "$CFG"
sed -i -e 's/^menuentry "Live system (amd64)"/menuentry "Simple OS Live"/' \
       -e 's/^menuentry "Live system (amd64 fail-safe mode)"/menuentry "Simple OS Live (safe mode)"/' "$CFG"
grep -q '^menuentry "Simple OS Live" --hotkey=l {' "$CFG"
! grep -q 'Live system' "$CFG"
