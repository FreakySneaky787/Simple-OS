# Simple OS – applications
kitty
thunar
thunar-archive-plugin
# Thumbnails in the file manager (Thunar has no thumbnailer of its own)
tumbler
file-roller
gvfs
gvfs-backends
# FUSE bridge: files on phones (MTP) and network shares are also usable in programs that do not use GIO
gvfs-fuse
udisks2
# Mount USB sticks automatically (Openbox autostart, notification via simpleos-usb-notify)
udiskie
firefox-esr
mousepad
atril
mpv
viewnior
galculator
# Camera (simpleos-camera, #44): GStreamer from Python (GObject introspection) and its GTK picture widget
gir1.2-gstreamer-1.0
gir1.2-gst-plugins-base-1.0
gstreamer1.0-gtk3
# Disks: format USB sticks, write ISO images, disk health (Control Center → System)
gnome-disk-utility
htop
# Tab completion in the terminal (apt, git, systemctl …)
bash-completion
# Media keys (play/pause, next, previous) for browsers, Spotify … via MPRIS – tiny, see rc.xml
playerctl
# Flatpak + Flathub (Bazaar as Software Store), GNOME Software, portals for Flatpak apps
flatpak
gnome-software
gnome-software-plugin-flatpak
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-utils
