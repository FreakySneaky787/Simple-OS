# Simple OS – desktop (X11, Openbox, login, look & feel)
xorg
x11-xserver-utils
# Input: libinput explicitly (precise pointer, touchpad, smooth scrolling)
xserver-xorg-input-libinput
openbox
# openbox-xdg-autostart (Python) needs PyXDG – without it the autostart entries of apps (~/.config/autostart: Steam,
# Discord, KeePassXC …) never run. The programs of ~/.config/openbox/autostart are blocked in ~/.config/autostart
# (Hidden=true) so nothing starts twice.
python3-xdg
# Login manager with GTK greeter
lightdm
lightdm-gtk-greeter
tint2
feh
picom
# glxinfo: simpleos-picom detects software rendering (llvmpipe) and then starts without shadows/fades
mesa-utils
rofi
xcape
pcmanfm
dunst
libnotify-bin
lxpolkit
gnome-keyring
# Unlocks the login keyring with the login password (PAM, /etc/pam.d/lightdm) – otherwise apps that store secrets
# (Chromium, Signal, Discord, VS Code) ask for a new keyring password
libpam-gnome-keyring
xfce4-power-manager
# Theme & fonts
arc-theme
papirus-icon-theme
fonts-inter
fonts-jetbrains-mono
# Color emoji (browsers, chats, file names) and fonts metric-compatible with Arial/Times/Courier – office documents
# from Windows keep their line breaks and page count
fonts-noto-color-emoji
# Every other writing system (Arabic, Hebrew, Thai, Indic, Georgian …) and a small CJK font (WenQuanYi Micro Hei, 5 MB:
# Chinese, Japanese, Korean): without them web pages and file names in these scripts show empty boxes (nothing in the
# image has the glyphs). Chinese/Japanese/Korean systems get the full Noto CJK from simpleos-system-setup --language
fonts-noto-core
fonts-wqy-microhei
fonts-liberation2
fonts-font-awesome
# Store GTK settings permanently (dark/light, accent) + Setup Wizard (Python/GTK3)
dconf-gsettings-backend
python3-gi
# simpleos-progress (progress window) draws with Cairo in the GTK window
python3-gi-cairo
gir1.2-gtk-3.0
# Welcome window (simpleos-welcome): own WebKit window instead of the default browser (WebKit is already there,
# these are just the Python bindings, ~1 MB)
gir1.2-webkit2-4.1
# Configuration tools
lxappearance
obconf
arandr
lxrandr
# Network, Bluetooth, audio in the taskbar
network-manager-gnome
# VPN (OpenVPN, the common work/school VPN) in the network menu: Edit Connections → Add → Import a saved VPN
network-manager-openvpn-gnome
bluez
blueman
libspa-0.2-bluetooth
# alsa-ucm-conf: device profiles without which the speakers/microphones of many current laptops (Intel SOF, AMD,
# Chromebook-style codecs) show up as "Dummy Output" or only as headphones – libasound2-data only Recommends it.
# alsa-utils: alsamixer/amixer (an unmuted-by-hand "Speaker"/"Headphone" switch is the classic fix for "no sound")
# and the saving of the mixer state between boots
alsa-ucm-conf
alsa-utils
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
# Real-time priority for PipeWire (without it: "RTKit error: ServiceUnknown", crackling under load)
rtkit
pavucontrol
# pactl for the volume keys (talks to pipewire-pulse)
pulseaudio-utils
volumeicon-alsa
# Screenshots (Print, Shift+Print); xclip: screenshot + clipboard history (Super+V) into the clipboard
maim
xclip
# Night light (simpleos-nightlight), Bluetooth radio switch (simpleos-bluetooth), file type detection
# (Thunar actions: simpleos-wallpaper, simpleos-copy-file). Task Manager: own simpleos-taskmanager
# (SIGTERM -> SIGKILL, pkexec for other users' processes); hardware detection for simpleos-drivers: pciutils/usbutils
pciutils
usbutils
gammastep
rfkill
file
# broadwayd: 99_verify starts Control Center and Software Center without a screen (GUI self-test)
libgtk-3-bin
# XSETTINGS service: light/dark (simpleos-theme) switches immediately in running GTK3 programs
xsettingsd
# Window snapping (simpleos-snap: xdotool, wmctrl, xprop/xwininfo from x11-utils)
xdotool
wmctrl
x11-utils
# Restore points (simpleos-backup)
timeshift
# xinput: touchpad/mouse settings (simpleos-input: natural scrolling, tap to click, speed)
xinput
